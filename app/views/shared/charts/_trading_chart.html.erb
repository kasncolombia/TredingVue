<%
  # COMPONENTE TRADING CHART PROFESIONAL
  # Parámetros esperados:
  # - id: (opcional) String único para los contenedores (default: "main")
  # - symbol: String
  # - data_url: URL desde donde el JS buscará el JSON con {candles, volume, markers, price_lines}

  chart_id = local_assigns[:id] || "main"
  container_id = "tc-container-#{chart_id}"
%>

<div id="tc-wrapper-<%= chart_id %>" class="tc-wrapper flex flex-col w-full bg-lightCard dark:bg-darkCard border border-lightBorder dark:border-darkBorder rounded-2xl overflow-hidden shadow-sm h-full min-h-[380px] sm:min-h-[500px] lg:min-h-[600px] relative transition-colors">
  
  <!-- ==================== TOP TOOLBAR ==================== -->
  <div class="tc-toolbar flex-wrap flex items-center justify-between px-2 sm:px-4 py-2 border-b border-lightBorder dark:border-darkBorder bg-lightBg dark:bg-[#11121C] relative z-50">
    <div class="flex items-center gap-1 sm:gap-3 flex-wrap tc-toolbar-left">
      
      <!-- Symbol Info -->
      <div class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-slate-200/50 dark:hover:bg-darkHover cursor-pointer transition-colors" title="Change Symbol">
        <div class="w-6 h-6 rounded-full bg-brand/10 text-brand border border-brand/20 flex items-center justify-center font-bold text-xs uppercase"><%= symbol[0] %></div>
        <span class="font-extrabold text-sm text-slate-800 dark:text-white tracking-tight" id="tc-symbol-<%= chart_id %>"><%= symbol %></span>
      </div>
      
      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block shrink-0"></div>
      
      <!-- Timeframes Selector -->
      <div class="flex items-center gap-0.5 text-xs font-bold text-slate-500 tc-timeframes">
        <% ["1m", "5m", "15m", "1h", "4h", "1D"].each do |tf| %>
          <button class="tc-tf-btn px-2 py-1 rounded-md hover:bg-slate-200 dark:hover:bg-darkHover transition-colors <%= tf == '1m' ? 'text-brand bg-brand/10' : '' %>" data-tf="<%= tf %>"><%= tf %></button>
        <% end %>
      </div>
      
      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block shrink-0"></div>

      <!-- Chart Types Toggle (Mini Modal) -->
      <div class="relative flex items-center" id="tc-chart-type-<%= chart_id %>">
        <!-- Main Trigger -->
        <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-500 transition-colors tc-dropdown-trigger" title="Opciones de Gráfico">
          <span class="material-symbols-outlined text-[20px]" id="tc-current-chart-icon-<%= chart_id %>">candlestick_chart</span>
        </button>

        <!-- The Modal -->
        <div class="absolute top-full left-0 mt-2 w-64 bg-white dark:bg-[#1C1C28] rounded-xl shadow-2xl border border-slate-200 dark:border-darkBorder p-4 z-[999] hidden flex-col tc-dropdown-menu">
          <h4 class="text-caption text-slate-500 font-bold mb-3">Tipo de gráfico</h4>
          
          <div class="grid grid-cols-4 gap-2 mb-3">
             <button class="tc-type-btn flex flex-col items-center justify-center gap-1 p-2 rounded-xl border border-slate-200 dark:border-darkBorder bg-brand/5 border-brand/20 text-brand transition-all" data-type="candle" data-icon="candlestick_chart">
                <span class="material-symbols-outlined text-[24px]">candlestick_chart</span>
                <span class="text-[10px] font-bold">Velas</span>
             </button>
             <button class="tc-type-btn flex flex-col items-center justify-center gap-1 p-2 rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkHover/50 text-slate-500 transition-all" data-type="hollow" data-icon="candlestick_chart">
                <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 0;">candlestick_chart</span>
                <span class="text-[10px] font-bold">Huecas</span>
             </button>
             <button class="tc-type-btn flex flex-col items-center justify-center gap-1 p-2 rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkHover/50 text-slate-500 transition-all" data-type="bar" data-icon="waterfall_chart">
                <span class="material-symbols-outlined text-[24px]">waterfall_chart</span>
                <span class="text-[10px] font-bold">OHLC</span>
             </button>
             <button class="tc-type-btn flex flex-col items-center justify-center gap-1 p-2 rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkHover/50 text-slate-500 transition-all" data-type="area" data-icon="area_chart">
                <span class="material-symbols-outlined text-[24px]">area_chart</span>
                <span class="text-[10px] font-bold">Área</span>
             </button>
          </div>

          <div class="h-px bg-slate-200 dark:bg-darkBorder my-2 w-full"></div>

          <div class="flex items-center justify-between mb-3 mt-1">
             <h4 class="text-caption text-slate-500 font-bold">Color</h4>
             <button class="text-[10px] text-slate-400 font-medium flex items-center hover:text-slate-600 dark:hover:text-slate-300"><span class="material-symbols-outlined text-[13px] mr-1">edit</span> Editar</button>
          </div>

          <div class="flex items-center gap-2">
             <!-- Classic Palette -->
             <button class="tc-color-btn flex items-center p-2 rounded-lg border border-brand/20 bg-brand/5 gap-1 transition-all" data-palette="classic">
                <div class="w-4 h-4 rounded bg-[#089981]"></div>
                <div class="w-4 h-4 rounded bg-[#F23645]"></div>
             </button>
             <!-- Vibe Palette -->
             <button class="tc-color-btn flex items-center p-2 rounded-lg border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkHover/50 gap-1 transition-all" data-palette="vibe">
                <div class="w-4 h-4 rounded bg-[#8B5CF6]"></div>
                <div class="w-4 h-4 rounded bg-[#3B82F6]"></div>
             </button>
          </div>
        </div>
      </div>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 hidden lg:block shrink-0"></div>
      
      <!-- Compare / Indicators Modals Toggles -->
      <div class="hidden lg:flex items-center gap-2">
        <button class="tc-compare-btn px-2.5 py-1.5 flex items-center gap-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-xs font-bold text-slate-600 dark:text-slate-300 transition-colors">
          <span class="material-symbols-outlined text-[16px]">add</span> Compare
        </button>
        <button class="tc-indicators-btn px-2.5 py-1.5 flex items-center gap-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-xs font-bold text-slate-600 dark:text-slate-300 transition-colors">
          <span class="material-symbols-outlined text-[16px]">monitoring</span> Indicators
        </button>
      </div>

    </div>
    
    <!-- Toolbar Right -->
    <div class="flex items-center gap-1 sm:gap-2">
      <!-- Loading Spinner (Hidden by default) -->
      <div id="tc-loader-<%= chart_id %>" class="mr-2 hidden text-brand">
        <span class="material-symbols-outlined animate-spin text-[18px]">sync</span>
      </div>
      
      <!-- Actions -->
      <button class="tc-undo-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-400 dark:text-slate-500 transition-colors hidden xl:flex" title="Undo">
        <span class="material-symbols-outlined text-[18px]">undo</span>
      </button>
      <button class="tc-redo-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-400 dark:text-slate-500 transition-colors hidden xl:flex" title="Redo">
        <span class="material-symbols-outlined text-[18px]">redo</span>
      </button>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 hidden lg:block shrink-0 mx-1"></div>
      
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-400 dark:text-slate-400 transition-colors tc-settings-btn" title="Activar/Desactivar Cuadrícula">
        <span class="material-symbols-outlined text-[18px]">settings</span>
      </button>
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-400 dark:text-slate-400 transition-colors tc-screenshot-btn" title="Tomar Foto a la Gráfica">
        <span class="material-symbols-outlined text-[18px]">photo_camera</span>
      </button>
      
      <!-- Templates Mock & Fullscreen & Replay -->
      <button class="tc-templates-btn px-2.5 py-1.5 flex items-center gap-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-xs font-bold text-slate-600 dark:text-slate-300 transition-colors hidden md:flex" title="Templates">
        <span class="material-symbols-outlined text-[16px]">grid_view</span>
      </button>
      <button class="tc-replay-btn px-2.5 py-1.5 flex items-center gap-1 text-blue-600 dark:text-blue-400 bg-blue-500/10 hover:bg-blue-500/20 rounded-lg text-xs font-bold transition-colors shadow-sm hidden md:flex border border-blue-500/20" title="Simular Estrategia (Replay)">
        <span class="material-symbols-outlined text-[16px]">fast_rewind</span> Replay
      </button>
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover flex items-center justify-center text-slate-400 dark:text-slate-400 transition-colors tc-fullscreen-btn" title="Pantalla Completa">
        <span class="material-symbols-outlined text-[20px]">fullscreen</span>
      </button>
    </div>
  </div>

  <!-- ==================== BODY ==================== -->
  <div class="relative flex-1 flex w-full h-full bg-white dark:bg-[#090A10]">
    
    <!-- FASE 4: DRAWING TOOLS SIDEBAR (12 Tools) -->
    <div class="hidden sm:flex flex-col w-12 border-r border-lightBorder dark:border-darkBorder bg-lightBg dark:bg-darkCardAlt items-center py-2 space-y-1.5 shrink-0">
      <!-- 1. Cursor -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors text-brand bg-brand/10 border border-brand/20" title="Cursor en cruz"><span class="material-symbols-outlined text-[18px]">my_location</span></button>
      <!-- 2. Línea de tendencia -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Línea de Tendencia"><span class="material-symbols-outlined text-[18px]">show_chart</span></button>
      <!-- 3. Líneas horizontales -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Niveles / Horizontal"><span class="material-symbols-outlined text-[18px]">horizontal_rule</span></button>
      <!-- 4. Patrones -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Figuras de Patrón"><span class="material-symbols-outlined text-[18px]">polyline</span></button>
      <!-- 5. Rectángulo -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Rectángulo / Zona"><span class="material-symbols-outlined text-[18px]">crop_square</span></button>
      <!-- 6. Posición Larga -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Posición Larga"><span class="material-symbols-outlined text-[18px]">trending_up</span></button>
      <!-- 7. Posición Corta -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Posición Corta"><span class="material-symbols-outlined text-[18px]">trending_down</span></button>
      <!-- 8. Regla -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Regla / Medir"><span class="material-symbols-outlined text-[18px]">square_foot</span></button>
      <!-- 9. Texto -->
      <button class="tc-draw-btn w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Texto"><span class="material-symbols-outlined text-[18px]">title</span></button>
      
      <div class="w-6 h-px bg-slate-200 dark:bg-slate-700 my-1"></div>
      
      <!-- 10. Ocultar -->
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Mostrar/Ocultar Dibujos"><span class="material-symbols-outlined text-[18px]">visibility</span></button>
      <!-- 11. Candado -->
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400 flex items-center justify-center transition-colors" title="Bloquear Dibujos"><span class="material-symbols-outlined text-[18px]">lock</span></button>
      <!-- 12. Papelera -->
      <button class="w-8 h-8 rounded-lg hover:bg-slate-200 dark:hover:bg-darkHover text-slate-400/80 hover:text-rose-500 flex items-center justify-center transition-colors" title="Borrar Todo"><span class="material-symbols-outlined text-[18px]">delete</span></button>
    </div>

    <!-- MAIN CHART AREA -->
    <div class="relative flex-1 w-full h-full overflow-hidden" id="tc-root-<%= chart_id %>">
      
      <!-- LEYENDA OHLC (Estática) -->
      <div class="absolute top-2 left-4 z-10 flex flex-col pointer-events-none">
        
        <!-- Valores OHLC -->
        <div id="tc-legend-<%= chart_id %>" class="hidden sm:flex items-center gap-3 text-caption font-mono whitespace-nowrap px-2 py-1 rounded bg-slate-100/80 dark:bg-[#11121C]/80 backdrop-blur-md shadow-sm border border-slate-200 dark:border-darkBorder tc-legend-container">
          <span class="font-bold text-slate-800 dark:text-white" id="tc-val-time-<%= chart_id %>">----</span>
          <div class="h-3 w-px bg-slate-300 dark:bg-slate-700"></div>
          <span class="text-slate-500 dark:text-slate-400">Open <span id="tc-val-o-<%= chart_id %>" class="text-slate-700 dark:text-slate-300 font-bold ml-1">---</span></span>
          <span class="text-slate-500 dark:text-slate-400">High <span id="tc-val-h-<%= chart_id %>" class="text-slate-700 dark:text-slate-300 font-bold ml-1">---</span></span>
          <span class="text-slate-500 dark:text-slate-400">Low <span id="tc-val-l-<%= chart_id %>" class="text-slate-700 dark:text-slate-300 font-bold ml-1">---</span></span>
          <span class="text-slate-500 dark:text-slate-400">Close <span id="tc-val-c-<%= chart_id %>" class="text-slate-700 dark:text-slate-300 font-bold ml-1">---</span></span>
          <span class="text-slate-500 dark:text-slate-400">Vol <span id="tc-val-vol-<%= chart_id %>" class="text-slate-700 dark:text-slate-300 font-bold ml-1">---</span></span>
        </div>

        <!-- Toggle Indicadores -->
        <div class="mt-2 pointer-events-auto flex flex-col items-start gap-1">
          <!-- Active Indicators Mock -->
          <div class="flex items-center gap-2 px-2 py-1 rounded bg-slate-100/50 dark:bg-[#1A1D2D]/60 hover:bg-slate-200 dark:hover:bg-darkHover cursor-pointer transition-colors">
            <button class="tc-ind-toggle text-[10px] font-bold text-indigo-600 dark:text-indigo-400 flex items-center gap-1.5" data-color="#6366f1" data-series="ema9">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> EMA (9, close) <span class="material-symbols-outlined text-[12px] ml-1">visibility</span>
            </button>
          </div>
          <div class="flex items-center gap-2 px-2 py-1 rounded bg-slate-100/50 dark:bg-[#1A1D2D]/60 hover:bg-slate-200 dark:hover:bg-darkHover cursor-pointer transition-colors">
            <button class="tc-ind-toggle text-[10px] font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1.5" data-color="#f59e0b" data-series="ema20">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> EMA (20, close) <span class="material-symbols-outlined text-[12px] ml-1">visibility</span>
            </button>
          </div>
          <div class="flex items-center gap-2 px-2 py-1 rounded bg-slate-100/50 dark:bg-[#1A1D2D]/60 hover:bg-slate-200 dark:hover:bg-darkHover cursor-pointer transition-colors">
            <button class="tc-ind-toggle text-[10px] font-bold text-emerald-600 dark:text-teal-400 flex items-center gap-1.5" data-color="#26a69a" data-series="volume">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span> Volume <span class="material-symbols-outlined text-[12px] ml-1">visibility</span>
            </button>
          </div>
        </div>
      </div>
      
      <!-- TOOLTIP CRUZ FLOTANTE -->
      <div id="tc-tooltip-<%= chart_id %>" class="absolute z-20 pointer-events-none hidden px-3 py-2.5 rounded-xl bg-slate-900/95 text-white shadow-xl border border-slate-700 text-xs backdrop-blur-md transform -translate-x-1/2 -translate-y-full mt-[-10px] transition-transform duration-75 ease-out w-[160px]"></div>
      
      <!-- Lightweight Charts Injection DIV -->
      <div id="<%= container_id %>" class="absolute inset-0"></div>
    </div>
  </div>
</div>

<!-- ==================== JAVASCRIPT SCOPE ==================== -->
<script>
  // PATRÓN: Registramos la lógica por contenedor
  // Esto permite inicializar múltiples instancias si es necesario
  (function() {
    const chartId = '<%= chart_id %>';
    const container = document.getElementById('<%= container_id %>');
    const wrapper = document.getElementById(`tc-wrapper-${chartId}`);
    const dataUrl = '<%= data_url %>';
    
    if (!container || !wrapper) return;

    class ProfessionalTradingChart {
      constructor(containerElem, dataUrl) {
        this.container = containerElem;
        this.dataUrl = dataUrl;
        this.chart = null;
        this.series = {};
        this.precision = 2;
        this.theme = document.getElementById("html-root")?.classList.contains("dark") ? 'dark' : 'light';
        
        // Elementos UI
        this.ui = {
          loader: document.getElementById(`tc-loader-${chartId}`),
          legendOHLC: {
            time: document.getElementById(`tc-val-time-${chartId}`),
            o: document.getElementById(`tc-val-o-${chartId}`),
            h: document.getElementById(`tc-val-h-${chartId}`),
            l: document.getElementById(`tc-val-l-${chartId}`),
            c: document.getElementById(`tc-val-c-${chartId}`),
            vol: document.getElementById(`tc-val-vol-${chartId}`),
          }
        };

        this.initConfig();
        this.bindEvents();
        this.loadData();
      }

      initConfig() {
        const isDark = this.theme === 'dark';
        
        // Colores base estilo TradingView
        const bg = isDark ? '#090A10' : '#FFFFFF';
        const txt = isDark ? '#8286A8' : '#4A5568';
        const grid = isDark ? '#161928' : '#F1F3F9';
        const border = isDark ? '#1E2235' : '#E3E6EF';

        this.chart = LightweightCharts.createChart(this.container, {
          layout: {
            background: { color: bg, type: 'solid' },
            textColor: txt,
            fontFamily: "JetBrains Mono, Manrope, sans-serif"
          },
          watermark: {
            color: isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.06)',
            visible: true,
            text: '<%= symbol %>',
            fontSize: 120,
            horzAlign: 'center',
            vertAlign: 'center',
          },
          grid: {
            vertLines: { color: grid },
            horzLines: { color: grid }
          },
          crosshair: {
            mode: LightweightCharts.CrosshairMode.Normal,
            vertLine: {
              color: isDark ? '#334155' : '#CBD5E1',
              width: 1,
              style: LightweightCharts.LineStyle.Dashed,
              labelBackgroundColor: isDark ? '#1E293B' : '#475569',
            },
            horzLine: {
              color: isDark ? '#334155' : '#CBD5E1',
              width: 1,
              style: LightweightCharts.LineStyle.Dashed,
              labelBackgroundColor: isDark ? '#1E293B' : '#475569',
            }
          },
          rightPriceScale: {
            borderColor: border,
            autoScale: true,
            scaleMargins: { top: 0.1, bottom: 0.25 },
          },
          timeScale: {
            borderColor: border,
            timeVisible: true,
            secondsVisible: false,
            fixLeftEdge: true,
            fixRightEdge: true,
            rightOffset: 15,
            barSpacing: 20,
            tickMarkFormatter: (time, tickMarkType, locale) => {
              const d = new Date(time * 1000);
              // Si cambia de día, mostrar MM-DD en negrita/destacado (el framework textStyle soporta strings)
              if (tickMarkType === LightweightCharts.TickMarkType.TimeMap || tickMarkType === 3) {
                 return `${String(d.getMonth() + 1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
              }
              return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
            },
          }
        });

        // ResizeObserver para reactividad fluida
        this.resizeObserver = new ResizeObserver(entries => {
          if (entries.length === 0 || entries[0].target !== this.container) return;
          const newRect = entries[0].contentRect;
          this.chart.applyOptions({ width: newRect.width, height: newRect.height });
        });
        this.resizeObserver.observe(this.container);

        // Instanciar series principales
        this.series.candles = this.chart.addCandlestickSeries({
          upColor: "#089981",          
          downColor: "#F23645",        
          borderVisible: true,
          borderColor: "#089981",
          borderUpColor: "#089981",
          borderDownColor: "#F23645",
          wickUpColor: "#089981",
          wickDownColor: "#F23645",
          priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
        });

        // Pre-create the line series but hidden by default
        this.series.line = this.chart.addLineSeries({
          color: '#2962FF',
          lineWidth: 2,
          visible: false,
          crosshairMarkerVisible: true,
          priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
        });

        // Pre-create Area Series
        this.series.area = this.chart.addAreaSeries({
          lineColor: '#2962FF',
          topColor: 'rgba(41, 98, 255, 0.28)',
          bottomColor: 'rgba(41, 98, 255, 0.05)',
          lineWidth: 2,
          visible: false,
          priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
        });
        
        // Pre-create Bar Series
        this.series.bar = this.chart.addBarSeries({
          upColor: "#089981",          
          downColor: "#F23645",   
          visible: false,
          priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
        });

        this.series.volume = this.chart.addHistogramSeries({
          priceFormat: { type: 'volume' },
          priceScaleId: '',            
        });

        // Limitar la Escala de Volumen (22% inferior) como se requiere
        this.chart.priceScale('').applyOptions({
          scaleMargins: {
            top: 0.78,
            bottom: 0,
          },
        });

        this.series.ema9 = this.chart.addLineSeries({
          color: '#6366f1',
          lineWidth: 2,
          crosshairMarkerVisible: false,
          priceLineVisible: false,
        });

        this.series.ema20 = this.chart.addLineSeries({
          color: '#f59e0b',
          lineWidth: 2,
          crosshairMarkerVisible: false,
          priceLineVisible: false,
        });
      }

      bindEvents() {
        // Mover overlays custom de etiquetas de entrada/salida (FASE 2)
        this.chart.timeScale().subscribeVisibleTimeRangeChange(() => this.updateOverlays());
        
        // Crosshair move for tooltip and legend
        this.chart.subscribeCrosshairMove(param => {
          this.handleCrosshair(param);
          this.updateOverlays(); // Sincroniza overlays
        });

        // Fullscreen toggle
        const fsBtn = document.querySelector(`#tc-wrapper-${chartId} .tc-fullscreen-btn`);
        if (fsBtn) {
          fsBtn.addEventListener('click', () => {
            const wrap = document.getElementById(`tc-wrapper-${chartId}`);
            if (!document.fullscreenElement) {
              if (wrap.requestFullscreen) wrap.requestFullscreen();
            } else {
              if (document.exitFullscreen) document.exitFullscreen();
            }
          });
        }

        // Screenshot Real Integration via Lightweight Charts takeScreenshot
        const ssBtn = document.querySelector(`#tc-wrapper-${chartId} .tc-screenshot-btn`);
        if (ssBtn) {
          ssBtn.addEventListener('click', () => {
            if(this.chart) {
              const canvas = this.chart.takeScreenshot();
              const url = canvas.toDataURL("image/png");
              const a = document.createElement("a");
              a.href = url;
              a.download = `Trade_${chartId}_Analysis.png`;
              a.click();
            }
          });
        }

        // Indicator Toggle Ticks
        document.querySelectorAll(`#tc-wrapper-${chartId} .tc-ind-toggle`).forEach(btn => {
          btn.addEventListener('click', (e) => {
            const sName = btn.dataset.series;
            if (this.series[sName]) {
              const currentV = this.series[sName].options().visible;
              const isVis = currentV === undefined ? true : currentV; // Default LW is visible
              this.series[sName].applyOptions({ visible: !isVis });
              btn.style.opacity = !isVis ? '1' : '0.5';
              const icon = btn.querySelector('.material-symbols-outlined');
              if(icon) icon.innerText = !isVis ? 'visibility' : 'visibility_off';
            }
          });
        });

        // Timeframe switch mock
        document.querySelectorAll(`#tc-wrapper-${chartId} .tc-tf-btn`).forEach(btn => {
          btn.addEventListener('click', (e) => {
            document.querySelectorAll(`#tc-wrapper-${chartId} .tc-tf-btn`).forEach(b => {
               b.className = "tc-tf-btn px-2 py-1 rounded-md hover:bg-slate-200 dark:hover:bg-darkHover transition-colors";
            });
            btn.className = "tc-tf-btn px-2 py-1 rounded-md text-brand bg-brand/10 transition-colors";
            // Aquí en un sistema real se llamaría `this.loadData(btn.dataset.tf)`
            console.log("Switch Timeframe to", btn.dataset.tf);
          });
        });

        // Dropdown Toggle Logic
        const wrapper = document.getElementById(`tc-wrapper-${chartId}`);
        const dropdownTrigger = wrapper.querySelector('.tc-dropdown-trigger');
        const dropdownMenu = wrapper.querySelector('.tc-dropdown-menu');
        
        if (dropdownTrigger && dropdownMenu) {
           dropdownTrigger.addEventListener('click', (e) => {
              e.stopPropagation();
              dropdownMenu.classList.toggle('hidden');
              dropdownMenu.classList.toggle('flex');
           });
           
           document.addEventListener('click', (e) => {
              if (!dropdownMenu.contains(e.target) && !dropdownTrigger.contains(e.target)) {
                 dropdownMenu.classList.add('hidden');
                 dropdownMenu.classList.remove('flex');
              }
           });
        }

        // Color Palettes Setup
        const palettes = {
           classic: { up: "#089981", down: "#F23645", borderUp: "#089981", borderDown: "#F23645" },
           vibe: { up: "#8B5CF6", down: "#3B82F6", borderUp: "#8B5CF6", borderDown: "#3B82F6" }
        };
        let currentPalette = 'classic';
        let currentType = 'candle';
        
        // Helper to apply colors based on palette and type (candle vs hollow)
        const applyColors = () => {
           let colors = palettes[currentPalette];
           
           // If hollow, body is transparent, borders are colored
           const isHollow = currentType === 'hollow';
           
           this.series.candles.applyOptions({
              upColor: isHollow ? 'transparent' : colors.up,
              downColor: isHollow ? 'transparent' : colors.down,
              borderColor: colors.borderUp,
              borderUpColor: colors.borderUp,
              borderDownColor: colors.borderDown,
              wickUpColor: colors.borderUp,
              wickDownColor: colors.borderDown,
           });
           
           this.series.bar.applyOptions({
              upColor: colors.up,
              downColor: colors.down
           });
        };

        // Chart Types Toggle Logic
        const typeBtns = wrapper.querySelectorAll('.tc-type-btn');
        typeBtns.forEach(btn => {
           btn.addEventListener('click', () => {
              // Update Classes
              typeBtns.forEach(b => {
                 b.classList.remove('text-brand', 'bg-brand/5', 'border-brand/20');
                 b.classList.add('text-slate-500');
              });
              btn.classList.add('text-brand', 'bg-brand/5', 'border-brand/20');
              btn.classList.remove('text-slate-500');

              currentType = btn.dataset.type;
              
              // Change outer icon
              const iconBox = document.getElementById(`tc-current-chart-icon-${chartId}`);
              if (iconBox) iconBox.innerText = btn.dataset.icon;
              if (currentType === 'hollow') iconBox.style.fontVariationSettings = "'FILL' 0";
              else iconBox.style.fontVariationSettings = "'FILL' 1";

              // Activate correct series
              this.series.candles.applyOptions({ visible: currentType === 'candle' || currentType === 'hollow' });
              this.series.line.applyOptions({ visible: currentType === 'line' });
              this.series.area.applyOptions({ visible: currentType === 'area' });
              this.series.bar.applyOptions({ visible: currentType === 'bar' });
              
              // Apply colors to handle hollow transparency transition
              applyColors();
           });
        });
        
        // Palette Toggle Logic
        const colorBtns = wrapper.querySelectorAll('.tc-color-btn');
        colorBtns.forEach(btn => {
           btn.addEventListener('click', () => {
              colorBtns.forEach(b => {
                 b.classList.remove('bg-brand/5', 'border-brand/20');
              });
              btn.classList.add('bg-brand/5', 'border-brand/20');
              
              currentPalette = btn.dataset.palette;
              applyColors();
           });
        });
        
        const wrap = document.getElementById(`tc-wrapper-${chartId}`);
        // Fullscreen action
        const fullBtn = wrap.querySelector('.tc-fullscreen-btn');
        if (fullBtn) fullBtn.addEventListener('click', () => {
           if (!document.fullscreenElement) {
              wrap.requestFullscreen().catch(err => console.log(err));
           } else {
              document.exitFullscreen();
           }
        });
        
        // Screenshot action
        const picBtn = wrap.querySelector('.tc-screenshot-btn');
        if (picBtn) picBtn.addEventListener('click', () => {
           const url = this.chart.takeScreenshot().toDataURL();
           const a = document.createElement("a");
           a.href = url;
           a.download = `coachtrading-chart-<%= symbol %>-${Date.now()}.png`;
           a.click();
        });

        // Settings (Toggle Grid Lines) action
        let gridVisible = true;
        const setBtn = wrap.querySelector('.tc-settings-btn');
        if (setBtn) setBtn.addEventListener('click', () => {
           gridVisible = !gridVisible;
           this.chart.applyOptions({
              grid: {
                  vertLines: { visible: gridVisible, color: isDark ? '#2B2B43' : '#e2e8f0' },
                  horzLines: { visible: gridVisible, color: isDark ? '#2B2B43' : '#e2e8f0' }
              }
           });
        });
        
        // Premium feature Mock Alerts
        const mockAlertClasses = ['.tc-compare-btn', '.tc-indicators-btn', '.tc-undo-btn', '.tc-redo-btn', '.tc-templates-btn', '.tc-replay-btn'];
        mockAlertClasses.forEach(cls => {
           const b = wrap.querySelector(cls);
           if (b) b.addEventListener('click', () => {
              if (cls === '.tc-replay-btn') {
                 window.location = "/backtesting";
              } else {
                 alert("Esta funcionalidad se encuentra en desarrollo o requiere un módulo premium vinculado a TradingView UI de pago.");
              }
           });
        });

        // Top Toolbar Mocks
        const toolbarGroups = document.querySelectorAll(`#tc-wrapper-${chartId} .tc-toolbar-left .flex.items-center`);
        toolbarGroups.forEach(group => {
           if(group.classList.contains('tc-timeframes') || group.classList.contains('cursor-pointer')) return;
           const btns = group.querySelectorAll('button:not(.tc-tf-btn)');
           btns.forEach(btn => {
              btn.addEventListener('click', () => {
                 btns.forEach(b => { 
                   b.classList.remove('text-brand', 'bg-brand/5', 'border', 'border-brand/10');
                   b.classList.add('text-slate-500');
                 });
                 btn.classList.add('text-brand', 'bg-brand/5', 'border', 'border-brand/10');
                 btn.classList.remove('text-slate-500');
              });
           });
        });

        // Left Drawing Toolbar Toggles
        const drawBtns = document.querySelectorAll(`#tc-wrapper-${chartId} .tc-draw-btn`);
        drawBtns.forEach(btn => {
           btn.addEventListener('click', () => {
              drawBtns.forEach(b => b.classList.remove('text-brand', 'bg-brand/10', 'border', 'border-brand/20'));
              btn.classList.add('text-brand', 'bg-brand/10', 'border', 'border-brand/20');
           });
        });
      }

      async loadData() {
        if(!this.dataUrl) return;
        this.ui.loader.classList.remove('hidden');

        try {
          const response = await fetch(this.dataUrl);
          if (!response.ok) throw new Error("Error HTTP");
          
          const data = await response.json();
          this.populate(data);

        } catch(e) {
          console.error("Error loading chart data:", e);
          this.container.innerHTML = `<div class="flex h-full items-center justify-center text-slate-500 font-bold">Falló la carga de datos del gráfico.</div>`;
        } finally {
          this.ui.loader.classList.add('hidden');
        }
      }

      populate(data) {
        if (!data.candles || data.candles.length === 0) return;

        // Auto-detect precision from first close price
        const cpStr = data.candles[0].close.toString();
        const pLen = cpStr.includes('.') ? cpStr.split('.')[1].length : 2;
        this.precision = Math.max(2, pLen);

        this.series.candles.applyOptions({
          priceFormat: {
            type: 'price',
            precision: this.precision,
            minMove: 1 / Math.pow(10, this.precision),
          },
        });

        // Fill Data
        this.series.candles.setData(data.candles);
        
        // Populate alternative series with close/ohlc values
        const closeValues = data.candles.map(c => ({ time: c.time, value: c.close }));
        this.series.line.setData(closeValues);
        this.series.area.setData(closeValues);
        this.series.bar.setData(data.candles); // Bar and Candle share same OHLC data format

        if (data.volume) {
          const coloredVolume = data.volume.map((v, i) => {
            const candle = data.candles.find(c => c.time === v.time) || data.candles[i];
            const isUp = candle ? (candle.close >= candle.open) : true;
            return {
              time: v.time,
              value: v.value,
              color: isUp ? 'rgba(16, 185, 129, 0.25)' : 'rgba(244, 63, 94, 0.25)'
            };
          });
          this.series.volume.setData(coloredVolume);
        }

        const ema9Data = this.calculateEMA(data.candles, 9);
        const ema20Data = this.calculateEMA(data.candles, 20);
        if(ema9Data.length > 0) this.series.ema9.setData(ema9Data);
        if(ema20Data.length > 0) this.series.ema20.setData(ema20Data);

        // Markers & Lines (ENTRY, SL, TP)
        if (data.markers) this.series.candles.setMarkers(data.markers);
        
        if (data.price_lines) {
          data.price_lines.forEach(pl => {
            this.series.candles.createPriceLine({
              price: pl.price,
              color: pl.color || '#3B82F6',
              lineWidth: pl.lineWidth || 2,
              lineStyle: pl.lineStyle || LightweightCharts.LineStyle.Dashed,
              axisLabelVisible: true,
              title: pl.title || ''
            });
          });
        }

        // Autoencuadre masivo (FASE 1)
        this.chart.timeScale().fitContent();

        // Inicializamos los marcadores HTML (FASE 2)
        this.createTradeOverlays(data);
        
        // Actualizamos leyenda con la última vela disponible por defecto
        if (data.candles.length > 0) {
          const lastC = data.candles[data.candles.length - 1];
          const lastV = data.volume && data.volume.length > 0 ? data.volume[data.volume.length - 1] : {value: 0};
          this.updateLegend(lastC, lastV.value, lastC.time);
        }
      }

      createTradeOverlays(data) {
        if(!data || !data.markers || data.markers.length === 0) return;
        
        this.overlays = [];
        const wrap = document.getElementById(`tc-root-${chartId}`);
        const cSeries = this.series.candles;
        
        // Extraemos entry y exit
        const entry = data.markers.find(m => (m.text||'').includes('ENTRY') || (m.id||'').includes('entry'));
        const exit = data.markers.find(m => (m.text||'').includes('EXIT') || (m.id||'').includes('exit'));
        
        // Color Rojo para Entrada y Azul para Salida según requisito FASE 2
        
        // Crear elemento linea vertical gruesa entre puntos si ambos existen
        if (entry && exit) {
            const line = document.createElement('div');
            line.className = 'absolute bg-rose-500 opacity-50 z-[5] pointer-events-none transform -translate-x-1/2';
            line.style.width = '3px';
            wrap.appendChild(line);
            this.overlays.push({ el: line, type: 'line', entry: entry, exit: exit });
        }
        
        // Función util para armar badge HTML
        const createBadge = (marker, isEntry) => {
           const badge = document.createElement('div');
           badge.className = `absolute z-10 font-sans font-bold text-[11px] text-white px-2 py-0.5 rounded shadow-sm flex items-center gap-1 cursor-default select-none pointer-events-none transform -translate-x-1/2 break-none whitespace-nowrap ${isEntry ? 'bg-rose-500' : 'bg-blue-600'}`;
           // Parse "qty @ price" from text or default
           let price = "0.00";
           let qty = null;
           let mText = marker.text || "";
           let pts = mText.split(' ');
           if(pts.length > 2) { qty = pts[0]; price = pts[pts.length-1]; } 
           else { price = mText.replace(/[^0-9.]/g, '') || marker.price.toFixed(this.precision) || '0.00'; }
           
           badge.innerText = qty ? `${qty} @ ${price}` : `@ ${price}`;
           wrap.appendChild(badge);
           this.overlays.push({ el: badge, type: 'badge', marker: marker, isEntry: isEntry });
        };
        
        if (entry) createBadge(entry, true);
        if (exit) createBadge(exit, false);
      }

      updateOverlays() {
        if(!this.overlays || this.overlays.length === 0) return;
        const ts = this.chart.timeScale();
        const ps = this.series.candles.priceScale();
        
        this.overlays.forEach(ov => {
           if (ov.type === 'badge') {
              const x = ts.timeToCoordinate(ov.marker.time);
              const y = ps.priceToCoordinate(ov.marker.price);
              if(x && y) {
                 ov.el.style.left = x + 'px';
                 // Desplazar verticalmente para no pisar la vela directamente
                 ov.el.style.top = (ov.isEntry ? (y + 15) : (y - 30)) + 'px';
                 ov.el.style.display = 'flex';
              } else {
                 ov.el.style.display = 'none';
              }
           } else if (ov.type === 'line') {
              const x1 = ts.timeToCoordinate(ov.entry.time);
              const x2 = ts.timeToCoordinate(ov.exit.time);
              const y1 = ps.priceToCoordinate(ov.entry.price);
              const y2 = ps.priceToCoordinate(ov.exit.price);
              
              if(x1 && x2 && y1 && y2) {
                 const length = Math.sqrt(Math.pow(x2-x1, 2) + Math.pow(y2-y1, 2));
                 const angle = Math.atan2(y2-y1, x2-x1) * 180 / Math.PI;
                 
                 ov.el.style.left = x1 + 'px';
                 ov.el.style.top = y1 + 'px';
                 ov.el.style.height = '3px';
                 ov.el.style.width = length + 'px';
                 ov.el.style.transformOrigin = '0 0';
                 ov.el.style.transform = `rotate(${angle}deg) translate(0, -50%)`;
                 ov.el.style.display = 'block';
              } else {
                 ov.el.style.display = 'none';
              }
           }
        });
      }

      updateLegend(price, volume, time) {
          this.ui.legendOHLC.o.innerText = price.open.toFixed(this.precision);
          this.ui.legendOHLC.h.innerText = price.high.toFixed(this.precision);
          this.ui.legendOHLC.l.innerText = price.low.toFixed(this.precision);
          this.ui.legendOHLC.c.innerText = price.close.toFixed(this.precision);
          
          let colorClass = price.close >= price.open ? 'text-emerald-500' : 'text-rose-500';
          this.ui.legendOHLC.c.className = `ml-1 font-bold ${colorClass}`;

          if(volume !== undefined) {
             let fVol = volume >= 1000000 ? (volume/1000000).toFixed(1) + 'M' : (volume >= 1000 ? (volume/1000).toFixed(1) + 'K' : volume);
             this.ui.legendOHLC.vol.innerText = fVol;
          }

          if (time) {
            const dateObj = new Date(time * 1000);
            this.ui.legendOHLC.time.innerText = dateObj.toLocaleString('en-CA', { year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', hour12: false}).replace(',','');
          }
      }

      handleCrosshair(param) {
        if (!param.point || !param.time) {
          // Restore to null / --- is handled implicitly, but wait, criteria says "siempre con datos (defecto ultima)". 
          // We won't clear it, we keep last data.
          return;
        }

        const price = param.seriesData.get(this.series.candles);
        const volData = param.seriesData.get(this.series.volume);
        
        if (price) {
          this.updateLegend(price, volData ? volData.value : 0, param.time);
        }
      }

      calculateEMA(data, period) {
        if(!data || data.length < period) return [];
        const k = 2 / (period + 1);
        let emaResult = [];
        let sum = 0;
        for(let i=0; i<period; i++) sum += data[i].close;
        let ema = sum / period;
        emaResult.push({ time: data[period - 1].time, value: ema });
        for(let i=period; i<data.length; i++){
          ema = (data[i].close - ema) * k + ema;
          emaResult.push({ time: data[i].time, value: ema });
        }
        return emaResult;
      }
    }

    // Inicializar globalmente si el DOM ya cargó, o si está listo
    window.addEventListener("DOMContentLoaded", () => {
      new ProfessionalTradingChart(container, dataUrl);
    });
    // Fallback por si la vista se cargó por AJAX
    setTimeout(() => { if(container.innerHTML === "") new ProfessionalTradingChart(container, dataUrl); }, 100);

  })();
</script>
