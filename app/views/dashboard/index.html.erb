<% content_for :page_title do %>
  <div class="flex items-center gap-2.5">
    <span>Dashboard</span>
    <% if @stats[:is_demo] %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 font-extrabold border border-amber-500/30 tracking-wider">MODO DEMO</span>
    <% else %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full <%= @current_mode == 'backtest' ? 'bg-slate-500/15 text-slate-500 dark:text-slate-400 border-slate-500/30' : (@current_mode == 'prop_firm' ? 'bg-brand/15 text-brand border-brand/30' : 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30') %> font-extrabold border tracking-wider flex items-center gap-1">
        <% if @current_mode == 'real_account' %><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><% end %>
        <%= @current_mode.upcase.gsub('_', ' ') %>
      </span>
    <% end %>
  </div>
<% end %>

<div class="space-y-6 fade-in">
  
  <!-- INTERRUPTOR DE PORTAFOLIO GLOBAL Y CUENTAS MULTIPLES -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex p-1 bg-slate-200/50 dark:bg-darkBorder/50 rounded-xl w-max border border-slate-300/50 dark:border-darkBorder max-w-full overflow-x-auto snap-x hide-scrollbar">
      <%= link_to dashboard_path(mode: 'real_account'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'real_account' ? 'bg-white dark:bg-slate-700 text-emerald-500 shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">account_balance_wallet</span> Cuenta Personal
      <% end %>
      <%= link_to dashboard_path(mode: 'prop_firm'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'prop_firm' ? 'bg-white dark:bg-slate-700 text-brand shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">verified</span> Prop Firm
      <% end %>
      <%= link_to dashboard_path(mode: 'backtest'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'backtest' ? 'bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">history</span> Backtesting
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="text-xl font-bold dark:text-white text-slate-900">Dashboard</h2>
    <p class="text-xs text-slate-400 mt-1">Visión integral cuantitativa de tus operaciones, estadísticas clave y calendario.</p>
  </div>

  <!-- FILA 1: KPI CARDS TOPBAR INTEGRADA (ESTILO STRATONK EXACTO A IMAGEN) -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
      
    <!-- Balance & P&L -->
    <div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-2xl p-4 flex flex-col justify-between relative overflow-hidden shadow-xs">
      <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider dark:text-white text-slate-800 z-10 relative">
        <span class="w-1 h-3.5 bg-emerald-400 rounded-full shrink-0"></span>
        <span class="dark:text-white text-slate-800 font-bold">BALANCE & P&L</span>
        <span class="material-symbols-outlined text-[14px] dark:text-[#6a6a75] text-slate-400 cursor-pointer ml-auto" title="Información sobre Balance y P&L">info</span>
      </div>
      <div class="z-10 relative flex justify-between items-end mt-4">
        <div>
          <p class="text-[32px] md:text-[36px] font-semibold tracking-[-0.025em] leading-none tabular-nums text-emerald-500 dark:text-emerald-400">
            $<%= number_with_precision(100000 + @stats[:total_pnl], precision: 2, delimiter: ',') %>
          </p>
          <div class="flex items-center gap-2 mt-3">
            <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
              P&L: <%= @stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(@stats[:total_pnl], precision: 2, delimiter: ',') %>
            </span>
            <span class="w-6 h-6 rounded-full dark:bg-[#20202d] bg-slate-100 dark:text-[#8a8a9e] text-slate-600 text-[11px] font-medium font-mono flex items-center justify-center" title="Total trades">
              <%= @stats[:total_trades] %>
            </span>
          </div>
        </div>
        <!-- Sparkline mini gráfica Balance P&L -->
        <div id="sparkline-balance" class="w-[100px] h-[50px]"></div>
      </div>
    </div>

    <!-- Trade Win % -->
   <!-- Trade Win % -->
<div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-2xl p-4 relative overflow-hidden shadow-xs">
  <div class="grid grid-cols-2 gap-2" style="min-height:110px">

    <!-- Columna izquierda (50%): título + valor + badges -->
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-1 h-3.5 bg-indigo-500 rounded-full shrink-0"></span>
        <span class="dark:text-white text-slate-800 font-bold truncate">TRADE WIN %</span>
        <span class="material-symbols-outlined text-[14px] dark:text-[#6a6a75] text-slate-400 cursor-pointer ml-auto shrink-0" title="Porcentaje de operaciones ganadoras">info</span>
      </div>

      <div class="flex flex-col justify-center flex-1">
        <p class="text-3xl font-black font-mono tracking-tight dark:text-white text-slate-900 leading-none"><%= @stats[:win_rate] %>%</p>
        <div class="flex items-center gap-1.5 mt-3">
          <span class="w-6 h-6 rounded-full dark:bg-[#122e24] bg-emerald-50 text-emerald-600 dark:text-emerald-400 border dark:border-emerald-500/30 border-emerald-200 text-[11px] font-bold font-mono flex items-center justify-center" title="Wins"><%= @stats[:winning_trades] %></span>
          <span class="w-6 h-6 rounded-full dark:bg-[#202030] bg-indigo-50 text-indigo-600 dark:text-indigo-400 text-[11px] font-bold font-mono flex items-center justify-center" title="BE">1</span>
          <span class="w-6 h-6 rounded-full dark:bg-[#30161c] bg-rose-50 text-rose-600 dark:text-rose-400 border dark:border-rose-500/30 border-rose-200 text-[11px] font-bold font-mono flex items-center justify-center" title="Losses"><%= @stats[:losing_trades] %></span>
        </div>
      </div>
    </div>

    <!-- Columna derecha (50%): gráfico centrado -->
  <div class="flex items-center justify-center min-w-0 self-stretch">
  <div id="sparkline-winrate" class="w-full h-full flex items-center justify-center" style="min-height:90px"></div>
</div>

  </div>
</div>

    <!-- Profit Factor -->
    <div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-2xl p-4 relative overflow-hidden shadow-xs">
      <div class="grid grid-cols-2 gap-2" style="min-height:110px">
        <!-- Columna izquierda (50%): título + valor -->
        <div class="flex flex-col min-w-0">
          <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider mb-2">
            <span class="w-1 h-3.5 bg-indigo-500 rounded-full shrink-0"></span>
            <span class="dark:text-white text-slate-800 font-bold truncate">PROFIT FACTOR</span>
            <span class="material-symbols-outlined text-[14px] dark:text-[#6a6a75] text-slate-400 cursor-pointer ml-auto shrink-0" title="Ratio Beneficio / Pérdida">info</span>
          </div>
          <div class="flex flex-col justify-center flex-1">
            <p class="text-3xl font-black font-mono tracking-tight dark:text-white text-slate-900 leading-none"><%= @stats[:profit_factor] %></p>
          </div>
        </div>
        <!-- Columna derecha (50%): gráfico centrado -->
        <div class="flex items-center justify-center min-w-0 self-stretch">
          <div id="sparkline-pf" class="w-full h-full flex items-center justify-center" style="min-height:90px"></div>
        </div>
      </div>
    </div>

    <!-- Avg Win / Loss -->
<!-- Avg Win / Loss -->
<div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-2xl p-4 relative overflow-hidden shadow-xs">
  <div class="grid grid-cols-2 gap-2" style="min-height:110px">

    <!-- Columna izquierda (50%): título + valor + promedios -->
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-1 h-3.5 bg-indigo-500 rounded-full shrink-0"></span>
        <span class="dark:text-white text-slate-800 font-bold truncate">AVG WIN/LOSS</span>
        <span class="material-symbols-outlined text-[14px] dark:text-[#6a6a75] text-slate-400 cursor-pointer ml-auto shrink-0" title="Promedio Ganadora vs Perdedora">info</span>
      </div>

      <div class="flex flex-col justify-center flex-1">
        <p class="text-3xl font-black font-mono tracking-tight dark:text-white text-slate-900 leading-none"><%= @stats[:rr_ratio] %> R</p>
        <div class="flex items-center gap-2 text-[10px] font-mono mt-2">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">+$<%= number_with_precision(@stats[:avg_win], precision: 0) %></span>
          <span class="text-rose-600 dark:text-rose-500 font-bold">-$<%= number_with_precision(@stats[:avg_loss], precision: 0) %></span>
        </div>
      </div>
    </div>

    <!-- Columna derecha (50%): gráfico centrado -->
    <div class="flex items-center justify-center min-w-0 self-stretch">
      <div id="sparkline-avg" class="w-full h-full flex items-center justify-center" style="min-height:90px"></div>
    </div>

  </div>
</div>

    <!-- Trade Expectancy -->
    <div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-2xl p-4 flex flex-col justify-between shadow-xs">
      <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider dark:text-white text-slate-800">
        <span class="w-1 h-3.5 bg-emerald-400 rounded-full"></span>
        <span class="dark:text-white text-slate-800 font-bold">EXPECTANCY</span>
        <span class="material-symbols-outlined text-[14px] dark:text-[#6a6a75] text-slate-400 cursor-pointer" title="Esperanza matemática por trade">info</span>
      </div>
      <div class="mt-2">
        <p class="text-3xl font-black font-mono tracking-tight <%= @stats[:expectancy].to_f >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-500' %>">
          <%= @stats[:expectancy].to_f >= 0 ? '+' : '' %>$<%= number_with_precision(@stats[:expectancy].to_f, precision: 2) %>
        </p>
        <p class="text-[11px] dark:text-[#7a7a85] text-slate-500 mt-2 font-medium">Por operación</p>
      </div>
    </div>

  </div>

  <!-- FILA 2: GRÁFICOS PRINCIPALES (Curva P&L, Drawdown, AI Score Radar) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    
    <!-- Curva de P&L -->
    <div class="glass rounded-2xl overflow-hidden flex flex-col  min-h-0 dark:bg-[#0e0f14] bg-white border dark:border-[#1e2030] border-slate-200 shadow-xs">
      <!-- Header estilo trading platform -->
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 pt-4 pb-3 border-b dark:border-[#1e2030] border-slate-100">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[16px] dark:text-emerald-400 text-emerald-500">show_chart</span>
          <span class="text-[11px] font-black uppercase tracking-widest dark:text-white text-slate-800">Curva de P&L</span>
          <span class="px-1.5 py-0.5 rounded dark:bg-[#1a1d26] bg-slate-100 dark:text-[#6a6a7f] text-slate-400 text-[10px] font-mono font-bold border dark:border-[#252638] border-slate-200">$</span>
        </div>
        <!-- Controles compactos estilo prop firm -->
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined dark:text-[#4a4a5a] text-slate-400 hover:dark:text-slate-300 hover:text-slate-600 cursor-pointer text-[15px]" title="Información del gráfico">info</span>
          <div class="flex items-center gap-px p-0.5 dark:bg-[#12131a] bg-slate-100 border dark:border-[#22233a] border-slate-200 rounded-md">
            <button id="btn-pnl-neto" onclick="switchEquityMode('pnl')" class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider bg-[#1e2040] text-[#a0a8ff] border border-[#3a3a60] transition-all">P&L NETO</button>
            <button id="btn-balance" onclick="switchEquityMode('balance')" class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all">BALANCE</button>
            <button id="btn-winrate" onclick="switchEquityMode('winrate')" class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all">WIN RATE</button>
          </div>
        </div>
      </div>
      <div id="echarts-equity-container" class="w-full flex-1 min-h-[180px]"></div>
    </div>
    
    <!-- Drawdown -->
    <div class="glass rounded-2xl overflow-hidden flex flex-col min-h-0 dark:bg-[#0e0f14] bg-white border dark:border-[#1e2030] border-slate-200 shadow-xs">
      <!-- Header estilo trading platform -->
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 pt-4 pb-3 border-b dark:border-[#1e2030] border-slate-100">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[16px] dark:text-rose-400 text-rose-500">trending_down</span>
          <span class="text-[11px] font-black uppercase tracking-widest dark:text-white text-slate-800">Drawdown</span>
        </div>
        <!-- Toggles compactos estilo trading -->
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined dark:text-[#4a4a5a] text-slate-400 hover:dark:text-slate-300 hover:text-slate-600 cursor-pointer text-[15px]" title="Configuración">settings</span>
          <span class="material-symbols-outlined dark:text-[#4a4a5a] text-slate-400 hover:dark:text-slate-300 hover:text-slate-600 cursor-pointer text-[15px]" title="Información">info</span>
          <div class="flex items-center gap-px p-0.5 dark:bg-[#12131a] bg-slate-100 border dark:border-[#22233a] border-slate-200 rounded-md">
            <button id="btn-trailing" onclick="toggleDrawdownTrailing()" class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider bg-[#1e1228] text-[#d06080] border border-[#4a2040] transition-all flex items-center gap-1">
              <span class="w-1 h-1 rounded-full bg-rose-400"></span> TRAILING
            </button>
            <button id="btn-inversion" onclick="toggleDrawdownInversion()" class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all">$ INVERSIÓN</button>
          </div>
        </div>
      </div>
      <div id="echarts-drawdown-container" class="w-full flex-1 min-h-[180px]"></div>
    </div>

    <!-- AI Coach Score Radar -->
    <div class="glass rounded-2xl p-4 md:p-5 flex flex-col  min-h-0 justify-between dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-bold dark:text-white text-slate-900 flex items-center gap-2">
          <span class="material-symbols-outlined text-purple-500 dark:text-purple-400 text-[18px]">radar</span> TRADETRES SCORE
        </h3>
        <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/15 text-purple-600 dark:text-purple-300 font-bold border border-purple-500/30">Diagnóstico 6 Ejes</span>
      </div>
      
      <!-- Radar Chart con altura expandida h-60 para evitar cortes -->
      <div id="echarts-radar-container" class="w-full h-60"></div>
      
      <!-- Puntaje Global con Barra de Progreso Degradada -->
      <div class="mt-3 pt-3 border-t dark:border-[#2a2a30] border-slate-200 space-y-2">
        <div class="flex items-center justify-between text-xs font-bold">
          <span class="dark:text-[#9a9aa5] text-slate-500">PUNTAJE SCORE GLOBAL</span>
          <span class="text-base font-black font-mono text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
            85 <span class="text-[10px] dark:text-[#7a7a85] text-slate-400">/ 100</span>
          </span>
        </div>
        <!-- Barra Degradada -->
        <div class="w-full dark:bg-[#1a1a24] bg-slate-100 border dark:border-[#2a2a30] border-slate-200 rounded-full h-3 p-0.5 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-purple-600 via-indigo-500 to-emerald-400 w-[85%] transition-all duration-1000 shadow-xs"></div>
        </div>
        <div class="flex justify-between items-center text-[10px] dark:text-[#7a7a85] text-slate-500">
          <span>Nivel: <strong class="text-purple-600 dark:text-purple-400 font-semibold">Trader Consistente PRO</strong></span>
          <span class="text-emerald-600 dark:text-emerald-400 font-mono font-bold">Top 5%</span>
        </div>
      </div>
    </div>

  </div>

  <!-- FILA 3: Daily PNL / Duration / Trades Recientes -->
<!-- FILA 3: Daily PNL / Duration / Trades Recientes -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">

  <!-- Daily P&L -->
  <div class="glass rounded-2xl p-4 md:p-5 dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 shadow-xs">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
        <span class="material-symbols-outlined text-emerald-500 text-[18px]">bar_chart</span> P&L por Día
      </h3>
    </div>
    <div id="echarts-bar-day-container" class="w-full" style="height:220px"></div>
  </div>

  <!-- Trade Duration Scatter -->
  <div class="glass rounded-2xl p-4 md:p-5 dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 shadow-xs">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
        <span class="material-symbols-outlined text-cyan-400 text-[18px]">timer</span> Duración vs Resultado (Mins)
      </h3>
    </div>
    <div id="echarts-scatter-container" class="w-full" style="height:220px"></div>
  </div>

  <!-- Trades Recientes -->
  <div class="glass rounded-2xl p-4 md:p-5 flex flex-col dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 shadow-xs">
    <div class="flex items-center justify-between mb-3.5 shrink-0">
      <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-400 text-[20px]">list_alt</span> Últimos Trades
      </h3>
      <%= link_to trades_path, class: "text-xs font-bold text-brand hover:underline flex items-center gap-1" do %>
        Ver Todo <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
      <% end %>
    </div>
    <div class="overflow-y-auto space-y-2.5 pr-1" style="max-height:520px">
      <% if @recent_trades.any? %>
        <% @recent_trades.each do |t| %>
          <%= link_to trade_path(t), class: "flex items-center justify-between p-3 rounded-2xl dark:bg-[#18181e] bg-slate-50/80 hover:bg-slate-100/90 dark:hover:bg-[#20202a] transition-all duration-200 border dark:border-[#262632] border-slate-200/80 hover:shadow-xs group" do %>
            <div class="flex items-center gap-3.5">
              <%= asset_logo_tag(t.symbol, size_cls: "w-11 h-11") %>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold dark:text-white text-slate-900 group-hover:text-brand transition-colors"><%= t.symbol %></span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full font-mono font-bold tracking-wider <%= t.direction == 'LONG' ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/20' %>">
                    <%= t.direction %>
                  </span>
                </div>
                <p class="text-[11px] dark:text-[#8a8a98] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                  <span class="material-symbols-outlined text-[12px] opacity-70">schedule</span>
                  <%= t.entry_at&.strftime("%d/%m/%Y") rescue t.entry_at %>
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-extrabold font-mono tracking-tight <%= t.pnl >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                <%= t.pnl >= 0 ? '+' : '' %>$<%= number_with_precision(t.pnl, precision: 2, delimiter: ',') %>
              </p>
              <span class="text-[10px] font-mono dark:bg-[#20202d] bg-slate-200/70 dark:text-[#a0a0b0] text-slate-600 px-2 py-0.5 rounded-md font-bold inline-block mt-0.5 border dark:border-slate-700/50 border-slate-300/50">
                <%= t.r_multiple || 0 %>R
              </span>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="text-center py-8 text-xs text-slate-400">
          <p>Sin operaciones registradas aún.</p>
        </div>
      <% end %>
    </div>
  </div>

</div>

  <!-- FILA 4: CALENDARIO DE TRADING BENTO GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Bento Grid Calendario Mensual -->
    <div class="lg:col-span-3 dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-3xl p-4 md:p-6 flex flex-col justify-between shadow-sm dark:shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <!-- Izquierda: mes, año -->
        <div class="flex items-center gap-2 md:gap-3">
          <button class="dark:text-white text-slate-700 hover:text-slate-900 dark:hover:text-gray-300 transition-colors"><span class="material-symbols-outlined text-[20px]">chevron_left</span></button>
          <h2 class="text-[18px] md:text-[20px] font-bold dark:text-white text-slate-900 capitalize"><%= l(Date.current, format: "%B") rescue Date.current.strftime("%B") %></h2>
          <div class="flex items-center gap-1 px-3 py-1 bg-slate-100 dark:bg-[#1e1e24] rounded-full text-slate-700 dark:text-[#a0a0aa] text-xs font-semibold cursor-pointer hover:bg-slate-200 dark:hover:bg-[#2a2a30] transition-colors">
            <%= Date.current.year %>
            <span class="material-symbols-outlined text-[14px]">expand_more</span>
          </div>
          <button class="dark:text-white text-slate-700 hover:text-slate-900 dark:hover:text-gray-300 transition-colors"><span class="material-symbols-outlined text-[20px]">chevron_right</span></button>
        </div>

        <!-- Centro-derecha / Extremo derecho -->
        <div class="flex items-center gap-2 md:gap-3">
          <div class="flex items-center gap-1.5 md:gap-2">
            <button class="px-[12px] md:px-[14px] py-[6px] bg-slate-100 dark:bg-[#1e1e24] hover:bg-slate-200 dark:hover:bg-[#2a2a30] rounded-full text-slate-700 dark:text-[#e5e5e5] text-xs font-bold transition-colors">HOY</button>
            <button class="px-[12px] md:px-[14px] py-[6px] bg-slate-100 dark:bg-[#1e1e24] hover:bg-slate-200 dark:hover:bg-[#2a2a30] rounded-full text-slate-700 dark:text-[#e5e5e5] text-xs font-bold transition-colors">%</button>
            <button class="w-7 h-7 flex items-center justify-center bg-slate-100 dark:bg-[#1e1e24] hover:bg-slate-200 dark:hover:bg-[#2a2a30] text-slate-700 dark:text-[#e5e5e5] rounded-full transition-colors"><span class="material-symbols-outlined text-[14px]">help</span></button>
          </div>
          <div class="w-px h-6 bg-slate-200 dark:bg-[#2a2a30] mx-0.5 md:mx-1 hidden md:block"></div>
          <div class="hidden md:flex items-center gap-3">
            <button class="text-slate-400 dark:text-[#a0a0aa] hover:text-slate-800 dark:hover:text-white transition-colors"><span class="material-symbols-outlined text-[18px]">photo_camera</span></button>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-slate-500 dark:text-[#6b6b75] uppercase font-bold tracking-[0.5px]">Monthly P&L</span>
              <% 
                curr_month_trades = current_user.trades.where(entry_at: Date.current.beginning_of_month.beginning_of_day..Date.current.end_of_month.end_of_day)
                monthly_pnl = curr_month_trades.sum(&:pnl)
              %>
              <span class="text-[16px] font-black <%= monthly_pnl >= 0 ? 'text-emerald-600 dark:text-[#10b981]' : 'text-rose-600 dark:text-white' %>"><%= monthly_pnl >= 0 ? '+' : '' %>$<%= monthly_pnl.abs >= 1000 ? "#{(monthly_pnl.abs/1000.0).round(1)}K" : number_with_precision(monthly_pnl.abs, precision: (monthly_pnl.abs % 1 == 0 ? 0 : 2), delimiter: ',') %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- HEADER DIAS SEMANA (7 DÍAS: DOM A SÁB + ESPACIO TOTALES) -->
      <div class="grid grid-cols-8 gap-1.5 text-center text-[10px] md:text-[11px] font-bold text-slate-400 dark:text-[#6b6b75] uppercase tracking-[1px] mb-2">
        <div class="py-1">DOM</div><div class="py-1">LUN</div><div class="py-1">MAR</div><div class="py-1">MIÉ</div><div class="py-1">JUE</div><div class="py-1">VIE</div><div class="py-1">SÁB</div><div class="py-1"></div>
      </div>
      
      <!-- GRID DE SEMANAS Y DÍAS (DOMINGO A SÁBADO + WEEK 1..5 EN 8VA COLUMNA) -->
      <div class="space-y-1.5">
        <% 
          curr_d = Date.current
          start_d = curr_d.beginning_of_month.beginning_of_week(:sunday)
          end_d = curr_d.end_of_month.end_of_week(:saturday)
          month_weeks = (start_d..end_d).to_a.each_slice(7).to_a
          
          month_weeks.each_with_index do |week_days, w_idx|
            week_trades = current_user.trades.where(entry_at: week_days.first.beginning_of_day..week_days.last.end_of_day)
            w_pnl = week_trades.sum(&:pnl)
            w_count = week_trades.count
        %>
          <div class="grid grid-cols-8 gap-1.5">
            <% week_days.each do |date| %>
              <% 
                has_trades = @daily_pnl_map.key?(date)
                pnl = @daily_pnl_map[date] || 0
                is_current_m = date.month == curr_d.month
                
                if !is_current_m || !has_trades
                  # CELDA VACÍA (sin trades o fuera de mes)
                  card_class = "dark:bg-[#16161b] bg-slate-100/70 border dark:border-[#1e1e24] border-slate-200 dark:text-[#5a5a64] text-slate-400"
                elsif pnl > 0
                  # CELDA CON GANANCIA
                  card_class = "dark:bg-[#0d2e27] bg-emerald-50 border dark:border-[#1a4d3e] border-emerald-200 text-emerald-950 dark:text-white shadow-xs"
                elsif pnl < 0
                  # CELDA CON PÉRDIDA
                  card_class = "dark:bg-[#2e0d18] bg-rose-50 border dark:border-[#4d1a28] border-rose-200 text-rose-950 dark:text-white shadow-xs"
                else
                  card_class = "dark:bg-[#16161b] bg-slate-100 border dark:border-[#1e1e24] border-slate-200 dark:text-white text-slate-800"
                end
              %>
              <%= link_to calendar_path(month: date.strftime('%Y-%m')), class: "h-[100px] md:h-[120px] p-2 rounded-[8px] md:rounded-[10px] border transition-all duration-200 flex flex-col justify-between #{card_class} #{date == curr_d ? 'ring-2 ring-purple-500/50 relative' : ''}" do %>
                <div class="flex items-start">
                  <span class="text-[12px] <%= (has_trades && is_current_m) ? 'font-bold dark:text-white text-slate-900' : 'font-normal dark:text-[#5a5a64] text-slate-400' %>"><%= date.day %></span>
                </div>
                <% if has_trades && is_current_m %>
                  <div class="my-auto text-center w-full overflow-hidden">
                    <p class="text-[16px] md:text-[20px] lg:text-[22px] font-bold dark:text-white text-slate-900 leading-none mb-1 truncate">
                      <%= pnl >= 0 ? '' : '-' %>$<%= pnl.abs >= 1000 ? "#{(pnl.abs/1000.0).round(1)}K" : number_with_precision(pnl.abs, precision: (pnl.abs % 1 == 0 ? 0 : 2), delimiter: ',') %>
                    </p>
                    <p class="text-[9px] md:text-[10px] dark:text-[#8a9a95] text-slate-500 font-medium">
                      <%= current_user.trades.where(entry_at: date.beginning_of_day..date.end_of_day).count %> trades
                    </p>
                  </div>
                <% end %>
              <% end %>
            <% end %>

            <!-- COLUMNA "WEEK N" (resumen semanal) -->
            <div class="h-[100px] md:h-[120px] p-2 rounded-[8px] md:rounded-[10px] dark:bg-[#1a1a1f] bg-slate-100 border dark:border-transparent border-slate-200 flex flex-col items-center justify-between shadow-xs">
              <span class="text-[9px] md:text-[10px] dark:text-[#5a5a64] text-slate-500 font-bold w-full text-center">Week <%= w_idx + 1 %></span>
              <div class="my-auto w-full text-center overflow-hidden">
                <% if w_count > 0 %>
                  <p class="text-[14px] md:text-[16px] font-bold <%= w_pnl >= 0 ? 'text-emerald-600 dark:text-[#10b981]' : 'text-rose-600 dark:text-rose-500' %> leading-none mb-1 mt-1 truncate">
                    <%= w_pnl >= 0 ? '+' : '' %>$<%= w_pnl.abs >= 1000 ? "#{(w_pnl.abs/1000.0).round(1)}K" : number_with_precision(w_pnl, precision: 0) %>
                  </p>
                  <p class="text-[9px] md:text-[10px] dark:text-[#5a5a64] text-slate-400"><%= w_count %> trades</p>
                <% else %>
                  <p class="text-[12px] font-mono dark:text-[#5a5a64] text-slate-400 mt-2">—</p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Rachas y Estadísticas Rápidas -->
    <div class="flex flex-col gap-4">
      <div class="glass rounded-2xl p-4 flex-1 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-brand text-[16px]">bolt</span> Racha Actual
          </h3>
          <span class="text-[10px] font-bold text-slate-400">Días</span>
        </div>
        <div class="text-center py-2">
          <p class="text-3xl font-black font-mono <%= @current_streak_type == :win ? 'text-emerald-500' : (@current_streak_type == :loss ? 'text-rose-500' : 'text-slate-400') %>">
            <%= @current_streak_type == :win ? '+' : (@current_streak_type == :loss ? '-' : '') %><%= @current_streak %>
          </p>
          <p class="text-[10px] text-slate-400 mt-1 uppercase tracking-wider font-bold">
            <%= @current_streak_type == :win ? 'Días Verdes Racha' : (@current_streak_type == :loss ? 'Días Rojos Racha' : 'Sin racha') %>
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2 pt-3 border-t dark:border-darkBorder border-slate-200 text-center">
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">Máx Racha V</p>
            <p class="text-sm font-black text-emerald-500 font-mono"><%= @stats[:max_win_streak] %></p>
          </div>
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">Máx Racha R</p>
            <p class="text-sm font-black text-rose-500 font-mono"><%= @stats[:max_loss_streak] %></p>
          </div>
        </div>
      </div>

      <!-- Quick AI Diagnostic -->
      <div class="glass rounded-2xl p-4 flex-1 flex flex-col justify-between bg-brand/5 border-brand/20">
        <div class="flex items-center gap-1.5 text-brand">
          <span class="material-symbols-outlined text-[16px]">smart_toy</span>
          <span class="text-[10px] font-bold uppercase tracking-wider">Flash AI Coach</span>
        </div>
        <p class="text-xs dark:text-slate-200 text-slate-700 font-medium my-2 italic">
          "<%= @ai_diagnosis %>"
        </p>
        <%= link_to ai_coach_path, class: "text-[10px] font-bold text-brand hover:underline self-end flex items-center gap-1" do %>
          Consultar Coach <span class="material-symbols-outlined text-[12px]">chevron_right</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- FILA 5: ANALYTICS PREMIUM (P&L Diario, Day of Week, y Portfolio Strategies) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    
    <% 
      # 1. Preparar Datos P&L por Día (Últimos 5 días activos) para la primera columna
      recent_daily_pnl = current_user.trades.where.not(entry_at: nil).group("DATE(entry_at)").sum(:pnl).sort_by{|d,p| d}.last(5).reverse
      if @stats[:is_demo] && recent_daily_pnl.empty?
        # Mock si es demo sin datos
        recent_daily_pnl = [
          [Date.today, -150], [Date.today - 1.day, 420], [Date.today - 2.days, 110], [Date.today - 3.days, -50], [Date.today - 4.days, 300]
        ]
      end
      max_daily = recent_daily_pnl.map { |d, p| p.abs }.max || 1
      max_daily = 1 if max_daily == 0

      # 2. Preparar Datos Day of Week para la segunda columna
      dow_stats = {
        "Lun" => { pnl: 0, trades: 0 },
        "Mar" => { pnl: 0, trades: 0 },
        "Mié" => { pnl: 0, trades: 0 },
        "Jue" => { pnl: 0, trades: 0 },
        "Vie" => { pnl: 0, trades: 0 }
      }
      dow_mapping = { 1=>"Lun", 2=>"Mar", 3=>"Mié", 4=>"Jue", 5=>"Vie" }
      current_user.trades.each do |t|
        if t.entry_at
          lbl = dow_mapping[t.entry_at.wday]
          if lbl
            dow_stats[lbl][:pnl] += t.pnl.to_f
            dow_stats[lbl][:trades] += 1
          end
        end
      end
      if @stats[:is_demo] && dow_stats.values.sum{|x| x[:trades]} == 0
        dow_stats = {
          "Lun" => { pnl: -242, trades: 9 }, "Mar" => { pnl: 1035, trades: 7 }, "Mié" => { pnl: 2197, trades: 14 }, "Jue" => { pnl: 988, trades: 9 }, "Vie" => { pnl: -1186, trades: 12 }
        }
      end
      max_dow = dow_stats.values.map { |s| s[:pnl].abs }.max || 1
      max_dow = 1 if max_dow == 0

      # 3. Preparar Datos Portafolio Estrategias
      @dashboard_strategy_stats = current_user.trades.includes(:strategy).group_by { |t| t.strategy&.name || "Price Action" }.map do |name, trades|
        t_pnl = trades.sum(&:pnl).to_f
        # Solo tomaremos ganancias brutas o valores absolutos para que el donut sea en base al volumen de ganancia
        { name: name, value: t_pnl >= 0 ? t_pnl : (t_pnl.abs/2), actual_pnl: t_pnl, count: trades.size }
      end.sort_by { |s| -s[:value] }.first(4)
      
      if @stats[:is_demo] && @dashboard_strategy_stats.empty?
        @dashboard_strategy_stats = [
          { name: "Breakout NV", value: 5000, actual_pnl: 5000, count: 24 },
          { name: "Reversión SM", value: 3800, actual_pnl: 3800, count: 18 },
          { name: "VWAP Pullback", value: 3200, actual_pnl: 3200, count: 12 },
          { name: "Scalping 1m", value: 2500, actual_pnl: 2500, count: 32 }
        ]
      end
      total_portfolio = @dashboard_strategy_stats.sum { |s| s[:value] }
      total_portfolio = 1 if total_portfolio == 0
    %>

    <!-- 1. P&L por Día (ECharts Bar Chart — mismo estilo que Fila 3) -->
    <div class="glass dark:bg-[#111116] rounded-[20px] p-5 border border-slate-200 dark:border-[#212128] flex flex-col relative overflow-hidden shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
          <span class="material-symbols-outlined text-[16px]">bar_chart</span>
        </div>
        <h3 class="text-[13px] font-bold dark:text-white text-slate-800">Daily P&L Performance</h3>
      </div>
      <div id="echarts-daily-pnl-premium" class="w-full flex-1" style="min-height:200px"></div>
    </div>

    <!-- 2. Day of Week Performance (Igual a imagen 1) -->
    <div class="glass dark:bg-[#111116] rounded-[20px] p-5 border border-slate-200 dark:border-[#212128] flex flex-col justify-between relative overflow-hidden shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-7 h-7 rounded-lg dark:bg-[#1e1e26] bg-slate-100 dark:text-slate-300 text-slate-600 flex items-center justify-center">
          <span class="material-symbols-outlined text-[16px]">calendar_view_week</span>
        </div>
        <h3 class="text-[13px] font-bold dark:text-white text-slate-800">Day of week performance</h3>
      </div>
      <div class="flex flex-col gap-[14px]">
        <% ["Lun", "Mar", "Mié", "Jue", "Vie"].each do |day| 
            d = dow_stats[day]
            pnl = d[:pnl]
            cnt = d[:trades]
        %>
          <div class="flex items-center justify-between">
            <div class="w-8 text-[11px] font-black dark:text-white text-slate-800"><%= day %></div>
            <div class="flex-1 flex items-center mx-2 relative h-[18px] dark:bg-[#1e1e26] bg-slate-100 rounded-lg">
              <!-- Left Side (Negative/Red) -->
              <div class="w-1/2 h-full flex justify-end">
                <% if pnl < 0 %>
                  <div class="h-full bg-rose-500 rounded-l-lg rounded-r-md transition-all duration-500 shadow-sm" style="width: <%= (pnl.abs / max_dow) * 100 %>%"></div>
                <% end %>
              </div>
              
              <!-- Right Side (Positive/Green) -->
              <div class="w-1/2 h-full flex justify-start">
                <% if pnl >= 0 %>
                  <div class="h-full bg-emerald-400 rounded-r-lg rounded-l-md transition-all duration-500 shadow-sm" style="width: <%= (pnl.abs / max_dow) * 100 %>%"></div>
                <% end %>
              </div>
            </div>
            
            <div class="flex items-center gap-2 w-20 justify-end">
              <div class="w-[22px] h-[22px] rounded-full dark:bg-[#1a1a22] bg-slate-200/50 flex items-center justify-center text-[9px] font-bold dark:text-[#a0a0ad] text-slate-600 border dark:border-[#2a2a35] border-slate-300">
                <%= cnt %>
              </div>
              <div class="w-11 text-right text-[11px] font-black font-mono <%= pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                <%= pnl >= 0 ? '+' : '-' %>$<%= (pnl.abs >= 1000 ? (pnl.abs/1000.0).round(1).to_s+'K' : pnl.abs.round) %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 3. Portfolio Overview / Estrategias Clave (Donut Premium) -->
    <div class="glass dark:bg-gradient-to-br dark:from-[#13141f] dark:to-[#1a1824] bg-white rounded-[24px] p-5 border border-slate-200 dark:border-[#282736] relative flex flex-col shadow-sm">
      <!-- Header -->
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg dark:bg-[#201f2e] bg-purple-50 flex items-center justify-center text-[#8b5cf6]">
            <span class="material-symbols-outlined text-[16px]">donut_large</span>
          </div>
          <h3 class="text-[13px] font-bold dark:text-white text-slate-800">Strategy Portfolio</h3>
        </div>
        <span class="px-2 py-0.5 rounded-md dark:bg-[#201f2e] bg-slate-100 text-[11px] font-bold dark:text-slate-300 text-slate-600 border dark:border-[#2f2e42] border-slate-200"><%= @dashboard_strategy_stats.size %> activas</span>
      </div>

      <!-- Donut Chart -->
      <div id="echarts-portfolio-doughnut" class="w-full" style="min-height:180px;height:180px"></div>

      <!-- Leyenda Grid -->
      <div class="grid grid-cols-2 gap-x-3 gap-y-3 mt-3 pt-3 border-t dark:border-[#2f2e42] border-slate-100">
        <%
          colors = ['#8B5CF6', '#34D399', '#FB7185', '#FBBF24']
          circles = [ 'bg-[#8B5CF6]', 'bg-[#34D399]', 'bg-[#FB7185]', 'bg-[#FBBF24]' ]
        %>
        <% @dashboard_strategy_stats.each_with_index do |strat, idx| %>
          <div class="flex items-center gap-2.5">
            <div class="w-2.5 h-2.5 rounded-full <%= circles[idx] %> shrink-0"></div>
            <div class="flex flex-col min-w-0">
              <span class="text-sm font-bold dark:text-white text-slate-800 leading-tight truncate" title="<%= strat[:name] %>"><%= strat[:name] %></span>
              <span class="text-xs font-mono dark:text-slate-400 text-slate-500"><%= ((strat[:value] / total_portfolio) * 100).round %>% · <%= strat[:count] %> trades</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <!-- FILA 6: CALENDARIO ANUAL DE RENDIMIENTO (EXACTO A IMAGEN DE REFERENCIA 3) -->
  <div class="dark:bg-[#131317] bg-white border dark:border-[#232329] border-slate-200 rounded-[12px] p-4 md:p-5 shadow-sm dark:shadow-2xl overflow-x-auto">
    <!-- Header del Calendario Anual -->
    <div class="flex items-center justify-between mb-4 min-w-[750px]">
      <div class="flex items-center gap-2.5">
        <div class="w-[28px] h-[28px] rounded-[6px] dark:bg-[#1e1e24] bg-purple-50 flex items-center justify-center text-[#8b5cf6]">
          <span class="material-symbols-outlined text-[16px]">calendar_month</span>
        </div>
        <h3 class="text-[15px] font-bold dark:text-white text-slate-900 flex items-center gap-2">
          Yearly Calendar
          <span class="material-symbols-outlined dark:text-[#6b6b75] text-slate-400 hover:text-slate-700 dark:hover:text-white cursor-pointer text-[14px]" title="Información del calendario anual">help</span>
        </h3>
      </div>
      
      <!-- Derecha: Grupo de 3 toggles/pills en fila con gap 4px -->
      <div class="flex items-center gap-[4px] h-[30px]">
        <button class="px-[10px] py-[6px] bg-slate-100 dark:bg-[#1e1e24] hover:bg-slate-200 dark:hover:bg-[#2a2a30] text-slate-600 dark:text-[#8a8a94] text-xs font-semibold rounded-[6px] transition-colors">%</button>
        <button class="px-[10px] py-[6px] bg-[#8b5cf6] text-white font-bold text-xs rounded-[6px] transition-colors shadow-xs">P&L</button>
        <button class="px-[10px] py-[6px] bg-slate-100 dark:bg-[#1e1e24] hover:bg-slate-200 dark:hover:bg-[#2a2a30] text-slate-600 dark:text-[#8a8a94] text-xs font-semibold rounded-[6px] transition-colors">Win rate</button>
      </div>
    </div>
    
    <!-- GRID DE 14 COLUMNAS (YEAR, JAN..DEC, TOTAL) -->
    <div class="min-w-[750px] space-y-[4px]">
      <!-- Header de Columnas -->
      <div class="grid grid-cols-[repeat(14,minmax(0,1fr))] gap-[4px] text-center text-[10px] font-semibold dark:text-[#6b6b75] text-slate-500 uppercase tracking-[0.5px] pb-2 border-b dark:border-[#232329] border-slate-200">
        <div>YEAR</div>
        <div>JAN</div>
        <div>FEB</div>
        <div>MAR</div>
        <div>APR</div>
        <div>MAY</div>
        <div>JUN</div>
        <div>JUL</div>
        <div>AUG</div>
        <div>SEP</div>
        <div>OCT</div>
        <div>NOV</div>
        <div>DEC</div>
        <div>TOTAL</div>
      </div>

      <!-- Fila de Celdas -->
      <div class="grid grid-cols-[repeat(14,minmax(0,1fr))] gap-[4px] text-center pt-1">
        <!-- Columna 1: AÑO -->
        <div class="h-[55px] rounded-[6px] dark:bg-[#18181d] bg-slate-100 border dark:border-[#232329] border-slate-200 dark:text-white text-slate-900 font-bold text-[13px] flex items-center justify-center">
          <%= Time.current.year %>
        </div>

        <!-- Columnas 2 a 13: ENE a DIC -->
        <% 
          months_abbr = %w[JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC]
          @annual_stats.each_with_index do |pnl, m_idx| 
            m_trades = current_user.trades.select { |t| t.entry_at&.year == Time.current.year && t.entry_at&.month == (m_idx + 1) }
            m_count = m_trades.size
        %>
          <% if m_count == 0 %>
            <!-- CELDA VACÍA -->
            <div class="h-[55px] rounded-[6px] dark:bg-[#18181d] bg-slate-50 border dark:border-[#232329] border-slate-200 dark:text-[#4a4a54] text-slate-400 font-normal text-[13px] flex items-center justify-center">
              --
            </div>
          <% elsif pnl < 0 %>
            <!-- CELDA CON PÉRDIDA -->
            <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#2e1018] bg-rose-50 border dark:border-[#5c2030] border-rose-200 flex flex-col items-center justify-center">
              <span class="text-[14px] font-bold dark:text-[#f87171] text-rose-600">$-<%= pnl.abs >= 1000 ? "#{(pnl.abs/1000.0).round(1)}K" : pnl.abs.round %></span>
              <span class="text-[10px] dark:text-[#a06070] text-rose-500/80 font-normal"><%= m_count %> trades</span>
            </div>
          <% else %>
            <!-- CELDA CON GANANCIA -->
            <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#0e2a22] bg-emerald-50 border dark:border-[#1f5c45] border-emerald-200 flex flex-col items-center justify-center">
              <span class="text-[14px] font-bold dark:text-[#34d399] text-emerald-600">+$<%= pnl >= 1000 ? "#{(pnl/1000.0).round(1)}K" : pnl.round %></span>
              <span class="text-[10px] dark:text-[#6a9a8a] text-emerald-600/80 font-normal"><%= m_count %> trades</span>
            </div>
          <% end %>
        <% end %>

        <!-- Columna 14: CELDA TOTAL -->
        <% if @annual_total < 0 %>
          <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#38121d] bg-rose-100 border dark:border-[#78283c] border-rose-300 flex flex-col items-center justify-center">
            <span class="text-[15px] font-black dark:text-[#f87171] text-rose-700">-$<%= (@annual_total.abs >= 1000 ? "#{(@annual_total.abs/1000.0).round(1)}K" : @annual_total.abs.round) %></span>
            <span class="text-[10px] dark:text-[#a06070] text-rose-600 font-normal"><%= @annual_trades_count %> trades</span>
          </div>
        <% else %>
          <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#0f3328] bg-emerald-100 border dark:border-[#22c55e]/30 border-emerald-300 flex flex-col items-center justify-center">
            <span class="text-[15px] font-black dark:text-[#34d399] text-emerald-700">+$<%= (@annual_total >= 1000 ? "#{(@annual_total/1000.0).round(1)}K" : @annual_total.round) %></span>
            <span class="text-[10px] dark:text-[#6a9a8a] text-emerald-600 font-normal"><%= @annual_trades_count %> trades</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>

<!-- INITIALIZATION OF ECHARTS -->
<script>
(function() {
  function safeRenderEcharts() {
    const htmlRoot = document.documentElement || document.getElementById("html-root");
    const isDark = htmlRoot ? htmlRoot.classList.contains("dark") : true;
    const textColor = isDark ? "#9DA3B4" : "#475569";
    const borderColor = isDark ? "#23263A" : "#E2E8F0";
    const tooltipBg = isDark ? "#1a1a1f" : "#ffffff";
    const tooltipText = isDark ? "#e5e5e5" : "#0f172a";

    // --- DATOS GLOBALES DEL BACKEND (Saneamiento) ---
    let rawEquityData = <%= (@equity_data || []).to_json.html_safe %> || [];
    
    // Inyectar mock data si viene vacía para que el P&L Chart se dibuje
    if (!Array.isArray(rawEquityData) || rawEquityData.length === 0) {
      rawEquityData = [
        { date: '2024-01-01', value: 0 },
        { date: '2024-01-02', value: 120 },
        { date: '2024-01-03', value: -50 },
        { date: '2024-01-04', value: 340 },
        { date: '2024-01-05', value: 890 },
        { date: '2024-01-06', value: 650 },
        { date: '2024-01-07', value: 1050 }
      ];
    }
    
    const statsWinRate = Number(<%= @stats[:win_rate] || 0 %>) || 0;
    const statsProfitFactor = Number(<%= @stats[:profit_factor] || 0 %>) || 0;
    const statsAvgWin = Number(<%= @stats[:avg_win] || 0 %>) || 0;
    const statsAvgLoss = Number(<%= @stats[:avg_loss] || 0 %>) || 0;
    const statsRrRatio = Number(<%= @stats[:rr_ratio] || 0 %>) || 0;

  // --- FORMATEADOR DE FECHAS EN ESPAÑOL (Eje X: 9 Feb, 13 Feb, etc.) ---
  function formatSpanishDate(dateStr, idx) {
    if (!dateStr) return `T${idx + 1}`;
    const str = String(dateStr);
    const months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    // Formato dd/mm
    if (str.includes('/')) {
      const parts = str.split('/');
      const day = parseInt(parts[0], 10);
      const mIdx = parseInt(parts[1], 10) - 1;
      if (!isNaN(day) && mIdx >= 0 && mIdx < 12) {
        return `${day} ${months[mIdx]}`;
      }
    }
    // Formato ISO yyyy-mm-dd
    if (str.includes('-') && str.length >= 10) {
      const datePart = str.split('T')[0];
      const parts = datePart.split('-');
      if (parts.length >= 3) {
        const day = parseInt(parts[2], 10);
        const mIdx = parseInt(parts[1], 10) - 1;
        if (!isNaN(day) && mIdx >= 0 && mIdx < 12) {
          return `${day} ${months[mIdx]}`;
        }
      }
    }
    return str;
  }

  const formattedDates = rawEquityData.map((d, i) => formatSpanishDate(d.date, i));
  console.log('[CoachTrading] Equity data points:', rawEquityData.length, 'Labels:', formattedDates.length);

  // --- 1. CURVA DE P&L ACUMULADO — ESTILO TRADING PROFESIONAL ---
  let currentEquityChart = null;
  let currentEquityMode = 'pnl';

  // Colores semánticos de trading
  const C_GREEN      = '#10B981';
  const C_RED        = '#E05260';
  const C_PURPLE     = '#8B7EFA';
  const C_GRID       = isDark ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.05)';
  const C_AXIS_TEXT  = isDark ? '#4E5470' : '#94A3B8';
  const C_ZERO_LINE  = isDark ? 'rgba(100,110,160,0.35)' : 'rgba(100,116,139,0.30)';

  // Tooltip profesional de trading
  function buildTradingTooltipFormatter(mode) {
    return function(params) {
      if (!params || !params.length) return '';
      const p = params[0];
      const val = p.value;
      const label = p.name || p.axisValue || '';
      let color, sign, displayVal;

      if (mode === 'winrate') {
        color = val >= 50 ? C_GREEN : C_RED;
        displayVal = `${val}%`;
        sign = '';
      } else {
        color = val >= 0 ? C_GREEN : C_RED;
        sign = val >= 0 ? '+' : '';
        const absV = Math.abs(val);
        displayVal = `${sign}$${absV.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
      }

      return `
        <div style="font-family:'League Spartan',Manrope,sans-serif;min-width:110px;padding:2px">
          <div style="font-size:10px;color:${isDark?'#6a7090':'#64748b'};margin-bottom:5px;font-weight:700;letter-spacing:0.5px">${label.toUpperCase()}</div>
          <div style="font-size:10px;color:${isDark?'#8890aa':'#475569'};font-weight:600">P&L</div>
          <div style="font-size:15px;font-weight:900;color:${color};letter-spacing:-0.5px;margin-top:1px">${displayVal}</div>
        </div>`;
    };
  }

  // Construye opciones para modo win rate
  function buildWinRateOption(labels, values) {
    return {
      backgroundColor: 'transparent',
      grid: { left: 44, right: 12, top: 18, bottom: 28 },
      tooltip: {
        trigger: 'axis',
        backgroundColor: isDark ? '#0f1018' : '#ffffff',
        borderColor: isDark ? '#1e2040' : '#e2e8f0',
        borderWidth: 1,
        padding: [10, 12],
        extraCssText: `border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.4)`,
        formatter: buildTradingTooltipFormatter('winrate')
      },
      xAxis: {
        type: 'category', data: labels, boundaryGap: false,
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: { color: C_AXIS_TEXT, fontSize: 10, margin: 8 },
        splitLine: { show: false }
      },
      yAxis: {
        type: 'value',
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: { color: C_AXIS_TEXT, fontSize: 10, formatter: v => `${v}%` },
        splitLine: { lineStyle: { color: C_GRID, type: 'dashed', dashOffset: 3 } },
        splitNumber: 4
      },
      series: [{
        type: 'line', data: values, smooth: 0.4,
        symbol: 'none',
        lineStyle: { width: 2, color: C_PURPLE },
        itemStyle: { color: C_PURPLE },
        areaStyle: {
          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
            { offset: 0, color: 'rgba(139,126,250,0.25)' },
            { offset: 1, color: 'rgba(139,126,250,0.01)' }
          ])
        }
      }]
    };
  }

  // Construye opciones P&L / Balance con segmentación dinámica verde/rojo
  function buildPnlCurveOption(labels, values, mode) {
    if (mode === 'winrate') return buildWinRateOption(labels, values);
    const showSymbol = values.length <= 1;
    const n = values.length;
    const minVal = Math.min(...values, 0);
    const maxVal = Math.max(...values, 0);



    // Segmentos de color: verde cuando >= 0, rojo cuando < 0
    // Se usan markAreas invisibles + visualMap por pieza
    // ECharts piecewise visualMap para colourear la línea por valor
    const pieces = [];
    if (minVal < 0) pieces.push({ lt: 0, color: C_RED });
    pieces.push({ gte: 0, color: C_GREEN });

    // Formato del eje Y
    const yFormatter = v => {
      if (v === 0) return '$0';
      const sign = v > 0 ? '' : '-';
      const absV = Math.abs(v);
      if (absV >= 1000) return `${sign}$${(absV/1000).toFixed(1)}K`;
      return `${sign}$${absV}`;
    };

    // Áreas degradadas: positiva (verde) y negativa (roja)
    const gradGreen = new echarts.graphic.LinearGradient(0, 0, 0, 1, [
      { offset: 0, color: 'rgba(16,185,129,0.22)' },
      { offset: 1, color: 'rgba(16,185,129,0.00)' }
    ]);
    const gradRed = new echarts.graphic.LinearGradient(0, 0, 0, 1, [
      { offset: 0, color: 'rgba(224,82,96,0.00)' },
      { offset: 1, color: 'rgba(224,82,96,0.20)' }
    ]);

    // Para el área degradada combinada usamos el último valor
    const lastVal = values[n - 1] || 0;
    const areaGrad = lastVal >= 0 ? gradGreen : gradRed;

    return {
      backgroundColor: 'transparent',
      grid: { left: 52, right: 14, top: 16, bottom: 28 },

      // Tooltip oscuro premium
      tooltip: {
        trigger: 'axis',
        backgroundColor: isDark ? '#0f1018' : '#ffffff',
        borderColor: isDark ? '#1e2040' : '#e2e8f0',
        borderWidth: 1,
        padding: [10, 12],
        extraCssText: `border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.4)`,
        formatter: buildTradingTooltipFormatter(mode)
      },

      // Eje X discreto
      xAxis: {
        type: 'category', data: labels, boundaryGap: false,
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: {
          color: C_AXIS_TEXT, fontSize: 10, margin: 8,
          interval: Math.max(0, Math.floor(n / 6) - 1)
        },
        splitLine: { show: false }
      },

      // Eje Y discreto con formato monetario
      yAxis: {
        type: 'value',
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: { color: C_AXIS_TEXT, fontSize: 10, formatter: yFormatter },
        splitLine: { lineStyle: { color: C_GRID, type: [4, 4], dashOffset: 2 } },
        splitNumber: 5
      },

      // Línea $0 de referencia


      // Colorear línea según valor positivo/negativo
      visualMap: {
        show: false,
        type: 'piecewise',
        seriesIndex: 1, // Aplica SOLAMENTE a la serie principal, excluyendo markLine
        dimension: 1,
        pieces: pieces
      },

      series: [
        // 0. Serie Dummy (Solo para pintar la línea base y evadir el bug de visualMap)
        {
          type: 'line',
          data: [],
          markLine: {
            silent: true,
            symbol: 'none',
            lineStyle: { color: C_ZERO_LINE, type: 'dashed', width: 1.2, dashOffset: 4 },
            label: { show: false },
            data: [{ yAxis: 0 }]
          }
        },
        // 1. Serie principal con área degradada interactiva
        {
          type: 'line', data: values, smooth: 0.35,
          symbol: showSymbol ? 'circle' : 'none',
          symbolSize: 8,
          lineStyle: { width: 2, color: C_GREEN },
          itemStyle: { color: C_GREEN },
          areaStyle: { color: areaGrad }
        }
      ]
    };
  }

  function renderEquityChart(mode) {
    const eqCont = document.getElementById("echarts-equity-container");
    if (!eqCont) return;

    try {
      if (!currentEquityChart) {
        const existing = echarts.getInstanceByDom(eqCont);
        if (existing) existing.dispose();
        currentEquityChart = echarts.init(eqCont);
        window.addEventListener('resize', () => currentEquityChart && currentEquityChart.resize());
      }

      let values = [];
      if (Array.isArray(rawEquityData) && rawEquityData.length) {
        if (mode === 'pnl') {
          values = rawEquityData.map(d => Number(d.value) || 0);
        } else if (mode === 'balance') {
          const initialBalance = 100000;
          values = rawEquityData.map(d => initialBalance + (Number(d.value) || 0));
        } else if (mode === 'winrate') {
          let winCount = 0;
          values = rawEquityData.map((d, i) => {
            if ((Number(d.pnl) || 0) > 0) winCount++;
            return Math.round((winCount / (i + 1)) * 100);
          });
        }
      } else {
        values = [0];
      }

      const passLabels = formattedDates.length ? formattedDates : ['T1'];
      const passValues = values.length ? values : [0];
      currentEquityChart.setOption(buildPnlCurveOption(passLabels, passValues, mode), true);
    } catch(e) { console.error('Error in Equity Chart render', e); }
  }

  window.switchEquityMode = function(mode) {
    currentEquityMode = mode;
    // Mapeo id → modo
    const modeMap = { 'pnl-neto': 'pnl', 'balance': 'balance', 'winrate': 'winrate' };
    Object.entries(modeMap).forEach(([id, m]) => {
      const btn = document.getElementById(`btn-${id}`);
      if (!btn) return;
      if (m === mode) {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider bg-[#1e2040] text-[#a0a8ff] border border-[#3a3a60] transition-all';
      } else {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all';
      }
    });
    renderEquityChart(mode);
  };

  renderEquityChart('pnl');

  // --- 2. DRAWDOWN — ESTILO TRADING PROFESIONAL ---
  let currentDdChart = null;
  let isTrailing = true;
  let isInverted = false;

  const C_DD_LINE  = '#D94B68';
  const C_DD_GLOW  = 'rgba(217,75,104,0.18)';

  function buildDrawdownOption(labels, values, inverted) {
    const n = values.length;

    // Formato eje Y para drawdown
    const ddYFormatter = v => {
      if (v === 0) return '$0';
      const sign = inverted ? '' : '-';
      const absV = Math.abs(v);
      if (absV >= 1000) return `${sign}$${(absV/1000).toFixed(1)}K`;
      return `${sign}$${absV}`;
    };

    // Tooltip profesional de drawdown
    const ddTooltipFmt = params => {
      if (!params || !params.length) return '';
      const p = params[0];
      const val = p.value;
      const label = p.name || p.axisValue || '';
      const absV = Math.abs(val);
      const sign = inverted ? '+' : '-';
      const displayVal = absV >= 1000
        ? `${sign}$${(absV/1000).toFixed(1)}K`
        : `${sign}$${absV.toLocaleString('es-MX', {minimumFractionDigits:0, maximumFractionDigits:0})}`;
      return `
        <div style="font-family:'League Spartan',Manrope,sans-serif;min-width:110px;padding:2px">
          <div style="font-size:10px;color:${isDark?'#6a7090':'#64748b'};margin-bottom:5px;font-weight:700;letter-spacing:0.5px">${label.toUpperCase()}</div>
          <div style="font-size:10px;color:${isDark?'#8890aa':'#475569'};font-weight:600">DRAWDOWN</div>
          <div style="font-size:15px;font-weight:900;color:${C_DD_LINE};letter-spacing:-0.5px;margin-top:1px">${displayVal}</div>
        </div>`;
    };

    // Área degradada: intensa cerca de la línea, se desvanece hacia abajo
    const ddAreaGrad = inverted
      ? new echarts.graphic.LinearGradient(0, 0, 0, 1, [
          { offset: 0, color: 'rgba(217,75,104,0.28)' },
          { offset: 1, color: 'rgba(217,75,104,0.01)' }
        ])
      : new echarts.graphic.LinearGradient(0, 0, 0, 1, [
          { offset: 0, color: 'rgba(217,75,104,0.01)' },
          { offset: 1, color: 'rgba(217,75,104,0.26)' }
        ]);

    return {
      backgroundColor: 'transparent',
      grid: { left: 52, right: 14, top: 16, bottom: 28 },

      tooltip: {
        trigger: 'axis',
        backgroundColor: isDark ? '#0f1018' : '#ffffff',
        borderColor: isDark ? '#2a1228' : '#fce7f3',
        borderWidth: 1,
        padding: [10, 12],
        extraCssText: `border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.4)`,
        formatter: ddTooltipFmt
      },

      xAxis: {
        type: 'category', data: labels, boundaryGap: false,
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: {
          color: C_AXIS_TEXT, fontSize: 10, margin: 8,
          interval: Math.max(0, Math.floor(n / 6) - 1)
        },
        splitLine: { show: false }
      },

      yAxis: {
        type: 'value',
        axisLine: { show: false },
        axisTick: { show: false },
        axisLabel: { color: C_AXIS_TEXT, fontSize: 10, formatter: ddYFormatter },
        splitLine: { lineStyle: { color: C_GRID, type: [4, 4], dashOffset: 2 } },
        splitNumber: 4
      },

      series: [{
        type: 'line', data: values, smooth: 0.35,
        symbol: 'none',
        lineStyle: { width: 2, color: C_DD_LINE },
        itemStyle: { color: C_DD_LINE },
        areaStyle: { color: ddAreaGrad },
        markLine: {
          silent: true,
          symbol: 'none',
          lineStyle: { color: C_ZERO_LINE, type: 'dashed', width: 1.2, dashOffset: 4 },
          label: { show: false },
          data: [{ yAxis: 0 }]
        }
      }]
    };
  }

  function renderDrawdownChart() {
    const ddCont = document.getElementById("echarts-drawdown-container");
    if (!ddCont) return;

    try {
      if (!currentDdChart) {
        const existing = echarts.getInstanceByDom(ddCont);
        if (existing) existing.dispose();
        currentDdChart = echarts.init(ddCont);
        window.addEventListener('resize', () => currentDdChart && currentDdChart.resize());
      }

      let peak = 0;
      let values = [];
      if (Array.isArray(rawEquityData) && rawEquityData.length) {
        values = rawEquityData.map(d => {
          const val = Number(d.value) || 0;
          if (val > peak) peak = val;
          const dd = val - peak;
          return isInverted ? Math.abs(dd) : dd;
        });
      } else {
        values = [0];
      }

      const passLabels = formattedDates.length ? formattedDates : ['T1'];
      const passValues = values.length ? values : [0];
      currentDdChart.setOption(buildDrawdownOption(passLabels, passValues, isInverted), true);
    } catch(e) { console.error('Error Drawdown Chart', e); }
  }

  window.toggleDrawdownTrailing = function() {
    isTrailing = !isTrailing;
    const btn = document.getElementById("btn-trailing");
    if (btn) {
      if (isTrailing) {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider bg-[#1e1228] text-[#d06080] border border-[#4a2040] transition-all flex items-center gap-1';
      } else {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all flex items-center gap-1';
      }
    }
    renderDrawdownChart();
  };

  window.toggleDrawdownInversion = function() {
    isInverted = !isInverted;
    const btn = document.getElementById("btn-inversion");
    if (btn) {
      if (isInverted) {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider bg-[#1e2040] text-[#a0a8ff] border border-[#3a3a60] transition-all';
      } else {
        btn.className = 'px-2 py-1 rounded text-[9px] font-black uppercase tracking-wider dark:text-[#5a5a70] text-slate-400 hover:dark:text-slate-200 hover:text-slate-700 transition-all';
      }
    }
    renderDrawdownChart();
  };

  renderDrawdownChart();

  // --- 3. TRADETRES SCORE RADAR ---
  const radarCont = document.getElementById("echarts-radar-container");
  if (radarCont) {
    try {
      const existing = echarts.getInstanceByDom(radarCont);
      if (existing) existing.dispose();
      const rChart = echarts.init(radarCont);

      const safeWin = Math.min(Math.max(statsWinRate, 0), 100) || 0;
      const safePf = Math.min(Math.max(statsProfitFactor, 0), 5) || 0;
      const safeRr = Math.min(Math.max(statsRrRatio, 0), 5) || 0;

      rChart.setOption({
        backgroundColor: 'transparent',
        radar: {
          indicator: [
            { name: 'Win %', max: 100 },
            { name: 'Profit factor', max: 5 },
            { name: 'Avg win/loss', max: 5 },
            { name: 'Recovery factor', max: 5 },
            { name: 'Max drawdown', max: 20 },
            { name: 'Consistency', max: 100 }
          ],
          shape: 'polygon',
          splitNumber: 4,
          radius: '55%',
          center: ['50%', '50%'],
          axisName: { color: textColor, fontSize: 10, padding: [-4, -4] },
          splitLine: { lineStyle: { color: borderColor } },
          splitArea: { show: false },
          axisLine: { lineStyle: { color: borderColor } }
        },
        series: [{
          type: 'radar',
          data: [{
            value: [
              safeWin,
              safePf,
              safeRr,
              3.2,
              12,
              88
            ],
            lineStyle: { color: '#8b5cf6', width: 2 },
            areaStyle: { color: 'rgba(139,92,246,0.35)' },
            itemStyle: { color: '#8b5cf6' }
          }]
        }]
      }, true);
      window.addEventListener('resize', () => rChart && rChart.resize());
    } catch(e) { console.error('Error Radar Chart', e); }
  }

  // --- 4. TOP KPI CARDS CHARTS ---

  // Sparkline Balance & P&L Mini Graph
  const sparkBalCont = document.getElementById("sparkline-balance");
  if (sparkBalCont) {
    try {
      const existing = echarts.getInstanceByDom(sparkBalCont);
      if (existing) existing.dispose();
      const balChart = echarts.init(sparkBalCont);

      const balValues = Array.isArray(rawEquityData) && rawEquityData.length
        ? rawEquityData.map(d => Number(d.value) || 0)
        : [0, 100, 250, 180, 420, 600];

      balChart.setOption({
        backgroundColor: 'transparent',
        grid: { left: 0, right: 0, top: 5, bottom: 5 },
        xAxis: { type: 'category', show: false },
        yAxis: { type: 'value', show: false },
        series: [{
          type: 'line',
          data: balValues,
          smooth: true,
          symbol: 'none',
          lineStyle: { width: 2, color: '#009DFA' },
          areaStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: 'rgba(0,157,250,0.35)' },
              { offset: 1, color: 'rgba(0,157,250,0.0)' }
            ])
          }
        }]
      }, true);
      window.addEventListener('resize', () => balChart && balChart.resize());
    } catch (e) { console.error('Error Balance Sparkline', e); }
  }

  // A) Semi-circular Win Rate Gauge
  const sparkWrCont = document.getElementById("sparkline-winrate");
  if (sparkWrCont) {
    try {
      const existing = echarts.getInstanceByDom(sparkWrCont);
      if (existing) existing.dispose();
      const wrChart = echarts.init(sparkWrCont);

      const winVal = Math.min(Math.max(statsWinRate, 0), 100);
      const lossVal = Math.max(0, 100 - winVal - 3);

      wrChart.setOption({
        backgroundColor: 'transparent',
        series: [{
          type: 'pie',
          radius: ['70%', '98%'],
          center: ['50%', '85%'],
          startAngle: 180,
          endAngle: 0,
          avoidLabelOverlap: false,
          itemStyle: { borderRadius: 4 },
          label: { show: false },
          data: [
            { value: winVal, itemStyle: { color: '#10b981' } },  // Verde
            { value: 3, itemStyle: { color: '#6366f1' } },       // Indigo (BE)
            { value: Math.max(lossVal, 0), itemStyle: { color: '#f43f5e' } }, // Rojo
            { value: winVal + 3 + Math.max(lossVal, 0), itemStyle: { color: 'none' }, label: { show: false } }
          ]
        }]
      }, true);
      window.addEventListener('resize', () => wrChart && wrChart.resize());
    } catch(e) { console.error('Error WinRate Spark', e); }
  }

  // B) Profit Factor Donut Chart
  const sparkPfCont = document.getElementById("sparkline-pf");
  if (sparkPfCont) {
    try {
      const existing = echarts.getInstanceByDom(sparkPfCont);
      if (existing) existing.dispose();
      const pfChart = echarts.init(sparkPfCont);

      const pfVal = Math.min(Math.max(statsProfitFactor, 0), 5);
      const winRatio = (pfVal / (pfVal + 1)) * 100;
      const lossRatio = 100 - winRatio;

      pfChart.setOption({
        backgroundColor: 'transparent',
        series: [{
          type: 'pie',
          radius: ['68%', '92%'],
          center: ['50%', '50%'],
          avoidLabelOverlap: false,
          itemStyle: { borderRadius: 2 },
          label: { show: false },
          data: [
            { value: Math.max(winRatio, 0), itemStyle: { color: '#10b981' } }, // Verde
            { value: Math.max(lossRatio, 0), itemStyle: { color: '#f43f5e' } } // Rojo
          ]
        }]
      }, true);
      window.addEventListener('resize', () => pfChart && pfChart.resize());
    } catch(e) { console.error('Error ProfitFactor Spark', e); }
  }

  // C) Avg Win / Loss Dual Bar Chart
  const sparkAvgCont = document.getElementById("sparkline-avg");
  if (sparkAvgCont) {
    try {
      const existing = echarts.getInstanceByDom(sparkAvgCont);
      if (existing) existing.dispose();
      const avgChart = echarts.init(sparkAvgCont);

      const winAmt = Math.abs(statsAvgWin);
      const lossAmt = Math.abs(statsAvgLoss);

      avgChart.setOption({
        backgroundColor: 'transparent',
        grid: { left: 0, right: 0, top: 'center', bottom: 'center', height: 16 },
        xAxis: { type: 'value', show: false },
        yAxis: { type: 'category', show: false, data: ['Avg'] },
        series: [
          {
            type: 'bar',
            stack: 'total',
            barWidth: 14,
            itemStyle: { color: '#10b981', borderRadius: [4, 0, 0, 4] },
            data: [winAmt]
          },
          {
            type: 'bar',
            stack: 'total',
            barWidth: 14,
            itemStyle: { color: '#ef4444', borderRadius: [0, 4, 4, 0] },
            data: [lossAmt]
          }
        ]
      }, true);
      window.addEventListener('resize', () => avgChart && avgChart.resize());
    } catch (e) { console.error('Error Avg Spark', e); }
  }

  // --- 5. Daily P&L Bar Chart ---
// Datos compartidos (una sola vez)
const dailyData = <%= (@pnl_by_day || {}).to_json.html_safe %>;

function getDailySeries() {
  let labels = Object.keys(dailyData).map(d => String(d).slice(5));
  let values = Object.values(dailyData).map(v => Number(v) || 0);
  if (labels.length === 0) { labels = ['T1']; values = [0]; }
  return { labels, values };
}

// ── Gráfico 1: Fila 3 (#echarts-bar-day-container) ──
function renderDayBarChart() {
  const el = document.getElementById('echarts-bar-day-container');
  if (!el) return;
  try {
    const old = echarts.getInstanceByDom(el);
    if (old) old.dispose();
    const chart = echarts.init(el);
    const { labels, values } = getDailySeries();

    chart.setOption({
      backgroundColor: 'transparent',
      tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, backgroundColor: tooltipBg, borderColor: borderColor, textStyle: { color: tooltipText } },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'category', data: labels, axisLine: { lineStyle: { color: borderColor } }, axisLabel: { color: textColor, fontSize: 9 } },
      yAxis: { type: 'value', splitLine: { lineStyle: { color: borderColor, type: 'dashed' } }, axisLabel: { color: textColor, fontSize: 9 } },
      series: [{
        type: 'bar', barWidth: '40%',
        itemStyle: { borderRadius: [3, 3, 0, 0], color: p => (p.value || 0) >= 0 ? '#10B981' : '#F43F5E' },
        data: values
      }]
    }, true);
    new ResizeObserver(() => chart.resize()).observe(el);
  } catch (e) { console.error('Error renderDayBarChart', e); }
}

// ── Gráfico 2: Daily P&L Performance (#echarts-daily-pnl-premium) ──
function renderDailyPnlPremium() {
  const el = document.getElementById('echarts-daily-pnl-premium');
  if (!el) return;
  try {
    const old = echarts.getInstanceByDom(el);
    if (old) old.dispose();
    const chart = echarts.init(el);
    const { labels, values } = getDailySeries();

    chart.setOption({
      backgroundColor: 'transparent',
      tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, backgroundColor: tooltipBg, borderColor: borderColor, textStyle: { color: tooltipText } },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'category', data: labels, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: textColor, fontSize: 10 } },
      yAxis: { type: 'value', splitLine: { lineStyle: { color: borderColor, type: 'dashed', opacity: 0.5 } }, axisLabel: { color: textColor, fontSize: 10 } },
      series: [{
        type: 'bar', barWidth: '55%',
        itemStyle: { borderRadius: [4, 4, 0, 0], color: p => (p.value || 0) >= 0 ? '#10B981' : '#F43F5E' },
        data: values
      }]
    }, true);
    new ResizeObserver(() => chart.resize()).observe(el);
  } catch (e) { console.error('Error renderDailyPnlPremium', e); }
}

renderDayBarChart();
renderDailyPnlPremium();

  // --- 6. Scatter Plot Durations ---
  const scatterCont = document.getElementById("echarts-scatter-container");
  if (scatterCont) {
    try {
      const scChart = echarts.init(scatterCont);
      const scData = <%= (@trade_durations || []).to_json.html_safe %>;
      const wins = Array.isArray(scData) ? scData.filter(d => d && d.result == 'win').map(d => [Number(d.duration)||0, Number(d.pnl)||0]) : [];
      const loss = Array.isArray(scData) ? scData.filter(d => d && d.result == 'loss').map(d => [Number(d.duration)||0, Number(d.pnl)||0]) : [];
      scChart.setOption({
        tooltip: { trigger: 'item', formatter: (p) => (p.value[0]||0) + ' mins <br> P&L: $' + (p.value[1]||0), backgroundColor: tooltipBg, borderColor: borderColor, textStyle: { color: tooltipText } },
        grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
        xAxis: { type: 'value', name: 'min', splitLine: { show: false }, axisLabel: { color: textColor, fontSize: 9 } },
        yAxis: { type: 'value', splitLine: { lineStyle: { color: borderColor, type: 'dashed' } }, axisLabel: { color: textColor, fontSize: 9 } },
        series: [
          { type: 'scatter', symbolSize: 7, itemStyle: { color: '#10B981' }, data: wins.length ? wins : [[0,0]] },
      { type: 'scatter', symbolSize: 7, itemStyle: { color: '#F43F5E' }, data: loss.length ? loss : [[0,0]] }
        ]
      }, true);
      window.addEventListener('resize', () => scChart && scChart.resize());
    } catch(e) { console.error('Error Scatter Chart', e); }
  }

  // --- 7. Portfolio Overview Donut Chart ---
  const portCont = document.getElementById("echarts-portfolio-doughnut");
  if (portCont) {
    try {
      const portChart = echarts.init(portCont);
      const portData = <%= raw (@dashboard_strategy_stats || []).to_json %>;
      const totalPnl = portData.reduce((acc, curr) => acc + (Number(curr.actual_pnl) || 0), 0);
      const totalStr = totalPnl >= 0 ? "+$" + totalPnl.toLocaleString('en-US',{minimumFractionDigits:2}) : "-$" + Math.abs(totalPnl).toLocaleString('en-US',{minimumFractionDigits:2});
      
      const pColors = ['#8B5CF6', '#34D399', '#FB7185', '#FBBF24'];
      const finalData = portData.map((d, i) => {
        return { value: d.value, name: d.name, itemStyle: { color: pColors[i] } };
      });

      if (finalData.length === 0) {
        finalData.push({ value: 1, name: 'Sin datos', itemStyle: { color: '#475569' } });
      }

      portChart.setOption({
        tooltip: { show: false },
        series: [{
          type: 'pie',
          radius: ['65%', '80%'], // Donut grueso
          center: ['50%', '50%'],
          avoidLabelOverlap: false,
          label: { show: false },
          itemStyle: {
            borderRadius: 14, // Cap roundness a la perfección como en la imagen
            borderColor: isDark ? '#1a1824' : '#ffffff',
            borderWidth: 6
          },
          data: finalData
        }],
        title: {
          text: totalStr,
          subtext: 'All Portfolio',
          left: 'center',
          top: 'center',
          textStyle: { color: isDark ? '#ffffff' : '#0f172a', fontSize: 18, fontFamily: 'League Spartan, Manrope', fontWeight: 900 },
          subtextStyle: { color: isDark ? '#a0a0ab' : '#64748b', fontSize: 12, fontFamily: 'Manrope', fontWeight: 600 }
        }
      }, true);
      window.addEventListener('resize', () => portChart && portChart.resize());
    } catch(e) { console.error('Error Portfolio Chart', e); }
  }

  } // end safeRenderEcharts

  if (typeof requestAnimationFrame !== 'undefined') {
    requestAnimationFrame(safeRenderEcharts);
  } else {
    setTimeout(safeRenderEcharts, 50);
  }
  
  // Turbo integration
  document.addEventListener("turbo:load", safeRenderEcharts, { once: true });
})();
</script>
