<% content_for :page_title do %>
  <div class="flex items-center gap-2.5">
    <span>Dashboard</span>
    <% if @stats[:is_demo] %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 font-extrabold border border-amber-500/30 tracking-wider">MODO DEMO</span>
    <% else %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full <%= @current_mode == 'backtest' ? 'bg-slate-500/15 text-slate-500 dark:text-slate-400 border-slate-500/30' : (@current_mode == 'prop_firm' ? 'bg-brand/15 text-brand border-brand/30' : 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30') %> font-extrabold border tracking-wider flex items-center gap-1">
        <% if @current_mode == 'real_account' %><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><% end %>
        <%= @current_mode.upcase.gsub('_', ' ') %>
      </span>
    <% end %>
  </div>
<% end %>

<div class="space-y-6 fade-in">
  
  <!-- INTERRUPTOR DE PORTAFOLIO GLOBAL Y CUENTAS MULTIPLES -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex p-1 bg-slate-200/50 dark:bg-darkBorder/50 rounded-xl w-max border border-slate-300/50 dark:border-darkBorder max-w-full overflow-x-auto snap-x hide-scrollbar">
      <%= link_to dashboard_path(mode: 'real_account'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'real_account' ? 'bg-white dark:bg-slate-700 text-emerald-500 shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">account_balance_wallet</span> Cuenta Personal
      <% end %>
      <%= link_to dashboard_path(mode: 'prop_firm'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'prop_firm' ? 'bg-white dark:bg-slate-700 text-brand shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">verified</span> Fondeo (FTMO/Apex)
      <% end %>
      <%= link_to dashboard_path(mode: 'backtest'), class: "snap-center py-1.5 px-4 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 #{@current_mode == 'backtest' ? 'bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white'}" do %>
        <span class="material-symbols-outlined text-[16px]">history</span> Backtest
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="text-xl font-bold dark:text-white text-slate-900">Dashboard de Rendimiento</h2>
    <p class="text-xs text-slate-400 mt-1">Visión integral cuantitativa de tus operaciones, estadísticas clave y calendario.</p>
  </div>

  <!-- FILA 1: KPI CARDS (Balance, Win%, Profit Factor, Avg W/L, Expectancy) -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    
    <!-- Balance & P&L -->
    <div class="glass rounded-xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Balance & P&L</span>
        <span class="material-symbols-outlined text-emerald-500 text-[18px]">payments</span>
      </div>
      <div>
        <p class="text-2xl font-black font-mono <%= @stats[:total_pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
          <%= @stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(@stats[:total_pnl], precision: 2, delimiter: ',') %>
        </p>
        <p class="text-[11px] text-slate-400 mt-1">P&L Neto Acumulado</p>
      </div>
    </div>

    <!-- Trade Win % -->
    <div class="glass rounded-xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Trade Win %</span>
        <span class="material-symbols-outlined text-brand text-[18px]">check_circle</span>
      </div>
      <div class="flex items-center gap-3">
        <div id="mini-gauge-winrate" class="w-12 h-12 flex-shrink-0"></div>
        <div>
          <p class="text-2xl font-black font-mono dark:text-white text-slate-800"><%= @stats[:win_rate] %>%</p>
          <div class="flex items-center gap-2 text-[10px] mt-0.5">
            <span class="text-emerald-500 font-bold"><%= @stats[:winning_trades] %>W</span>
            <span class="text-rose-500 font-bold"><%= @stats[:losing_trades] %>L</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Profit Factor -->
    <div class="glass rounded-xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Profit Factor</span>
        <span class="material-symbols-outlined text-cyan-400 text-[18px]">balance</span>
      </div>
      <div>
        <p class="text-2xl font-black font-mono text-cyan-400"><%= @stats[:profit_factor] %></p>
        <p class="text-[11px] text-slate-400 mt-1">Ratio Beneficio/Pérdida</p>
      </div>
    </div>

    <!-- Avg Win / Loss -->
    <div class="glass rounded-xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Avg Win/Loss</span>
        <span class="material-symbols-outlined text-amber-400 text-[18px]">award_star</span>
      </div>
      <div>
        <p class="text-2xl font-black font-mono text-amber-400"><%= @stats[:rr_ratio] %> R</p>
        <div class="flex items-center justify-between text-[10px] font-mono mt-1">
          <span class="text-emerald-500 font-bold">+$<%= number_with_precision(@stats[:avg_win], precision: 0) %></span>
          <span class="text-rose-500 font-bold">-$<%= number_with_precision(@stats[:avg_loss], precision: 0) %></span>
        </div>
      </div>
    </div>

    <!-- Trade Expectancy -->
    <div class="glass rounded-xl p-4 flex flex-col justify-between h-full col-span-2 md:col-span-1">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Trade Expectancy</span>
        <span class="material-symbols-outlined text-indigo-400 text-[18px]">moving</span>
      </div>
      <div>
        <p class="text-2xl font-black font-mono <%= @stats[:expectancy].to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
          <%= @stats[:expectancy].to_f >= 0 ? '+' : '' %>$<%= number_with_precision(@stats[:expectancy].to_f, precision: 2) %>
        </p>
        <p class="text-[11px] text-slate-400 mt-1">Expectativa matemática por trade</p>
      </div>
    </div>

  </div>

  <!-- FILA 2: GRÁFICOS PRINCIPALES (Curva P&L, Drawdown, AI Score Radar) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Curva de P&L -->
    <div class="glass rounded-2xl p-4 md:p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-500 text-[18px]">ssid_chart</span> Curva de P&L Acumulado
        </h3>
        <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">Crecimiento</span>
      </div>
      <div id="echarts-equity-container" class="w-full h-52"></div>
    </div>
    
    <!-- Drawdown -->
    <div class="glass rounded-2xl p-4 md:p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-rose-500 text-[18px]">water_drop</span> Drawdown Temporal
        </h3>
        <span class="text-[10px] px-2 py-0.5 rounded bg-rose-500/10 text-rose-500 font-bold">Riesgo</span>
      </div>
      <div id="echarts-drawdown-container" class="w-full h-52"></div>
    </div>

    <!-- AI Coach Score Radar -->
    <div class="glass rounded-2xl p-4 md:p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-brand text-[18px]">radar</span> Coach Score AI
        </h3>
        <span class="text-[10px] px-2 py-0.5 rounded bg-brand/10 text-brand font-bold">Diagnóstico</span>
      </div>
      <div id="echarts-radar-container" class="w-full h-44"></div>
      <div class="mt-auto pt-2 flex items-center justify-between border-t dark:border-darkBorder border-slate-200">
        <span class="text-[11px] font-bold text-slate-400">PUNTAJE GLOBAL</span>
        <span class="text-xl font-black font-mono text-brand">85 / 100</span>
      </div>
    </div>
  </div>

  <!-- FILA 3: Daily PNL / Duration / Trades Recientes -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Daily P&L -->
    <div class="glass rounded-2xl p-4 md:p-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-500 text-[18px]">bar_chart</span> P&L por Día
        </h3>
      </div>
      <div id="echarts-bar-day-container" class="w-full h-48"></div>
    </div>

    <!-- Trade Duration Scatter -->
    <div class="glass rounded-2xl p-4 md:p-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-cyan-400 text-[18px]">timer</span> Duración vs Resultado (Mins)
        </h3>
      </div>
      <div id="echarts-scatter-container" class="w-full h-48"></div>
    </div>

    <!-- Trades Recientes -->
    <div class="glass rounded-2xl p-4 md:p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-amber-400 text-[18px]">list_alt</span> Últimas Operaciones
        </h3>
        <%= link_to trades_path, class: "text-[11px] font-bold text-brand hover:underline" do %>
          Ver Todo
        <% end %>
      </div>
      <div class="flex-1 overflow-y-auto space-y-2">
        <% if @recent_trades.any? %>
          <% @recent_trades.each do |t| %>
            <%= link_to trade_path(t), class: "flex items-center justify-between p-2.5 rounded-xl dark:bg-darkCard bg-slate-50 hover:bg-slate-100 dark:hover:bg-darkHover transition border dark:border-darkBorder border-slate-200" do %>
              <div class="flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-black text-white <%= t.direction == 'LONG' ? 'bg-emerald-500' : 'bg-rose-500' %>">
                  <%= t.direction[0] %>
                </span>
                <div>
                  <p class="text-xs font-black dark:text-white text-slate-800"><%= t.symbol %></p>
                  <p class="text-[10px] text-slate-400"><%= t.entry_at&.strftime("%d/%m %H:%M") %></p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-xs font-black font-mono <%= t.pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                  <%= t.pnl >= 0 ? '+' : '' %>$<%= number_with_precision(t.pnl, precision: 2) %>
                </p>
                <span class="text-[9px] font-mono text-slate-400 font-bold"><%= t.r_multiple || 0 %>R</span>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="text-center py-8 text-xs text-slate-400">
            <p>Sin operaciones registradas aún.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- FILA 4: CALENDARIO DE TRADING ACTIVOS & RACHAS -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Mini Heatmap Calendario del Mes -->
    <div class="lg:col-span-3 glass rounded-2xl p-4 md:p-5 flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-brand text-[18px]">calendar_month</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Calendario Térmico Mensual</h3>
        </div>
        <%= link_to calendar_path, class: "text-[11px] font-bold text-brand hover:underline flex items-center gap-1" do %>
          Vista Calendario Completa <span class="material-symbols-outlined text-[14px]">open_in_new</span>
        <% end %>
      </div>

      <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">
        <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div class="text-brand">Sáb</div><div class="text-brand">Dom</div>
      </div>
      
      <div class="grid grid-cols-7 gap-1.5 flex-1">
        <% 
          today = Date.current
          start_d = today.beginning_of_month.beginning_of_week(:monday)
          end_d = today.end_of_month.end_of_week(:sunday)
          (start_d..end_d).each do |date|
            has_trades = @daily_pnl_map.key?(date)
            pnl = @daily_pnl_map[date] || 0
            is_current_m = date.month == today.month
            
            card_class = if !is_current_m
              "opacity-25 dark:bg-darkCard bg-slate-100 text-slate-400"
            elsif has_trades
              pnl >= 0 ? "bg-emerald-500/15 border border-emerald-500/30 text-emerald-500 font-bold" : "bg-rose-500/15 border border-rose-500/30 text-rose-500 font-bold"
            else
              "dark:bg-darkCard/60 bg-slate-100/60 text-slate-400 hover:border-brand/30"
            end
        %>
          <%= link_to calendar_path(month: date.strftime('%Y-%m')), class: "min-h-[42px] p-1 rounded-xl border transition flex flex-col justify-between #{card_class} #{date == today ? 'ring-2 ring-brand' : ''}" do %>
            <span class="text-[9px] font-black"><%= date.day %></span>
            <% if has_trades %>
              <span class="text-[8px] font-mono font-bold truncate self-end"><%= pnl >= 0 ? '+' : '' %>$<%= pnl.round %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Rachas y Estadísticas Rápidas -->
    <div class="flex flex-col gap-4">
      <div class="glass rounded-2xl p-4 flex-1 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-brand text-[16px]">bolt</span> Racha Actual
          </h3>
          <span class="text-[10px] font-bold text-slate-400">Días</span>
        </div>
        <div class="text-center py-2">
          <p class="text-3xl font-black font-mono <%= @current_streak_type == :win ? 'text-emerald-500' : (@current_streak_type == :loss ? 'text-rose-500' : 'text-slate-400') %>">
            <%= @current_streak_type == :win ? '+' : (@current_streak_type == :loss ? '-' : '') %><%= @current_streak %>
          </p>
          <p class="text-[10px] text-slate-400 mt-1 uppercase tracking-wider font-bold">
            <%= @current_streak_type == :win ? 'Días Verdes Racha' : (@current_streak_type == :loss ? 'Días Rojos Racha' : 'Sin racha') %>
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2 pt-3 border-t dark:border-darkBorder border-slate-200 text-center">
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">Máx Racha V</p>
            <p class="text-sm font-black text-emerald-500 font-mono"><%= @stats[:max_win_streak] %></p>
          </div>
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">Máx Racha R</p>
            <p class="text-sm font-black text-rose-500 font-mono"><%= @stats[:max_loss_streak] %></p>
          </div>
        </div>
      </div>

      <!-- Quick AI Diagnostic -->
      <div class="glass rounded-2xl p-4 flex-1 flex flex-col justify-between bg-brand/5 border-brand/20">
        <div class="flex items-center gap-1.5 text-brand">
          <span class="material-symbols-outlined text-[16px]">smart_toy</span>
          <span class="text-[10px] font-bold uppercase tracking-wider">Flash AI Coach</span>
        </div>
        <p class="text-xs dark:text-slate-200 text-slate-700 font-medium my-2 italic">
          "<%= @ai_diagnosis %>"
        </p>
        <%= link_to ai_coach_path, class: "text-[10px] font-bold text-brand hover:underline self-end flex items-center gap-1" do %>
          Consultar Coach <span class="material-symbols-outlined text-[12px]">chevron_right</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- FILA 5: ANALYTICS POR HORA, DÍA Y TICKER -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
    <!-- Por Hora -->
    <div class="glass rounded-2xl p-4 md:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-brand text-[16px]">schedule</span> Rendimiento por Hora
      </h3>
      <div class="space-y-2 max-h-[200px] overflow-y-auto pr-1">
        <% @pnl_by_hour.each do |hour, data| %>
          <div class="flex items-center justify-between text-xs">
            <span class="font-mono text-slate-400 text-[11px]"><%= hour %></span>
            <div class="flex-1 mx-3 h-2 rounded-full bg-slate-200 dark:bg-darkBorder overflow-hidden">
              <div class="h-full <%= data[:pnl] >= 0 ? 'bg-emerald-500' : 'bg-rose-500' %>" style="width: <%= [(data[:pnl].abs / 500.0) * 100, 100].min %>%"></div>
            </div>
            <span class="font-mono font-bold <%= data[:pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
              <%= data[:pnl] >= 0 ? '+' : '' %>$<%= data[:pnl].round %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Por Ticker -->
    <div class="glass rounded-2xl p-4 md:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-brand text-[16px]">candlestick_chart</span> Rendimiento por Ticker
      </h3>
      <div class="space-y-2 max-h-[200px] overflow-y-auto pr-1">
        <% @pnl_by_ticker.first(5).each do |sym, data| %>
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold dark:text-white text-slate-800 text-[11px] font-mono"><%= sym %></span>
            <div class="flex-1 mx-3 h-2 rounded-full bg-slate-200 dark:bg-darkBorder overflow-hidden">
              <div class="h-full <%= data[:pnl] >= 0 ? 'bg-emerald-500' : 'bg-rose-500' %>" style="width: <%= [(data[:pnl].abs / 1000.0) * 100, 100].min %>%"></div>
            </div>
            <span class="font-mono font-bold <%= data[:pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
              <%= data[:pnl] >= 0 ? '+' : '' %>$<%= data[:pnl].round %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Resumen de Estrategias -->
    <div class="glass rounded-2xl p-4 md:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-brand text-[16px]">target</span> Estrategias Clave
      </h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold dark:text-slate-300 text-slate-700">Breakout VWAP</span>
          <span class="font-mono font-bold text-emerald-500">+$1,450.00</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold dark:text-slate-300 text-slate-700">Reversión Smart Money</span>
          <span class="font-mono font-bold text-emerald-500">+$820.00</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold dark:text-slate-300 text-slate-700">Scalping 1M</span>
          <span class="font-mono font-bold text-rose-500">-$360.00</span>
        </div>
      </div>
    </div>
  </div>

  <!-- FILA 6: CALENDARIO ANUAL -->
  <div class="glass rounded-2xl p-4 md:p-5 overflow-x-auto">
    <div class="flex items-center justify-between mb-3 min-w-[650px]">
      <h3 class="text-sm font-bold dark:text-white text-slate-800 flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[18px]">calendar_today</span> Calendario Anual de Rendimiento (<%= Time.current.year %>)
      </h3>
      <span class="text-[10px] font-mono text-slate-400">P&L Neto por Mes</span>
    </div>
    
    <table class="w-full text-xs text-center min-w-[650px]">
      <thead>
        <tr class="text-slate-400 font-bold text-[10px] uppercase tracking-wider border-b dark:border-darkBorder border-slate-200">
          <th class="py-2 text-left">Año</th>
          <% %w[Ene Feb Mar Abr May Jun Jul Ago Sep Oct Nov Dic].each do |m| %>
            <th class="py-2"><%= m %></th>
          <% end %>
          <th class="py-2 text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        <tr class="font-mono border-b dark:border-darkBorder/40 border-slate-100">
          <td class="py-3 text-left font-bold dark:text-white"><%= Time.current.year %></td>
          <% @annual_stats.each do |pnl| %>
            <% if pnl == 0 %>
              <td class="py-3 text-slate-500/40">—</td>
            <% else %>
              <td class="py-3 font-bold <%= pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                <%= pnl >= 0 ? '+' : '' %>$<%= pnl.abs >= 1000 ? "#{(pnl/1000.0).round(1)}K" : pnl.round %>
              </td>
            <% end %>
          <% end %>
          <td class="py-3 text-right font-black <%= @annual_total >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
            <%= @annual_total >= 0 ? '+' : '' %>$<%= @annual_total.abs >= 1000 ? "#{(@annual_total/1000.0).round(1)}K" : @annual_total.round %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</div>

<!-- INITIALIZATION OF ECHARTS -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const isDark = document.getElementById("html-root").classList.contains("dark");
  const textColor = isDark ? "#9DA3B4" : "#64748B";
  const borderColor = isDark ? "#23263A" : "#E3E6EF";

  // 1. Equity Curve
  const eqCont = document.getElementById("echarts-equity-container");
  if(eqCont) {
    const eqChart = echarts.init(eqCont);
    const data = <%= @equity_data.to_json.html_safe %>;
    eqChart.setOption({
      tooltip: { trigger: 'axis', backgroundColor: isDark ? '#151724' : '#FFF', borderColor },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'category', data: data.map(d=>d.trade || d.date), axisLine:{lineStyle:{color:borderColor}}, axisLabel:{color:textColor, fontSize:10} },
      yAxis: { type: 'value', splitLine:{lineStyle:{color:borderColor, type:'dashed'}}, axisLabel:{color:textColor, fontSize:10} },
      series: [{
        type: 'line', smooth: true, symbol: 'none',
        areaStyle: { color: new echarts.graphic.LinearGradient(0,0,0,1, [{offset:0, color:'rgba(16,185,129,0.35)'},{offset:1, color:'rgba(16,185,129,0)'}]) },
        lineStyle: { width: 2.5, color: '#10B981' },
        itemStyle: { color: '#10B981' },
        data: data.map(d=>d.value)
      }]
    });
    window.addEventListener('resize', ()=>eqChart.resize());
  }

  // 2. Drawdown Chart
  const ddCont = document.getElementById("echarts-drawdown-container");
  if(ddCont) {
    const ddChart = echarts.init(ddCont);
    const data = <%= @equity_data.to_json.html_safe %>;
    let peak = 0;
    const ddData = data.map(d => {
       if(d.value > peak) peak = d.value;
       return { name: d.trade||d.date, value: d.value - peak };
    });
    ddChart.setOption({
      tooltip: { trigger: 'axis', backgroundColor: isDark ? '#151724' : '#FFF', borderColor },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'category', data: ddData.map(d=>d.name), axisLine:{lineStyle:{color:borderColor}}, axisLabel:{show:false} },
      yAxis: { type: 'value', splitLine:{lineStyle:{color:borderColor, type:'dashed'}}, axisLabel:{color:textColor, fontSize:10} },
      series: [{
        type: 'line', smooth: true, symbol: 'none',
        areaStyle: { color: new echarts.graphic.LinearGradient(0,0,0,1, [{offset:0, color:'rgba(244,63,94,0.35)'},{offset:1, color:'rgba(244,63,94,0)'}]) },
        lineStyle: { width: 2, color: '#F43F5E' },
        itemStyle: { color: '#F43F5E' },
        data: ddData.map(d=>d.value)
      }]
    });
    window.addEventListener('resize', ()=>ddChart.resize());
  }

  // 3. Radar Chart
  const radarCont = document.getElementById("echarts-radar-container");
  if(radarCont) {
    const rChart = echarts.init(radarCont);
    rChart.setOption({
      radar: {
        indicator: [ {name:'Win Rate', max:100}, {name:'Profit Factor', max:5}, {name:'R:R Ratio', max:5}, {name:'Gestión Riesgo', max:100}, {name:'Disciplina', max:100} ],
        radius: '60%', center:['50%','50%'], splitArea:{show:false}, splitLine:{lineStyle:{color:borderColor}}, axisName:{color:textColor, fontSize:9}
      },
      series: [{
        type: 'radar',
        data: [
          { value: [<%= @stats[:win_rate] %>, <%= [@stats[:profit_factor].to_f, 5].min %>, <%= [@stats[:rr_ratio].to_f, 5].min %>, 88, 92], itemStyle:{color:'#6C5CE7'}, areaStyle:{color:'rgba(108,92,231,0.35)'} }
        ]
      }]
    });
    window.addEventListener('resize', ()=>rChart.resize());
  }

  // 4. Daily P&L Bar
  const dayCont = document.getElementById("echarts-bar-day-container");
  if(dayCont) {
    const dayChart = echarts.init(dayCont);
    const dailyData = <%= @pnl_by_day.to_json.html_safe %>;
    dayChart.setOption({
      tooltip: { trigger: 'axis', axisPointer: {type: 'shadow'}, backgroundColor: isDark ? '#151724' : '#FFF' },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'category', data: Object.keys(dailyData).map(d => d.slice(5)), axisLine:{lineStyle:{color:borderColor}}, axisLabel:{color:textColor, fontSize:9} },
      yAxis: { type: 'value', splitLine:{lineStyle:{color:borderColor, type:'dashed'}}, axisLabel:{color:textColor, fontSize:9} },
      series: [{
        type: 'bar', barWidth: '40%',
        itemStyle: { borderRadius: [3,3,0,0], color: (p) => p.value>=0 ? '#10B981' : '#F43F5E' },
        data: Object.values(dailyData)
      }]
    });
    window.addEventListener('resize', ()=>dayChart.resize());
  }

  // 5. Scatter Plot Durations
  const scatterCont = document.getElementById("echarts-scatter-container");
  if(scatterCont) {
    const scChart = echarts.init(scatterCont);
    const scData = <%= @trade_durations.to_json.html_safe %>;
    const wins = scData.filter(d=>d.result=='win').map(d=>[d.duration, d.pnl]);
    const loss = scData.filter(d=>d.result=='loss').map(d=>[d.duration, d.pnl]);
    scChart.setOption({
      tooltip: { trigger:'item', formatter: (p) => p.value[0]+' mins <br> P&L: $'+p.value[1], backgroundColor: isDark ? '#151724' : '#FFF' },
      grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
      xAxis: { type: 'value', name: 'min', splitLine:{show:false}, axisLabel:{color:textColor, fontSize:9} },
      yAxis: { type: 'value', splitLine:{lineStyle:{color:borderColor, type:'dashed'}}, axisLabel:{color:textColor, fontSize:9} },
      series: [
        { type: 'scatter', symbolSize: 7, itemStyle: {color:'#10B981'}, data: wins },
        { type: 'scatter', symbolSize: 7, itemStyle: {color:'#F43F5E'}, data: loss }
      ]
    });
    window.addEventListener('resize', ()=>scChart.resize());
  }
  
  // 6. Mini Gauge WinRate
  const miniGaugeEl = document.getElementById('mini-gauge-winrate');
  if(miniGaugeEl) {
    const gW = echarts.init(miniGaugeEl);
    gW.setOption({ series:[{ type:'gauge', startAngle:90, endAngle:-270, pointer:{show:false}, progress:{show:true, overlap:false, roundCap:true, clip:false, itemStyle:{color:'#10B981'}}, axisLine:{lineStyle:{width:5, color:[[1, borderColor]]}}, splitLine:{show:false}, axisTick:{show:false}, axisLabel:{show:false}, detail:{show:false}, data:[{value: <%= @stats[:win_rate] %>}] }] });
  }
});
</script>
