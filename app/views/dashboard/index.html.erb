      <%
        total_actual_pnl = @dashboard_strategy_stats.sum { |s| s[:actual_pnl].to_f }
        formatted_total = total_actual_pnl >= 0 ? "+$#{number_with_precision(total_actual_pnl, precision: 2, delimiter: ',')}" : "-$#{number_with_precision(total_actual_pnl.abs, precision: 2, delimiter: ',')}"
