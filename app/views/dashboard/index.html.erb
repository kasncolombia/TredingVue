<% content_for :page_title do %>
  <div class="flex items-center gap-2.5">
    <span>Dashboard</span>
    <% if @stats[:is_demo] %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 font-extrabold border border-amber-500/30 tracking-wider">MODO DEMO</span>
    <% else %>
      <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-extrabold border border-emerald-500/30 tracking-wider flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        REAL EN VIVO
      </span>
    <% end %>
  </div>
<% end %>

<div class="space-y-6 fade-in">

  <!-- ===================== STATUS BANNER (DEMO VS REAL) ===================== -->
  <% if @stats[:is_demo] %>
    <div class="rounded-2xl p-4 bg-gradient-to-r from-amber-500/10 via-brand/10 to-amber-500/10 border border-amber-500/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 shadow-lg">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 animate-pulse">
          <span class="material-symbols-outlined text-[22px]">visibility</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-xs md:text-sm font-extrabold dark:text-white text-slate-900 uppercase tracking-wider">Modo Demostración Activo</h4>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30">DATOS DE MUESTRA</span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Estás viendo una simulación comercial pre-cargada. En cuanto agregues tu primera operación, el sistema calculará tus estadísticas reales automáticamente.
          </p>
        </div>
      </div>
      <%= link_to new_trade_path, class: "px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition-all flex-shrink-0 shadow-md" do %>
        <span class="material-symbols-outlined text-[16px]">add_circle</span>
        <span>Crear Primera Operación Real</span>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl p-3.5 bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></div>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-xs font-bold dark:text-emerald-300 text-emerald-700 uppercase tracking-wider">Métricas Reales en Vivo</h4>
            <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">CUENTA REAL</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-0.5">
            Calculado en tiempo real desde <strong><%= @stats[:total_trades] %></strong> operaciones registradas en tu diario.
          </p>
        </div>
      </div>
      <div class="hidden sm:flex items-center gap-2">
        <%= link_to new_trade_path, class: "px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 text-xs font-bold transition-all border border-emerald-500/30 flex items-center gap-1" do %>
          <span class="material-symbols-outlined text-[15px]">add</span>
          <span>Nueva Operación</span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- ===================== LIVE TICKER STRIP ===================== -->
  <div class="glass rounded-2xl p-3 flex items-center justify-between gap-4 overflow-x-auto">
    <div class="flex items-center gap-6 min-w-max text-xs">
      <div class="flex items-center gap-2">
        <span class="font-black dark:text-white text-slate-800">NQ1!</span>
        <span class="font-mono text-accent-green">19,842.50</span>
        <span class="text-[10px] text-accent-green bg-accent-green/10 px-1.5 py-0.5 rounded font-bold">+1.24%</span>
      </div>
      <div class="w-px h-4 bg-slate-300 dark:bg-darkBorder"></div>
      <div class="flex items-center gap-2">
        <span class="font-black dark:text-white text-slate-800">EUR/USD</span>
        <span class="font-mono dark:text-slate-200 text-slate-700">1.0845</span>
        <span class="text-[10px] text-loss bg-loss/10 px-1.5 py-0.5 rounded font-bold">-0.18%</span>
      </div>
      <div class="w-px h-4 bg-slate-300 dark:bg-darkBorder"></div>
      <div class="flex items-center gap-2">
        <span class="font-black dark:text-white text-slate-800">BTC/USD</span>
        <span class="font-mono text-accent-green">64,120.00</span>
        <span class="text-[10px] text-accent-green bg-accent-green/10 px-1.5 py-0.5 rounded font-bold">+3.80%</span>
      </div>
      <div class="w-px h-4 bg-slate-300 dark:bg-darkBorder"></div>
      <div class="flex items-center gap-2">
        <span class="font-black dark:text-white text-slate-800">XAU/USD</span>
        <span class="font-mono text-accent-green">2,512.40</span>
        <span class="text-[10px] text-accent-green bg-accent-green/10 px-1.5 py-0.5 rounded font-bold">+0.45%</span>
      </div>
    </div>
    <div class="hidden md:flex items-center gap-2 text-[11px] text-slate-400 font-medium">
      <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span> Sincronizado en tiempo real
    </div>
  </div>

  <!-- ===================== TOP KPI CARDS ===================== -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- P&L ACUMULADO -->
    <div class="stat-card rounded-2xl p-4 md:p-5 relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">P&L Acumulado</span>
        <div class="w-8 h-8 rounded-xl bg-accent-green/15 text-accent-green flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">payments</span>
        </div>
      </div>
      <p class="text-2xl md:text-3xl font-black mt-2 font-mono <%= pnl_class(@stats[:total_pnl]) %>">
        <%= @stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(@stats[:total_pnl], precision: 2, delimiter: ',') %>
      </p>
      <div class="flex items-center justify-between mt-2 text-[11px]">
        <span class="<%= @stats[:pnl_change_pct] >= 0 ? 'text-accent-green' : 'text-loss' %> font-bold flex items-center gap-0.5">
          <span class="material-symbols-outlined text-[14px]"><%= @stats[:pnl_change_pct] >= 0 ? 'arrow_upward' : 'arrow_downward' %></span>
          <%= @stats[:pnl_change_pct] >= 0 ? '+' : '' %><%= @stats[:pnl_change_pct] %>%
        </span>
        <span class="text-slate-400"><%= @stats[:total_trades] %> trades</span>
      </div>
    </div>

    <!-- WIN RATE -->
    <div class="stat-card rounded-2xl p-4 md:p-5 relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Win Rate</span>
        <div class="w-8 h-8 rounded-xl bg-brand/15 text-brand flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </div>
      </div>
      <p class="text-2xl md:text-3xl font-black mt-2 font-mono dark:text-white text-slate-900">
        <%= @stats[:win_rate] %>%
      </p>
      <div class="flex items-center justify-between mt-2 text-[11px]">
        <span class="text-slate-400"><%= @stats[:winning_trades] %>W / <%= @stats[:losing_trades] %>L</span>
        <span class="text-brand font-bold">Objetivo: 65%</span>
      </div>
    </div>

    <!-- PROFIT FACTOR -->
    <div class="stat-card rounded-2xl p-4 md:p-5 relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Profit Factor</span>
        <div class="w-8 h-8 rounded-xl bg-violet-500/15 text-violet-500 flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">balance</span>
        </div>
      </div>
      <p class="text-2xl md:text-3xl font-black mt-2 font-mono text-violet-400">
        <%= @stats[:profit_factor] %>
      </p>
      <div class="flex items-center justify-between mt-2 text-[11px]">
        <span class="text-slate-400">Ganancia / Pérdida</span>
        <span class="text-accent-green font-bold">Saludable (>1.5)</span>
      </div>
    </div>

    <!-- PROMEDIO WIN / LOSS -->
    <div class="stat-card rounded-2xl p-4 md:p-5 relative overflow-hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Ratio R:R Prom.</span>
        <div class="w-8 h-8 rounded-xl bg-amber-500/15 text-amber-500 flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">award_star</span>
        </div>
      </div>
      <p class="text-2xl md:text-3xl font-black mt-2 font-mono text-amber-400">
        <%= @stats[:rr_ratio] %> R
      </p>
      <div class="flex items-center justify-between mt-2 text-[11px]">
        <span class="text-accent-green font-bold">Win: +$<%= number_with_precision(@stats[:avg_win] || 0, precision: 0) %></span>
        <span class="text-loss font-bold">Loss: -$<%= number_with_precision(@stats[:avg_loss] || 0, precision: 0) %></span>
      </div>
    </div>
  </div>

  <!-- ===================== MAIN CHARTS SECTION (ECHARTS) ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- EQUITY CURVE (ECHARTS 2 COLS) -->
    <div class="lg:col-span-2 glass rounded-2xl p-5 md:p-6 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
        <div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand text-[20px]">show_chart</span>
            <h3 class="text-base font-extrabold dark:text-white text-slate-900">Curva de Equity Acumulada</h3>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">Evolución de capital trade a trade</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs px-2.5 py-1 rounded-lg bg-accent-green/10 text-accent-green font-bold border border-accent-green/20">
            Peak: +$<%= number_with_precision(@stats[:total_pnl], precision: 0) %>
          </span>
        </div>
      </div>

      <!-- ECHARTS CONTAINER -->
      <div id="echarts-equity-container" class="w-full h-72"></div>
    </div>

    <!-- WIN/LOSS DONUT + QUICK DIAGNOSIS (1 COL) -->
    <div class="space-y-6 flex flex-col">

      <!-- DONUT CHART (ECHARTS) -->
      <div class="glass rounded-2xl p-5 flex-1 flex flex-col">
        <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder mb-3">
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Distribución W / L</h3>
          <span class="text-[11px] text-slate-400"><%= @stats[:total_trades] %> Operaciones</span>
        </div>
        <div id="echarts-donut-container" class="w-full h-48 my-auto"></div>
        <div class="grid grid-cols-2 gap-2 text-center text-xs pt-2 border-t dark:border-darkBorder border-lightBorder">
          <div class="p-2 rounded-xl bg-accent-green/10">
            <p class="text-[10px] text-slate-400">Ganadoras</p>
            <p class="font-extrabold text-accent-green text-sm"><%= @stats[:winning_trades] %></p>
          </div>
          <div class="p-2 rounded-xl bg-loss/10">
            <p class="text-[10px] text-slate-400">Perdedoras</p>
            <p class="font-extrabold text-loss text-sm"><%= @stats[:losing_trades] %></p>
          </div>
        </div>
      </div>

      <!-- AI DIAGNOSIS BANNER -->
      <div class="glass rounded-2xl p-5 border-l-4 border-brand">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand text-[20px]">smart_toy</span>
            <span class="text-xs font-bold dark:text-white text-slate-900">AI Coach Diagnosis</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded bg-brand/10 text-brand font-bold">PRO</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
          "<%= @ai_diagnosis %>"
        </p>
        <%= link_to ai_coach_path, class: "w-full py-2 px-3 rounded-xl bg-brand/15 hover:bg-brand/25 text-brand dark:text-brand-light text-xs font-bold border border-brand/20 transition-all flex items-center justify-center gap-1.5" do %>
          <span>Consultar Diagnóstico Completo</span>
          <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
        <% end %>
      </div>

    </div>
  </div>

  <!-- ===================== SECOND ROW: P&L BY DAY & RECENT TRADES ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- DAILY P&L BAR CHART (ECHARTS 1 COL) -->
    <div class="glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <div>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">P&L por Día de Semana</h3>
          <p class="text-[11px] text-slate-400">Rendimiento por jornada laboral</p>
        </div>
      </div>
      <div id="echarts-bar-day-container" class="w-full h-64"></div>
    </div>

    <!-- RECENT TRADES TABLE (2 COLS) -->
    <div class="lg:col-span-2 glass rounded-2xl p-5 space-y-4 flex flex-col justify-between">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-brand text-[20px]">swap_horiz</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Operaciones Recientes</h3>
        </div>
        <%= link_to trades_path, class: "text-xs font-bold text-brand hover:underline flex items-center gap-1" do %>
          <span>Ver todas</span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <% end %>
      </div>

      <!-- TABLE CONTAINER -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="table-header text-slate-400 border-b dark:border-darkBorder border-lightBorder">
              <th class="py-2.5 px-3 rounded-l-xl">Símbolo</th>
              <th class="py-2.5 px-3">Dirección</th>
              <th class="py-2.5 px-3">Entrada / Salida</th>
              <th class="py-2.5 px-3">R-Multiple</th>
              <th class="py-2.5 px-3 text-right rounded-r-xl">P&L Neto</th>
            </tr>
          </thead>
          <tbody class="divide-y dark:divide-darkBorder divide-lightBorder">
            <% if @recent_trades.present? %>
              <% @recent_trades.each do |t| %>
                <tr class="table-row-hover transition-colors cursor-pointer" onclick="window.location.href='<%= trade_path(t) %>'">
                  <td class="py-3 px-3 font-bold dark:text-white text-slate-800">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full <%= t.pnl >= 0 ? 'bg-accent-green' : 'bg-loss' %>"></span>
                      <span><%= t.symbol %></span>
                    </div>
                  </td>
                  <td class="py-3 px-3">
                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold <%= t.direction == 'LONG' ? 'badge-long' : 'badge-short' %>">
                      <%= t.direction %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-slate-400 font-mono">
                    $<%= t.entry_price %> → $<%= t.exit_price || '—' %>
                  </td>
                  <td class="py-3 px-3 font-bold font-mono <%= t.r_multiple.to_f >= 0 ? 'text-accent-green' : 'text-loss' %>">
                    <%= t.r_multiple ? "#{t.r_multiple}R" : '—' %>
                  </td>
                  <td class="py-3 px-3 text-right font-black font-mono <%= pnl_class(t.pnl) %>">
                    <%= t.pnl >= 0 ? '+' : '' %>$<%= number_with_precision(t.pnl, precision: 2) %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="py-8 text-center text-slate-400">
                  No hay operaciones registradas todavía. ¡Haz clic en <strong>Nueva</strong> para comenzar tu diario!
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>

</div>

<!-- ===================== ECHARTS INITIALIZATION SCRIPT ===================== -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const isDark = document.getElementById("html-root").classList.contains("dark");
  const textColor = isDark ? "#9DA3B4" : "#64748B";
  const borderColor = isDark ? "#23263A" : "#E3E6EF";

  // 1. EQUITY CURVE (ECHARTS)
  const equityContainer = document.getElementById("echarts-equity-container");
  if (equityContainer) {
    const equityChart = echarts.init(equityContainer);
    const rawData = <%= @equity_data.to_json.html_safe %>;
    const xAxisData = rawData.map(d => d.trade || d.date);
    const seriesData = rawData.map(d => d.value);

    const equityOption = {
      tooltip: {
        trigger: "axis",
        backgroundColor: isDark ? "#151724" : "#FFFFFF",
        borderColor: borderColor,
        textStyle: { color: isDark ? "#FFFFFF" : "#0F0E1A", fontFamily: "Manrope" },
        formatter: function(params) {
          const item = params[0];
          const color = item.value >= 0 ? '#10B981' : '#F43F5E';
          return `<strong>${item.name}</strong><br/>Equity Acumulada: <span style="color:${color};font-weight:bold">$${item.value}</span>`;
        }
      },
      grid: { left: "3%", right: "3%", bottom: "3%", top: "8%", containLabel: true },
      xAxis: {
        type: "category",
        data: xAxisData,
        axisLine: { lineStyle: { color: borderColor } },
        axisLabel: { color: textColor, fontFamily: "Manrope", fontSize: 11 }
      },
      yAxis: {
        type: "value",
        axisLine: { show: false },
        splitLine: { lineStyle: { color: borderColor, type: "dashed" } },
        axisLabel: { color: textColor, fontFamily: "Manrope", fontSize: 11, formatter: "${value}" }
      },
      series: [{
        name: "Equity",
        type: "line",
        smooth: true,
        symbolSize: 8,
        itemStyle: { color: "#10B981" },
        lineStyle: { width: 3, color: "#10B981" },
        areaStyle: {
          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
            { offset: 0, color: "rgba(16, 185, 129, 0.4)" },
            { offset: 1, color: "rgba(16, 185, 129, 0.0)" }
          ])
        },
        data: seriesData
      }]
    };
    equityChart.setOption(equityOption);
    window.addEventListener("resize", () => equityChart.resize());
  }

  // 2. DONUT W/L (ECHARTS)
  const donutContainer = document.getElementById("echarts-donut-container");
  if (donutContainer) {
    const donutChart = echarts.init(donutContainer);
    const winCount = <%= @stats[:winning_trades] %>;
    const lossCount = <%= @stats[:losing_trades] %>;

    const donutOption = {
      tooltip: {
        trigger: "item",
        backgroundColor: isDark ? "#151724" : "#FFFFFF",
        borderColor: borderColor,
        textStyle: { color: isDark ? "#FFFFFF" : "#0F0E1A", fontFamily: "Manrope" }
      },
      legend: { show: false },
      series: [{
        name: "Operaciones",
        type: "pie",
        radius: ["55%", "80%"],
        avoidLabelOverlap: false,
        itemStyle: { borderRadius: 8, borderColor: isDark ? "#151724" : "#FFFFFF", borderWidth: 2 },
        label: { show: false },
        data: [
          { value: winCount, name: "Ganadoras", itemStyle: { color: "#10B981" } },
          { value: lossCount, name: "Perdedoras", itemStyle: { color: "#F43F5E" } }
        ]
      }]
    };
    donutChart.setOption(donutOption);
    window.addEventListener("resize", () => donutChart.resize());
  }

  // 3. BAR CHART BY DAY OF WEEK (ECHARTS)
  const barContainer = document.getElementById("echarts-bar-day-container");
  if (barContainer) {
    const barChart = echarts.init(barContainer);
    const dailyData = <%= @pnl_by_day.to_json.html_safe %>;
    const xAxisData = Object.keys(dailyData);
    const seriesData = Object.values(dailyData);

    const barOption = {
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        backgroundColor: isDark ? "#151724" : "#FFFFFF",
        borderColor: borderColor,
        textStyle: { color: isDark ? "#FFFFFF" : "#0F0E1A", fontFamily: "Manrope" },
        formatter: function(params) {
          const item = params[0];
          const val = item.value;
          const color = val >= 0 ? '#10B981' : '#F43F5E';
          return `<strong>${item.name}</strong><br/>P&L: <span style="color:${color};font-weight:bold">${val >= 0 ? '+' : ''}$${val}</span>`;
        }
      },
      grid: { left: "3%", right: "3%", bottom: "3%", top: "8%", containLabel: true },
      xAxis: {
        type: "category",
        data: xAxisData,
        axisLine: { lineStyle: { color: borderColor } },
        axisLabel: { color: textColor, fontFamily: "Manrope", fontSize: 11 }
      },
      yAxis: {
        type: "value",
        splitLine: { lineStyle: { color: borderColor, type: "dashed" } },
        axisLabel: { color: textColor, fontFamily: "Manrope", fontSize: 11, formatter: "${value}" }
      },
      series: [{
        name: "P&L",
        type: "bar",
        barWidth: "40%",
        itemStyle: {
          borderRadius: [6, 6, 0, 0],
          color: function(params) {
            return params.value >= 0 ? "#10B981" : "#F43F5E";
          }
        },
        data: seriesData
      }]
    };
    barChart.setOption(barOption);
    window.addEventListener("resize", () => barChart.resize());
  }
});
</script>
