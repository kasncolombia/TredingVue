        <!-- Columna 1: AÑO -->
        <div class="h-[55px] rounded-[6px] dark:bg-[#18181d] bg-slate-100 border dark:border-[#1d1d1d] border-slate-200 dark:text-white text-slate-900 font-bold text-[13px] flex items-center justify-center">
          <%= Time.current.year %>
        </div>

        <!-- Columnas 2 a 13: ENE a DIC -->
        <% 
          months_abbr = %w[JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC]
          @annual_stats.each_with_index do |pnl, m_idx| 
            m_trades = current_user.trades.select { |t| t.entry_at&.year == Time.current.year && t.entry_at&.month == (m_idx + 1) }
            m_count = m_trades.size
        %>
          <% if m_count == 0 %>
            <!-- CELDA VACÍA -->
            <div class="h-[55px] rounded-[6px] dark:bg-[#18181d] bg-slate-50 border dark:border-[#1d1d1d] border-slate-200 dark:text-[#4a4a54] text-slate-400 font-normal text-[13px] flex items-center justify-center">
              --
            </div>
          <% elsif pnl < 0 %>
            <!-- CELDA CON PÉRDIDA -->
            <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#2e1018] bg-rose-50 border dark:border-[#5c2030] border-rose-200 flex flex-col items-center justify-center">
              <span class="text-[14px] font-bold dark:text-[#f87171] text-rose-600">$-<%= pnl.abs >= 1000 ? "#{(pnl.abs/1000.0).round(1)}K" : pnl.abs.round %></span>
              <span class="text-[10px] dark:text-[#a06070] text-rose-500/80 font-normal"><%= m_count %> trades</span>
            </div>
          <% else %>
            <!-- CELDA CON GANANCIA -->
            <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#0e2a22] bg-emerald-50 border dark:border-[#1f5c45] border-emerald-200 flex flex-col items-center justify-center">
              <span class="text-[14px] font-bold dark:text-[#34d399] text-emerald-600">+$<%= pnl >= 1000 ? "#{(pnl/1000.0).round(1)}K" : pnl.round %></span>
              <span class="text-[10px] dark:text-[#6a9a8a] text-emerald-600/80 font-normal"><%= m_count %> trades</span>
            </div>
          <% end %>
        <% end %>

        <!-- Columna 14: CELDA TOTAL -->
        <% if @annual_total < 0 %>
          <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#38121d] bg-rose-100 border dark:border-[#78283c] border-rose-300 flex flex-col items-center justify-center">
            <span class="text-[15px] font-black dark:text-[#f87171] text-rose-700">-$<%= (@annual_total.abs >= 1000 ? "#{(@annual_total.abs/1000.0).round(1)}K" : @annual_total.abs.round) %></span>
            <span class="text-[10px] dark:text-[#a06070] text-rose-600 font-normal"><%= @annual_trades_count %> trades</span>
          </div>
        <% else %>
          <div class="h-[55px] p-1.5 rounded-[6px] dark:bg-[#0f3328] bg-emerald-100 border dark:border-[#22c55e]/30 border-emerald-300 flex flex-col items-center justify-center">
            <span class="text-[15px] font-black dark:text-[#34d399] text-emerald-700">+$<%= (@annual_total >= 1000 ? "#{(@annual_total/1000.0).round(1)}K" : @annual_total.round) %></span>
