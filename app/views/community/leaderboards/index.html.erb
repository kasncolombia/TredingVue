<% content_for :page_title, "Leaderboard" %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">🏆 Leaderboard</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Los mejores traders de la comunidad</p>
    </div>
  </div>

  <!-- TOP TRADERS -->
  <div class="glass rounded-2xl p-6 mb-5">
    <h2 class="text-lg font-bold text-slate-800 dark:text-white mb-4">💰 Top Traders por P&L</h2>
    <div class="space-y-3">
      <% @top_traders.each_with_index do |user, i| %>
        <div class="flex items-center gap-4 p-3 rounded-xl <%= i == 0 ? 'bg-emerald-500/10 border border-emerald-500/20' : 'bg-slate-50 dark:bg-darkSidebar' %>">
          <span class="text-lg font-black <%= i == 0 ? 'text-emerald-500' : i == 1 ? 'text-slate-400' : i == 2 ? 'text-amber-600' : 'text-slate-500' %>"><%= i + 1 %>.</span>
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm">
            <%= user.name&.first&.upcase || "?" %>
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-800 dark:text-white"><%= user.name %></p>
            <p class="text-[10px] text-slate-400"><%= user.trades.count %> trades</p>
          </div>
          <span class="text-sm font-black <%= user.total_pnl.to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
            <%= user.total_pnl.to_f >= 0 ? "+" : "" %>$<%= user.total_pnl.to_f.round(2) %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- TOP WINNERS -->
  <div class="glass rounded-2xl p-6 mb-5">
    <h2 class="text-lg font-bold text-slate-800 dark:text-white mb-4">🎯 Mayor Win Rate</h2>
    <div class="space-y-3">
      <% @top_winners.each_with_index do |user, i| %>
        <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-50 dark:bg-darkSidebar">
          <span class="text-lg font-black <%= i == 0 ? 'text-emerald-500' : i == 1 ? 'text-slate-400' : i == 2 ? 'text-amber-600' : 'text-slate-500' %>"><%= i + 1 %}.</span>
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm">
            <%= user.name&.first&.upcase || "?" %>
          </div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-800 dark:text-white"><%= user.name %></p>
            <p class="text-[10px] text-slate-400"><%= user.trades.count %> trades</p>
          </div>
          <div class="text-right">
            <span class="text-sm font-black text-emerald-500"><%= user.win_rate.round(1) %>%</span>
            <p class="text-[10px] text-slate-400">Win Rate</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- FULL LEADERBOARD -->
  <div class="glass rounded-2xl overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-200 dark:border-darkBorder">
      <p class="text-sm font-bold text-slate-800 dark:text-white">Ranking Completo</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead class="table-header">
          <tr>
            <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 uppercase">#</th>
            <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 uppercase">Trader</th>
            <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 uppercase">Trades</th>
            <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 uppercase">P&L</th>
            <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 uppercase">Win Rate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
          <% @users.each_with_index do |user, i| %>
          <tr class="table-row-hover cursor-pointer" onclick="window.location.href='<%= community_public_profile_path(user.id) %>'">
            <td class="py-3 px-4 font-bold <%= i < 3 ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-400' %>"><%= i + 1 %></td>
            <td class="py-3 px-4 font-bold text-slate-800 dark:text-white"><%= user.name %></td>
            <td class="py-3 px-4 text-right text-slate-600 dark:text-slate-300"><%= user.trades.count %></td>
            <td class="py-3 px-4 text-right font-bold <%= user.total_pnl.to_f >= 0 ? "text-emerald-500" : "text-rose-500" %>"><%= user.total_pnl.to_f >= 0 ? "+" : "" %>$<%= user.total_pnl.to_f.round(2) %></td>
            <td class="py-3 px-4 text-right font-bold text-emerald-500"><%= user.win_rate.round(1) %>%</td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>