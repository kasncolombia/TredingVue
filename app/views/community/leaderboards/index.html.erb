<% content_for :page_title, "Leaderboard" %>

<div class="space-y-6 fade-in">

  <!-- HEADER -->
  <div class="glass rounded-2xl p-5 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[24px]">emoji_events</span>
        <h1 class="text-xl font-black dark:text-white text-slate-800">Leaderboard de Traders</h1>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Ranking oficial de rendimiento de la comunidad CoachTrading</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand/10 text-brand border border-brand/20">Temporada 2026</span>
    </div>
  </div>

  <!-- TOP TRADERS GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- TOP TRADERS POR PNL -->
    <div class="glass rounded-3xl p-6 border dark:border-darkBorder border-lightBorder">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-emerald-500 text-[20px]">payments</span>
        <h2 class="text-base font-extrabold dark:text-white text-slate-800">Top Traders por P&L</h2>
      </div>

      <div class="space-y-3">
        <% @top_traders.each_with_index do |user, i| %>
          <div class="flex items-center gap-4 p-3.5 rounded-2xl transition-all <%= i == 0 ? 'bg-emerald-500/10 border border-emerald-500/30' : i == 1 ? 'bg-amber-500/10 border border-amber-500/20' : i == 2 ? 'bg-brand/10 border border-brand/20' : 'dark:bg-darkInput bg-slate-100 border border-transparent' %>">
            <span class="text-base font-black w-6 text-center <%= i == 0 ? 'text-emerald-500' : i == 1 ? 'text-amber-500' : i == 2 ? 'text-brand' : 'text-slate-400' %>">
              #<%= i + 1 %>
            </span>
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white font-extrabold text-sm shadow-md">
              <%= user.name&.first&.upcase || "?" %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold dark:text-white text-slate-800 truncate"><%= user.name || user.email %></p>
              <p class="text-[11px] text-slate-400"><%= user.trades.count %> operaciones</p>
            </div>
            <div class="text-right">
              <span class="text-sm font-black font-mono <%= user.total_pnl.to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                <%= user.total_pnl.to_f >= 0 ? '+' : '' %>$<%= number_with_precision(user.total_pnl.to_f, precision: 2, delimiter: ',') %>
              </span>
              <p class="text-[10px] text-slate-400">P&L Acumulado</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- TOP WINNERS POR WIN RATE -->
    <div class="glass rounded-3xl p-6 border dark:border-darkBorder border-lightBorder">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-brand text-[20px]">target</span>
        <h2 class="text-base font-extrabold dark:text-white text-slate-800">Mayor Win Rate</h2>
      </div>

      <div class="space-y-3">
        <% @top_winners.each_with_index do |user, i| %>
          <div class="flex items-center gap-4 p-3.5 rounded-2xl dark:bg-darkInput bg-slate-100 border border-transparent">
            <span class="text-base font-black w-6 text-center <%= i == 0 ? 'text-emerald-500' : i == 1 ? 'text-amber-500' : i == 2 ? 'text-brand' : 'text-slate-400' %>">
              #<%= i + 1 %>
            </span>
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white font-extrabold text-sm shadow-md">
              <%= user.name&.first&.upcase || "?" %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold dark:text-white text-slate-800 truncate"><%= user.name || user.email %></p>
              <p class="text-[11px] text-slate-400"><%= user.trades.count %> operaciones</p>
            </div>
            <div class="text-right">
              <span class="text-sm font-black text-emerald-500 font-mono"><%= user.win_rate.round(1) %>%</span>
              <p class="text-[10px] text-slate-400">Efectividad</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <!-- RANKING TABULAR COMPLETO -->
  <div class="glass rounded-3xl overflow-hidden border dark:border-darkBorder border-lightBorder">
    <div class="px-6 py-4 border-b dark:border-darkBorder border-lightBorder flex items-center justify-between">
      <p class="text-sm font-bold dark:text-white text-slate-800">Ranking Global de la Comunidad</p>
      <span class="text-xs text-slate-400"><%= @users.count %> traders auditados</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead class="table-header">
          <tr>
            <th class="py-3.5 px-5 text-left text-[10px] font-extrabold text-slate-400 uppercase">Posición</th>
            <th class="py-3.5 px-5 text-left text-[10px] font-extrabold text-slate-400 uppercase">Trader</th>
            <th class="py-3.5 px-5 text-right text-[10px] font-extrabold text-slate-400 uppercase">Trades</th>
            <th class="py-3.5 px-5 text-right text-[10px] font-extrabold text-slate-400 uppercase">P&L Total</th>
            <th class="py-3.5 px-5 text-right text-[10px] font-extrabold text-slate-400 uppercase">Win Rate</th>
            <th class="py-3.5 px-5 text-center text-[10px] font-extrabold text-slate-400 uppercase">Perfil</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-darkBorder/60">
          <% @users.each_with_index do |user, i| %>
          <tr class="table-row-hover cursor-pointer" onclick="window.location.href='<%= community_public_profile_path(user.id) %>'">
            <td class="py-4 px-5 font-black <%= i < 3 ? 'text-brand' : 'text-slate-400' %>">#<%= i + 1 %></td>
            <td class="py-4 px-5 font-bold dark:text-white text-slate-800 flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-brand/15 text-brand font-bold text-xs flex items-center justify-center">
                <%= user.name&.first&.upcase || "?" %>
              </div>
              <span><%= user.name || user.email %></span>
            </td>
            <td class="py-4 px-5 text-right font-mono dark:text-slate-300 text-slate-600"><%= user.trades.count %></td>
            <td class="py-4 px-5 text-right font-black font-mono <%= user.total_pnl.to_f >= 0 ? "text-emerald-500" : "text-rose-500" %>">
              <%= user.total_pnl.to_f >= 0 ? "+" : "" %>$<%= number_with_precision(user.total_pnl.to_f, precision: 2, delimiter: ',') %>
            </td>
            <td class="py-4 px-5 text-right font-bold text-emerald-500 font-mono"><%= user.win_rate.round(1) %>%</td>
            <td class="py-4 px-5 text-center">
              <span class="px-2.5 py-1 text-[11px] font-semibold text-brand bg-brand/10 rounded-xl hover:bg-brand/20 transition-all">Ver</span>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>