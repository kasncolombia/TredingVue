<% content_for :page_title, "Publicación" %>
<div class="fade-in max-w-2xl mx-auto space-y-4">
  <%= link_to community_feed_index_path, class: "inline-flex items-center gap-1 text-xs font-semibold text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all" do %>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Volver al feed
  <% end %>
  <%= render "community/post_card", post: @post %>
  <div class="glass rounded-2xl p-4">
    <p class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-3">Comentarios (<%= @comments.count %>)</p>
    <% if @comments.any? %>
      <div class="space-y-3">
        <% @comments.each do |comment| %>
          <div class="flex gap-2">
            <div class="w-7 h-7 rounded-full bg-indigo-100 dark:bg-darkCard flex items-center justify-center text-[11px] font-bold text-indigo-600 dark:text-indigo-400 flex-shrink-0">
              <%= comment.user&.name&.first&.upcase || "?" %>
            </div>
            <div class="min-w-0">
              <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300"><%= comment.user&.name || "Anónimo" %></span>
              <span class="text-[10px] text-slate-400 ml-1">hace <%= time_ago_in_words(comment.created_at) %></span>
              <p class="text-xs text-slate-600 dark:text-slate-400 break-words"><%= comment.content %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-slate-400">Aún no hay comentarios en esta publicación.</p>
    <% end %>
  </div>
</div>
