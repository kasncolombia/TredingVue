<% content_for :page_title, "Nuevo Post" %>

<div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <div class="w-full max-w-lg relative fade-in">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">Nuevo Post</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Comparte tu experiencia con la comunidad</p>
    </div>
    <div class="glass rounded-2xl p-8 shadow-2xl shadow-indigo-500/10">
      <%= form_with model: @post, url: community_feed_index_path, method: :post, local: true do |f| %>
        <div class="space-y-5">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Contenido</label>
            <%= f.text_area :content, rows: 6, placeholder="Escribe tu post sobre trading...", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Visibilidad</label>
            <%= f.select :visibility, options_for_select([["🌐 Público", "public"], ["👥 Seguidores", "friends"], ["🔒 Solo yo", "private"]]), {}, { class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" } %>
          </div>
          <%= f.submit "Publicar", class: "w-full py-3 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/30 transition-all duration-200 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99]" %>
        </div>
      <% end %>
      <div class="mt-5 text-center">
        <%= link_to "Cancelar", community_feed_index_path, class: "text-xs text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold" %>
      </div>
    </div>
  </div>
</div>