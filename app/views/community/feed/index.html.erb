<% content_for :page_title, "Comunidad de Traders" %>

<div class="space-y-6 fade-in">
  <!-- HEADER -->
  <div class="glass rounded-3xl p-5 flex items-center justify-between border dark:border-darkBorder border-lightBorder">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="material-symbols-outlined text-brand text-[24px]">forum</span>
        <h1 class="text-xl font-black dark:text-white text-slate-800">Comunidad CoachTrading</h1>
      </div>
      <p class="text-xs text-slate-400 mt-0.5 font-medium">Feed social, trades compartidos y lecciones de mercado en vivo</p>
    </div>
    <%= link_to new_community_feed_path, class: "px-4 py-2.5 text-xs font-extrabold bg-brand hover:bg-brand-hover text-white rounded-2xl glow-brand transition-all flex items-center gap-1.5 shadow-md shadow-brand/20" do %>
      <span class="material-symbols-outlined text-[18px]">add</span>
      <span>Nuevo Post</span>
    <% end %>
  </div>

  <!-- NAV TABS -->
  <div class="flex flex-wrap gap-2 glass rounded-2xl p-2 border dark:border-darkBorder border-lightBorder">
    <%= link_to community_feed_index_path, class: "px-4 py-2 text-xs font-extrabold text-white bg-brand rounded-xl shadow-md transition-all flex items-center gap-2" do %>
      <span class="material-symbols-outlined text-[17px]">feed</span>
      <span>Feed</span>
    <% end %>
    <%= link_to community_trade_shares_path, class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-brand rounded-xl hover:bg-brand/10 transition-all flex items-center gap-2" do %>
      <span class="material-symbols-outlined text-[17px]">share</span>
      <span>Trades Compartidos</span>
    <% end %>
    <%= link_to community_leaderboards_path, class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-brand rounded-xl hover:bg-brand/10 transition-all flex items-center gap-2" do %>
      <span class="material-symbols-outlined text-[17px]">emoji_events</span>
      <span>Leaderboard</span>
    <% end %>
    <%= link_to "#", onclick: "event.preventDefault();", class: "px-4 py-2 text-xs font-bold text-slate-400 dark:text-slate-500 rounded-xl flex items-center gap-2 cursor-not-allowed select-none relative group border border-transparent" do %>
      <span class="material-symbols-outlined text-[17px]">chat</span>
      <span>Salas de Chat</span>
      <span class="absolute -top-2 -right-2 px-1.5 py-0.5 rounded text-[8px] font-black bg-brand/20 text-brand uppercase tracking-widest border border-brand/30 shadow-md">Pronto</span>
    <% end %>
    <%= link_to community_classrooms_path, class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-brand rounded-xl hover:bg-brand/10 transition-all flex items-center gap-2" do %>
      <span class="material-symbols-outlined text-[17px]">school</span>
      <span>Aulas</span>
    <% end %>
    <%= link_to community_resources_path, class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-brand rounded-xl hover:bg-brand/10 transition-all flex items-center gap-2" do %>
      <span class="material-symbols-outlined text-[17px]">folder</span>
      <span>Recursos</span>
    <% end %>
  </div>

  <!-- LAYOUT PRINCIPAL -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  
    <!-- ÁREA IZQUIERDA: FEED Y PUBLICACIONES -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- NEW POST FORM -->
      <div class="glass rounded-3xl p-6 space-y-4 border dark:border-darkBorder border-brand/20 relative overflow-hidden">
        <!-- Glow effect decorativo -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand/10 blur-3xl rounded-full pointer-events-none"></div>
        
        <div class="flex items-center gap-2 mb-2 relative z-10">
          <span class="material-symbols-outlined text-brand text-[18px]">edit_square</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Comparte tu sesión</h3>
        </div>
        
        <%= form_with model: @new_post, url: community_feed_index_path, method: :post, local: true, class: "relative z-10" do |f| %>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 text-white font-extrabold text-sm flex items-center justify-center flex-shrink-0 shadow-md">
            <%= current_user.name&.first&.upcase %>
          </div>
          <div class="flex-1 space-y-3">
            <%= f.text_area :content, rows: 3, placeholder: "¿Qué setup u observación sobre el mercado quieres compartir hoy con la comunidad?", class: "input-field w-full px-4 py-3 rounded-2xl text-xs focus:outline-none transition-all dark:bg-darkInput/80 bg-slate-50 border dark:border-darkBorder border-slate-300" %>
            <div class="flex items-center justify-between">
              <select name="post[visibility]" class="input-field text-xs px-3.5 py-2 rounded-xl dark:bg-darkInput bg-slate-50 border dark:border-darkBorder border-slate-300">
                <option value="public">Público para la Comunidad</option>
                <option value="friends">Solo seguidores</option>
                <option value="private">Privado</option>
              </select>
              <%= f.button type: :submit, class: "px-5 py-2.5 bg-brand hover:bg-brand-hover text-white font-extrabold text-xs rounded-xl glow-brand transition-all cursor-pointer flex items-center gap-1.5 shadow-md" do %>
                <span>Publicar</span>
                <span class="material-symbols-outlined text-[17px]">send</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

      <!-- POSTS LIST -->
      <div class="space-y-5">
        <% if @posts.present? %>
          <% @posts.each do |post| %>
            <%= render "community/post_card", post: post %>
          <% end %>
        <% else %>
          <div class="glass rounded-3xl p-12 text-center text-slate-400 space-y-3 border dark:border-darkBorder border-lightBorder">
            <span class="material-symbols-outlined text-brand text-[44px]">forum</span>
            <p class="text-base font-extrabold dark:text-white text-slate-800">Aún no hay publicaciones en el feed</p>
            <p class="text-xs max-w-md mx-auto">¡Sé el primero en compartir un análisis, gráfico o reflexión de tu sesión de trading!</p>
          </div>
        <% end %>
      </div>

    </div> <!-- Cierra Columna Izquierda -->

    <!-- ÁREA DERECHA: SIDEBAR DE MÓDULOS -->
    <div class="space-y-6">
      
      <!-- REGLAS DE COMUNIDAD -->
      <div class="glass rounded-3xl p-6 border dark:border-darkBorder border-lightBorder">
        <div class="flex items-center gap-2 mb-4 pb-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="material-symbols-outlined text-emerald-500 text-[18px]">verified_user</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Reglas del Foro</h3>
        </div>
        <ul class="space-y-3 text-[11px] text-slate-500 dark:text-slate-400">
          <li class="flex items-start gap-2">
            <span class="material-symbols-outlined text-emerald-500 text-[15px] shrink-0">check</span>
            Comparte aprendizajes reales y disciplina técnica, cero promesas de dinero rápido.
          </li>
          <li class="flex items-start gap-2">
            <span class="material-symbols-outlined text-emerald-500 text-[15px] shrink-0">check</span>
            El P&L no lo es todo; la comunidad premia a quienes respetan los Stop Losses planeados.
          </li>
          <li class="flex items-start gap-2">
            <span class="material-symbols-outlined text-emerald-500 text-[15px] shrink-0">check</span>
            Estrictamente prohibido el spam de canales externos o ventas.
          </li>
        </ul>
      </div>

      <!-- TRENDING / RESUMEN -->
      <div class="glass rounded-3xl p-6 border dark:border-darkBorder border-lightBorder relative overflow-hidden">
        <!-- Glow top left -->
        <div class="absolute -top-5 -left-5 w-24 h-24 bg-amber-500/10 blur-2xl rounded-full pointer-events-none"></div>

        <div class="flex items-center gap-2 mb-4 pb-2 border-b dark:border-darkBorder border-lightBorder relative z-10">
          <span class="material-symbols-outlined text-amber-500 text-[18px]">trending_up</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Tendencias Globales</h3>
        </div>
        <div class="space-y-4 relative z-10">
          <div class="flex items-center justify-between">
             <div class="flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
               <p class="text-xs font-bold dark:text-slate-200 text-slate-700">NQ1! / Nasdaq</p>
             </div>
             <p class="text-[10px] text-slate-500">24 menciones</p>
          </div>
          <div class="flex items-center justify-between">
             <div class="flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-brand"></span>
               <p class="text-xs font-bold dark:text-slate-200 text-slate-700">ICT Strategy</p>
             </div>
             <p class="text-[10px] text-slate-500">18 menciones</p>
          </div>
          <div class="flex items-center justify-between">
             <div class="flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-amber-500"></span>
               <p class="text-xs font-bold dark:text-slate-200 text-slate-700">Psicología</p>
             </div>
             <p class="text-[10px] text-slate-500">10 debates</p>
          </div>
        </div>
        <%= link_to community_leaderboards_path, class: "mt-5 w-full py-2.5 rounded-xl border border-brand/20 text-brand text-xs font-bold text-center block hover:bg-brand hover:text-white transition-all shadow-sm" do %>
          Ver Ranking Completo
        <% end %>
      </div>
      
    </div> <!-- Cierra Columna Derecha -->

  </div> <!-- Cierra Layout Grid -->
</div>