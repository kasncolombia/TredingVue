<% content_for :page_title, "Community" %>

<div class="fade-in">
  <!-- HEADER -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">🌐 Community</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Feed, trading insights y más</p>
    </div>
    <%= link_to new_community_feed_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-1.5 animate-float" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nuevo Post
    <% end %>
  </div>

  <!-- NAV TABS -->
  <div class="flex gap-1 mb-5 glass rounded-xl p-1">
    <%= link_to community_feed_index_path, class: "px-3 py-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-darkCard rounded-lg transition-all" do %>
      <svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      Feed
    <% end %>
    <%= link_to community_trade_shares_path, class: "px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-darkCard transition-all" do %>
      📊 Trades Compartidos
    <% end %>
    <%= link_to community_leaderboards_path, class: "px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-darkCard transition-all" do %>
      🏆 Leaderboard
    <% end %>
    <%= link_to community_chat_rooms_path, class: "px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-darkCard transition-all" do %>
      💬 Chat
    <% end %>
    <%= link_to community_classrooms_path, class: "px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-darkCard transition-all" do %>
      📚 Classroom
    <% end %>
    <%= link_to community_resources_path, class: "px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-darkCard transition-all" do %>
      📦 Resources
    <% end %>
  </div>

  <!-- FEED POSTS -->
  <div class="space-y-4">
    <!-- NEW POST FORM -->
    <div class="glass rounded-2xl p-4">
      <%= form_with model: @new_post, url: community_feed_index_path, method: :post, local: true do |f| %>
        <div class="flex gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
            <%= current_user.name&.first&.upcase %>
          </div>
          <div class="flex-1">
            <%= f.text_area :content, rows: 3, placeholder: "¿Qué estás pensando sobre trading hoy? Comparte tu experiencia...", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
            <div class="flex items-center justify-between mt-2">
              <select name="post[visibility]" class="input-field text-xs px-3 py-1.5 rounded-lg">
                <option value="public">🌐 Público</option>
                <option value="friends">👥 Solo seguidores</option>
                <option value="private">🔒 Solo yo</option>
              </select>
              <%= f.submit "Publicar", class: "px-4 py-1.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-500/30 transition-all cursor-pointer" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- POSTS LIST -->
    <% @posts.each do |post| %>
      <%= render "community/post_card", post: post %>
    <% end %>
  </div>
</div>

<% content_for :scripts do %>
<script>
  function toggleLike(postId) {
    const btn = document.getElementById('like-btn-' + postId);
    if (!btn) return;
    fetch(`/community/feed/${postId}/react`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector("meta[name=csrf-token]").content }
    }).then(r => r.json()).then(data => {
      btn.innerHTML = data.reaction + ' ' + data.count;
    });
  }
</script>
<% end %>