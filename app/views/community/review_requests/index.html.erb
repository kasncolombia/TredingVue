<% content_for :page_title, "Solicitudes de Revisión" %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">🎓 Solicitudes de Revisión</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Mentoría 1:1 con traders experimentados</p>
    </div>
    <%= link_to new_community_review_request_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white rounded-xl shadow-lg shadow-amber-500/30 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
      Nueva Solicitud
    <% end %>
  </div>

  <!-- AS REQUESTER -->
  <div class="glass rounded-2xl p-5 mb-5">
    <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-3">📤 Mis Solicitudes</h2>
    <% if @requests_as_requester.any? %>
      <div class="space-y-3">
        <% @requests_as_requester.each do |request| %>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkSidebar border border-slate-200 dark:border-darkBorder">
            <div class="flex items-center justify-between mb-2">
              <div>
                <p class="text-sm font-bold text-slate-800 dark:text-white">Trade: <%= request.trade&.symbol || "—" %></p>
                <p class="text-[10px] text-slate-400"><%= request.mentor&.name || "Sin asignar" %> como mentor</p>
              </div>
              <span class="text-xs px-2 py-0.5 rounded-full <%= request.status == 'pending' ? 'bg-amber-500/10 text-amber-500' : request.status == 'accepted' ? 'bg-emerald-500/10 text-emerald-500' : request.status == 'completed' ? 'bg-blue-500/10 text-blue-500' : 'bg-rose-500/10 text-rose-500' %>">
                <%= request.status.capitalize %>
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300"><%= request.message %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-400 text-center py-4">No tienes solicitudes enviadas</p>
    <% end %>
  </div>

  <!-- AS MENTOR -->
  <div class="glass rounded-2xl p-5">
    <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-3">📥 Solicitudes Recibidas</h2>
    <% if @requests_as_mentor.any? %>
      <div class="space-y-3">
        <% @requests_as_mentor.each do |request| %>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkSidebar border border-slate-200 dark:border-darkBorder">
            <div class="flex items-center justify-between mb-2">
              <div>
                <p class="text-sm font-bold text-slate-800 dark:text-white"><%= request.requester&.name || "Anónimo" %></p>
                <p class="text-[10px] text-slate-400">Trade: <%= request.trade&.symbol || "—" %></p>
              </div>
              <span class="text-xs px-2 py-0.5 rounded-full <%= request.status == 'pending' ? 'bg-amber-500/10 text-amber-500' : 'bg-slate-500/10 text-slate-500' %>">
                <%= request.status.capitalize %>
              </span>
            </div>
            <div class="flex gap-2 mt-2">
              <%= form_with model: request, url: community_review_request_path(request), method: :patch, data: { turbo_method: :patch } do |f| %>
                <%= f.hidden_field :status, value: "accepted" %>
                <%= f.submit "Aceptar", class: "px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-lg transition-all cursor-pointer" %>
              <% end %>
              <%= form_with model: request, url: community_review_request_path(request), method: :patch, data: { turbo_method: :patch } do |f| %>
                <%= f.hidden_field :status, value: "rejected" %>
                <%= f.submit "Rechazar", class: "px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-lg transition-all cursor-pointer" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-400 text-center py-4">No tienes solicitudes recibidas</p>
    <% end %>
  </div>
</div>