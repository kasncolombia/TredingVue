<% content_for :page_title, "Nueva Clase" %>

<div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <div class="w-full max-w-lg relative fade-in">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">Nueva Clase</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Crea contenido educativo</p>
    </div>
    <div class="glass rounded-2xl p-8 shadow-2xl shadow-indigo-500/10">
      <%= form_with model: @classroom, url: community_classrooms_path, local: true do |f| %>
        <div class="space-y-5">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Título</label>
            <%= f.text_field :title, placeholder="Nombre de la clase", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Descripción</label>
            <%= f.text_area :description, rows: 4, placeholder="Describe la clase...", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Categoría</label>
            <%= f.select :category, options_for_select([["Principiante", "beginner"], ["Intermedio", "intermediate"], ["Avanzado", "advanced"]]), {}, { class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" } %>
          </div>
          <%= f.submit "Crear Clase", class: "w-full py-3 px-4 bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-violet-500/30 transition-all duration-200 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99]" %>
        </div>
      <% end %>
    </div>
  </div>
</div>