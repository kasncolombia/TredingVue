<% content_for :page_title, @classroom.title %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white"><%= @classroom.title %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5"><%= @classroom.category.capitalize %> · <%= @classroom.enrollments.count %> inscritos</p>
    </div>
    <div class="flex gap-2">
      <% unless @classroom.enrollments.exists?(user: current_user) %>
        <%= link_to community_classroom_enroll_path(@classroom), method: :patch, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 text-white rounded-xl shadow-lg shadow-violet-500/30 transition-all flex items-center gap-1.5" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
          Inscribirse
        <% end %>
      <% else %>
        <span class="px-4 py-2 text-xs font-bold bg-emerald-500/10 text-emerald-500 rounded-xl">✅ Inscrito</span>
      <% end %>
      <%= link_to community_classrooms_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-1.5" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Volver
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <!-- INFO -->
    <div class="lg:col-span-2 space-y-5">
      <div class="glass rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs px-2 py-0.5 rounded-full <%= @classroom.category == 'beginner' ? 'bg-emerald-500/10 text-emerald-500' : @classroom.category == 'intermediate' ? 'bg-amber-500/10 text-amber-500' : 'bg-rose-500/10 text-rose-500' %>">
            <%= @classroom.category.capitalize %>
          </span>
          <span class="text-[10px] text-slate-400">por <%= @classroom.author.name %></span>
        </div>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed"><%= @classroom.description %></p>
      </div>

      <!-- STUDENTS -->
      <div class="glass rounded-2xl p-5">
        <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-3">Estudiantes (<%= @enrollments.count %>)</h3>
        <div class="flex flex-wrap gap-2">
          <% @enrollments.includes(:user).each do |enrollment| %>
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-darkSidebar border border-slate-200 dark:border-darkBorder">
              <div class="w-6 h-6 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-[10px]">
                <%= enrollment.user.name&.first&.upcase %>
              </div>
              <span class="text-xs text-slate-700 dark:text-slate-300"><%= enrollment.user.name %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- SIDEBAR -->
    <div>
      <div class="glass rounded-2xl p-5">
        <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-3">Detalles</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Categoría</span>
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400"><%= @classroom.category.capitalize %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Inscriptos</span>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400"><%= @classroom.enrollments.count %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Autor</span>
            <span class="text-xs font-semibold text-slate-800 dark:text-white"><%= @classroom.author.name %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Creado</span>
            <span class="text-xs font-semibold text-slate-800 dark:text-white"><%= time_ago_in_words(@classroom.created_at) %> ago</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
