<% content_for :page_title, @resource.title %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white"><%= @resource.title %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5"><%= @resource.category.capitalize %> · por <%= @resource.author.name %></p>
    </div>
    <%= link_to community_resources_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Volver
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <!-- CONTENT -->
    <div class="lg:col-span-2 space-y-5">
      <div class="glass rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-lg">
            <%= @resource.category == 'book' ? '📖' : @resource.category == 'video' ? '🎬' : @resource.category == 'article' ? '📝' : @resource.category == 'podcast' ? '🎙️' : '📚' %>
          </div>
          <div>
            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-500"><%= @resource.category.capitalize %></span>
          </div>
        </div>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-4"><%= @resource.description %></p>
        <a href="<%= @resource.url %>" target="_blank" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/30 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Ver Recurso
        </a>
      </div>
    </div>

    <!-- SIDEBAR -->
    <div>
      <div class="glass rounded-2xl p-5">
        <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-3">Detalles</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Categoría</span>
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400"><%= @resource.category.capitalize %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Autor</span>
            <span class="text-xs font-semibold text-slate-800 dark:text-white"><%= @resource.author.name %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 dark:text-slate-400">Creado</span>
            <span class="text-xs font-semibold text-slate-800 dark:text-white"><%= time_ago_in_words(@resource.created_at) %> ago</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
