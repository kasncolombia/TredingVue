<% content_for :page_title, "Compartir Trade" %>

<div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden">
  <div class="w-full max-w-lg relative fade-in">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">Compartir Trade</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Comparte tu operación con la comunidad</p>
    </div>
    <div class="glass rounded-2xl p-8 shadow-2xl shadow-indigo-500/10">
      <%= form_with model: @trade_share, url: community_trade_shares_path, local: true do |f| %>
        <div class="space-y-5">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Trade</label>
            <%= f.collection_select :trade_id, current_user.trades, :id, :symbol, { prompt: "Selecciona un trade" }, { class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" } %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Título</label>
            <%= f.text_field :title, placeholder="Mi trade de hoy", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Nota</label>
            <%= f.text_area :note, rows: 3, placeholder="Cuéntanos sobre este trade...", class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Privacidad</label>
            <%= f.select :privacy, options_for_select([["🌐 Público", "public"], ["👥 Seguidores", "followers"], ["🔒 Solo yo", "private"]]), {}, { class: "input-field w-full px-4 py-3 rounded-xl text-sm transition-all focus:outline-none" } %>
          </div>
          <%= f.submit "Compartir", class: "w-full py-3 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-emerald-500/30 transition-all duration-200 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99]" %>
        </div>
      <% end %>
      <div class="mt-5 text-center">
        <%= link_to "Cancelar", community_trade_shares_path, class: "text-xs text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold" %>
      </div>
    </div>
  </div>
</div>