<% content_for :page_title, "Trades Compartidos" %>

<div class="space-y-6 fade-in">
  <!-- HEADER -->
  <div class="glass rounded-2xl p-5 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[24px]">share</span>
        <h1 class="text-xl font-black dark:text-white text-slate-800">Trades Compartidos</h1>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Operaciones reales publicadas por miembros de la comunidad</p>
    </div>
    <%= link_to new_community_trade_share_path, class: "px-4 py-2 text-xs font-bold bg-brand hover:bg-brand-hover text-white rounded-xl glow-brand transition-all flex items-center gap-1.5" do %>
      <span class="material-symbols-outlined text-[16px]">add</span>
      <span>Compartir Trade</span>
    <% end %>
  </div>

  <!-- LIST OF SHARED TRADES -->
  <div class="space-y-4">
    <% @trade_shares.each do |share| %>
      <div class="glass rounded-3xl p-5 border dark:border-darkBorder border-lightBorder hover:shadow-xl transition-all duration-300">
        
        <!-- USER & PRIVACY -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white font-black text-sm shadow-md">
              <%= share.user.name&.first&.upcase || "?" %>
            </div>
            <div>
              <p class="text-sm font-bold dark:text-white text-slate-800"><%= share.user.name || share.user.email %></p>
              <p class="text-[11px] text-slate-400">hace <%= time_ago_in_words(share.created_at) %></p>
            </div>
          </div>

          <span class="text-[10px] font-extrabold px-3 py-1 rounded-full flex items-center gap-1.5 border <%= share.privacy == 'public' ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : share.privacy == 'followers' ? 'bg-amber-500/10 text-amber-500 border-amber-500/20' : 'bg-slate-500/10 text-slate-400 border-slate-500/20' %>">
            <span class="material-symbols-outlined text-[13px]">
              <%= share.privacy == 'public' ? 'public' : share.privacy == 'followers' ? 'group' : 'lock' %>
            </span>
            <span><%= share.privacy == 'public' ? 'Público' : share.privacy == 'followers' ? 'Seguidores' : 'Privado' %></span>
          </span>
        </div>

        <!-- TRADE METRICS BAR -->
        <div class="grid grid-cols-3 gap-3 mb-4">
          <div class="p-3 rounded-2xl dark:bg-darkInput bg-slate-100 text-center border dark:border-darkBorder border-slate-200">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Activo</p>
            <p class="text-sm font-black dark:text-white text-slate-800 font-mono mt-0.5"><%= share.trade&.symbol || "—" %></p>
          </div>
          <div class="p-3 rounded-2xl dark:bg-darkInput bg-slate-100 text-center border dark:border-darkBorder border-slate-200">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Dirección</p>
            <span class="inline-block mt-0.5 text-xs font-black px-2 py-0.5 rounded-full <%= share.trade&.direction == 'LONG' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20' %>">
              <%= share.trade&.direction || "—" %>
            </span>
          </div>
          <div class="p-3 rounded-2xl dark:bg-darkInput bg-slate-100 text-center border dark:border-darkBorder border-slate-200">
            <p class="text-[10px] font-bold text-slate-400 uppercase">P&L Obtenido</p>
            <p class="text-sm font-black font-mono mt-0.5 <%= share.trade&.pnl.to_f >= 0 ? "text-emerald-500" : "text-rose-500" %>">
              <%= share.trade&.pnl.to_f >= 0 ? "+" : "" %>$<%= number_with_precision(share.trade&.pnl.to_f, precision: 2) %>
            </p>
          </div>
        </div>

        <!-- NOTE -->
        <% if share.note.present? %>
          <p class="text-sm dark:text-slate-300 text-slate-700 leading-relaxed mb-4 p-3 rounded-2xl dark:bg-darkInput/40 bg-slate-50 border dark:border-darkBorder border-slate-200">
            <%= share.note %>
          </p>
        <% end %>

        <!-- FOOTER INFO -->
        <div class="flex items-center justify-between text-xs text-slate-400 border-t dark:border-darkBorder border-slate-200 pt-3">
          <div class="flex items-center gap-4">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[15px] text-brand">notes</span>
              <span><%= share.trade&.trade_notes&.count || 0 %> notas</span>
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[15px] text-emerald-500">smart_toy</span>
              <span><%= share.trade&.ai_analyses&.count || 0 %> análisis IA</span>
            </span>
          </div>
          <% if share.trade %>
            <%= link_to trade_path(share.trade), class: "text-brand hover:underline font-bold text-xs flex items-center gap-1" do %>
              <span>Ver Detalle del Trade</span>
              <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            <% end %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>
</div>