<% content_for :page_title, "Trades Compartidos" %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">📊 Trades Compartidos</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Los trades de la comunidad en tiempo real</p>
    </div>
    <%= link_to new_community_trade_share_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white rounded-xl shadow-lg shadow-emerald-500/30 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Compartir Trade
    <% end %>
  </div>

  <div class="space-y-4">
    <% @trade_shares.each do |share| %>
      <div class="glass rounded-2xl p-5 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm">
              <%= share.user.name&.first&.upcase %>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-800 dark:text-white"><%= share.user.name %></p>
              <p class="text-[10px] text-slate-400"><%= time_ago_in_words(share.created_at) %> ago</p>
            </div>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full <%= share.privacy == 'public' ? 'bg-emerald-500/10 text-emerald-500' : share.privacy == 'followers' ? 'bg-amber-500/10 text-amber-500' : 'bg-slate-500/10 text-slate-500' %>">
            <%= share.privacy == 'public' ? '🌐' : share.privacy == 'followers' ? '👥' : '🔒' %> <%= share.privacy %>
          </span>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-3">
          <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-darkSidebar">
            <p class="text-[10px] text-slate-400">Activo</p>
            <p class="text-sm font-bold text-slate-800 dark:text-white"><%= share.trade&.symbol || "—" %></p>
          </div>
          <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-darkSidebar">
            <p class="text-[10px] text-slate-400">Dirección</p>
            <p class="text-sm font-bold text-slate-800 dark:text-white"><%= share.trade&.direction || "—" %></p>
          </div>
          <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-darkSidebar">
            <p class="text-[10px] text-slate-400">P&L</p>
            <p class="text-sm font-bold <%= share.trade&.pnl.to_f >= 0 ? "text-emerald-500" : "text-rose-500" %>">
              <%= share.trade&.pnl.to_f >= 0 ? "+" : "" %>$<%= share.trade&.pnl %></p>
          </div>
        </div>

        <p class="text-sm text-slate-700 dark:text-slate-300 mb-3"><%= share.note %></p>

        <div class="flex items-center gap-4">
          <span class="text-[10px] text-slate-400">🗨️ <%= share.trade&.trade_notes&.count || 0 %> notas</span>
          <span class="text-[10px] text-slate-400">👍 <%= share.trade&.ai_analyses&.count || 0 %> análisis</span>
          <button class="ml-auto text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">Ver Trade</button>
        </div>
      </div>
    <% end %>
  </div>
</div>