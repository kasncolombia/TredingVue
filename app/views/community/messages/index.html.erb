<% content_for :page_title, "Mensajes - #{@chat_room.name}" %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">💬 <%= @chat_room.name %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Mensajes de la comunidad</p>
    </div>
    <%= link_to community_chat_room_path(@chat_room), class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Volver al Chat
    <% end %>
  </div>

  <div class="glass rounded-2xl overflow-hidden">
    <div id="chat-messages" class="p-4 space-y-3 max-h-[500px] overflow-y-auto">
      <% @messages.each do |message| %>
        <div class="flex gap-2 items-start <%= message.user_id == current_user.id ? 'justify-end' : '' %>">
          <% unless message.user_id == current_user.id %>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
              <%= message.user.name&.first&.upcase %>
            </div>
          <% end %>
          <div class="p-2.5 rounded-2xl max-w-[75%] <%= message.user_id == current_user.id ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white rounded-tr-none' : 'bg-slate-100 dark:bg-darkSidebar border border-slate-200 dark:border-darkBorder text-slate-700 dark:text-slate-200' %>">
            <p class="text-sm"><%= message.content %></p>
            <p class="text-[10px] mt-1 opacity-60"><%= time_ago_in_words(message.created_at) %> ago</p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="p-3 border-t border-slate-200 dark:border-darkBorder bg-slate-50 dark:bg-darkSidebar">
      <%= form_with model: [@chat_room, @chat_room.messages.build], url: community_chat_room_messages_path(@chat_room), local: true, class: "flex gap-2" do |f| %>
        <%= f.text_area :content, rows: 1, placeholder="Escribe un mensaje...", class: "input-field flex-1 px-3 py-2 rounded-xl text-xs transition-all focus:outline-none" %>
        <%= f.submit "Enviar", class: "px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-500/30 transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
