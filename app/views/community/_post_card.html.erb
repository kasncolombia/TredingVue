<div class="glass rounded-2xl p-4 hover:shadow-lg transition-shadow">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
      <%= post.user&.name&.first&.upcase || post.user&.email&.first&.upcase || "?" %>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-bold text-slate-800 dark:text-white truncate"><%= post.user&.name || post.user&.email || "Anónimo" %></p>
      <p class="text-[10px] text-slate-400">hace <%= time_ago_in_words(post.created_at) %></p>
    </div>
    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full flex-shrink-0 <%= post.visibility == 'public' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : post.visibility == 'friends' ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'bg-slate-500/10 text-slate-500' %>">
      <%= post.visibility == 'public' ? '🌐 Público' : post.visibility == 'friends' ? '👥 Seguidores' : '🔒 Privado' %>
    </span>
  </div>
  <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-3 break-words"><%= post.content %></p>
  <div class="flex items-center gap-4 mb-3 text-xs text-slate-500 dark:text-slate-400">
    <span class="flex items-center gap-1">👍 <%= post.reactions.where(reaction_type: 'like').count %></span>
    <span class="flex items-center gap-1">❤️ <%= post.reactions.where(reaction_type: 'heart').count %></span>
    <span class="flex items-center gap-1">🔥 <%= post.reactions.where(reaction_type: 'fire').count %></span>
    <span class="flex items-center gap-1">💬 <%= post.comments.count %> comentarios</span>
  </div>
  <% if post.comments.any? %>
    <div class="border-t border-slate-200 dark:border-darkBorder pt-3 mb-3 space-y-2">
      <% post.comments.includes(:user).limit(3).each do |comment| %>
        <div class="flex gap-2">
          <div class="w-6 h-6 rounded-full bg-indigo-100 dark:bg-darkCard flex items-center justify-center text-[10px] font-bold text-indigo-600 dark:text-indigo-400 flex-shrink-0">
            <%= comment.user&.name&.first&.upcase || "?" %>
          </div>
          <div class="min-w-0">
            <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300"><%= comment.user&.name || "Anónimo" %></span>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 break-words"><%= comment.content %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="flex items-center gap-2 border-t border-slate-200 dark:border-darkBorder pt-3">
    <%= link_to community_feed_path(post), class: "px-3 py-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-darkCard rounded-lg transition-all" do %>
      Ver detalle
    <% end %>
    <% if post.user == current_user %>
      <%= button_to community_feed_path(post), method: :delete, data: { turbo_confirm: "¿Eliminar esta publicación?" }, class: "px-3 py-1.5 text-xs font-semibold text-rose-500 hover:bg-rose-50 dark:hover:bg-darkCard rounded-lg transition-all cursor-pointer" do %>
        Eliminar
      <% end %>
    <% end %>
  </div>
</div>
