<%# app/views/community/_post_card.html.erb %>
<div class="glass rounded-3xl p-5 hover:shadow-xl border dark:border-darkBorder border-lightBorder transition-all duration-300">
  <!-- AUTHOR & VISIBILITY -->
  <div class="flex items-center gap-3 mb-3.5">
    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white font-extrabold text-sm shadow-md shadow-brand/20 flex-shrink-0">
      <%= post.user&.name&.first&.upcase || post.user&.email&.first&.upcase || "?" %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <p class="text-sm font-bold text-slate-900 dark:text-white truncate"><%= post.user&.name || post.user&.email || "Anónimo" %></p>
        <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-brand/10 text-brand border border-brand/20">Trader</span>
      </div>
      <p class="text-[11px] text-slate-400 font-medium">hace <%= time_ago_in_words(post.created_at) %></p>
    </div>

    <!-- VISIBILITY BADGE -->
    <span class="text-[10px] font-extrabold px-3 py-1 rounded-full flex items-center gap-1.5 flex-shrink-0 border <%= post.visibility == 'public' ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : post.visibility == 'friends' ? 'bg-amber-500/10 text-amber-500 border-amber-500/20' : 'bg-slate-500/10 text-slate-400 border-slate-500/20' %>">
      <span class="material-symbols-outlined text-[13px]">
        <%= post.visibility == 'public' ? 'public' : post.visibility == 'friends' ? 'group' : 'lock' %>
      </span>
      <span><%= post.visibility == 'public' ? 'Público' : post.visibility == 'friends' ? 'Seguidores' : 'Privado' %></span>
    </span>
  </div>

  <!-- CONTENT -->
  <p class="text-sm dark:text-slate-200 text-slate-700 leading-relaxed mb-4 break-words font-normal">
    <%= post.content %>
  </p>

  <!-- REACTIONS BAR -->
  <div class="flex items-center gap-4 mb-3.5 text-xs text-slate-500 dark:text-slate-400 border-t border-b dark:border-darkBorder border-lightBorder py-2.5">
    <button class="flex items-center gap-1.5 hover:text-brand transition-colors font-medium">
      <span class="material-symbols-outlined text-[16px] text-emerald-500">thumb_up</span>
      <span><%= post.reactions.where(reaction_type: 'like').count %></span>
    </button>
    <button class="flex items-center gap-1.5 hover:text-rose-500 transition-colors font-medium">
      <span class="material-symbols-outlined text-[16px] text-rose-500">favorite</span>
      <span><%= post.reactions.where(reaction_type: 'heart').count %></span>
    </button>
    <button class="flex items-center gap-1.5 hover:text-amber-500 transition-colors font-medium">
      <span class="material-symbols-outlined text-[16px] text-amber-500">local_fire_department</span>
      <span><%= post.reactions.where(reaction_type: 'fire').count %></span>
    </button>
    <div class="ml-auto flex items-center gap-1 text-[11px] font-medium text-slate-400">
      <span class="material-symbols-outlined text-[15px]">chat_bubble</span>
      <span><%= post.comments.count %> comentarios</span>
    </div>
  </div>

  <!-- COMMENTS PREVIEW -->
  <% if post.comments.any? %>
    <div class="pt-1 mb-3 space-y-2.5">
      <% post.comments.includes(:user).limit(3).each do |comment| %>
        <div class="flex gap-2.5 items-start p-2.5 rounded-2xl dark:bg-darkInput/60 bg-slate-100/70 border dark:border-darkBorder border-slate-200/50">
          <div class="w-6 h-6 rounded-full bg-brand/20 text-brand font-bold text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5">
            <%= comment.user&.name&.first&.upcase || "?" %>
          </div>
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold text-slate-900 dark:text-white"><%= comment.user&.name || "Anónimo" %></span>
            <p class="text-xs text-slate-600 dark:text-slate-300 break-words leading-snug"><%= comment.content %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- FOOTER ACTIONS -->
  <div class="flex items-center justify-between pt-1">
    <%= link_to community_feed_path(post), class: "px-3.5 py-1.5 text-xs font-bold text-brand hover:bg-brand/10 rounded-xl transition-all flex items-center gap-1" do %>
      <span>Ver conversación completa</span>
      <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
    <% end %>

    <% if post.user == current_user %>
      <%= button_to community_feed_path(post), method: :delete, data: { turbo_confirm: "¿Eliminar esta publicación?" }, class: "px-3 py-1.5 text-xs font-bold text-loss hover:bg-loss/10 rounded-xl transition-all cursor-pointer flex items-center gap-1" do %>
        <span class="material-symbols-outlined text-[15px]">delete</span>
        <span>Eliminar</span>
      <% end %>
    <% end %>
  </div>
</div>
