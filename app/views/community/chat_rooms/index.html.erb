<% content_for :page_title, "Chat en Vivo" %>

<div class="fade-in">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-black text-slate-800 dark:text-white">💬 Chat Comunitario</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Conecta con otros traders en tiempo real</p>
    </div>
    <%= link_to new_community_chat_room_path, class: "px-4 py-2 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-500/30 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nuevo Salón
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <!-- SALONS LIST -->
    <div class="lg:col-span-1 glass rounded-2xl p-4">
      <h3 class="text-sm font-bold text-slate-800 dark:text-white mb-3">Salones Activos</h3>
      <div class="space-y-2">
        <% @chat_rooms.each do |room| %>
          <%= link_to community_chat_room_path(room), class: "flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-50 dark:hover:bg-darkCard transition-all group" do %>
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
              <%= room.name[0].upcase %>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-800 dark:text-white"><%= room.name %></p>
              <p class="text-[10px] text-slate-400"><%= room.messages.count %> mensajes</p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- CHAT AREA -->
    <div class="lg:col-span-2 glass rounded-2xl flex flex-col h-[500px] overflow-hidden">
      <div class="p-4 border-b border-slate-200 dark:border-darkBorder flex items-center justify-between bg-slate-50/50 dark:bg-darkSidebar/40">
        <div>
          <h3 class="text-sm font-bold text-slate-800 dark:text-white"><%= @chat_room.name %></h3>
          <p class="text-[10px] text-emerald-500 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> En vivo
          </p>
        </div>
      </div>

      <!-- MESSAGES -->
      <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
        <% @messages.each do |message| %>
          <div class="flex gap-2 items-start <%= message.user_id == current_user.id ? 'justify-end' : '' %>">
            <% unless message.user_id == current_user.id %>
              <div class="w-6 h-6 rounded-full bg-indigo-100 dark:bg-darkCard flex items-center justify-center text-[10px] font-bold text-indigo-600 flex-shrink-0">
                <%= message.user.name&.first&.upcase %>
              </div>
            <% end %>
            <div class="p-2.5 rounded-2xl max-w-[80%] <%= message.user_id == current_user.id ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white rounded-tr-none' : 'bg-slate-100 dark:bg-darkSidebar border border-slate-200 dark:border-darkBorder text-slate-700 dark:text-slate-200' %>">
              <%= message.content %>
              <p class="text-[9px] mt-1 opacity-60"><%= time_ago_in_words(message.created_at) %> ago</p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- INPUT -->
      <div class="p-3 border-t border-slate-200 dark:border-darkBorder bg-slate-50 dark:bg-darkSidebar">
        <%= form_with model: [@chat_room, @chat_room.messages.build], url: community_chat_room_messages_path(@chat_room), local: true, class: "flex gap-2" do |f| %>
          <%= f.text_area :content, rows: 1, placeholder="Escribe un mensaje...", class: "input-field flex-1 px-3 py-2 rounded-xl text-xs transition-all focus:outline-none" %>
          <%= f.submit "Enviar", class: "px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-500/30 transition-all cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>