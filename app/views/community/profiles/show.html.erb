<% content_for :page_title, "Perfil Público" %>

<div class="space-y-6 fade-in">
  <!-- PROFILE HEADER CARD -->
  <div class="glass rounded-3xl p-6 border dark:border-darkBorder border-lightBorder relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="flex flex-col sm:flex-row items-center gap-6 relative z-10">
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white font-black text-3xl shadow-xl shadow-brand/20 border-2 border-white/20 flex-shrink-0">
        <%= @user.name&.first&.upcase || "?" %>
      </div>
      <div class="flex-1 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <h1 class="text-2xl font-black dark:text-white text-slate-900"><%= @user.name || "Anónimo" %></h1>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-brand bg-brand/10 px-2.5 py-0.5 rounded-full border border-brand/20 self-center sm:self-auto">
            <span class="material-symbols-outlined text-[14px]">verified</span> Trader Verificado
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1 font-mono"><%= @user.email %></p>

        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 mt-3">
          <div class="flex items-center gap-1.5 text-xs text-slate-400">
            <span class="material-symbols-outlined text-brand text-[16px]">show_chart</span>
            <span class="font-bold dark:text-white text-slate-800"><%= @stats[:total_trades] %></span> trades
          </div>
          <div class="flex items-center gap-1.5 text-xs text-slate-400">
            <span class="material-symbols-outlined text-emerald-500 text-[16px]">emoji_events</span>
            <span class="font-bold text-emerald-500 font-mono"><%= @stats[:win_rate] %>%</span> Win Rate
          </div>
          <div class="flex items-center gap-1.5 text-xs text-slate-400">
            <span class="material-symbols-outlined text-emerald-500 text-[16px]">payments</span>
            <span class="font-bold font-mono <%= @stats[:total_pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
              <%= @stats[:total_pnl] >= 0 ? "+" : "" %>$<%= number_with_precision(@stats[:total_pnl], precision: 2, delimiter: ',') %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS GRID -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="stat-card rounded-2xl p-4">
      <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Operaciones</p>
      <p class="text-2xl font-black dark:text-white text-slate-900 font-mono mt-1"><%= @stats[:total_trades] %></p>
    </div>
    <div class="stat-card rounded-2xl p-4">
      <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tasa de Ganancia</p>
      <p class="text-2xl font-black text-emerald-500 font-mono mt-1"><%= @stats[:win_rate] %>%</p>
    </div>
    <div class="stat-card rounded-2xl p-4">
      <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Operaciones Verdes</p>
      <p class="text-2xl font-black text-emerald-500 font-mono mt-1"><%= @stats[:win_trades] %></p>
    </div>
    <div class="stat-card rounded-2xl p-4">
      <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Operaciones Rojas</p>
      <p class="text-2xl font-black text-rose-500 font-mono mt-1"><%= @stats[:loss_trades] %></p>
    </div>
  </div>

  <!-- RECENT TRADES TABULAR -->
  <div class="glass rounded-3xl overflow-hidden border dark:border-darkBorder border-lightBorder">
    <div class="px-6 py-4 border-b dark:border-darkBorder border-lightBorder flex items-center justify-between">
      <p class="text-sm font-bold dark:text-white text-slate-900">Operaciones Recientes Públicas</p>
      <span class="text-xs text-slate-400"><%= @trades.count %> registradas</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead class="table-header">
          <tr>
            <th class="py-3.5 px-5 text-left text-[10px] font-extrabold text-slate-400 uppercase">Activo</th>
            <th class="py-3.5 px-5 text-left text-[10px] font-extrabold text-slate-400 uppercase">Dirección</th>
            <th class="py-3.5 px-5 text-right text-[10px] font-extrabold text-slate-400 uppercase">P&L ($)</th>
            <th class="py-3.5 px-5 text-center text-[10px] font-extrabold text-slate-400 uppercase">Resultado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-darkBorder/60">
          <% @trades.each do |trade| %>
          <tr class="table-row-hover cursor-pointer" onclick="location.href='<%= trade_path(trade) %>'">
            <td class="py-4 px-5 font-black dark:text-white text-slate-900 font-mono"><%= trade.symbol %></td>
            <td class="py-4 px-5">
              <span class="inline-flex items-center gap-1 text-xs font-black px-2.5 py-0.5 rounded-full <%= trade.direction == 'LONG' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20' %>">
                <span class="material-symbols-outlined text-[13px]"><%= trade.direction == 'LONG' ? 'arrow_upward' : 'arrow_downward' %></span>
                <%= trade.direction %>
              </span>
            </td>
            <td class="py-4 px-5 text-right font-black font-mono <%= trade.pnl >= 0 ? "text-emerald-500" : "text-rose-500" %>">
              <%= trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(trade.pnl, precision: 2) %>
            </td>
            <td class="py-4 px-5 text-center">
              <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full <%= trade.result == 'WIN' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500' %>">
                <span class="material-symbols-outlined text-[13px]"><%= trade.result == 'WIN' ? 'check_circle' : 'cancel' %></span>
                <%= trade.result %>
              </span>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>