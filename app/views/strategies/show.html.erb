<% content_for :page_title, @strategy.name %>

<div class="max-w-4xl mx-auto fade-in space-y-5">
  <!-- BREADCRUMB -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <%= link_to "Estrategias", strategies_path, class: "hover:text-indigo-500 transition-colors" %>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-slate-600 dark:text-slate-300 font-semibold"><%= @strategy.name %></span>
    </div>
    <div class="flex gap-2">
      <%= link_to edit_strategy_path(@strategy), class: "flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-xl border border-amber-500/20 transition-all" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
      <%= link_to @strategy, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta estrategia?" },
          class: "flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-500/10 hover:bg-rose-500/20 rounded-xl border border-rose-500/20 transition-all" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Eliminar
      <% end %>
    </div>
  </div>

  <% trades = current_user.trades.where(strategy_id: @strategy.id) %>
  <% stats  = Trading::CalculateStatistics.new(trades).call %>

  <!-- HEADER -->
  <div class="glass rounded-2xl p-6">
    <div class="flex items-center justify-between mb-3">
      <h1 class="text-2xl font-black text-slate-800 dark:text-white"><%= @strategy.name %></h1>
      <% if @strategy.market.present? %>
        <span class="text-xs px-2.5 py-1 rounded-md font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20"><%= @strategy.market %></span>
      <% end %>
    </div>
    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-5"><%= @strategy.description.presence || "Sin descripción registrada." %></p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg/60 border border-slate-100 dark:border-darkBorder/50">
        <p class="text-[10px] text-slate-400 uppercase">Total Operaciones</p>
        <p class="text-base font-bold text-slate-800 dark:text-white"><%= stats[:total_trades] %></p>
      </div>
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg/60 border border-slate-100 dark:border-darkBorder/50">
        <p class="text-[10px] text-slate-400 uppercase">Win Rate</p>
        <p class="text-base font-bold text-indigo-600 dark:text-indigo-400"><%= stats[:win_rate] %>%</p>
      </div>
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg/60 border border-slate-100 dark:border-darkBorder/50">
        <p class="text-[10px] text-slate-400 uppercase">Profit Factor</p>
        <p class="text-base font-bold text-slate-800 dark:text-white"><%= stats[:profit_factor] %></p>
      </div>
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg/60 border border-slate-100 dark:border-darkBorder/50">
        <p class="text-[10px] text-slate-400 uppercase">P&L Total</p>
        <p class="text-base font-bold <%= stats[:total_pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
          <%= stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(stats[:total_pnl], precision: 2) %>
        </p>
      </div>
    </div>
  </div>

  <!-- OPERACIONES ASOCIADAS -->
  <div class="glass rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-bold text-slate-800 dark:text-white">Operaciones de <%= @strategy.name %></h3>
      <%= link_to trades_path(strategy_id: @strategy.id), class: "text-xs text-indigo-600 dark:text-indigo-400 font-semibold hover:underline" do %>
        Ver filtradas en diario →
      <% end %>
    </div>

    <% if trades.empty? %>
      <p class="text-xs text-slate-400 italic py-4 text-center">No hay operaciones registradas con esta estrategia aún.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="table-header">
            <tr class="border-b border-slate-200 dark:border-darkBorder">
              <th class="py-2.5 px-3">Fecha</th>
              <th class="py-2.5 px-3">Activo</th>
              <th class="py-2.5 px-3">Dirección</th>
              <th class="py-2.5 px-3 text-right">P&L</th>
              <th class="py-2.5 px-3 text-center">Resultado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
            <% trades.recent.limit(5).each do |trade| %>
              <tr>
                <td class="py-2.5 px-3 text-slate-400"><%= trade.entry_at&.strftime("%d/%m/%y %H:%M") || "—" %></td>
                <td class="py-2.5 px-3 font-bold text-slate-800 dark:text-white"><%= link_to trade.symbol, trade_path(trade), class: "hover:underline" %></td>
                <td class="py-2.5 px-3"><%= direction_badge(trade.direction) %></td>
                <td class="py-2.5 px-3 text-right font-black <%= pnl_class(trade.pnl) %>">$<%= trade.pnl %></td>
                <td class="py-2.5 px-3 text-center"><%= result_badge(trade.result || "—") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
