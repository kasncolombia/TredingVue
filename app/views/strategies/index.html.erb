<% content_for :page_title, "Estrategias de Trading" %>
<% content_for :badge do %>
  <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20"><%= @strategies.size %> registradas</span>
<% end %>

<div class="space-y-5 fade-in">

  <!-- CABECERA -->
  <div class="glass p-5 rounded-2xl flex items-center justify-between">
    <div>
      <h2 class="text-sm font-bold text-slate-800 dark:text-white">Tus Planes de Trading y Setups</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">Organiza y evalúa el rendimiento de cada estrategia por separado</p>
    </div>
    <%= link_to new_strategy_path, class: "px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-500/20 transition-all flex items-center gap-1.5" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      Nueva Estrategia
    <% end %>
  </div>

  <!-- CARDS DE ESTRATEGIAS -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @strategies.each do |strategy| %>
      <% trades = current_user.trades.where(strategy_id: strategy.id) %>
      <% stats  = Trading::CalculateStatistics.new(trades).call %>
      <div class="stat-card rounded-2xl p-5 flex flex-col justify-between group hover:scale-[1.01] transition-all duration-200">
        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-base font-bold text-slate-800 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"><%= strategy.name %></h3>
            <% if strategy.market.present? %>
              <span class="text-[10px] px-2 py-0.5 rounded-md font-semibold bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-darkBorder"><%= strategy.market %></span>
            <% end %>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mb-4"><%= strategy.description.presence || "Sin descripción definida." %></p>

          <!-- STATS MINI GRID -->
          <div class="grid grid-cols-3 gap-2 p-3 rounded-xl bg-slate-50 dark:bg-darkBg/60 border border-slate-100 dark:border-darkBorder/50 text-center mb-4">
            <div>
              <p class="text-[9px] uppercase tracking-wider text-slate-400">Trades</p>
              <p class="text-sm font-bold text-slate-800 dark:text-white"><%= stats[:total_trades] %></p>
            </div>
            <div>
              <p class="text-[9px] uppercase tracking-wider text-slate-400">Win Rate</p>
              <p class="text-sm font-bold text-indigo-600 dark:text-indigo-400"><%= stats[:win_rate] %>%</p>
            </div>
            <div>
              <p class="text-[9px] uppercase tracking-wider text-slate-400">P&L</p>
              <p class="text-sm font-bold <%= stats[:total_pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                <%= stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(stats[:total_pnl], precision: 0) %>
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-darkBorder/50 text-xs">
          <%= link_to trades_path(strategy_id: strategy.id), class: "text-indigo-600 dark:text-indigo-400 font-semibold hover:underline" do %>
            Ver trades →
          <% end %>
          <div class="flex items-center gap-2">
            <%= link_to edit_strategy_path(strategy), class: "text-slate-400 hover:text-amber-500 transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <% end %>
            <%= link_to strategy, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta estrategia?" }, class: "text-slate-400 hover:text-rose-500 transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @strategies.empty? %>
      <div class="col-span-full glass rounded-2xl p-12 text-center text-slate-400">
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center text-xl font-bold">🎯</div>
          <p class="font-bold text-slate-700 dark:text-slate-300">No tienes estrategias registradas</p>
          <p class="text-xs">Crea tu primera estrategia para clasificar y evaluar tus operaciones.</p>
          <%= link_to new_strategy_path, class: "mt-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-md transition-all" do %>
            + Crear Estrategia
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
