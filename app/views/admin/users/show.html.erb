<% content_for :page_title, "Detalle de Usuario" %>

<div class="mb-4 flex items-center justify-between">
  <%= link_to admin_users_path, class: "text-xs font-semibold text-slate-500 hover:text-brand flex items-center gap-1 w-max transition-colors" do %>
    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
    Volver a Usuarios
  <% end %>
  <%= link_to edit_admin_user_path(@user), class: "px-3 py-1.5 text-xs font-bold bg-brand hover:bg-brand-hover text-white rounded-xl glow-brand transition-all flex items-center gap-1" do %>
    <span class="material-symbols-outlined text-[16px]">edit</span>
    Editar
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <!-- Perfil Principal -->
  <div class="md:col-span-1 space-y-6">
    <div class="p-6 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm text-center">
      <div class="w-20 h-20 mx-auto rounded-full bg-brand/10 text-brand flex items-center justify-center font-bold text-2xl mb-4 border border-brand/20">
        <%= @user.email.first.upcase %>
      </div>
      <h3 class="text-xl font-bold dark:text-white text-slate-900"><%= @user.name.presence || "Sin Nombre" %></h3>
      <p class="text-sm text-slate-500 mb-4"><%= @user.email %></p>
      
      <div class="flex justify-center mb-6">
        <% if @user.admin? %>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand/10 text-brand border border-brand/20 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">shield</span> ADMIN
          </span>
        <% else %>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300">USER</span>
        <% end %>
      </div>

      <div class="pt-4 border-t dark:border-darkBorder border-lightBorder text-left space-y-3">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-500">Miembro desde</span>
          <p class="text-sm font-semibold dark:text-slate-300"><%= @user.created_at.strftime("%d %b %Y") %></p>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-500">Zona horaria</span>
          <p class="text-sm font-semibold dark:text-slate-300"><%= @user.timezone %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Métricas de Trading -->
  <div class="md:col-span-2 space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Trades -->
      <div class="p-4 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm">
        <div class="text-[10px] uppercase font-bold text-slate-500 mb-1 flex items-center justify-between">
          Operaciones
          <span class="material-symbols-outlined text-slate-400 text-[14px]">swap_horiz</span>
        </div>
        <div class="text-2xl font-extrabold dark:text-white text-slate-900"><%= @user.trade_count %></div>
      </div>
      <!-- Win Rate -->
      <div class="p-4 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm">
        <div class="text-[10px] uppercase font-bold text-slate-500 mb-1 flex items-center justify-between">
          Win Rate
          <span class="material-symbols-outlined text-profit text-[14px]">donut_large</span>
        </div>
        <div class="text-2xl font-extrabold <%= @user.win_rate > 50 ? 'text-profit' : (@user.win_rate == 0 ? 'text-slate-500' : 'text-loss') %>">
          <%= number_to_percentage(@user.win_rate, precision: 1) %>
        </div>
      </div>
      <!-- P&L -->
      <div class="p-4 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm">
        <div class="text-[10px] uppercase font-bold text-slate-500 mb-1 flex items-center justify-between">
          P&L Neto
          <span class="material-symbols-outlined <%= @user.total_pnl >= 0 ? 'text-profit' : 'text-loss' %> text-[14px]">account_balance_wallet</span>
        </div>
        <div class="text-2xl font-extrabold <%= @user.total_pnl >= 0 ? 'text-profit' : 'text-loss' %>">
          <%= number_to_currency(@user.total_pnl) %>
        </div>
      </div>
    </div>

    <!-- Stats adicionales -->
    <div class="p-6 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm">
      <h4 class="text-sm font-bold dark:text-white text-slate-800 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-brand">data_usage</span> Datos en Sistema
      </h4>
      <ul class="space-y-3">
        <li class="flex justify-between items-center py-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="text-xs text-slate-500 font-semibold">Estrategias Creadas</span>
          <span class="text-xs font-bold dark:text-white"><%= @user.strategies.count %></span>
        </li>
        <li class="flex justify-between items-center py-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="text-xs text-slate-500 font-semibold">Interacciones con AI Coach</span>
          <span class="text-xs font-bold dark:text-white"><%= @user.ai_conversations.count %></span>
        </li>
        <li class="flex justify-between items-center py-2">
          <span class="text-xs text-slate-500 font-semibold">Posts en Comunidad</span>
          <span class="text-xs font-bold dark:text-white"><%= @user.posts.count %></span>
        </li>
      </ul>
    </div>
  </div>
</div>
