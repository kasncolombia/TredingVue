<% content_for :page_title, "Editar Usuario" %>

<div class="mb-4">
  <%= link_to admin_users_path, class: "text-xs font-semibold text-slate-500 hover:text-brand flex items-center gap-1 w-max transition-colors" do %>
    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
    Volver a Usuarios
  <% end %>
</div>

<div class="max-w-2xl mx-auto">
  <div class="p-6 rounded-2xl dark:bg-darkCard bg-white border dark:border-darkBorder border-lightBorder shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center shadow-lg glow-brand font-bold text-sm">
        <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
      </div>
      <div>
        <h3 class="text-lg font-bold dark:text-white text-slate-900">Editar Perfil de Usuario</h3>
        <p class="text-xs text-slate-500"><%= @user.email %></p>
      </div>
    </div>

    <%= form_with(model: [:admin, @user], local: true, data: { turbo: false }, class: "space-y-4") do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-loss/10 border border-loss/20 p-4 rounded-xl mb-6">
          <div class="text-loss text-sm font-bold flex items-center gap-1.5 mb-2">
            <span class="material-symbols-outlined text-[18px]">error</span>
            No se pudo guardar:
          </div>
          <ul class="text-xs text-loss/80 list-disc pl-5">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Nombre completo", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" %>
          <%= f.text_field :name, class: "w-full py-2.5 rounded-xl border border-lightBorder dark:border-darkBorder bg-slate-50/50 dark:bg-darkInput text-sm dark:text-white focus:ring-2 focus:ring-brand/40 focus:border-brand focus:outline-none transition-all" %>
        </div>
        
        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" %>
          <%= f.email_field :email, class: "w-full py-2.5 rounded-xl border border-lightBorder dark:border-darkBorder bg-slate-50/50 dark:bg-darkInput text-sm dark:text-white focus:ring-2 focus:ring-brand/40 focus:border-brand focus:outline-none transition-all" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t dark:border-darkBorder border-lightBorder">
        <div>
          <%= f.label :role, "Rol en el Sistema", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" %>
          <%= f.select :role, User.roles.keys.map { |r| [r.humanize.upcase, r] }, {}, class: "w-full py-2.5 rounded-xl border border-lightBorder dark:border-darkBorder bg-slate-50/50 dark:bg-darkInput text-sm dark:text-white focus:ring-2 focus:ring-brand/40 focus:border-brand focus:outline-none transition-all" %>
        </div>

        <div>
          <%= f.label :timezone, "Zona Horaria", class: "block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5" %>
          <%= f.time_zone_select :timezone, nil, {}, class: "w-full py-2.5 rounded-xl border border-lightBorder dark:border-darkBorder bg-slate-50/50 dark:bg-darkInput text-sm dark:text-white focus:ring-2 focus:ring-brand/40 focus:border-brand focus:outline-none transition-all" %>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-6">
        <%= link_to "Cancelar", admin_users_path, class: "px-4 py-2 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-darkHover rounded-xl transition-all" %>
        <%= f.submit "Guardar Cambios", class: "px-4 py-2 text-sm font-bold bg-brand hover:bg-brand-hover text-white rounded-xl glow-brand transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
