<% content_for :page_title, "Importar CSV" %>

<div class="max-w-xl mx-auto fade-in space-y-5">

  <!-- BREADCRUMB -->
  <div class="flex items-center gap-2 text-xs text-slate-400">
    <%= link_to "Operaciones", trades_path, class: "hover:text-indigo-500 transition-colors" %>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-600 dark:text-slate-300 font-semibold">Importar CSV</span>
  </div>

  <div class="glass rounded-2xl p-6 space-y-5">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">
        📁
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-800 dark:text-white">Importación Masiva de Trades</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Sube tus operaciones desde MetaTrader, TradingView o Excel</p>
      </div>
    </div>

    <%= form_with url: import_csv_trades_path, method: :post, multipart: true, local: true, class: "space-y-4" do |f| %>

      <!-- DROPZONE -->
      <div class="border-2 border-dashed border-slate-300 dark:border-darkBorder hover:border-indigo-500 dark:hover:border-indigo-500 rounded-2xl p-8 text-center transition-all bg-slate-50/50 dark:bg-darkBg/50 group cursor-pointer" onclick="document.getElementById('csv_file').click()">
        <svg class="w-10 h-10 mx-auto text-slate-400 group-hover:text-indigo-500 transition-colors mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
        <p class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Arrastra tu archivo CSV aquí o haz clic para examinar</p>
        <p class="text-[10px] text-slate-400">Formatos aceptados: .csv (Columnas: symbol, direction, entry_price, exit_price, pnl, entry_at)</p>
        <input type="file" name="csv_file" id="csv_file" accept=".csv" class="hidden" onchange="updateFileName(this)">
        <p id="file-name" class="mt-3 text-xs font-bold text-indigo-600 dark:text-indigo-400 hidden"></p>
      </div>

      <!-- BOTONES -->
      <div class="flex items-center justify-end gap-3 pt-2">
        <%= link_to "Cancelar", trades_path, class: "px-4 py-2.5 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkCard transition-all" %>
        <%= f.submit "🚀 Importar Operaciones",
            class: "px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-500/20 cursor-pointer transition-all" %>
      </div>
    <% end %>

    <!-- FORMATO FORMAT HELPER -->
    <div class="p-4 rounded-xl bg-slate-100 dark:bg-darkSidebar/50 border border-slate-200 dark:border-darkBorder space-y-2">
      <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Formato del archivo CSV:</p>
      <div class="overflow-x-auto">
        <code class="text-[11px] text-indigo-600 dark:text-indigo-300 font-mono block bg-slate-200 dark:bg-darkBg p-2.5 rounded-lg">
          symbol,direction,entry_price,exit_price,pnl,entry_at<br>
          BTC/USDT,LONG,62000,64500,2500,2026-09-01 14:30<br>
          EURUSD,SHORT,1.0850,1.0820,300,2026-09-02 09:15
        </code>
      </div>
    </div>
  </div>

</div>

<script>
function updateFileName(input) {
  const el = document.getElementById("file-name");
  if (input.files && input.files[0]) {
    el.textContent = "📄 " + input.files[0].name;
    el.classList.remove("hidden");
  }
}
</script>
