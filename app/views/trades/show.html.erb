<% content_for :page_title, "#{@trade.symbol} • Detalle de Operación" %>

<div class="max-w-6xl mx-auto space-y-6 fade-in">

  <!-- ===================== BREADCRUMB & ACCIONES ===================== -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <%= link_to trades_path, class: "hover:text-brand transition-colors flex items-center gap-1" do %>
        <span class="material-symbols-outlined text-[15px]">arrow_back</span>
        <span>Operaciones</span>
      <% end %>
      <span>/</span>
      <span class="dark:text-white text-slate-800 font-bold"><%= @trade.symbol %></span>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to edit_trade_path(@trade), class: "px-3 py-1.5 text-xs font-bold text-amber-500 bg-amber-500/10 hover:bg-amber-500/20 rounded-xl border border-amber-500/20 transition-all flex items-center gap-1.5" do %>
        <span class="material-symbols-outlined text-[16px]">edit</span>
        <span>Editar</span>
      <% end %>
      <%= link_to @trade, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta operación?" },
          class: "px-3 py-1.5 text-xs font-bold text-loss bg-loss/10 hover:bg-loss/20 rounded-xl border border-loss/20 transition-all flex items-center gap-1.5" do %>
        <span class="material-symbols-outlined text-[16px]">delete</span>
        <span>Eliminar</span>
      <% end %>
    </div>
  </div>

  <!-- ===================== HEADER SUMMARY CARD ===================== -->
  <div class="glass rounded-2xl p-6 border-l-4 <%= @trade.pnl >= 0 ? 'border-accent-green' : 'border-loss' %>">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-black dark:text-white text-slate-900 tracking-tight"><%= @trade.symbol %></h1>
          <span class="px-3 py-1 rounded-full text-xs font-extrabold <%= @trade.direction == 'LONG' ? 'badge-long' : 'badge-short' %>">
            <%= @trade.direction %>
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-extrabold <%= @trade.pnl >= 0 ? 'badge-win' : 'badge-loss' %>">
            <%= @trade.result || (@trade.pnl >= 0 ? "WIN" : "LOSS") %>
          </span>
        </div>
        <p class="text-xs text-slate-400">
          Entrada: <strong><%= @trade.entry_at&.strftime("%d %b %Y %H:%M") || "—" %></strong>
          <% if @trade.exit_at %> • Salida: <strong><%= @trade.exit_at.strftime("%d %b %Y %H:%M") %></strong><% end %>
        </p>
      </div>

      <div class="text-right">
        <p class="text-3xl font-black font-mono <%= pnl_class(@trade.pnl) %>">
          <%= @trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(@trade.pnl, precision: 2, delimiter: ',') %>
        </p>
        <p class="text-xs text-slate-400 font-medium">P&L Neto Realizado</p>
      </div>
    </div>

    <!-- R MULTIPLE BAR -->
    <% if @trade.r_multiple %>
    <div class="mt-5 pt-4 border-t dark:border-darkBorder border-lightBorder">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-400">R Multiple Logrado</span>
        <span class="text-sm font-black font-mono <%= @trade.r_multiple.to_f >= 0 ? 'text-accent-green' : 'text-loss' %>">
          <%= @trade.r_multiple %>R
        </span>
      </div>
      <div class="relative h-2 bg-slate-200 dark:bg-darkInput rounded-full overflow-hidden">
        <% pct = [[@trade.r_multiple.to_f.abs / 3.0 * 50, 50].min, 0].max %>
        <div class="absolute top-0 h-2 rounded-full transition-all duration-1000 <%= @trade.r_multiple.to_f >= 0 ? 'bg-accent-green left-1/2' : 'bg-loss right-1/2' %>" style="width:<%= pct %>%"></div>
        <div class="absolute top-0 left-1/2 w-0.5 h-2 bg-slate-400"></div>
      </div>
    </div>
    <% end %>
  </div>

  <!-- ===================== TRADINGVIEW LIGHTWEIGHT CHARTS CANDLESTICK ===================== -->
  <div class="glass rounded-2xl p-5 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
      <div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-brand text-[20px]">candlestick_chart</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Gráfico Interactivo de Velas (TradingView Lightweight Charts)</h3>
        </div>
        <p class="text-[11px] text-slate-400">Puntos exactos de Entrada, Stop Loss y Take Profit</p>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <span class="flex items-center gap-1 text-accent-green font-bold">
          <span class="w-2.5 h-2.5 rounded-full bg-accent-green"></span> Entry: $<%= @trade.entry_price %>
        </span>
        <% if @trade.stop_loss %>
          <span class="flex items-center gap-1 text-loss font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-loss"></span> SL: $<%= @trade.stop_loss %>
          </span>
        <% end %>
        <% if @trade.take_profit %>
          <span class="flex items-center gap-1 text-brand font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-brand"></span> TP: $<%= @trade.take_profit %>
          </span>
        <% end %>
      </div>
    </div>

    <!-- TRADINGVIEW CONTAINER -->
    <div id="tradingview-candlestick-container" class="w-full h-96 rounded-xl overflow-hidden"></div>
  </div>

  <!-- ===================== TECHNICAL DETAILS & AI COACH ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- DATOS TÉCNICOS -->
    <div class="glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
        <span class="material-symbols-outlined text-brand text-[20px]">tune</span>
        <h3 class="text-sm font-bold dark:text-white text-slate-800">Parámetros Técnicos</h3>
      </div>
      <dl class="space-y-3 text-xs">
        <% [
          ["Símbolo / Par",   @trade.symbol],
          ["Dirección",       @trade.direction],
          ["Precio Entrada",  @trade.entry_price ? "$#{@trade.entry_price}" : "—"],
          ["Precio Salida",   @trade.exit_price  ? "$#{@trade.exit_price}"  : "—"],
          ["Stop Loss",       @trade.stop_loss   ? "$#{@trade.stop_loss}"   : "—"],
          ["Take Profit",     @trade.take_profit ? "$#{@trade.take_profit}" : "—"],
          ["Tamaño Posición", @trade.position_size || "—"],
          ["Comisión",        @trade.commission  ? "$#{@trade.commission}"  : "—"],
          ["Estrategia",      @trade.strategy&.name || "Sin asignar"],
          ["Setup",           @trade.setup || "—"],
          ["Estado Emocional",@trade.emotion || "—"],
        ].each do |label, value| %>
          <div class="flex items-center justify-between py-1 border-b dark:border-darkBorder/50 border-lightBorder/50">
            <dt class="text-slate-400"><%= label %></dt>
            <dd class="font-bold dark:text-slate-200 text-slate-800 text-right font-mono"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- NOTAS Y DIAGNÓSTICO AI -->
    <div class="space-y-6 flex flex-col">

      <!-- NOTAS Y REFLEXIÓN -->
      <div class="glass rounded-2xl p-5 space-y-3 flex-1">
        <div class="flex items-center gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="material-symbols-outlined text-brand text-[20px]">notes</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Notas y Bitácora</h3>
        </div>
        <% if @trade.notes.present? %>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed"><%= @trade.notes %></p>
        <% else %>
          <p class="text-xs text-slate-400 italic">No agregaste notas para esta operación.</p>
        <% end %>
      </div>

      <!-- AI COACH ANALYSIS -->
      <div class="glass rounded-2xl p-5 border-l-4 border-brand space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand text-[20px]">smart_toy</span>
            <h3 class="text-sm font-bold dark:text-white text-slate-800">Diagnóstico AI Coach</h3>
          </div>
          <% if @trade.ai_analysis.present? %>
            <span class="text-xs font-bold font-mono text-brand bg-brand/15 px-2.5 py-0.5 rounded-full border border-brand/20">
              Score: <%= @trade.ai_analysis.discipline_score %>/10
            </span>
          <% end %>
        </div>

        <% if @trade.ai_analysis.present? %>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            <%= @trade.ai_analysis.feedback %>
          </p>
          <% if @trade.ai_analysis.reflection_question %>
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-500 text-xs">
              <strong>💡 Reflexión Guiada:</strong> <%= @trade.ai_analysis.reflection_question %>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-400">Solicita un diagnóstico instantáneo con inteligencia artificial.</p>
          <button onclick="analyzeNow()" class="w-full py-2.5 rounded-xl bg-brand hover:bg-brand-hover text-white text-xs font-bold shadow-md glow-brand transition-all cursor-pointer flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">bolt</span>
            <span>Generar Diagnóstico AI</span>
          </button>
        <% end %>
      </div>

    </div>

  </div>

</div>

<!-- ===================== TRADINGVIEW LIGHTWEIGHT CHARTS SCRIPT ===================== -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const container = document.getElementById("tradingview-candlestick-container");
  if (!container) return;

  const isDark = document.getElementById("html-root").classList.contains("dark");

  const chart = LightweightCharts.createChart(container, {
    layout: {
      background: { color: isDark ? "#151724" : "#FFFFFF" },
      textColor: isDark ? "#9DA3B4" : "#64748B",
      fontFamily: "Manrope"
    },
    grid: {
      vertLines: { color: isDark ? "#23263A" : "#E3E6EF" },
      horzLines: { color: isDark ? "#23263A" : "#E3E6EF" }
    },
    crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
    rightPriceScale: { borderColor: isDark ? "#23263A" : "#E3E6EF" },
    timeScale: { borderColor: isDark ? "#23263A" : "#E3E6EF", timeVisible: true }
  });

  const candlestickSeries = chart.addCandlestickSeries({
    upColor: "#10B981",
    downColor: "#F43F5E",
    borderVisible: false,
    wickUpColor: "#10B981",
    wickDownColor: "#F43F5E"
  });

  // GENERAR DATOS DE VELAS REALISTAS ALREDEDOR DE LOS PRECIOS DE ENTRADA Y SALIDA
  const entryPrice = parseFloat("<%= @trade.entry_price || 100.0 %>");
  const exitPrice  = parseFloat("<%= @trade.exit_price || (@trade.entry_price ? @trade.entry_price * 1.02 : 102.0) %>");
  const stopLoss   = parseFloat("<%= @trade.stop_loss || (@trade.entry_price ? @trade.entry_price * 0.98 : 98.0) %>");
  const takeProfit = parseFloat("<%= @trade.take_profit || (@trade.entry_price ? @trade.entry_price * 1.05 : 105.0) %>");

  const baseTime = Math.floor(Date.now() / 1000) - (30 * 3600);
  const candleData = [];
  let currentPrice = entryPrice * 0.99;

  for (let i = 0; i < 30; i++) {
    const time = baseTime + (i * 3600);
    const open = currentPrice;
    let close = open + (Math.random() - 0.47) * (entryPrice * 0.008);
    if (i === 10) close = entryPrice; // Punto de entrada exacto
    if (i === 28) close = exitPrice;  // Punto de salida exacto

    const high = Math.max(open, close) + Math.random() * (entryPrice * 0.004);
    const low  = Math.min(open, close) - Math.random() * (entryPrice * 0.004);
    currentPrice = close;

    candleData.push({ time, open, high, low, close });
  }

  candlestickSeries.setData(candleData);

  // MARCADORES EN EL GRÁFICO (ENTRY & EXIT)
  candlestickSeries.setMarkers([
    {
      time: candleData[10].time,
      position: '<%= @trade.direction == "LONG" ? "belowBar" : "aboveBar" %>',
      color: '#10B981',
      shape: '<%= @trade.direction == "LONG" ? "arrowUp" : "arrowDown" %>',
      text: 'ENTRY $<%= @trade.entry_price %>'
    },
    {
      time: candleData[28].time,
      position: '<%= @trade.pnl >= 0 ? "aboveBar" : "belowBar" %>',
      color: '<%= @trade.pnl >= 0 ? "#10B981" : "#F43F5E" %>',
      shape: 'square',
      text: 'EXIT $<%= @trade.exit_price %> (<%= @trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(@trade.pnl, precision: 2) %>)'
    }
  ]);

  // LÍNEAS HORIZONTALES DE STOP LOSS & TAKE PROFIT
  if (stopLoss) {
    candlestickSeries.createPriceLine({
      price: stopLoss,
      color: '#F43F5E',
      lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Dashed,
      axisLabelVisible: true,
      title: 'Stop Loss'
    });
  }

  if (takeProfit) {
    candlestickSeries.createPriceLine({
      price: takeProfit,
      color: '#6C5CE7',
      lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Dashed,
      axisLabelVisible: true,
      title: 'Take Profit'
    });
  }

  chart.timeScale().fitContent();

  window.addEventListener('resize', () => {
    chart.applyOptions({ width: container.clientWidth });
  });
});

function analyzeNow() {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  fetch('<%= analyze_trade_ai_coach_path %>', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ trade_id: <%= @trade.id %> })
  }).then(() => window.location.reload());
}
</script>
