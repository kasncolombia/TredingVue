<% content_for :page_title, "#{@trade.symbol} • Trade Analysis Workspace" %>
<% 
  # Helper shortcuts
  pnl_color = @trade.pnl >= 0 ? 'text-emerald-500' : 'text-rose-500'
  pnl_sign = @trade.pnl > 0 ? '+' : ''
  risk_sl = @trade.stop_loss || 0
  risk_tp = @trade.take_profit || 0
  direction_color = @trade.direction == 'LONG' ? 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20' : 'text-rose-500 bg-rose-500/10 border-rose-500/20'
%>

<div class="h-[calc(100vh-64px)] -mx-4 -mt-6 sm:-mx-6 lg:-mx-8 flex flex-col bg-slate-50 dark:bg-[#07080F] font-sans">
  
  <!-- ========================================================== -->
  <!-- 1. GLOBAL / TRADE HEADER -->
  <!-- ========================================================== -->
  <header class="h-14 border-b border-slate-200 dark:border-darkBorder bg-white dark:bg-darkCard px-4 flex items-center justify-between shrink-0">
    <!-- Left Navigation -->
    <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
      <%= link_to trades_path, class: "w-9 h-9 rounded-lg hover:bg-slate-100 dark:hover:bg-darkHover flex items-center justify-center text-slate-500 mr-2 transition-colors", title: "Volver al Journal" do %>
        <span class="material-symbols-outlined text-[20px]">arrow_back</span>
      <% end %>
      
      <!-- TABS (MOVIDOS AL SIDEBAR POR REQUERIMIENTO VISUAL) -->
      <span class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider ml-1">Trade #<%= @trade.id %></span>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- MOCK Navigation -->
      <button class="w-8 h-8 rounded-lg border border-slate-200 dark:border-darkBorder flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover transition-colors" title="Previous Trade">
        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
      </button>
      <button class="w-8 h-8 rounded-lg border border-slate-200 dark:border-darkBorder flex items-center justify-center text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover transition-colors" title="Next Trade">
        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
      </button>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 mx-1"></div>

      <button onclick="analyzeNow()" id="analyze-btn" class="px-3 py-1.5 h-8 flex items-center justify-center gap-2 bg-[#9B87F5] bg-opacity-20 hover:bg-opacity-30 border border-[#9B87F5] border-opacity-30 text-[#9B87F5] rounded-xl text-xs font-bold transition-all shadow-[0_0_15px_rgba(155,135,245,0.15)] group">
        <span class="material-symbols-outlined text-[16px] group-hover:animate-pulse">auto_awesome</span>
        <span class="hidden sm:inline">AI Coach</span>
      </button>
    </div>
  </header>

  <!-- ========================================================== -->
  <!-- MAIN WORKSPACE GRID -->
  <!-- ========================================================== -->
  <div class="flex-1 flex overflow-hidden lg:flex-row flex-col">
    
    <!-- ========================================================== -->
    <!-- 2. TRADE SIDEBAR (380px) -->
    <!-- ========================================================== -->
    <aside class="w-full lg:w-[380px] lg:border-r border-b lg:border-b-0 border-slate-200 dark:border-darkBorder bg-white dark:bg-darkCard flex flex-col overflow-y-auto custom-scrollbar shrink-0">
      
      <!-- HORIZONTAL TABS SLIDER -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar px-5 py-3 border-b border-slate-200 dark:border-darkBorder shrink-0">
        <button type="button" class="ws-tab-btn shrink-0 px-3 py-1.5 rounded-lg bg-brand/10 text-brand text-[13px] font-bold transition-colors cursor-pointer" data-tab="workspace" onclick="switchWsTab(this, 'workspace')">Workspace</button>
        <button type="button" class="ws-tab-btn shrink-0 px-3 py-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover text-[13px] font-bold transition-colors cursor-pointer" data-tab="stats" onclick="switchWsTab(this, 'stats')">Stats</button>
        <button type="button" class="ws-tab-btn shrink-0 px-3 py-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover text-[13px] font-bold transition-colors cursor-pointer" data-tab="estrategia" onclick="switchWsTab(this, 'estrategia')">Estrategia</button>
        <button type="button" class="ws-tab-btn shrink-0 px-3 py-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover text-[13px] font-bold transition-colors cursor-pointer" data-tab="subyacente" onclick="switchWsTab(this, 'subyacente')">Subyacente</button>
        <button type="button" class="ws-tab-btn shrink-0 px-3 py-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-darkHover text-[13px] font-bold transition-colors cursor-pointer" data-tab="adjuntar" onclick="switchWsTab(this, 'adjuntar')">Adjuntar</button>
      </div>

      <!-- TAB CONTENT: WORKSPACE (DEFAULT) -->
      <div id="tab-workspace" class="ws-tab-content flex flex-col flex-1" style="display: flex;">
        <!-- SUMMARY CARD -->
      <div class="p-5 border-b border-slate-200 dark:border-darkBorder">
        <div class="flex items-start justify-between mb-2">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <%= @trade.symbol %>
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-md border <%= direction_color %>"><%= @trade.direction %></span>
            </h2>
            <p class="text-xs text-slate-500 mt-1"><%= @trade.entry_at&.strftime("%Y-%m-%d %H:%M") %> • <%= @trade.market %></p>
          </div>
          <div class="text-right">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">NET P&L</p>
            <p class="text-xl font-black font-mono <%= pnl_color %>"><%= pnl_sign %><%= number_to_currency(@trade.pnl) %></p>
          </div>
        </div>
      </div>

      <!-- DETAILS GRID -->
      <div class="p-5 border-b border-slate-200 dark:border-darkBorder space-y-3 font-mono text-xs">
        <div class="flex justify-between items-center gap-4">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Entry Price</span>
          <span class="text-slate-900 dark:text-white font-bold"><%= @trade.entry_price ? number_with_precision(@trade.entry_price, precision: 2) : '-' %></span>
        </div>
        <div class="flex justify-between items-center gap-4">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Exit Price</span>
          <span class="text-slate-900 dark:text-white font-bold"><%= @trade.exit_price ? number_with_precision(@trade.exit_price, precision: 2) : '-' %></span>
        </div>
        <div class="flex justify-between items-center gap-4">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Quantity / Size</span>
          <span class="text-slate-900 dark:text-white font-bold"><%= @trade.position_size || '-' %></span>
        </div>
        <div class="flex justify-between items-center gap-4">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Return %</span>
          <span class="<%= @trade.pnl_percent.to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %> font-bold">
            <%= @trade.pnl_percent ? "+#{@trade.pnl_percent}%" : '-' %>
          </span>
        </div>
        <div class="flex justify-between items-center gap-4">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Strategy</span>
          <span class="text-slate-900 dark:text-white font-bold"><%= @trade.strategy&.name || 'Discrecional' %></span>
        </div>
        
        <!-- RISK MANAGEMENT -->
        <div class="pt-3 mt-3 border-t border-slate-100 dark:border-slate-800">
          <h3 class="text-slate-900 dark:text-white font-sans font-bold text-xs uppercase mb-3 flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-brand">security</span> Risk Management</h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-rose-500/5 border border-rose-500/10 p-2.5 rounded-xl">
              <span class="text-rose-500/70 uppercase font-sans font-bold text-[9px] block mb-1">Stop Loss</span>
              <span class="text-rose-500 font-bold block"><%= risk_sl > 0 ? risk_sl : 'N/A' %></span>
            </div>
            <div class="bg-emerald-500/5 border border-emerald-500/10 p-2.5 rounded-xl">
              <span class="text-emerald-500/70 uppercase font-sans font-bold text-[9px] block mb-1">Take Profit</span>
              <span class="text-emerald-500 font-bold block"><%= risk_tp > 0 ? risk_tp : 'N/A' %></span>
            </div>
          </div>
        </div>

        <div class="flex justify-between items-center gap-4 pt-2">
          <span class="text-slate-400 uppercase font-sans font-bold text-[10px]">Rating</span>
          
          <!-- TRADE RATING INTERACTIVO MOCK -->
          <div class="flex items-center gap-0.5 text-amber-400 text-sm">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0; opacity: 0.3;">star</span>
          </div>

        </div>
      </div>

      <!-- TRADE NOTES BLOCK -->
      <div class="p-5 flex-1 flex flex-col min-h-[300px]">
        <h3 class="text-slate-900 dark:text-white font-sans font-bold text-xs uppercase mb-3 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-brand">edit_note</span> Trade Notes
        </h3>
        <div class="flex-1 bg-slate-50 dark:bg-[#11121C] rounded-xl border border-slate-200 dark:border-darkBorder p-3 flex flex-col">
          <!-- Rich text editor mock toolbar -->
          <div class="flex items-center gap-2 pb-2 mb-2 border-b border-slate-200 dark:border-slate-800 text-slate-400">
            <span class="material-symbols-outlined text-[14px] hover:text-brand cursor-pointer">format_bold</span>
            <span class="material-symbols-outlined text-[14px] hover:text-brand cursor-pointer">format_italic</span>
            <span class="material-symbols-outlined text-[14px] hover:text-brand cursor-pointer">format_list_bulleted</span>
            <div class="h-3 w-px bg-slate-300 dark:bg-slate-700 mx-1"></div>
            <span class="material-symbols-outlined text-[14px] hover:text-brand cursor-pointer">undo</span>
            <span class="material-symbols-outlined text-[14px] hover:text-brand cursor-pointer">redo</span>
          </div>
          <textarea class="w-full flex-1 bg-transparent border-none outline-none resize-none text-xs text-slate-700 dark:text-slate-300 p-0" placeholder="Escribe tu análisis y reflexiones de la operativa aquí..."><%= @trade.notes %></textarea>
        </div>
      </div>
      <!-- END TAB CONTENT: WORKSPACE -->

      <!-- TAB CONTENT: STATS -->
      <div id="tab-stats" class="ws-tab-content hidden p-5 flex-col space-y-5 flex-1 font-mono text-xs" style="display: none;">
        
        <!-- R-Multiple Card -->
        <div class="bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder p-4 rounded-xl space-y-3">
          <div class="flex justify-between items-center font-sans">
            <span class="text-slate-500 font-bold text-xs uppercase">R-Multiple Real</span>
            <span class="font-extrabold text-sm <%= @trade.pnl >= 0 ? 'text-emerald-500 bg-emerald-500/10' : 'text-rose-500 bg-rose-500/10' %> px-2 py-0.5 rounded-md border border-current/20">
              <%= @trade.r_multiple ? "#{'+' if @trade.r_multiple > 0}#{@trade.r_multiple}R" : (@trade.pnl >= 0 ? '+2.45R' : '-1.00R') %>
            </span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full overflow-hidden flex">
            <div class="<%= @trade.pnl >= 0 ? 'bg-emerald-500' : 'bg-rose-500' %> h-full" style="width: <%= @trade.pnl >= 0 ? '78%' : '30%' %>"></div>
          </div>
          <div class="flex justify-between text-[10px] text-slate-400 font-sans">
            <span>Riesgo Base: <%= number_to_currency(@trade.risk_amount || 100) %></span>
            <span>Objetivo: <%= number_to_currency((@trade.risk_amount || 100) * 2.5) %></span>
          </div>
        </div>

        <!-- Metric Details List -->
        <div class="space-y-3">
          <h4 class="font-sans font-bold text-xs uppercase text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-brand">analytics</span> Métricas de Ejecución
          </h4>
          
          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Duración en Mercado</span>
            <span class="text-slate-900 dark:text-white font-bold">
              <% if @trade.entry_at && @trade.exit_at %>
                <%= distance_of_time_in_words(@trade.entry_at, @trade.exit_at) %>
              <% else %>
                42 min 18 seg
              <% end %>
            </span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">MFE (Max Favorable Excursion)</span>
            <span class="text-emerald-500 font-bold">+3.20R ($384.00)</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">MAE (Max Adverse Excursion)</span>
            <span class="text-rose-500 font-bold">-0.35R (-$42.00)</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Eficiencia de Salida</span>
            <span class="text-slate-900 dark:text-white font-bold">76.5%</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Comisiones & Swap</span>
            <span class="text-slate-900 dark:text-white font-bold"><%= number_to_currency(@trade.commission || 0) %></span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Capital Empleado</span>
            <span class="text-slate-900 dark:text-white font-bold"><%= number_to_currency(@trade.capital_used || 450) %></span>
          </div>
        </div>

      </div>

      <!-- TAB CONTENT: ESTRATEGIA -->
      <div id="tab-estrategia" class="ws-tab-content hidden p-5 flex-col space-y-5 flex-1 text-xs" style="display: none;">
        
        <!-- Strategy Card Header -->
        <div class="bg-brand/5 border border-brand/20 p-4 rounded-xl space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-extrabold uppercase text-brand tracking-wider">Estrategia Aplicada</span>
            <span class="px-2 py-0.5 text-[10px] font-bold bg-brand/10 text-brand rounded-md">TF: <%= @trade.timeframe.presence || "5m" %></span>
          </div>
          <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">
            <%= @trade.strategy&.name || "Liquidity Sweep & Order Block Retest" %>
          </h4>
          <p class="text-slate-500 text-[11px]">Setup: <span class="font-semibold text-slate-700 dark:text-slate-300"><%= @trade.setup.presence || "Fair Value Gap Fill + Rejection" %></span></p>
        </div>

        <!-- Tags & Psychology -->
        <div class="space-y-3">
          <h4 class="font-sans font-bold text-xs uppercase text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-brand">psychology</span> Psicología & Etiquetas
          </h4>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 font-bold text-[10px] flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px]">check_circle</span> #PlanExecuted
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-500 border border-blue-500/20 font-bold text-[10px] flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px]">verified</span> #CleanEntry
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-indigo-500/10 text-indigo-500 border border-indigo-500/20 font-bold text-[10px] flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px]">psychology</span> Estado: <%= @trade.emotion.presence || "Enfocado / Paciente" %>
            </span>
          </div>
        </div>

        <!-- Strategy Checklist Rules -->
        <div class="space-y-3">
          <h4 class="font-sans font-bold text-xs uppercase text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-brand">fact_check</span> Reglas del Plan Cumplidas
          </h4>
          <div class="space-y-2">
            <label class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder cursor-pointer">
              <input type="checkbox" checked disabled class="rounded border-slate-300 text-brand focus:ring-brand">
              <span class="text-slate-700 dark:text-slate-300 font-semibold text-[11px]">Alineación con Estructura H4/H1 (HTF Bias)</span>
            </label>
            <label class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder cursor-pointer">
              <input type="checkbox" checked disabled class="rounded border-slate-300 text-brand focus:ring-brand">
              <span class="text-slate-700 dark:text-slate-300 font-semibold text-[11px]">Barrida de Liquidez Previa (Session Sweep)</span>
            </label>
            <label class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder cursor-pointer">
              <input type="checkbox" checked disabled class="rounded border-slate-300 text-brand focus:ring-brand">
              <span class="text-slate-700 dark:text-slate-300 font-semibold text-[11px]">Confirmación de M5 Displacement + FVG</span>
            </label>
            <label class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder cursor-pointer">
              <input type="checkbox" checked disabled class="rounded border-slate-300 text-brand focus:ring-brand">
              <span class="text-slate-700 dark:text-slate-300 font-semibold text-[11px]">Riesgo menor o igual al 1% de la cuenta</span>
            </label>
          </div>
        </div>

        <!-- Entry & Exit Reasons -->
        <div class="space-y-3 pt-2">
          <div>
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Razón de Entrada</span>
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder text-slate-700 dark:text-slate-300 text-[11px]">
              <%= @trade.entry_reason.presence || "Entrada ejecutada tras la confirmación de barrido de altos de la sesión asiática y rechazo limpio en la zona FVG M5." %>
            </div>
          </div>
          <div>
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Razón de Salida</span>
            <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder text-slate-700 dark:text-slate-300 text-[11px]">
              <%= @trade.exit_reason.presence || "Salida por TP predefinido en el máximo de la estructura previa antes de la apertura de Nueva York." %>
            </div>
          </div>
        </div>

      </div>

      <!-- TAB CONTENT: SUBYACENTE -->
      <div id="tab-subyacente" class="ws-tab-content hidden p-5 flex-col space-y-5 flex-1 text-xs font-mono" style="display: none;">
        
        <!-- Symbol Info Header Card -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 dark:bg-[#11121C] border border-slate-200 dark:border-darkBorder font-sans">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand border border-brand/20 flex items-center justify-center font-black text-sm uppercase">
              <%= @trade.symbol[0..2] %>
            </div>
            <div>
              <h4 class="font-extrabold text-sm text-slate-900 dark:text-white tracking-tight"><%= @trade.symbol %></h4>
              <p class="text-[11px] text-slate-500"><%= @trade.market || "Índices / Equities" %></p>
            </div>
          </div>
          <span class="px-2.5 py-1 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 rounded-lg border border-emerald-500/20">Mercado Abierto</span>
        </div>

        <!-- Instrument Specs -->
        <div class="space-y-3">
          <h4 class="font-sans font-bold text-xs uppercase text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-brand">candlestick_chart</span> Métricas del Activo
          </h4>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Rango Diario ATR (14)</span>
            <span class="text-slate-900 dark:text-white font-bold">$12.45 (1.85%)</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Sesión de Ejecución</span>
            <span class="text-slate-900 dark:text-white font-bold">New York Session</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Spread Promedio</span>
            <span class="text-slate-900 dark:text-white font-bold">0.15 pts</span>
          </div>

          <div class="flex justify-between items-center gap-4 py-1.5 border-b border-slate-100 dark:border-slate-800">
            <span class="text-slate-400 uppercase font-sans text-[10px] font-bold">Correlación Directa</span>
            <span class="text-slate-900 dark:text-white font-bold">SPY (+0.94)</span>
          </div>
        </div>

        <!-- Key Levels Table -->
        <div class="space-y-3 pt-1">
          <h4 class="font-sans font-bold text-xs uppercase text-slate-900 dark:text-white flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-brand">table_chart</span> Niveles Clave del Día
          </h4>
          <div class="grid grid-cols-2 gap-2 font-sans">
