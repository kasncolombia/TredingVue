<% content_for :page_title, @trade.symbol %>

<div class="max-w-4xl mx-auto fade-in space-y-5">

  <!-- BREADCRUMB + ACCIONES -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <%= link_to "Operaciones", trades_path, class: "hover:text-indigo-500 transition-colors" %>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-slate-600 dark:text-slate-300 font-semibold"><%= @trade.symbol %></span>
    </div>
    <div class="flex gap-2">
      <%= link_to edit_trade_path(@trade), class: "flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-xl border border-amber-500/20 transition-all" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
      <%= link_to @trade, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta operación?" },
          class: "flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-500/10 hover:bg-rose-500/20 rounded-xl border border-rose-500/20 transition-all" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Eliminar
      <% end %>
    </div>
  </div>

  <!-- HEADER CARD -->
  <div class="glass rounded-2xl p-6 border-l-4 <%= @trade.pnl >= 0 ? 'border-emerald-500' : 'border-rose-500' %>">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-black text-slate-800 dark:text-white"><%= @trade.symbol %></h1>
          <%= direction_badge(@trade.direction) %>
          <%= result_badge(@trade.result || "—") %>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          <%= @trade.entry_at&.strftime("%d %b %Y %H:%M") || "—" %>
          <% if @trade.exit_at %>→ <%= @trade.exit_at.strftime("%d %b %Y %H:%M") %><% end %>
        </p>
      </div>
      <div class="text-right">
        <p class="text-3xl font-black <%= pnl_class(@trade.pnl) %>">
          <%= @trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(@trade.pnl, precision: 2) %>
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">P&L Neto</p>
      </div>
    </div>

    <!-- R MULTIPLE BAR -->
    <% if @trade.r_multiple %>
    <div class="mt-4 pt-4 border-t border-slate-200 dark:border-darkBorder">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">R Multiple</span>
        <span class="text-sm font-black <%= @trade.r_multiple.to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %>"><%= @trade.r_multiple %>R</span>
      </div>
      <div class="relative h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
        <% pct = [[@trade.r_multiple.to_f.abs / 3.0 * 50, 50].min, 0].max %>
        <div class="absolute top-0 h-2 rounded-full transition-all duration-1000 <%= @trade.r_multiple.to_f >= 0 ? 'bg-emerald-500 left-1/2' : 'bg-rose-500 right-1/2' %>" style="width:<%= pct %>%"></div>
        <div class="absolute top-0 left-1/2 w-0.5 h-2 bg-slate-400 dark:bg-slate-500"></div>
      </div>
      <div class="flex justify-between text-[10px] text-slate-400 mt-1">
        <span>-3R</span><span class="font-semibold">0</span><span>+3R</span>
      </div>
    </div>
    <% end %>
  </div>

  <!-- DETALLES + NOTAS -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

    <!-- Datos técnicos -->
    <div class="glass rounded-2xl p-5">
      <p class="text-sm font-bold text-slate-800 dark:text-white mb-4">Datos de la Operación</p>
      <dl class="space-y-3 text-xs">
        <% [
          ["Símbolo",        @trade.symbol],
          ["Dirección",      @trade.direction],
          ["Precio Entrada", @trade.entry_price ? "$#{@trade.entry_price}" : "—"],
          ["Precio Salida",  @trade.exit_price  ? "$#{@trade.exit_price}"  : "—"],
          ["Stop Loss",      @trade.stop_loss   ? "$#{@trade.stop_loss}"   : "—"],
          ["Take Profit",    @trade.take_profit ? "$#{@trade.take_profit}" : "—"],
          ["Tamaño",         @trade.position_size || "—"],
          ["Comisión",       @trade.commission  ? "$#{@trade.commission}"  : "—"],
          ["Estrategia",     @trade.strategy&.name || "—"],
          ["Setup",          @trade.setup || "—"],
          ["Est. Emocional", @trade.emotion || "—"],
        ].each do |label, value| %>
          <div class="flex items-start justify-between gap-4">
            <dt class="text-slate-500 dark:text-slate-400 flex-shrink-0"><%= label %></dt>
            <dd class="font-semibold text-slate-800 dark:text-slate-200 text-right"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Notas + AI -->
    <div class="space-y-4">
      <!-- Notas -->
      <div class="glass rounded-2xl p-5">
        <p class="text-sm font-bold text-slate-800 dark:text-white mb-3">📝 Notas y Reflexión</p>
        <% if @trade.notes.present? %>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed"><%= @trade.notes %></p>
        <% else %>
          <p class="text-xs text-slate-400 italic">Sin notas registradas.</p>
        <% end %>
      </div>

      <!-- AI Analysis Panel -->
      <div class="glass rounded-2xl p-5 border-l-4 border-indigo-500">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-base">🤖</span>
          <p class="text-sm font-bold text-slate-800 dark:text-white">Análisis AI Coach</p>
        </div>
        <% if @trade.ai_analysis.present? %>
          <div class="space-y-3 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-slate-400">Score Disciplina</span>
              <span class="ml-auto font-black text-sm text-indigo-600 dark:text-indigo-400"><%= @trade.ai_analysis.discipline_score %>/10</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
              <% sc = @trade.ai_analysis.discipline_score.to_i %>
              <div class="h-1.5 rounded-full <%= sc >= 7 ? 'bg-emerald-500' : sc >= 5 ? 'bg-amber-500' : 'bg-rose-500' %>" style="width:<%= sc * 10 %>%"></div>
            </div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed"><%= @trade.ai_analysis.feedback %></p>
            <% if @trade.ai_analysis.reflection_question %>
              <div class="p-2.5 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/40 text-amber-700 dark:text-amber-300">
                💡 <strong>Reflexión:</strong> <%= @trade.ai_analysis.reflection_question %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-slate-400 mb-3">Sin análisis AI para esta operación.</p>
          <button onclick="analyzeNow()" class="w-full py-2 rounded-xl bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-600 dark:text-indigo-300 text-xs font-bold border border-indigo-500/30 transition-all">
            ⚡ Analizar con AI Coach
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function analyzeNow() {
  fetch('<%= analyze_trade_ai_coach_path %>', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content },
    body: JSON.stringify({ trade_id: <%= @trade.id %> })
  }).then(() => window.location.reload());
}
</script>
