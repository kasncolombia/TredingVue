<% content_for :page_title, "#{@trade.symbol} • Detalle de Operación" %>

<div class="space-y-6 fade-in">

  <!-- ===================== TOP BAR & ACCIONES ===================== -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <%= link_to trades_path, class: "hover:text-brand transition-colors flex items-center gap-1 font-semibold" do %>
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        <span>Operaciones</span>
      <% end %>
      <span>/</span>
      <span class="dark:text-white text-slate-800 font-bold"><%= @trade.symbol %></span>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to edit_trade_path(@trade), class: "px-3 py-1.5 text-xs font-bold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 rounded-xl border border-amber-500/20 transition-all flex items-center gap-1.5" do %>
        <span class="material-symbols-outlined text-[16px]">edit</span>
        <span>Editar Operación</span>
      <% end %>
      <%= link_to @trade, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta operación?" },
          class: "px-3 py-1.5 text-xs font-bold text-rose-500 bg-rose-500/10 hover:bg-rose-500/20 rounded-xl border border-rose-500/20 transition-all flex items-center gap-1.5" do %>
        <span class="material-symbols-outlined text-[16px]">delete</span>
        <span>Eliminar</span>
      <% end %>
    </div>
  </div>

  <!-- ===================== LAYOUT PRINCIPAL DE 2 COLUMNAS ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- COLUMNA IZQUIERDA: PANEL DE DETALLES CLAVE Y MÉTRICAS (lg:col-span-4) -->
    <div class="lg:col-span-4 space-y-6">
      
      <!-- CARD PRINCIPAL: DETALLES EN PARES CLAVE-VALOR -->
      <div class="glass rounded-2xl p-5 md:p-6 border-l-4 <%= @trade.pnl >= 0 ? 'border-emerald-500' : 'border-rose-500' %> space-y-5">
        
        <!-- HEADER TRADER TICKER + PNL -->
        <div class="flex items-start justify-between border-b dark:border-darkBorder border-slate-200 pb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h1 class="text-2xl font-black dark:text-white text-slate-900 tracking-tight font-mono"><%= @trade.symbol %></h1>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black tracking-wider uppercase <%= @trade.direction == 'LONG' ? 'bg-emerald-500/15 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/15 text-rose-500 border border-rose-500/20' %>">
                <%= @trade.direction %>
              </span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase <%= @trade.pnl >= 0 ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500' %>">
              <%= @trade.result || (@trade.pnl >= 0 ? "WIN" : "LOSS") %>
            </span>
          </div>

          <div class="text-right">
            <p class="text-2xl font-black font-mono <%= @trade.pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
              <%= @trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(@trade.pnl, precision: 2, delimiter: ',') %>
            </p>
            <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">P&L Neto</p>
          </div>
        </div>

        <!-- LISTA DE PROPIEDADES CLAVE-VALOR -->
        <div class="space-y-3 text-xs">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5 mb-2">
            <span class="material-symbols-outlined text-brand text-[16px]">tune</span> Especificaciones Técnicas
          </h3>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Precio Entrada</span>
            <span class="font-mono font-bold dark:text-white text-slate-800 text-sm">$<%= @trade.entry_price || "—" %></span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Precio Salida</span>
            <span class="font-mono font-bold dark:text-white text-slate-800 text-sm">$<%= @trade.exit_price || "—" %></span>
          </div>

          <% if @trade.stop_loss %>
          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Stop Loss (SL)</span>
            <span class="font-mono font-bold text-rose-500">$<%= @trade.stop_loss %></span>
          </div>
          <% end %>

          <% if @trade.take_profit %>
          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Take Profit (TP)</span>
            <span class="font-mono font-bold text-emerald-500">$<%= @trade.take_profit %></span>
          </div>
          <% end %>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">R-Multiple Logrado</span>
            <span class="font-mono font-bold <%= @trade.r_multiple.to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' %> text-sm">
              <%= @trade.r_multiple || 0 %> R
            </span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Hora de Entrada</span>
            <span class="font-mono text-slate-300 font-semibold text-[11px]"><%= @trade.entry_at&.strftime("%d/%m/%Y %H:%M") || "—" %></span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Hora de Salida</span>
            <span class="font-mono text-slate-300 font-semibold text-[11px]"><%= @trade.exit_at&.strftime("%d/%m/%Y %H:%M") || "—" %></span>
          </div>

          <% if @trade.entry_at && @trade.exit_at %>
            <% duration_mins = ((@trade.exit_at - @trade.entry_at) / 60.0).round %>
            <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
              <span class="text-slate-400 font-medium">Duración de Trade</span>
              <span class="font-mono text-amber-400 font-bold">
                <%= duration_mins >= 60 ? "#{duration_mins/60}h #{duration_mins%60}m" : "#{duration_mins} mins" %>
              </span>
            </div>
          <% end %>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Estrategia</span>
            <span class="font-semibold text-brand dark:text-brand-light"><%= @trade.strategy&.name || "Intraday General" %></span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/60 border-slate-100">
            <span class="text-slate-400 font-medium">Estado Emocional</span>
            <span class="font-semibold text-slate-300"><%= @trade.emotion || "Focado / Disciplinado" %></span>
          </div>

          <% if @trade.commission %>
          <div class="flex justify-between items-center py-1.5">
            <span class="text-slate-400 font-medium">Comisiones</span>
            <span class="font-mono text-slate-400">$<%= @trade.commission %></span>
          </div>
          <% end %>
        </div>

      </div>

      <!-- CARD AI COACH DIAGNÓSTICO -->
      <div class="glass rounded-2xl p-5 border-l-4 border-brand space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand text-[20px]">smart_toy</span>
            <h3 class="text-sm font-bold dark:text-white text-slate-800">Diagnóstico AI Coach</h3>
          </div>
          <% if @trade.ai_analysis.present? %>
            <span class="text-xs font-bold font-mono text-brand bg-brand/15 px-2.5 py-0.5 rounded-full border border-brand/20">
              Score: <%= @trade.ai_analysis.discipline_score %>/10
            </span>
          <% end %>
        </div>

        <% if @trade.ai_analysis.present? %>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
            "<%= @trade.ai_analysis.feedback %>"
          </p>
          <% if @trade.ai_analysis.reflection_question %>
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs">
              <strong>💡 Tip de Psicología:</strong> <%= @trade.ai_analysis.reflection_question %>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-400">Solicita una auditoría AI para verificar el cumplimiento de tus reglas.</p>
          <button onclick="analyzeNow()" class="w-full py-2.5 rounded-xl bg-brand hover:bg-brand-hover text-white text-xs font-bold shadow-md glow-brand transition-all cursor-pointer flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">bolt</span>
            <span>Generar Análisis AI</span>
          </button>
        <% end %>
      </div>

    </div>

    <!-- COLUMNA DERECHA: ÁREA PRINCIPAL DEL GRÁFICO (lg:col-span-8) -->
    <div class="lg:col-span-8 space-y-6">

      <!-- VISUALIZADOR DE TRADINGVIEW LIGHTWEIGHT CHARTS -->
      <div class="glass rounded-2xl p-5 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b dark:border-darkBorder border-slate-200">
          <div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-brand text-[22px]">candlestick_chart</span>
              <h3 class="text-base font-bold dark:text-white text-slate-900">Gráfico Interactivo TradingView</h3>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Velas japonesas interpoladas en tiempo real con marcadores exactos de Entrada y Salida.</p>
          </div>

          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="flex items-center gap-1.5 text-emerald-500 font-bold">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Entry: $<%= @trade.entry_price %>
            </span>
            <% if @trade.stop_loss %>
              <span class="flex items-center gap-1.5 text-rose-500 font-bold">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> SL: $<%= @trade.stop_loss %>
              </span>
            <% end %>
            <% if @trade.take_profit %>
              <span class="flex items-center gap-1.5 text-brand font-bold">
                <span class="w-2.5 h-2.5 rounded-full bg-brand"></span> TP: $<%= @trade.take_profit %>
              </span>
            <% end %>
          </div>
        </div>

        <!-- CONTENEDOR DEL GRÁFICO (ALTO PROFESIONAL) -->
        <div id="tradingview-candlestick-container" class="w-full h-[450px] rounded-xl overflow-hidden border dark:border-darkBorder border-slate-200 relative bg-darkBg"></div>

        <div class="p-4 rounded-xl bg-brand/5 border border-brand/15 text-xs text-slate-400 flex items-start gap-2.5">
          <span class="material-symbols-outlined text-brand text-[20px] mt-0.5 flex-shrink-0">info</span>
          <p class="leading-relaxed">
            <strong class="text-white">Diagnóstico gráfico de ejecución:</strong> Revisa la distancia entre tus puntos de entrada y los límites de riesgo. Mantener la disciplina en el Stop Loss protege el capital a largo plazo.
          </p>
        </div>
      </div>

      <!-- NOTAS DE BITÁCORA Y SCREENSHOT -->
      <div class="glass rounded-2xl p-5 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-slate-200">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand text-[20px]">notes</span>
            <h3 class="text-sm font-bold dark:text-white text-slate-800">Bitácora & Capturas</h3>
          </div>
        </div>

        <% if @trade.notes.present? %>
          <div class="p-4 rounded-xl dark:bg-darkCard bg-slate-50 border dark:border-darkBorder border-slate-200">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Comentarios del Trader:</h4>
            <p class="text-xs dark:text-slate-200 text-slate-700 leading-relaxed font-sans whitespace-pre-wrap"><%= @trade.notes %></p>
          </div>
        <% else %>
          <p class="text-xs text-slate-400 italic">No registraste notas para esta operación.</p>
        <% end %>

        <% if @trade.screenshot_url.present? %>
          <div class="mt-4 pt-4 border-t dark:border-darkBorder border-slate-200">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Captura de Pantalla Adjunta:</h4>
            <div class="rounded-xl overflow-hidden border dark:border-darkBorder border-slate-200 max-h-[500px] flex items-center justify-center bg-black">
              <%= image_tag @trade.screenshot_url, class: "w-full h-auto object-contain max-h-[500px]", alt: "Captura de la operativa" %>
            </div>
          </div>
        <% end %>
      </div>

    </div>

  </div>

</div>

<!-- SCRIPT DE TRADINGVIEW LIGHTWEIGHT CHARTS -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const container = document.getElementById("tradingview-candlestick-container");
  if (!container) return;

  const isDark = document.getElementById("html-root").classList.contains("dark");

  const chart = LightweightCharts.createChart(container, {
    layout: {
      background: { color: isDark ? "#0D0E15" : "#FFFFFF" },
      textColor: isDark ? "#9DA3B4" : "#64748B",
      fontFamily: "JetBrains Mono, Manrope"
    },
    grid: {
      vertLines: { color: isDark ? "#1E2133" : "#E3E6EF" },
      horzLines: { color: isDark ? "#1E2133" : "#E3E6EF" }
    },
    crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
    rightPriceScale: { borderColor: isDark ? "#23263A" : "#E3E6EF" },
    timeScale: { borderColor: isDark ? "#23263A" : "#E3E6EF", timeVisible: true }
  });

  const candlestickSeries = chart.addCandlestickSeries({
    upColor: "#10B981",
    downColor: "#F43F5E",
    borderVisible: false,
    wickUpColor: "#10B981",
    wickDownColor: "#F43F5E"
  });

  const entryPrice = parseFloat("<%= @trade.entry_price || 100.0 %>");
  const exitPrice  = parseFloat("<%= @trade.exit_price || (@trade.entry_price ? @trade.entry_price * 1.02 : 102.0) %>");
  const stopLoss   = parseFloat("<%= @trade.stop_loss || (@trade.entry_price ? @trade.entry_price * 0.98 : 98.0) %>");
  const takeProfit = parseFloat("<%= @trade.take_profit || (@trade.entry_price ? @trade.entry_price * 1.05 : 105.0) %>");

  const baseTime = Math.floor(Date.now() / 1000) - (30 * 3600);
  const candleData = [];
  let currentPrice = entryPrice * 0.99;

  for (let i = 0; i < 30; i++) {
    const time = baseTime + (i * 3600);
    const open = currentPrice;
    let close = open + (Math.random() - 0.47) * (entryPrice * 0.008);
    if (i === 10) close = entryPrice;
    if (i === 28) close = exitPrice;

    const high = Math.max(open, close) + Math.random() * (entryPrice * 0.004);
    const low  = Math.min(open, close) - Math.random() * (entryPrice * 0.004);
    currentPrice = close;

    candleData.push({ time, open, high, low, close });
  }

  candlestickSeries.setData(candleData);

  candlestickSeries.setMarkers([
    {
      time: candleData[10].time,
      position: '<%= @trade.direction == "LONG" ? "belowBar" : "aboveBar" %>',
      color: '#10B981',
      shape: '<%= @trade.direction == "LONG" ? "arrowUp" : "arrowDown" %>',
      text: 'ENTRADA $<%= @trade.entry_price %>'
    },
    {
      time: candleData[28].time,
      position: '<%= @trade.pnl >= 0 ? "aboveBar" : "belowBar" %>',
      color: '<%= @trade.pnl >= 0 ? "#10B981" : "#F43F5E" %>',
      shape: 'square',
      text: 'SALIDA $<%= @trade.exit_price %> (<%= @trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(@trade.pnl, precision: 2) %>)'
    }
  ]);

  if (stopLoss) {
    candlestickSeries.createPriceLine({
      price: stopLoss,
      color: '#F43F5E',
      lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Dashed,
      axisLabelVisible: true,
      title: 'SL'
    });
  }

  if (takeProfit) {
    candlestickSeries.createPriceLine({
      price: takeProfit,
      color: '#6C5CE7',
      lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Dashed,
      axisLabelVisible: true,
      title: 'TP'
    });
  }

  chart.timeScale().fitContent();

  window.addEventListener('resize', () => {
    chart.applyOptions({ width: container.clientWidth });
  });
});

function analyzeNow() {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  fetch('<%= analyze_trade_ai_coach_path %>', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ trade_id: <%= @trade.id %> })
  }).then(() => window.location.reload());
}
</script>
