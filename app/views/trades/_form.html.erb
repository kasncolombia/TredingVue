<%# _form.html.erb — partial compartido por new y edit %>
<% content_for :page_title, @trade.new_record? ? "Nueva Operación" : "Editar #{@trade.symbol}" %>

<div class="fade-in pb-10">
  <!-- BREADCRUMB Y BOTONERA SUPERIOR DERECHA -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <%= link_to "Operaciones", trades_path, class: "hover:text-brand transition-colors" %>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-slate-600 dark:text-slate-300 font-bold"><%= trade.new_record? ? "Nueva Operación" : "Editar #{trade.symbol}" %></span>
    </div>

    <div class="flex items-center gap-3">
      <!-- UI: TABS MODO PRINCIPIANTE / EXPERTO -->
      <div class="flex p-1 bg-slate-200/50 dark:bg-darkBorder/50 rounded-xl w-56 border border-slate-300/50 dark:border-darkBorder relative">
        <div id="mode-slider" class="absolute top-1 left-1 bottom-1 w-[calc(50%-4px)] bg-white dark:bg-slate-700 rounded-lg shadow-sm transition-transform duration-300 ease-out z-0"></div>
        
        <button type="button" id="btn-beginner" onclick="setMode('beginner')" class="relative z-10 flex-1 py-1.5 text-xs font-bold rounded-lg text-brand transition-colors flex items-center justify-center gap-1.5 focus:outline-none">
          <span class="material-symbols-outlined text-[16px]">school</span> Principiante
        </button>
        <button type="button" id="btn-expert" onclick="setMode('expert')" class="relative z-10 flex-1 py-1.5 text-xs font-bold rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white transition-colors flex items-center justify-center gap-1.5 focus:outline-none">
          <span class="material-symbols-outlined text-[16px]">psychology_alt</span> PRO / Experto
        </button>
      </div>

      <!-- BOTÓN ADD ACCOUNT + (ABRE WIZARD DE BROKERS) -->
      <button type="button" onclick="openAddAccountWizard()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-brand to-indigo-600 hover:from-brand-hover hover:to-indigo-700 text-white text-xs font-extrabold shadow-md transition-all flex items-center gap-1.5 cursor-pointer border border-white/20 hover:scale-105 active:scale-95" title="Vincular Nueva Cuenta / Broker TradeZella">
        <span class="material-symbols-outlined text-[16px]">add_link</span>
        <span>Add Account +</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    
    <!-- COLUMNA IZQUIERDA: FORMULARIO (2/3) -->
    <div class="lg:col-span-2">
      <%= form_with model: trade, local: true, html: { class: "space-y-6 flex flex-col", id: "trade-form" } do |f| %>

        <!-- SECCIÓN 1: BÁSICO -->
        <div class="glass rounded-2xl p-5 md:p-6 shadow-sm relative overflow-visible">
          <div class="absolute top-0 left-0 w-1 h-full bg-brand rounded-l-2xl"></div>
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-xl bg-brand/15 text-brand flex items-center justify-center text-sm font-black flex-shrink-0">1</div>
            <div>
              <h2 class="text-sm font-bold text-slate-800 dark:text-white">Elige tu Activo y Dirección</h2>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Define qué operaste y hacia dónde.</p>
            </div>
          </div>

          <div class="mb-6 pb-6 border-b border-lightBorder dark:border-darkBorder">
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center justify-between">
              <span>Portafolio / Modalidad <span class="text-brand">*</span></span>
              <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                <span class="material-symbols-outlined text-[14px]">info</span>
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-52 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                  Selecciona a qué cuenta aislar este Trade. Los Backtests o Cuentas de Fondeo no afectarán tu P&L principal.
                </div>
              </div>
            </label>
            <div class="flex gap-2 text-xs font-bold w-full overflow-x-auto snap-x hide-scrollbar">
              <label class="flex-1 cursor-pointer min-w-[95px] snap-center">
                <%= f.radio_button :portfolio_mode, "real_account", class: "sr-only peer pm-radio", checked: (trade.portfolio_mode == 'real_account' || trade.portfolio_mode.nil?), onchange: "togglePropFirmSelector()" %>
                <div class="peer-checked:bg-emerald-500/15 peer-checked:border-emerald-500 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-400 input-field border py-2.5 rounded-xl text-center transition-all cursor-pointer flex flex-col md:flex-row items-center justify-center gap-1.5 shadow-sm">
                  <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span> Real
                </div>
              </label>
              <label class="flex-1 cursor-pointer min-w-[95px] snap-center">
                <%= f.radio_button :portfolio_mode, "prop_firm", class: "sr-only peer pm-radio", checked: trade.portfolio_mode == 'prop_firm', onchange: "togglePropFirmSelector()" %>
                <div class="peer-checked:bg-brand/15 peer-checked:border-brand peer-checked:text-brand dark:peer-checked:text-brand-light input-field border py-2.5 rounded-xl text-center transition-all cursor-pointer flex flex-col md:flex-row items-center justify-center gap-1.5 shadow-sm">
                  <span class="material-symbols-outlined text-[18px]">verified</span> Fondeo
                </div>
              </label>
              <label class="flex-1 cursor-pointer min-w-[95px] snap-center">
                <%= f.radio_button :portfolio_mode, "backtest", class: "sr-only peer pm-radio", checked: trade.portfolio_mode == 'backtest', onchange: "togglePropFirmSelector()" %>
                <div class="peer-checked:bg-slate-200 dark:peer-checked:bg-slate-700 peer-checked:border-slate-400 dark:peer-checked:border-slate-500 peer-checked:text-slate-800 dark:peer-checked:text-white input-field border py-2.5 rounded-xl text-center transition-all cursor-pointer flex flex-col md:flex-row items-center justify-center gap-1.5 shadow-sm">
                  <span class="material-symbols-outlined text-[18px]">history</span> Backtest
                </div>
              </label>
            </div>

            <!-- SELECTOR VISUAL DE COMPAÑÍAS DE FONDEO -->
            <div id="prop-firm-company-container" class="mt-4 pt-4 border-t dark:border-darkBorder border-slate-200 hidden fade-in space-y-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Vincular a Cuenta de Fondeo Específica</label>
                <%= f.collection_select :prop_firm_account_id, current_user.prop_firm_accounts.order(created_at: :desc), :id, ->(acc) { "#{acc.name} (#{acc.firm_name} - #{acc.account_size})" }, { prompt: "Seleccionar cuenta activa..." }, class: "input-field w-full px-3 py-2 rounded-xl text-xs font-bold focus:outline-none focus:border-brand" %>
              </div>

              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2 flex items-center justify-between">
                <span>O selecciona la Compañía / Empresa de Fondeo</span>
                <span class="text-[10px] text-brand font-bold">Logos Oficiales</span>
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
                <% [
                  { name: "Tradeify", logo: "compañias/Tradeify.png" },
                  { name: "Apex Trader Funding", logo: "compañias/Apex Trader funding.png" },
                  { name: "Topstep", logo: "compañias/Topstep.png" },
                  { name: "MyFundedFutures", logo: "compañias/My funded futures.png" },
                  { name: "Lucid Trading", logo: "compañias/Lucid trading.png" },
                  { name: "Alpha Futures", logo: "compañias/Alpha futures.png" },
                  { name: "Take Profit Trader", logo: "compañias/take profit trader.png" }
                ].each do |firm| %>
                  <button type="button" 
                          onclick="selectTradePropFirm('<%= firm[:name] %>', this)"
                          class="prop-firm-chip p-2 rounded-xl border dark:border-darkBorder border-slate-200 hover:border-brand dark:hover:border-brand flex flex-col items-center justify-center text-center gap-1.5 transition-all bg-slate-50 dark:bg-darkCard cursor-pointer">
                    <div class="w-8 h-8 rounded-lg bg-white p-1 flex items-center justify-center border border-slate-200 shadow-xs">
                      <%= image_tag firm[:logo], class: "max-h-full max-w-full object-contain", alt: firm[:name] %>
                    </div>
                    <span class="text-[9.5px] font-bold dark:text-slate-200 text-slate-700 line-clamp-1"><%= firm[:name] %></span>
                  </button>
                <% end %>
              </div>
              <%= f.hidden_field :setup, id: "selected_prop_firm_input" %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 z-20">
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Símbolo / Activo <span class="text-rose-500">*</span></span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-52 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Selecciona un activo frecuente o escribe cualquier ticker personalizado.
                  </div>
                </div>
              </label>

              <%= f.text_field :symbol, placeholder: "Escribe o elige un activo (Ej: NQ1!, BTCUSD)", required: true, id: "trade_symbol_input", list: "popular-symbols-list",
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm font-bold focus:outline-none transition-all uppercase relative z-10" %>

              <datalist id="popular-symbols-list">
                <option value="NQ1!">Futuros Nasdaq (NQ1!)</option>
                <option value="ES1!">Futuros S&P 500 (ES1!)</option>
                <option value="BTCUSD">Bitcoin / USD (BTCUSD)</option>
                <option value="ETHUSD">Ethereum / USD (ETHUSD)</option>
                <option value="EURUSD">Euro / US Dollar (EURUSD)</option>
                <option value="GBPUSD">Pound / US Dollar (GBPUSD)</option>
                <option value="XAUUSD">Gold / Oro (XAUUSD)</option>
                <option value="AAPL">Apple Inc. (AAPL)</option>
                <option value="NVDA">NVIDIA Corp. (NVDA)</option>
                <option value="TSLA">Tesla Inc. (TSLA)</option>
                <option value="SPY">SPDR S&P 500 ETF (SPY)</option>
                <option value="QQQ">Invesco QQQ (QQQ)</option>
              </datalist>

              <!-- QUICK SELECTION CHIPS -->
              <div class="flex flex-wrap gap-1.5 mt-2">
                <% %w[NQ1! ES1! BTCUSD ETHUSD EURUSD AAPL NVDA].each do |chip| %>
                  <button type="button" onclick="selectSymbol('<%= chip %>')" class="px-2 py-0.5 text-[10.5px] font-bold rounded-lg dark:bg-darkCard bg-slate-100 dark:text-slate-300 text-slate-700 border dark:border-darkBorder border-slate-200 hover:border-brand hover:text-brand dark:hover:text-brand-light transition-all cursor-pointer">
                    <%= chip %>
                  </button>
                <% end %>
              </div>
            </div>
            
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Dirección <span class="text-rose-500">*</span></span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    <strong class="text-emerald-400">LONG</strong> ganas si el precio sube. <strong class="text-rose-400">SHORT</strong> ganas si el precio cae.
                  </div>
                </div>
              </label>
              <div class="flex gap-2">
                <label class="flex-1 cursor-pointer">
                  <input type="radio" name="trade[direction]" value="LONG" class="sr-only peer dir-radio" <%= trade.direction == 'LONG' ? 'checked' : (trade.new_record? ? 'checked' : '') %>>
                  <div class="peer-checked:bg-emerald-500/20 peer-checked:border-emerald-500 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-400 input-field border py-2.5 rounded-xl text-xs font-black text-center transition-all cursor-pointer flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">trending_up</span> LONG
                  </div>
                </label>
                <label class="flex-1 cursor-pointer">
                  <input type="radio" name="trade[direction]" value="SHORT" class="sr-only peer dir-radio" <%= trade.direction == 'SHORT' ? 'checked' : '' %>>
                  <div class="peer-checked:bg-rose-500/20 peer-checked:border-rose-500 peer-checked:text-rose-600 dark:peer-checked:text-rose-400 input-field border py-2.5 rounded-xl text-xs font-black text-center transition-all cursor-pointer flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">trending_down</span> SHORT
                  </div>
                </label>
              </div>
            </div>

            <!-- EXCLUSIVO EXPERTO -->
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Estrategia</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Clasifica el modelo de tu entrada para ver estadísticas por estrategia.
                  </div>
                </div>
              </label>
              <%= f.collection_select :strategy_id, current_user.strategies, :id, :name,
                  { prompt: "Opcional (Ej: Breakout)" },
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Resultado Manual</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Ideal para forzar cierres en BreakEven si tu P&L es minúsculo, anulando el cálculo autómatico del sistema.
                  </div>
                </div>
              </label>
              <%= f.select :result, [["WIN","WIN"],["LOSS","LOSS"],["BREAKEVEN","BREAKEVEN"]],
                  { prompt: "Automático (según P&L)" },
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
            </div>

            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Fecha Entrada</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Modifícalo si estás cargando un trade antiguo a tu diario histórico. 
                  </div>
                </div>
              </label>
              <%= f.datetime_local_field :entry_at, step: 60,
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Fecha Salida</span>
              </label>
              <%= f.datetime_local_field :exit_at, step: 60,
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
            </div>
          </div>
        </div>

        <!-- SECCIÓN 2: EJECUCIÓN -->
        <div class="glass rounded-2xl p-5 md:p-6 shadow-sm relative overflow-visible mt-6">
          <div class="absolute top-0 left-0 w-1 h-full bg-violet-500 rounded-l-2xl"></div>
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-xl bg-violet-500/15 text-violet-600 dark:text-violet-400 flex items-center justify-center text-sm font-black flex-shrink-0">2</div>
            <div>
              <h2 class="text-sm font-bold text-slate-800 dark:text-white">Ejecución y Resultados</h2>
              <p id="hint-execution" class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Ingresa a qué precio compraste y vendiste.</p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>P. Entrada <span class="text-rose-500">*</span></span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-violet-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Precio base al que el broker ejecutó tu orden. 
                  </div>
                </div>
              </label>
              <%= f.number_field :entry_price, step: "any", placeholder: "0.00", id: "entry_price", required: true,
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>P. Salida <span class="text-rose-500">*</span></span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-violet-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Precio exacto de llenado al cual cerraste completamente tu posición.
                  </div>
                </div>
              </label>
              <%= f.number_field :exit_price, step: "any", placeholder: "0.00", id: "exit_price", required: true,
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
            
            <!-- EXCLUSIVO EXPERTO -->
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Tamaño/Lots</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-violet-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Número de Contratos, Lotes o Monedas de tu operación. Multiplicará el P&L final matemático.
                  </div>
                </div>
              </label>
              <%= f.number_field :position_size, step: "any", placeholder: "1", id: "position_size", value: trade.position_size || 1,
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Stop Loss</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-violet-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    <strong class="text-rose-400">IMPRESCINDIBLE</strong> para calcular tu R-Multiple real (R:R). ¿Dónde ibas a cerrar la pérdida?
                  </div>
                </div>
              </label>
              <%= f.number_field :stop_loss, step: "any", placeholder: "0.00", id: "stop_loss",
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Take Profit</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-violet-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Dónde estaba apuntada tú toma de la ganancia planificada.
                  </div>
                </div>
              </label>
              <%= f.number_field :take_profit, step: "any", placeholder: "0.00",
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Comisión ($)</span>
              </label>
              <%= f.number_field :commission, step: "any", placeholder: "0.00",
                  class: "input-field w-full px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all" %>
            </div>
          </div>
          
          <!-- CALCULADORA EN VIVO -->
          <div class="mt-5 p-4 rounded-xl border border-brand/20 bg-brand/5 relative z-10">
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 text-center">
              <div>
                <p class="text-[10px] font-bold text-slate-500 mb-1">P&L Estimado</p>
                <p id="calc-pnl" class="text-xl font-black text-slate-800 dark:text-white font-mono transition-all">—</p>
              </div>
              <div class="expert-only hidden">
                <p class="text-[10px] font-bold text-slate-500 mb-1">R-Multiple (<span title="Risk Reward" class="cursor-help border-b border-dashed border-slate-400 pb-0.5">RR</span>)</p>
                <p id="calc-r" class="text-xl font-black text-slate-800 dark:text-white font-mono transition-all">—</p>
              </div>
              <div>
                <p class="text-[10px] font-bold text-slate-500 mb-1">Diferencial Pts.</p>
                <p id="calc-pct" class="text-xl font-black text-slate-800 dark:text-white font-mono transition-all">—</p>
              </div>
            </div>
          </div>
          
          <div class="mt-4 pt-4 expert-only hidden border-t dark:border-darkBorder border-lightBorder relative z-10">
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                P&L Final Neto <span class="text-rose-500">*</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-brand transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-0 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-left hidden group-hover:block">
                    El sistema auto-escribe este campo sumando o restando puntos. Pero puedes <strong>editarlo a mano</strong> para forzar lo que dijo tu broker incluyendo fees exóticas.
                  </div>
                </div>
              </span>
            </label>
            <%= f.number_field :pnl, step: "any", id: "actual_pnl", required: true,
                class: "input-field w-full md:w-1/3 px-4 py-2.5 rounded-xl font-mono text-sm focus:outline-none transition-all font-black text-brand", placeholder: "Calculado o manual" %>
          </div>
        </div>

        <!-- SECCIÓN 3: PSICOLOGÍA -->
        <div class="glass rounded-2xl p-5 md:p-6 shadow-sm relative overflow-visible mt-6">
          <div class="absolute top-0 left-0 w-1 h-full bg-amber-500 rounded-l-2xl"></div>
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-black flex-shrink-0">3</div>
            <div>
              <h2 class="text-sm font-bold text-slate-800 dark:text-white">Psicología</h2>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">El Coach evaluará si estabas calmado o en euforia.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>¿Cómo te sentías al operar? <span class="text-rose-500">*</span></span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-amber-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    El AI Coach detectará correlaciones ocultas si le revelas cuándo ganaste con FOMO versus cuándo ganaste estando según el plan.
                  </div>
                </div>
              </label>
              <%= f.select :emotion,
                  [["😌 Relajado y según el plan","calm"],["😤 Ansioso / FOMO / Miedo de quedarme fuera","anxious"],["💪 Confiado / Seguro","confident"],["😰 Asustado / Cerre antes de tiempo","fearful"],["😑 Neutral / Aburrido","neutral"]],
                  { prompt: "Sé brutalmente honesto..." }, required: true,
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm font-bold focus:outline-none transition-all relative z-10" %>
            </div>
            
            <div class="expert-only hidden">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Tags (Contexto extra)</span>
                <div class="relative group cursor-help flex items-center justify-center text-slate-400 hover:text-amber-500 transition-colors">
                  <span class="material-symbols-outlined text-[14px]">info</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 bg-slate-900 border border-slate-700/50 text-white text-[10.5px] rounded-xl shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 font-normal leading-relaxed text-center hidden group-hover:block">
                    Etiquetas libres separadas por comas. <br><strong class="text-amber-400">Ej: #Powell, #ViernesDeTarde, #ErrorDeBroker</strong>
                  </div>
                </div>
              </label>
              <%= f.text_field :tags_string, placeholder: "ej: #NoticiasMacro, #ContraTendencia",
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
            </div>
            
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Mi bitácora / Notas de aprendizaje</span>
              </label>
              <%= f.text_area :notes, rows: 3, placeholder: "Describe brevemente: ¿Qué salió bien? ¿Qué salió mal? ¿Acaso rompiste una regla de riesgo vital?",
                  class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all resize-none relative z-10" %>
            </div>
          </div>
        </div>

        <!-- ERRORS DE VALIDACIÓN -->
        <% if trade.errors.any? %>
        <div class="rounded-2xl p-4 border border-rose-500/30 bg-rose-500/10 mt-6">
          <p class="text-xs font-bold text-rose-500 mb-2 flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">error</span> <%= trade.errors.count %> error(es) detectados:
          </p>
          <ul class="space-y-1 pl-6 list-disc text-xs text-rose-400 font-medium">
            <% trade.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
        <% end %>

        <!-- ACCIONES -->
        <div class="flex items-center justify-end gap-3 pt-4">
          <%= link_to "Cancelar", trades_path, class: "px-5 py-3 text-xs md:text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-100 dark:hover:bg-darkCard transition-all" %>
          
          <button type="submit" class="px-8 py-3 bg-brand hover:scale-[1.02] active:scale-[0.98] text-white font-extrabold text-xs md:text-sm rounded-xl shadow-[0_4px_15px_-3px_rgba(108,92,231,0.5)] cursor-pointer transition-all flex items-center gap-2 border border-white/10 group">
            <span class="material-symbols-outlined text-[18px] group-hover:rotate-12 transition-transform">save</span>
            <%= trade.new_record? ? "Guardar al Diario" : "Actualizar Operación" %>
          </button>
        </div>
      <% end %>
    </div>

    <!-- COLUMNA DERECHA: ASISTENTE ONBOARDING (DINÁMICO) (1/3) -->
    <div class="lg:col-span-1 border dark:border-brand/20 border-brand/30 rounded-2xl bg-gradient-to-br from-brand/5 to-transparent p-5 sticky top-6 shadow-[0_8px_30px_rgba(108,92,231,0.08)] transition-all z-0" id="coach-panel-container">
      <div class="flex items-center gap-3 mb-4 border-b dark:border-brand/10 border-brand/20 pb-3">
        <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center shadow-md flex-shrink-0 relative">
          <span class="material-symbols-outlined text-[20px] absolute z-10 w-full h-full flex items-center justify-center">smart_toy</span>
          <span class="absolute inline-flex h-full w-full rounded-xl bg-brand opacity-40 animate-ping"></span>
        </div>
        <div>
          <h3 class="text-sm font-black dark:text-white text-slate-900">Coach en Línea</h3>
          <p id="coach-panel-title" class="text-[10px] text-brand font-bold uppercase tracking-widest transition-all">Modo Básico Activo</p>
        </div>
      </div>
      
      <!-- CONTENIDO PRINCIPIANTE -->
      <div id="coach-content-beginner" class="space-y-4 text-xs dark:text-slate-300 text-slate-600 leading-relaxed fade-in">
        <p>¡Bienvenido al modo principiante! Aquí las cosas son simples para que ganes el <strong class="dark:text-white text-slate-900 border-b border-dashed border-brand/50">hábito de registrar</strong> todo lo que haces.</p>
        
        <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 font-medium">
          <p class="font-bold mb-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">bolt</span> Solo necesitas 3 cosas:
          </p>
          <ul class="list-decimal pl-4 mt-1 space-y-0.5">
            <li>Saber qué operaste (El Símbolo).</li>
            <li>Dónde entraste y saliste (Precio).</li>
            <li>Cómo te sentiste <em>(Para diagnósticos)</em>.</li>
          </ul>
        </div>
        
        <p class="text-[11px] italic text-slate-400 mt-2">
          Cuando te sientas confiado en calcular lotajes, stop losses o R-Multiples, cambia al <strong class="text-brand font-bold cursor-pointer hover:underline" onclick="setMode('expert')">Modo PRO 🔬</strong> en la parte superior.
        </p>
      </div>

      <!-- CONTENIDO EXPERTO -->
      <div id="coach-content-expert" class="space-y-4 text-xs dark:text-slate-300 text-slate-600 leading-relaxed hidden fade-in">
        <p>¡Estás en la trinchera avanzada! Entregarme más datos me permite hacer diagnósticos hiper-precisos sobre tu <strong class="text-rose-500 dark:text-rose-400">riesgo de ruina</strong>.</p>
        
        <div class="p-3 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-600 dark:text-violet-400 font-medium overflow-hidden relative">
          <div class="absolute -right-2 -top-2 opacity-10">
            <span class="material-symbols-outlined text-[64px]">warning</span>
          </div>
          <p class="font-bold mb-1 flex items-center gap-1 relative z-10">
            <span class="material-symbols-outlined text-[14px]">warning</span> Regla de Oro (Stop Loss)
          </p>
          <p class="relative z-10">
            Si dejas tu <strong>Stop Loss</strong> vacío o en 0, no podré calcular tu <em>R-Multiple</em> (R:R). El RR me sirve para decirte si estás arriesgando demasiado para ganar muy poco.
          </p>
        </div>
        
        <ul class="space-y-2 mt-4 text-[11px]">
          <li class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-brand text-[14px] mt-0.5">check_circle</span>
            <span>Usa <strong>Tamaño</strong> (Lotes/Contratos) para el P&L exacto.</span>
          </li>
          <li class="flex items-start gap-1.5">
            <span class="material-symbols-outlined text-brand text-[14px] mt-0.5">check_circle</span>
            <span>Usa los iconos de "<span class="text-slate-400 font-bold">INFO (i)</span>" en cada campo para refrescar para qué sirven y aprender.</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</div>

<style>
/* Utilities extra para evitar cortes de z-index / overflow al hacer hover en el tooltip */
.overflow-visible { overflow: visible !important; }
</style>

<script>
// ---------- UI TOGGLE TAB PRINCIPIANTE / EXPERTO ----------
let currentMode = 'beginner';

window.setMode = function(targetMode) {
  currentMode = targetMode;
  const slider = document.getElementById('mode-slider');
  const btnB = document.getElementById('btn-beginner');
  const btnE = document.getElementById('btn-expert');
  const coachTitle = document.getElementById('coach-panel-title');
  const coachB = document.getElementById('coach-content-beginner');
  const coachE = document.getElementById('coach-content-expert');
  const hintExe = document.getElementById('hint-execution');

  // Mover el background slider toggle (tabs)
  if (targetMode === 'beginner') {
    slider.style.transform = 'translateX(0)';
    btnB.classList.add('text-brand');
    btnB.classList.remove('text-slate-500', 'dark:text-slate-400');
    btnE.classList.add('text-slate-500', 'dark:text-slate-400');
    btnE.classList.remove('text-brand');
    
    // UI Panel asistenten
    coachTitle.textContent = "MODO BÁSICO ACTIVO";
    coachB.classList.remove('hidden');
    coachE.classList.add('hidden');
    
    hintExe.textContent = "Ingresa a qué precio compraste y vendiste.";
  } else {
    slider.style.transform = 'translateX(100%)';
    btnE.classList.add('text-brand');
    btnE.classList.remove('text-slate-500', 'dark:text-slate-400');
    btnB.classList.add('text-slate-500', 'dark:text-slate-400');
    btnB.classList.remove('text-brand');

    coachTitle.innerHTML = "MODO EXPERTO ACTIVO <span class='animate-pulse inline-block'>🔬</span>";
    coachE.classList.remove('hidden');
    coachB.classList.add('hidden');
    
    hintExe.textContent = "El sistema gestionará tamaño de contratos, fees y RR ratio matemáticamente.";
  }

  // Ocultar / Mostrar los divs con clase "expert-only"
  const expertElements = document.querySelectorAll('.expert-only');
  expertElements.forEach(el => {
    if (targetMode === 'beginner') {
      el.classList.add('hidden');
    } else {
      el.classList.remove('hidden');
    }
  });
  
  // Limpiar campos que se ocultan (Stop Loss, Size, TP, si estamos en beginner)
  if (targetMode === 'beginner') {
    document.getElementById('position_size').value = 1;
    document.getElementById('stop_loss').value = "";
    // PNL input oculto en beginner debe seguir el simulador forzosamente
  }
  
  // Trigger calc forzoso
  if(window.triggerCalc) window.triggerCalc();
};

// ---------- CALCULADORA EN VIVO ----------
document.addEventListener("DOMContentLoaded", function() {
  
  window.triggerCalc = function() {
    const entry = parseFloat(document.getElementById('entry_price')?.value) || 0;
    const exit  = parseFloat(document.getElementById('exit_price')?.value) || 0;
    const size  = parseFloat(document.getElementById('position_size')?.value) || 1;
    const sl    = parseFloat(document.getElementById('stop_loss')?.value) || 0;
    const pnlOutput = document.getElementById('actual_pnl');
    
    const directionEl = document.querySelector('input[name="trade[direction]"]:checked');
    const isLong = directionEl && directionEl.value === 'LONG';

    if (entry <= 0 || exit <= 0) return;
    
    const pointsCaptured = isLong ? (exit - entry) : (entry - exit);
    const pnl = pointsCaptured * size;
    
    let riskPoints = 0;
    if (sl > 0) {
       riskPoints = isLong ? (entry - sl) : (sl - entry);
    }
    const riskDollar = riskPoints * size;
    const r = (riskDollar > 0) ? (pnl / riskDollar).toFixed(2) + 'R' : '—';
    
    const g = 'text-emerald-500', rd = 'text-rose-500', w = 'text-slate-800 dark:text-white';
    
    const pEl = document.getElementById('calc-pnl');
    const rEl = document.getElementById('calc-r');
    const pct2 = document.getElementById('calc-pct');
    
    pEl.textContent = (pnl >= 0 ? '+' : '') + '$' + pnl.toFixed(2);
    pEl.className   = 'text-xl font-black font-mono transition-all ' + (pnl >= 0 ? g : rd);
    
    pct2.textContent = (pointsCaptured >= 0 ? '+' : '') + pointsCaptured.toFixed(2) + ' pts';
    pct2.className  = 'text-xl font-black font-mono transition-all ' + (pointsCaptured >= 0 ? g : rd);
    
    if(rEl) {
      rEl.textContent = r;
      rEl.className   = 'text-xl font-black font-mono transition-all ' + w;
    }

    // El input del form real siempre recibe el calculo
    if (pnlOutput && document.activeElement.id !== 'actual_pnl') {
      pnlOutput.value = pnl.toFixed(2);
    }
  };

  ['entry_price','exit_price','position_size','stop_loss'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', window.triggerCalc);
  });
  
  document.querySelectorAll('.dir-radio').forEach(el => {
    el.addEventListener('change', window.triggerCalc);
  });
  
  // Set default mode on mount (Beginner by default)
  setMode('beginner');
});

window.selectSymbol = function(sym) {
  const input = document.getElementById('trade_symbol_input');
  if (input) {
    input.value = sym;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }
};

window.togglePropFirmSelector = function() {
  const container = document.getElementById('prop-firm-company-container');
  const propRadio = document.querySelector('input[name="trade[portfolio_mode]"][value="prop_firm"]');
  if (container && propRadio) {
    if (propRadio.checked) {
      container.classList.remove('hidden');
    } else {
      container.classList.add('hidden');
    }
  }
};

window.selectTradePropFirm = function(name, btn) {
  const input = document.getElementById('selected_prop_firm_input');
  if (input) input.value = name;
  document.querySelectorAll('.prop-firm-chip').forEach(c => {
    c.classList.remove('ring-2', 'ring-brand', 'border-brand', 'bg-brand/10');
  });
  if (btn) {
    btn.classList.add('ring-2', 'ring-brand', 'border-brand', 'bg-brand/10');
  }
};

document.addEventListener("DOMContentLoaded", function() {
  togglePropFirmSelector();
});
</script>
