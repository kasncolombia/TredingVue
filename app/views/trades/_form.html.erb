<%# _form.html.erb — partial compartido por new y edit %>
<% content_for :page_title, @trade.new_record? ? "Nueva Operación" : "Editar #{@trade.symbol}" %>

<div class="max-w-3xl mx-auto fade-in">

  <!-- BREADCRUMB -->
  <div class="flex items-center gap-2 text-xs text-slate-400 mb-5">
    <%= link_to "Operaciones", trades_path, class: "hover:text-indigo-500 transition-colors" %>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-600 dark:text-slate-300 font-medium"><%= trade.new_record? ? "Nueva Operación" : "Editar #{trade.symbol}" %></span>
  </div>

  <%= form_with model: trade, local: true, html: { class: "space-y-5", id: "trade-form" } do |f| %>

    <!-- SECCIÓN 1: BÁSICO -->
    <div class="glass rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-7 h-7 rounded-lg bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs font-black">1</div>
        <h2 class="text-sm font-bold text-slate-800 dark:text-white">Información Básica</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Símbolo <span class="text-rose-500">*</span></label>
          <%= f.text_field :symbol, placeholder: "BTC/USDT, AAPL...",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all uppercase" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Dirección <span class="text-rose-500">*</span></label>
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input type="radio" name="trade[direction]" value="LONG" class="sr-only peer" <%= trade.direction == 'LONG' ? 'checked' : '' %>>
              <div class="peer-checked:bg-emerald-500/20 peer-checked:border-emerald-500 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-400 input-field border py-2.5 rounded-xl text-xs font-bold text-center transition-all cursor-pointer">▲ LONG</div>
            </label>
            <label class="flex-1 cursor-pointer">
              <input type="radio" name="trade[direction]" value="SHORT" class="sr-only peer" <%= trade.direction == 'SHORT' ? 'checked' : '' %>>
              <div class="peer-checked:bg-rose-500/20 peer-checked:border-rose-500 peer-checked:text-rose-600 dark:peer-checked:text-rose-400 input-field border py-2.5 rounded-xl text-xs font-bold text-center transition-all cursor-pointer">▼ SHORT</div>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Estrategia</label>
          <%= f.collection_select :strategy_id, current_user.strategies, :id, :name,
              { prompt: "Selecciona estrategia" },
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Resultado</label>
          <%= f.select :result, [["WIN","WIN"],["LOSS","LOSS"],["BREAKEVEN","BREAKEVEN"],["OPEN","OPEN"]],
              { prompt: "Resultado" },
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Fecha/Hora Entrada</label>
          <%= f.datetime_local_field :entry_at,
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Fecha/Hora Salida</label>
          <%= f.datetime_local_field :exit_at,
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 2: EJECUCIÓN -->
    <div class="glass rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-7 h-7 rounded-lg bg-violet-500/15 text-violet-600 dark:text-violet-400 flex items-center justify-center text-xs font-black">2</div>
        <h2 class="text-sm font-bold text-slate-800 dark:text-white">Datos de Ejecución</h2>
        <span class="ml-auto text-[10px] px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 font-semibold border border-amber-500/20">⚡ Cálculo automático</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Precio entrada</label>
          <%= f.number_field :entry_price, step: "any", placeholder: "0.00", id: "entry_price",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Precio salida</label>
          <%= f.number_field :exit_price, step: "any", placeholder: "0.00", id: "exit_price",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Tamaño</label>
          <%= f.number_field :position_size, step: "any", placeholder: "1.0", id: "position_size",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Stop Loss</label>
          <%= f.number_field :stop_loss, step: "any", placeholder: "0.00", id: "stop_loss",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Take Profit</label>
          <%= f.number_field :take_profit, step: "any", placeholder: "0.00",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Comisión ($)</label>
          <%= f.number_field :commission, step: "any", placeholder: "0.00",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
      </div>
      <div class="mt-4 p-4 rounded-xl border border-dashed border-indigo-400/40 dark:border-indigo-500/30 bg-indigo-50/50 dark:bg-indigo-900/10">
        <p class="text-[10px] font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">Resultado calculado</p>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div><p class="text-[10px] text-slate-500 mb-0.5">P&L Estimado</p><p id="calc-pnl" class="text-lg font-black text-slate-800 dark:text-white">—</p></div>
          <div><p class="text-[10px] text-slate-500 mb-0.5">R Multiple</p><p id="calc-r" class="text-lg font-black text-slate-800 dark:text-white">—</p></div>
          <div><p class="text-[10px] text-slate-500 mb-0.5">P&L %</p><p id="calc-pct" class="text-lg font-black text-slate-800 dark:text-white">—</p></div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 3: CONTEXTO -->
    <div class="glass rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs font-black">3</div>
        <h2 class="text-sm font-bold text-slate-800 dark:text-white">Contexto y Reflexión</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Setup / Patrón</label>
          <%= f.text_field :setup, placeholder: "Doble techo, ruptura...",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Estado emocional</label>
          <%= f.select :emotion,
              [["😌 Tranquilo","calm"],["😤 Ansioso","anxious"],["😁 Confiado","confident"],["😰 Temeroso","fearful"],["😑 Neutral","neutral"]],
              { prompt: "¿Cómo te sentías?" },
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Tags (separados por coma)</label>
          <%= f.text_field :tags_string, placeholder: "breakout, cripto, htf...",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all" %>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Notas / Reflexión</label>
          <%= f.text_area :notes, rows: 3, placeholder: "¿Por qué entraste? ¿Qué salió bien/mal?",
              class: "input-field w-full px-4 py-2.5 rounded-xl text-sm focus:outline-none transition-all resize-none" %>
        </div>
      </div>
    </div>

    <!-- ERRORS -->
    <% if trade.errors.any? %>
    <div class="glass rounded-2xl p-4 border-l-4 border-rose-500">
      <p class="text-xs font-bold text-rose-500 mb-2"><%= trade.errors.count %> error(es) al guardar:</p>
      <ul class="space-y-1">
        <% trade.errors.full_messages.each do |msg| %>
          <li class="text-xs text-rose-400 flex items-start gap-1.5"><span class="mt-0.5">•</span><%= msg %></li>
        <% end %>
      </ul>
    </div>
    <% end %>

    <!-- ACCIONES -->
    <div class="flex items-center justify-end gap-3 pb-4">
      <%= link_to "Cancelar", trades_path, class: "px-5 py-2.5 text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-xl border border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-darkCard transition-all" %>
      <%= f.submit trade.new_record? ? "💾 Guardar Operación" : "✏️ Actualizar Operación",
          class: "px-6 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/30 cursor-pointer transition-all transform hover:scale-[1.02]" %>
    </div>

  <% end %>
</div>

<script>
(function() {
  function calc() {
    const entry = parseFloat(document.getElementById('entry_price')?.value) || 0;
    const exit  = parseFloat(document.getElementById('exit_price')?.value) || 0;
    const size  = parseFloat(document.getElementById('position_size')?.value) || 1;
    const sl    = parseFloat(document.getElementById('stop_loss')?.value) || 0;
    if (entry <= 0 || exit <= 0) return;
    const pnl  = (exit - entry) * size;
    const pct  = ((exit - entry) / entry) * 100;
    const risk = sl > 0 ? Math.abs(entry - sl) * size : null;
    const r    = risk ? (pnl / risk).toFixed(2) + 'R' : '—';
    const g = 'text-emerald-500', rd = 'text-rose-500', w = 'text-slate-800 dark:text-white';
    const pEl = document.getElementById('calc-pnl');
    const rEl = document.getElementById('calc-r');
    const pct2 = document.getElementById('calc-pct');
    pEl.textContent = (pnl >= 0 ? '+' : '') + '$' + pnl.toFixed(2);
    pEl.className   = 'text-lg font-black ' + (pnl >= 0 ? g : rd);
    pct2.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
    pct2.className  = 'text-lg font-black ' + (pct >= 0 ? g : rd);
    rEl.textContent = r;
    rEl.className   = 'text-lg font-black ' + w;
  }
  ['entry_price','exit_price','position_size','stop_loss'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calc);
  });
  calc(); // trigger on edit
})();
</script>
