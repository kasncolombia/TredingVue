<% content_for :page_title, "Operaciones" %>
<% content_for :badge do %>
  <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-darkBorder"><%= @trades.size %> trades</span>
<% end %>

<!-- MINI-KPIs -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
  <% [
    { label: "P&L Filtrado",  value: "$#{number_with_precision(@stats[:total_pnl], precision: 2)}",  color: @stats[:total_pnl].to_f >= 0 ? 'text-emerald-500' : 'text-rose-500' },
    { label: "Win Rate",      value: "#{@stats[:win_rate]}%",                                         color: 'text-indigo-600 dark:text-indigo-400' },
    { label: "Profit Factor", value: @stats[:profit_factor].to_s,                                     color: 'text-slate-800 dark:text-white' },
    { label: "Trades",        value: "#{@stats[:wins_count]}W / #{@stats[:losses_count]}L",           color: 'text-slate-800 dark:text-white' },
  ].each do |kpi| %>
    <div class="stat-card rounded-xl px-4 py-3">
      <p class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-0.5"><%= kpi[:label] %></p>
      <p class="text-sm font-black <%= kpi[:color] %>"><%= kpi[:value] %></p>
    </div>
  <% end %>
</div>

<!-- FILTROS -->
<div class="glass p-3 rounded-xl mb-4">
  <%= form_with url: trades_path, method: :get, local: true, class: "flex flex-wrap gap-2 items-center" do |f| %>
    <%= f.text_field :symbol, placeholder: "Símbolo (BTC...)", value: params[:symbol],
        class: "input-field px-3 py-2 rounded-lg text-xs focus:outline-none w-32 transition-all" %>
    <%= f.select :direction, [["Dirección", ""], ["LONG", "LONG"], ["SHORT", "SHORT"]],
        { selected: params[:direction] },
        class: "input-field px-3 py-2 rounded-lg text-xs focus:outline-none transition-all" %>
    <%= f.select :result, [["Resultado", ""], ["WIN", "WIN"], ["LOSS", "LOSS"], ["BREAKEVEN", "BREAKEVEN"]],
        { selected: params[:result] },
        class: "input-field px-3 py-2 rounded-lg text-xs focus:outline-none transition-all" %>
    <%= f.collection_select :strategy_id, current_user.strategies, :id, :name,
        { prompt: "Estrategia", selected: params[:strategy_id] },
        class: "input-field px-3 py-2 rounded-lg text-xs focus:outline-none transition-all" %>
    <%= f.submit "Filtrar",
        class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-lg cursor-pointer transition-all" %>
    <%= link_to "Limpiar", trades_path, class: "px-3 py-2 text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-darkCard transition-all" %>
    <div class="ml-auto flex gap-2">
      <%= link_to new_trade_path, class: "flex items-center gap-1.5 px-3 py-2 text-xs font-semibold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-lg border border-emerald-500/20 transition-all" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
        Nueva
      <% end %>
      <%= link_to import_trades_path, class: "flex items-center gap-1.5 px-3 py-2 text-xs font-semibold bg-slate-100 dark:bg-darkCard hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg border border-slate-200 dark:border-darkBorder transition-all" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        CSV
      <% end %>
    </div>
  <% end %>
</div>

<!-- TABLA DE TRADES -->
<div class="glass rounded-2xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead class="table-header">
        <tr class="border-b border-slate-200 dark:border-darkBorder">
          <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Fecha</th>
          <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Activo</th>
          <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Dir.</th>
          <th class="py-3 px-4 text-left text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Estrategia</th>
          <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Entrada</th>
          <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Salida</th>
          <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">P&L</th>
          <th class="py-3 px-4 text-center text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">R</th>
          <th class="py-3 px-4 text-center text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Resultado</th>
          <th class="py-3 px-4 text-right text-[10px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
        <% @trades.each do |trade| %>
        <tr class="table-row-hover transition-all duration-150 group">
          <td class="py-3 px-4 text-slate-500 dark:text-slate-400 whitespace-nowrap"><%= trade.entry_at&.strftime("%d/%m/%y %H:%M") || "—" %></td>
          <td class="py-3 px-4">
            <%= link_to trade_path(trade), class: "font-bold text-slate-800 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
              <%= trade.symbol %>
            <% end %>
          </td>
          <td class="py-3 px-4"><%= direction_badge(trade.direction) %></td>
          <td class="py-3 px-4 text-slate-600 dark:text-slate-300"><%= trade.strategy&.name || "—" %></td>
          <td class="py-3 px-4 text-right text-slate-600 dark:text-slate-300 font-medium"><% if trade.entry_price %>$<%= trade.entry_price %><% else %>—<% end %></td>
          <td class="py-3 px-4 text-right text-slate-600 dark:text-slate-300 font-medium"><% if trade.exit_price %>$<%= trade.exit_price %><% else %>—<% end %></td>
          <td class="py-3 px-4 text-right font-black <%= pnl_class(trade.pnl) %>">
            <%= trade.pnl >= 0 ? "+" : "" %>$<%= number_with_precision(trade.pnl, precision: 2) %>
          </td>
          <td class="py-3 px-4 text-center text-slate-600 dark:text-slate-300 font-semibold">
            <%= trade.r_multiple ? "#{trade.r_multiple}R" : "—" %>
          </td>
          <td class="py-3 px-4 text-center"><%= result_badge(trade.result || "—") %></td>
          <td class="py-3 px-4 text-right">
            <div class="flex justify-end gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
              <%= link_to trade, class: "p-1.5 text-slate-400 hover:text-indigo-500 dark:hover:text-indigo-400 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all" do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <% end %>
              <%= link_to edit_trade_path(trade), class: "p-1.5 text-slate-400 hover:text-amber-500 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-all" do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= link_to trade, data: { "turbo-method": :delete, "turbo-confirm": "¿Eliminar esta operación?" }, class: "p-1.5 text-slate-400 hover:text-rose-500 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all" do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          </td>
        </tr>
        <% end %>
        <% if @trades.empty? %>
        <tr>
          <td colspan="10" class="py-16 text-center text-slate-400 dark:text-slate-500">
            <div class="flex flex-col items-center gap-3">
              <svg class="w-12 h-12 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
              <p class="font-semibold">No hay operaciones <% if params[:direction].present? || params[:result].present? || params[:symbol].present? %>con estos filtros<% else %>registradas<% end %></p>
              <% if params[:direction].present? || params[:result].present? || params[:symbol].present? %>
                <%= link_to "Limpiar filtros", trades_path, class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold" %>
              <% else %>
                <%= link_to new_trade_path, class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl shadow-md transition-all" do %>+ Registrar primera operación<% end %>
              <% end %>
            </div>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @trades.size > 0 %>
  <div class="px-5 py-3 border-t border-slate-200 dark:border-darkBorder flex items-center justify-between">
    <p class="text-xs text-slate-500 dark:text-slate-400">Mostrando <span class="font-semibold text-slate-700 dark:text-slate-300"><%= @trades.size %></span> operaciones</p>
    <%= link_to analytics_path, class: "flex items-center gap-1.5 text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold" do %>
      Ver Analytics completo →
    <% end %>
  </div>
  <% end %>
</div>
