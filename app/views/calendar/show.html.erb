<% content_for :page_title, "Calendario de Trading" %>

<div class="space-y-6 fade-in">

  <!-- MONTH SELECTOR & HEADER -->
  <div class="glass rounded-2xl sm:rounded-3xl p-4 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-3 sm:gap-4 border dark:border-darkBorder border-lightBorder">
    <div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[20px] sm:text-[24px]">calendar_month</span>
        <h2 class="text-base sm:text-xl font-black dark:text-white text-slate-900 capitalize">
          <%= l(@current_month, format: "%B %Y") rescue @current_month.strftime("%B %Y") %>
        </h2>
      </div>
      <p class="text-[10px] sm:text-xs text-slate-400 mt-0.5 sm:mt-1 font-medium">Mapa térmico y resumen diario</p>
    </div>

    <!-- MONTH NAVIGATION -->
    <div class="flex items-center gap-2">
      <a href="<%= calendar_path(month: (@current_month - 1.month).strftime('%Y-%m')) %>" class="p-2.5 rounded-2xl dark:bg-darkCard bg-white hover:bg-brand/10 dark:text-slate-300 text-slate-700 border dark:border-darkBorder border-lightBorder transition-all shadow-sm flex items-center justify-center" title="Mes Anterior">
        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
      </a>

      <a href="<%= calendar_path %>" class="px-4 py-2 text-xs font-extrabold bg-brand/15 text-brand dark:text-brand-light rounded-2xl border border-brand/30 hover:bg-brand/25 transition-all shadow-sm">
        Mes Actual
      </a>

      <a href="<%= calendar_path(month: (@current_month + 1.month).strftime('%Y-%m')) %>" class="p-2.5 rounded-2xl dark:bg-darkCard bg-white hover:bg-brand/10 dark:text-slate-300 text-slate-700 border dark:border-darkBorder border-lightBorder transition-all shadow-sm flex items-center justify-center" title="Mes Siguiente">
        <span class="material-symbols-outlined text-[20px]">chevron_right</span>
      </a>
    </div>
  </div>

  <!-- MONTHLY KPIS (MOBILE SLIDER) -->
  <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 scrollbar-hide sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-4 sm:overflow-visible sm:pb-0">
    <!-- P&L Mensual -->
    <div class="stat-card rounded-2xl sm:rounded-3xl p-3 sm:p-5 relative overflow-hidden min-w-[150px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">P&L Mensual</span>
      <p class="text-lg sm:text-2xl font-black font-mono mt-1 <%= @month_stats[:total_pnl] >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
        <%= @month_stats[:total_pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(@month_stats[:total_pnl], precision: 2, delimiter: ',') %>
      </p>
      <p class="text-[10px] sm:text-[11px] text-slate-400 mt-1 font-medium"><%= @month_stats[:total_trades] %> ejecuciones</p>
    </div>

    <!-- Días Verdes / Rojos -->
    <div class="stat-card rounded-2xl sm:rounded-3xl p-3 sm:p-5 relative overflow-hidden min-w-[150px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Días V / R</span>
      <div class="flex items-center gap-2 mt-1 font-mono">
        <span class="text-lg sm:text-2xl font-black text-emerald-500"><%= @green_days %>V</span>
        <span class="text-slate-400">/</span>
        <span class="text-lg sm:text-2xl font-black text-rose-500"><%= @red_days %>R</span>
      </div>
      <p class="text-[10px] sm:text-[11px] text-slate-400 mt-1 font-medium">WR: <strong class="text-emerald-500"><%= @month_stats[:win_rate] %>%</strong></p>
    </div>

    <!-- Mejor Día -->
    <div class="stat-card rounded-2xl sm:rounded-3xl p-3 sm:p-5 relative overflow-hidden min-w-[150px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Mejor Día</span>
      <p class="text-lg sm:text-2xl font-black font-mono text-emerald-500 mt-1">
        +$<%= number_with_precision(@best_day, precision: 2, delimiter: ',') %>
      </p>
      <p class="text-[10px] sm:text-[11px] text-slate-400 mt-1 font-medium">Máx beneficio 24h</p>
    </div>

    <!-- Peor Día -->
    <div class="stat-card rounded-2xl sm:rounded-3xl p-3 sm:p-5 relative overflow-hidden min-w-[150px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Peor Día</span>
      <p class="text-lg sm:text-2xl font-black font-mono text-rose-500 mt-1">
        $<%= number_with_precision(@worst_day, precision: 2, delimiter: ',') %>
      </p>
      <p class="text-[10px] sm:text-[11px] text-slate-400 mt-1 font-medium">Máx drawdown 24h</p>
    </div>
  </div>

  <!-- CALENDAR BENTO GRID DE 8 COLUMNAS -->
  <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-5 md:p-6 shadow-sm">
    
    <!-- HEADER DIAS SEMANA (7 DÍAS + 8VA COLUMNA TOTALES SEMANALES) -->
    <div class="grid grid-cols-8 gap-2.5 mb-4 text-center text-xs font-extrabold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
      <div class="py-2 rounded-xl bg-white dark:bg-slate-800/80 shadow-xs border border-slate-200/60 dark:border-slate-700/50">Lun</div>
      <div class="py-2 rounded-xl bg-white dark:bg-slate-800/80 shadow-xs border border-slate-200/60 dark:border-slate-700/50">Mar</div>
      <div class="py-2 rounded-xl bg-white dark:bg-slate-800/80 shadow-xs border border-slate-200/60 dark:border-slate-700/50">Mié</div>
      <div class="py-2 rounded-xl bg-white dark:bg-slate-800/80 shadow-xs border border-slate-200/60 dark:border-slate-700/50">Jue</div>
      <div class="py-2 rounded-xl bg-white dark:bg-slate-800/80 shadow-xs border border-slate-200/60 dark:border-slate-700/50">Vie</div>
      <div class="py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/50">Sáb</div>
      <div class="py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/50">Dom</div>
      <div class="py-2 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/50 font-black">Totales</div>
    </div>

    <!-- FILAS DE SEMANAS (7 DÍAS + 1 TOTAL SEMANAL) -->
    <div class="space-y-3">
      <% @weeks.each_with_index do |week_days, idx| %>
        <% week_summary = @weekly_pnls[idx] || { pnl: 0, count: 0 } %>
        
        <div class="grid grid-cols-8 gap-2.5">
          <!-- 7 DÍAS DE LA SEMANA -->
          <% week_days.each do |date| %>
            <% 
              is_current_month = date.month == @current_month.month
              day_trades = @trades_by_date[date] || []
              daily_pnl  = day_trades.sum(&:pnl)
              has_trades  = day_trades.any?
              is_today    = date == Date.current

              # PALETA PASTEL SUAVE SEGÚN RESULTADO (LIGHT MODE OPTIMIZED)
              card_bg_class = if !is_current_month
                "bg-slate-100/40 dark:bg-slate-900/30 text-slate-300 dark:text-slate-600 border-slate-200/30 dark:border-slate-800/30 shadow-none opacity-50"
              elsif has_trades
                if daily_pnl > 0
                  # Verde Menta Pastel
                  "bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/60 text-emerald-900 dark:text-emerald-200 shadow-sm hover:border-emerald-400 hover:shadow-md"
                elsif daily_pnl < 0
                  # Rosa Pastel Suave
                  "bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/60 text-rose-900 dark:text-rose-200 shadow-sm hover:border-rose-400 hover:shadow-md"
                else
                  # Azul Lavanda / Neutro
                  "bg-indigo-50/70 dark:bg-indigo-950/30 border-indigo-200/80 dark:border-indigo-800/50 text-indigo-900 dark:text-indigo-200 shadow-sm hover:border-indigo-300"
                end
              else
                # Inactivo / Sin trades
                "bg-white dark:bg-slate-800/60 border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 hover:border-brand/40 shadow-xs"
              end
            %>

            <div class="min-h-[120px] p-3 rounded-2xl border transition-all duration-200 relative group flex flex-col justify-between cursor-pointer hover:-translate-y-0.5 <%= card_bg_class %> <%= is_today ? 'ring-2 ring-brand ring-offset-2 dark:ring-offset-slate-900 font-bold' : '' %>"
                 data-date="<%= date.to_s %>"
                 data-trades="<%= day_trades.to_json(include: :strategy) %>"
                 onclick="showDayDetails(this)">
              
              <!-- NÚMERO DEL DÍA EN ESQUINA SUPERIOR IZQUIERDA -->
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold <%= is_today ? 'text-brand font-black' : 'text-slate-500 dark:text-slate-400' %>">
                  <%= date.day %>
                </span>
                
                <% if is_today %>
                  <span class="text-[9px] px-1.5 py-0.5 rounded-md bg-brand text-white font-extrabold uppercase">Hoy</span>
                <% elsif has_trades %>
                  <span class="material-symbols-outlined text-[14px] opacity-40 group-hover:opacity-100 transition-opacity">sticky_note_2</span>
                <% end %>
              </div>

              <!-- MONTO MONETARIO AL CENTRO EN TIPOGRAFÍA TECH/FINANCIERA BOLD -->
              <div class="my-auto py-1">
                <% if has_trades %>
                  <p class="text-sm md:text-base font-black font-mono tracking-tight <%= daily_pnl > 0 ? 'text-emerald-600 dark:text-emerald-400' : (daily_pnl < 0 ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-300') %> truncate">
                    <%= daily_pnl >= 0 ? '+' : '' %>$<%= number_with_precision(daily_pnl, precision: 2, delimiter: ',') %>
                  </p>
                <% else %>
                  <span class="text-xs font-mono text-slate-300 dark:text-slate-600 font-medium">—</span>
                <% end %>
              </div>

              <!-- ETIQUETA SECUNDARIA PEQUEÑA CON CONTEO DE TRADES Y SYMBOLS -->
              <div class="flex items-center justify-between text-[10px] font-semibold text-slate-500 dark:text-slate-400 border-t border-slate-200/50 dark:border-slate-700/40 pt-1.5 mt-1">
                <% if has_trades %>
                  <span class="font-bold text-slate-600 dark:text-slate-300">
                    <%= day_trades.size %> <%= day_trades.size == 1 ? 'trade' : 'trades' %>
                  </span>
                  <div class="flex gap-1">
                    <% day_trades.map(&:symbol).uniq.first(1).each do |sym| %>
                      <span class="text-[9px] px-1 py-0.5 rounded bg-slate-200/60 dark:bg-slate-700/60 font-mono font-bold text-slate-700 dark:text-slate-200 truncate max-w-[55px]"><%= sym %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-[10px] text-slate-400 dark:text-slate-500 italic">Descanso</span>
                <% end %>
              </div>

            </div>
          <% end %>

          <!-- 8VA COLUMNA: TOTALES SEMANALES -->
          <div class="min-h-[120px] p-3 rounded-2xl border border-indigo-200/80 dark:border-indigo-800/60 bg-indigo-50/50 dark:bg-indigo-950/40 text-indigo-950 dark:text-indigo-100 flex flex-col justify-between shadow-xs">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-indigo-500 dark:text-indigo-400">Semana <%= idx + 1 %></span>
              <span class="material-symbols-outlined text-indigo-400 text-[14px]">analytics</span>
            </div>

            <div class="my-auto py-1">
              <p class="text-sm md:text-base font-black font-mono tracking-tight <%= week_summary[:pnl] >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                <%= week_summary[:pnl] >= 0 ? '+' : '' %>$<%= number_with_precision(week_summary[:pnl], precision: 2, delimiter: ',') %>
              </p>
            </div>

            <div class="flex items-center justify-between text-[10px] font-extrabold text-indigo-600 dark:text-indigo-300 border-t border-indigo-200/60 dark:border-indigo-800/50 pt-1.5">
              <span><%= week_summary[:count] %> trades</span>
              <span class="font-mono text-[9.5px]"><%= week_summary[:wins] %>V / <%= week_summary[:losses] %>R</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>

</div>

<!-- MODAL DETALLE DEL DÍA -->
<div id="day-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[100] hidden flex items-center justify-center p-4">
  <div class="glass w-full max-w-lg rounded-3xl overflow-hidden border dark:border-brand/40 border-brand/50 shadow-2xl fade-in relative">
    
    <!-- EFECTO GLOW INTERNO -->
    <div class="absolute top-0 right-0 w-48 h-48 bg-brand/20 blur-[60px] -translate-y-1/2 translate-x-1/4 rounded-full pointer-events-none"></div>

    <div class="p-6 md:p-7 border-b dark:border-darkBorder border-slate-200 flex items-center justify-between relative z-10">
      <div>
        <h3 id="modal-date-title" class="text-xl md:text-2xl font-black dark:text-white text-slate-900 tracking-tight">Operaciones del Día</h3>
        <p id="modal-date-subtitle" class="text-xs md:text-sm text-slate-400 mt-1 font-semibold flex items-center gap-1.5"></p>
      </div>
      <button onclick="closeDayModal()" class="text-slate-400 hover:text-brand p-2 rounded-xl hover:bg-brand/10 transition-all border border-transparent hover:border-brand/20">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- LISTA DE TRADES -->
    <div id="modal-trades-list" class="px-6 md:px-7 py-5 max-h-[50vh] overflow-y-auto space-y-3 relative z-10"></div>

    <div class="p-5 md:p-6 dark:bg-darkCard bg-slate-50 border-t dark:border-darkBorder border-slate-200 flex items-center justify-end gap-3 relative z-10 backdrop-blur-xl">
      <button onclick="closeDayModal()" class="px-5 py-2.5 text-xs font-bold rounded-xl dark:bg-slate-800 bg-slate-200 dark:hover:bg-slate-700 hover:bg-slate-300 dark:text-white text-slate-800 transition-all border dark:border-slate-600 border-slate-300">
        Cerrar
      </button>
      <a href="<%= new_trade_path %>" class="px-5 py-2.5 text-xs font-black rounded-xl bg-brand text-white hover:bg-brand-hover glow-brand transition-all flex items-center gap-2 border border-white/10">
        <span class="material-symbols-outlined text-[16px]">add</span> <span class="hidden sm:inline">Nueva Operación</span>
      </a>
    </div>
  </div>
</div>

<script>
  function showDayDetails(el) {
    const dateStr = el.dataset.date;
    const trades = JSON.parse(el.dataset.trades || "[]");
    
    const modal = document.getElementById('day-modal');
    const title = document.getElementById('modal-date-title');
    const subtitle = document.getElementById('modal-date-subtitle');
    const list = document.getElementById('modal-trades-list');

    title.innerText = `Operaciones del ` + dateStr;
    
    if (!trades || trades.length === 0) {
      subtitle.innerText = "Sin ejecuciones registradas en esta fecha.";
      list.innerHTML = `
        <div class="text-center py-10 text-xs text-slate-400 space-y-2">
          <span class="material-symbols-outlined text-[32px] text-slate-500">event_busy</span>
          <p class="font-bold dark:text-slate-300 text-slate-700">No realizaste ejecuciones este día.</p>
          <p class="text-[11px]">Mantener la disciplina y estar fuera del mercado también es operar.</p>
        </div>
      `;
    } else {
      const totalPnL = trades.reduce((acc, t) => acc + parseFloat(t.pnl || 0), 0);
      subtitle.innerText = `${trades.length} trades ejecutados | P&L Neto: ${totalPnL >= 0 ? '+' : ''}$${totalPnL.toFixed(2)}`;

      list.innerHTML = trades.map(t => {
        const pnl = parseFloat(t.pnl || 0);
        const isWin = pnl >= 0;
        return `
          <a href="/trades/${t.id}" class="p-4 rounded-2xl dark:bg-darkInput bg-white border dark:border-darkBorder border-slate-200 flex items-center justify-between shadow-sm hover:border-brand transition-all block">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-black text-sm dark:text-white text-slate-900 font-mono">${t.symbol}</span>
                <span class="text-[10px] px-2.5 py-0.5 rounded-full font-black ${t.direction === 'LONG' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20'}">${t.direction}</span>
                <span class="text-[10px] text-brand font-bold flex items-center gap-0.5">Ver detalles <span class="material-symbols-outlined text-[12px]">arrow_forward</span></span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1 font-medium">Estrategia: ${t.strategy ? t.strategy.name : 'Intraday'}</p>
            </div>
            <div class="text-right">
              <p class="font-black text-base font-mono ${isWin ? 'text-emerald-500' : 'text-rose-500'}">
                ${isWin ? '+' : ''}$${pnl.toFixed(2)}
              </p>
              <span class="text-[11px] font-mono text-slate-400 font-semibold">${t.r_multiple || 0}R</span>
            </div>
          </a>
        `;
      }).join('');
    }

    modal.classList.remove('hidden');
  }

  function closeDayModal() {
    document.getElementById('day-modal').classList.add('hidden');
  }
</script>
