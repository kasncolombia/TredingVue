<% content_for :page_title, "Calendario de Trading" %>

<div class="space-y-6 fade-in max-w-[1400px] mx-auto">

  <!-- MAIN CALENDAR CONTAINER (STRATONK DARK & LIGHT SAAS STYLE) -->
  <div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a30] border-slate-200 rounded-3xl p-4 md:p-6 shadow-sm dark:shadow-2xl">
    
    <!-- HEADER DEL CALENDARIO -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      
      <!-- CONTROLES IZQUIERDA: < ABRIL | 2026 v | HOY | % | ? -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <!-- Navegación de Mes -->
        <div class="flex items-center dark:bg-[#1c1c24] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 rounded-xl px-2 py-1 gap-1">
          <a href="<%= calendar_path(month: (@current_month - 1.month).strftime('%Y-%m')) %>" class="p-1 dark:text-[#7a7a85] text-slate-500 dark:hover:text-white hover:text-slate-900 transition-colors" title="Mes Anterior">
            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
          </a>
          <span class="px-2 dark:text-white text-slate-900 font-black text-sm capitalize">
            <%= l(@current_month, format: "%B") rescue @current_month.strftime("%B") %>
          </span>
          <a href="<%= calendar_path(month: (@current_month + 1.month).strftime('%Y-%m')) %>" class="p-1 dark:text-[#7a7a85] text-slate-500 dark:hover:text-white hover:text-slate-900 transition-colors" title="Mes Siguiente">
            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
          </a>
        </div>

        <!-- Selector de Año -->
        <div class="px-3 py-1.5 rounded-xl dark:bg-[#1c1c24] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 dark:text-white text-slate-800 flex items-center gap-1.5">
          <span><%= @current_month.year %></span>
          <span class="material-symbols-outlined text-[14px] dark:text-[#7a7a85] text-slate-400">unfold_more</span>
        </div>

        <!-- Botón HOY -->
        <a href="<%= calendar_path %>" class="px-3 py-1.5 rounded-xl dark:bg-[#1c1c24] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 dark:text-white text-slate-800 hover:bg-slate-200 dark:hover:bg-[#252532] transition-all uppercase text-[11px] font-extrabold">
          HOY
        </a>

        <!-- Toggle % / $ -->
        <div class="px-2.5 py-1.5 rounded-xl dark:bg-[#1c1c24] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 dark:text-[#7a7a85] text-slate-600 cursor-pointer font-mono font-bold text-[11px]">
          %
        </div>

        <!-- Icono Info -->
        <div class="w-7 h-7 rounded-xl dark:bg-[#1c1c24] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 dark:text-[#7a7a85] text-slate-500 dark:hover:text-white hover:text-slate-900 flex items-center justify-center cursor-pointer" title="Información del Calendario">
          <span class="material-symbols-outlined text-[16px]">help</span>
        </div>
      </div>

      <!-- INSIGHT DERECHA: MONTHLY P&L -->
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl dark:bg-[#12241d] bg-emerald-50 border dark:border-emerald-500/30 border-emerald-300 text-emerald-600 dark:text-emerald-400 font-mono font-bold text-xs">
          <span class="material-symbols-outlined text-[16px]">photo_camera</span>
          <span class="text-[11px] text-[#7a7a85] uppercase font-sans font-bold">MONTHLY P&L</span>
          <span class="text-sm font-black <%= @month_stats[:total_pnl] >= 0 ? 'text-emerald-400' : 'text-rose-500' %>">
            <%= @month_stats[:total_pnl] >= 0 ? '+' : '' %>$<%= @month_stats[:total_pnl].abs >= 1000 ? "#{(@month_stats[:total_pnl]/1000.0).round(1)}K" : number_with_precision(@month_stats[:total_pnl], precision: 2, delimiter: ',') %>
          </span>
        </div>
      </div>
    </div>

    <!-- HEADER DÍAS SEMANA (7 DÍAS: DOMINGO A SÁBADO) -->
    <div class="grid grid-cols-8 gap-3 mb-3 text-center text-[11px] font-bold dark:text-[#6a6a78] text-slate-500 uppercase tracking-wider">
      <div class="py-1">DOM</div>
      <div class="py-1">LUN</div>
      <div class="py-1">MAR</div>
      <div class="py-1">MIÉ</div>
      <div class="py-1">JUE</div>
      <div class="py-1">VIE</div>
      <div class="py-1">SÁB</div>
      <div class="py-1 text-right pr-2"></div>
    </div>

    <!-- FILAS DE LA MATRIZ (7 DÍAS + 8VA COLUMNA WEEK 1..5) -->
    <div class="space-y-3">
      <% @weeks.each_with_index do |week_days, idx| %>
        <% week_summary = @weekly_pnls[idx] || { pnl: 0, count: 0 } %>
        
        <div class="grid grid-cols-8 gap-3">
          <!-- 7 DÍAS DE LA SEMANA (DOMINGO A SÁBADO) -->
          <% week_days.each do |date| %>
            <% 
              is_current_month = date.month == @current_month.month
              day_trades = @trades_by_date[date] || []
              daily_pnl  = day_trades.sum(&:pnl)
              has_trades  = day_trades.any?
              is_today    = date == Date.current

              card_style = if !is_current_month
                "dark:bg-[#111116] bg-slate-100/50 border dark:border-[#1e1e26] border-slate-200 dark:text-[#4a4a58] text-slate-400 opacity-50"
              elsif has_trades
                if daily_pnl > 0
                  # Día Verde Ganador
                  "dark:bg-[#0f271e] bg-emerald-50 border dark:border-emerald-500/30 border-emerald-200 text-emerald-950 dark:text-white shadow-xs"
                elsif daily_pnl < 0
                  # Día Rojo Perdedor
                  "dark:bg-[#2c131a] bg-rose-50 border dark:border-rose-500/30 border-rose-200 text-rose-950 dark:text-white shadow-xs"
                else
                  # Neutro
                  "dark:bg-[#181820] bg-slate-100 border dark:border-[#252532] border-slate-200 dark:text-white text-slate-900"
                end
              else
                # Inactivo / Sin trades
                "dark:bg-[#181820] bg-slate-100/80 border dark:border-[#22222c] border-slate-200 dark:text-[#6a6a78] text-slate-400 dark:hover:border-[#333342] hover:border-slate-300"
              end
            %>

            <div class="min-h-[110px] md:min-h-[125px] p-3 rounded-2xl border transition-all duration-200 relative group flex flex-col justify-between cursor-pointer <%= card_style %> <%= is_today ? 'ring-2 ring-purple-500 font-bold' : '' %>"
                 data-date="<%= date.to_s %>"
                 data-trades="<%= day_trades.to_json(include: :strategy) %>"
                 onclick="showDayDetails(this)">
              
              <!-- NÚMERO DEL DÍA EN ESQUINA SUPERIOR IZQUIERDA -->
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold <%= is_current_month ? 'dark:text-white text-slate-900' : 'dark:text-[#4a4a58] text-slate-400' %>">
                  <%= date.day.to_s.rjust(2, '0') %>
                </span>
                <% if is_today %>
                  <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                <% end %>
              </div>

              <!-- MONTO AL CENTRO -->
              <div class="my-auto text-center py-1">
                <% if has_trades %>
                  <p class="text-sm md:text-base font-black font-mono tracking-tight dark:text-white text-slate-900">
                    <%= daily_pnl >= 0 ? '' : '-' %>$<%= number_with_precision(daily_pnl.abs, precision: (daily_pnl.abs % 1 == 0 ? 0 : 2), delimiter: ',') %>
                  </p>
                  <p class="text-[10px] font-medium dark:text-[#8a8a9a] text-slate-500 mt-0.5">
                    <%= day_trades.size %> <%= day_trades.size == 1 ? 'trade' : 'trades' %>
                  </p>
                <% end %>
              </div>

            </div>
          <% end %>

          <!-- 8VA COLUMNA: TOTAL SEMANAL -->
          <div class="min-h-[110px] md:min-h-[125px] p-3 rounded-2xl border dark:border-[#242432] border-slate-200 dark:bg-[#181822] bg-slate-100 dark:text-white text-slate-900 flex flex-col justify-between shadow-xs">
            <div class="flex items-center justify-between text-[10px] font-bold dark:text-[#6a6a78] text-slate-500">
              <span>Week <%= idx + 1 %></span>
            </div>

            <div class="my-auto text-center py-1">
              <% if week_summary[:count] > 0 %>
                <p class="text-sm md:text-base font-black font-mono tracking-tight <%= week_summary[:pnl] >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-500' %>">
                  <%= week_summary[:pnl] >= 0 ? '+' : '' %>$<%= week_summary[:pnl].abs >= 1000 ? "#{(week_summary[:pnl]/1000.0).round(1)}K" : number_with_precision(week_summary[:pnl], precision: 2) %>
                </p>
                <p class="text-[10px] font-medium dark:text-[#8a8a9a] text-slate-500 mt-0.5">
                  <%= week_summary[:count] %> trades
                </p>
              <% else %>
                <p class="text-xs font-mono dark:text-[#4a4a58] text-slate-400">—</p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>

</div>

<!-- MODAL DETALLE DEL DÍA -->
<div id="day-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[100] hidden flex items-center justify-center p-4">
  <div class="dark:bg-[#141414] bg-white border dark:border-[#2a2a35] border-slate-200 w-full max-w-lg rounded-3xl overflow-hidden shadow-2xl fade-in relative">
    
    <div class="p-5 border-b dark:border-[#2a2a35] border-slate-200 flex items-center justify-between">
      <div>
        <h3 id="modal-date-title" class="text-lg font-bold dark:text-white text-slate-900 tracking-tight">Operaciones del Día</h3>
        <p id="modal-date-subtitle" class="text-xs dark:text-[#7a7a85] text-slate-500 mt-0.5 font-semibold"></p>
      </div>
      <button onclick="closeDayModal()" class="dark:text-[#7a7a85] text-slate-400 dark:hover:text-white hover:text-slate-700 p-2 rounded-xl transition-all">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- LISTA DE TRADES -->
    <div id="modal-trades-list" class="p-5 max-h-[50vh] overflow-y-auto space-y-3"></div>

    <div class="p-4 dark:bg-[#181820] bg-slate-50 border-t dark:border-[#2a2a35] border-slate-200 flex items-center justify-end gap-3">
      <button onclick="closeDayModal()" class="px-4 py-2 text-xs font-bold rounded-xl dark:bg-[#22222c] bg-slate-200 dark:text-white text-slate-800 hover:bg-slate-300 dark:hover:bg-[#2b2b38] transition-all">
        Cerrar
      </button>
      <a href="<%= new_trade_path %>" class="px-4 py-2 text-xs font-black rounded-xl bg-purple-600 text-white hover:bg-purple-500 transition-all flex items-center gap-1.5 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">add</span> Nueva Operación
      </a>
    </div>
  </div>
</div>

<script>
  function showDayDetails(el) {
    const dateStr = el.dataset.date;
    const trades = JSON.parse(el.dataset.trades || "[]");
    
    const modal = document.getElementById('day-modal');
    const title = document.getElementById('modal-date-title');
    const subtitle = document.getElementById('modal-date-subtitle');
    const list = document.getElementById('modal-trades-list');

    title.innerText = `Operaciones del ` + dateStr;
    
    if (!trades || trades.length === 0) {
      subtitle.innerText = "Sin ejecuciones registradas en esta fecha.";
      list.innerHTML = `
        <div class="text-center py-8 text-xs text-[#7a7a85] space-y-2">
          <span class="material-symbols-outlined text-[32px] text-[#4a4a58]">event_busy</span>
          <p class="font-bold text-white">No realizaste ejecuciones este día.</p>
        </div>
      `;
    } else {
      const totalPnL = trades.reduce((acc, t) => acc + parseFloat(t.pnl || 0), 0);
      subtitle.innerText = `${trades.length} trades ejecutados | P&L Neto: ${totalPnL >= 0 ? '+' : ''}$${totalPnL.toFixed(2)}`;

      list.innerHTML = trades.map(t => {
        const pnl = parseFloat(t.pnl || 0);
        const isWin = pnl >= 0;
        return `
          <a href="/trades/${t.id}" class="p-3.5 rounded-2xl dark:bg-[#191922] bg-slate-100 border dark:border-[#2a2a35] border-slate-200 flex items-center justify-between shadow-xs hover:border-purple-500 transition-all block">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-black text-sm dark:text-white text-slate-900 font-mono">${t.symbol}</span>
                <span class="text-[10px] px-2 py-0.5 rounded font-bold ${t.direction === 'LONG' ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/20 text-rose-600 dark:text-rose-400'}">${t.direction}</span>
              </div>
              <p class="text-[11px] dark:text-[#7a7a85] text-slate-500 mt-1 font-medium">Estrategia: ${t.strategy ? t.strategy.name : 'Intraday'}</p>
            </div>
            <div class="text-right">
              <p class="font-black text-base font-mono ${isWin ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-500'}">
                ${isWin ? '+' : ''}$${pnl.toFixed(2)}
              </p>
              <span class="text-[11px] font-mono dark:text-[#7a7a85] text-slate-400 font-semibold">${t.r_multiple || 0}R</span>
            </div>
          </a>
        `;
      }).join('');
    }

    modal.classList.remove('hidden');
  }

  function closeDayModal() {
    document.getElementById('day-modal').classList.add('hidden');
  }
</script>

