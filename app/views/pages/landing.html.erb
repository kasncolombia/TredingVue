<%# app/views/pages/landing.html.erb %>
<div class="min-h-screen relative flex flex-col justify-between dark:bg-slate-950 bg-slate-50 dark:text-slate-100 text-slate-900 overflow-hidden selection:bg-emerald-500/30 selection:text-emerald-500 transition-colors duration-150">

  <!-- TECHNICAL GRID BACKGROUND & RADIAL GLOWS (PERMANENT & SUBTLE) -->
  <div class="fixed inset-0 dark:bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none z-0"></div>
  
  <!-- RADIAL GLOW DEGRADADOS (CYAN, PURPLE, EMERALD) -->
  <div class="absolute -top-40 -right-40 w-[650px] h-[650px] bg-emerald-500/15 dark:bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>
  <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-cyan-500/15 dark:bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>
  <div class="absolute top-2/3 -right-40 w-[550px] h-[550px] bg-purple-500/15 dark:bg-purple-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>

  <!-- NAVBAR -->
  <header class="w-full max-w-[1280px] mx-auto flex items-center justify-between h-[72px] px-4 sm:px-6 lg:px-8 z-30 relative border-b dark:border-slate-800/60 border-slate-200/60 backdrop-blur-xl bg-white/80 dark:bg-slate-950/80 sticky top-0">
    <div class="flex items-center gap-8">
      <%= link_to root_path, class: "flex items-center shrink-0 hover:opacity-90 transition-opacity" do %>
        <%= image_tag "tradetres_logo.png", class: "h-9 w-auto object-contain", alt: "TradeTres" %>
      <% end %>

      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600 dark:text-slate-300">
        <a href="#herramientas" class="hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">Producto</a>
        <a href="#ecosistema" class="hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">Recursos</a>
        <a href="#comunidad" class="hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">Comunidad</a>
        <a href="#precios" class="hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">Precios</a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <!-- THEME TOGGLE -->
      <button onclick="toggleTheme()" type="button" class="w-9 h-9 rounded-xl dark:bg-slate-900 bg-white border dark:border-slate-800 border-slate-200 flex items-center justify-center dark:text-amber-400 text-slate-700 hover:border-emerald-500/40 transition-all shadow-sm shrink-0" title="Cambiar Tema">
        <span class="material-symbols-outlined text-[18px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[18px] hidden dark:block text-amber-400">light_mode</span>
      </button>

      <% if user_signed_in? %>
        <%= link_to dashboard_path, class: "px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5" do %>
          <span>Ir a la Plataforma</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        <% end %>
      <% else %>
        <%= link_to "Iniciar Sesión", new_user_session_path, class: "px-3.5 py-2 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-emerald-500 transition-colors hidden sm:block" %>
        <%= link_to new_user_registration_path, class: "px-4 py-2.5 rounded-xl bg-slate-950 dark:bg-white text-white dark:text-slate-950 hover:bg-slate-800 dark:hover:bg-slate-100 font-extrabold text-xs shadow-lg transition-all flex items-center gap-1.5" do %>
          <span>Comienza Gratis</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        <% end %>
      <% end %>
    </div>
  </header>

  <!-- HERO SECTION -->
  <main class="relative z-10 flex-1 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <section class="py-12 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- HERO TEXT (45% COL SPAN 5) -->
        <div class="lg:col-span-5 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.16em] text-emerald-600 dark:text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>OPERA, ANALIZA, EJECUTA</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[54px] leading-[1.02] tracking-[-0.035em] font-black dark:text-white text-slate-950">
            Tu ecosistema <br/>
            <span class="text-emerald-500 dark:text-emerald-400">completo</span> de trading.
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
            Registra tus operaciones, analiza tu desempeño, mejora con inteligencia artificial y lleva tu trading a otro nivel.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-2">
            <%= link_to new_user_registration_path, class: "w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-950 dark:bg-white text-white dark:text-slate-950 font-black text-sm shadow-xl hover:bg-slate-800 dark:hover:bg-slate-100 transition-all flex items-center justify-center gap-2 group" do %>
              <span>Comienza Gratis</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            <% end %>

            <a href="#herramientas" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 text-slate-800 dark:text-slate-200 font-extrabold text-sm shadow-sm hover:border-emerald-500/50 transition-all flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[18px] text-emerald-500">play_circle</span>
              <span>Ver Video</span>
            </a>
          </div>

          <!-- AVATARS & SOCIAL PROOF -->
          <div class="pt-2 flex items-center justify-center lg:justify-start gap-3">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-emerald-500 text-white font-bold text-xs flex items-center justify-center border-2 border-white dark:border-slate-950">A</div>
              <div class="w-8 h-8 rounded-full bg-cyan-500 text-white font-bold text-xs flex items-center justify-center border-2 border-white dark:border-slate-950">R</div>
              <div class="w-8 h-8 rounded-full bg-purple-500 text-white font-bold text-xs flex items-center justify-center border-2 border-white dark:border-slate-950">M</div>
              <div class="w-8 h-8 rounded-full bg-amber-500 text-white font-bold text-xs flex items-center justify-center border-2 border-white dark:border-slate-950">J</div>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold">
              Únete a miles de traders que ya están construyendo un mejor futuro.
            </p>
          </div>

          <!-- METRICS ROW -->
          <div class="grid grid-cols-4 gap-2 pt-6 border-t dark:border-slate-800/80 border-slate-200/80 text-left">
            <div>
              <p class="text-xl sm:text-2xl font-black dark:text-white text-slate-950">10K+</p>
              <p class="text-[10px] text-slate-400 font-medium">Traders activos</p>
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-black text-emerald-500 font-mono">1M+</p>
              <p class="text-[10px] text-slate-400 font-medium">Operaciones</p>
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-black dark:text-white text-slate-950 font-mono">$500M+</p>
              <p class="text-[10px] text-slate-400 font-medium">Volumen</p>
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-black text-amber-500">4.8/5</p>
              <p class="text-[10px] text-slate-400 font-medium">Valoración</p>
            </div>
          </div>
        </div>

        <!-- HERO MOCKUP (55% COL SPAN 7) -->
        <div class="lg:col-span-7 relative">
          <div class="relative rounded-3xl border dark:border-slate-800 border-slate-200 bg-white/90 dark:bg-slate-900/90 p-2 shadow-2xl backdrop-blur-xl">
            <div class="relative overflow-hidden rounded-2xl border dark:border-slate-800/80 border-slate-100">
              <%= image_tag "landing-portada.png", class: "w-full h-auto object-cover rounded-2xl shadow-lg", alt: "TradeTres Dashboard Replay Portada" %>
            </div>

            <!-- ANNOTATION BADGE 1 -->
            <div class="absolute -top-4 -right-2 sm:right-4 bg-emerald-600 text-white text-[11px] font-bold px-3 py-1.5 rounded-xl shadow-lg flex items-center gap-1.5 border border-emerald-400/40">
              <span class="material-symbols-outlined text-[15px]">verified</span>
              <span>MÁS QUE UN JOURNAL: Tu palanca de crecimiento</span>
            </div>

            <!-- ANNOTATION BADGE 2 -->
            <div class="absolute -bottom-4 -left-2 sm:left-4 bg-slate-950/95 text-white dark:bg-white/95 dark:text-slate-950 text-[11px] font-bold px-3 py-1.5 rounded-xl shadow-xl border dark:border-slate-200 border-slate-800 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              <span>disciplina hoy, mejores resultados mañana</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- FIVE TOOLS OVERVIEW SECTION -->
    <section id="herramientas" class="py-16 border-t border-b dark:border-slate-800/60 border-slate-200/60">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <p class="text-[11px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">TODO LO QUE NECESITAS</p>
        <h2 class="text-2xl sm:text-4xl font-black dark:text-white text-slate-950">Cinco herramientas poderosas. Una sola plataforma.</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-sm hover:border-emerald-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold mb-3">
            <span class="material-symbols-outlined">dashboard</span>
          </div>
          <h3 class="font-extrabold text-sm dark:text-white mb-1">Dashboard / Journal</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Registra, analiza y entiende tu rendimiento.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-sm hover:border-cyan-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-500 flex items-center justify-center font-bold mb-3">
            <span class="material-symbols-outlined">account_balance</span>
          </div>
          <h3 class="font-extrabold text-sm dark:text-white mb-1">Prop Firms</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Administra tus cuentas y objetivos de fondeo.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-sm hover:border-purple-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold mb-3">
            <span class="material-symbols-outlined">replay</span>
          </div>
          <h3 class="font-extrabold text-sm dark:text-white mb-1">Backtesting</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Prueba tus estrategias con datos históricos.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-sm hover:border-amber-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold mb-3">
            <span class="material-symbols-outlined">smart_toy</span>
          </div>
          <h3 class="font-extrabold text-sm dark:text-white mb-1">AI Coach</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Obtén análisis y recomendaciones con IA.</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-sm hover:border-emerald-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold mb-3">
            <span class="material-symbols-outlined">groups</span>
          </div>
          <h3 class="font-extrabold text-sm dark:text-white mb-1">Comunidad</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Comparte, aprende y conecta con otros traders.</p>
        </div>
      </div>
    </section>

    <!-- SECTION 1: DASHBOARD / JOURNAL -->
    <section class="py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-5 space-y-5">
          <div class="text-[11px] font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400">DASHBOARD / JOURNAL / ESTRATEGIAS</div>
          <h2 class="text-3xl sm:text-4xl font-black dark:text-white text-slate-950 leading-tight">Tu centro de control de trading.</h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Registra cada operación. Mide cada estrategia. Entiende exactamente qué impulsa tu rendimiento para tomar mejores decisiones.
          </p>
          <ul class="space-y-3 pt-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Analíticas avanzadas y reportes</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Seguimiento de estrategias y playbook</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Capturas de pantalla, notas y emociones</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Identifica patrones y mejora más rápido</span>
            </li>
          </ul>
          <div class="pt-3">
            <a href="#precios" class="inline-flex items-center gap-2 text-sm font-extrabold text-emerald-600 dark:text-emerald-400 hover:underline">
              <span>Explorar Journal</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 relative">
          <div class="relative rounded-3xl border dark:border-slate-800 border-slate-200 bg-white dark:bg-slate-900 p-2 shadow-xl">
            <%= image_tag "calendario-landing.png", class: "w-full h-auto object-cover rounded-2xl shadow-md", alt: "Calendario de Trading TradeTres" %>
            <div class="absolute -top-3 -right-3 bg-slate-900 text-white text-[11px] font-bold px-3 py-1 rounded-lg border border-slate-700 shadow-md">
              Conecta tus trades sin información útil
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: PROP FIRMS -->
    <section class="py-20 border-t dark:border-slate-800/60 border-slate-200/60">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- MOCKUP FIRST ON DESKTOP (SPAN 7) -->
        <div class="lg:col-span-7 order-2 lg:order-1 relative">
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border dark:border-slate-800 border-slate-200 shadow-xl space-y-6">
            <div class="flex items-center justify-between pb-4 border-b dark:border-slate-800 border-slate-200">
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Cuentas Fondeadas</p>
                <p class="text-2xl font-black text-emerald-500 font-mono mt-0.5">$1,250,000 <span class="text-xs text-slate-400 font-normal">Capital Total</span></p>
              </div>
              <div class="flex gap-4 text-right">
                <div>
                  <p class="text-[10px] text-slate-400">Pagos Recibidos</p>
                  <p class="text-sm font-bold text-emerald-500 font-mono">$14,750</p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400">Ganancia Neta</p>
                  <p class="text-sm font-bold text-emerald-500 font-mono">$12,910</p>
                </div>
              </div>
            </div>

            <!-- PROP TABLE MOCK -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs font-medium">
                <thead>
                  <tr class="text-slate-400 border-b dark:border-slate-800 border-slate-100 pb-2">
                    <th class="pb-2">Firma</th>
                    <th class="pb-2">Cuenta</th>
                    <th class="pb-2">Tipo</th>
                    <th class="pb-2">Balance</th>
                    <th class="pb-2">P&L</th>
                    <th class="pb-2">Estado</th>
                  </tr>
                </thead>
                <tbody class="divide-y dark:divide-slate-800 divide-slate-100 font-mono">
                  <tr>
                    <td class="py-3 font-bold text-slate-900 dark:text-white">Apex</td>
                    <td class="py-3 text-slate-400">250k</td>
                    <td class="py-3 text-emerald-500 font-semibold">Fondeada</td>
                    <td class="py-3">$254,450</td>
                    <td class="py-3 text-emerald-500">+$4,450</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-sans font-bold text-[10px]">Activa</span></td>
                  </tr>
                  <tr>
                    <td class="py-3 font-bold text-slate-900 dark:text-white">Topstep</td>
                    <td class="py-3 text-slate-400">50k</td>
                    <td class="py-3 text-emerald-500 font-semibold">Fondeada</td>
                    <td class="py-3">$52,140</td>
                    <td class="py-3 text-emerald-500">+$2,140</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-sans font-bold text-[10px]">Activa</span></td>
                  </tr>
                  <tr>
                    <td class="py-3 font-bold text-slate-900 dark:text-white">AlphaFutures</td>
                    <td class="py-3 text-slate-400">50k</td>
                    <td class="py-3 text-amber-500 font-semibold">Evaluación</td>
                    <td class="py-3">$51,120</td>
                    <td class="py-3 text-emerald-500">+$1,120</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 font-sans font-bold text-[10px]">En Curso</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
          <div class="absolute -top-3 -left-3 bg-emerald-600 text-white text-[11px] font-bold px-3 py-1 rounded-lg shadow-md">
            Gestiona como conviene tus pagos
          </div>
        </div>

        <div class="lg:col-span-5 order-1 lg:order-2 space-y-5">
          <div class="text-[11px] font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400">PROP FIRMS</div>
          <h2 class="text-3xl sm:text-4xl font-black dark:text-white text-slate-950 leading-tight">Lleva el trading fondeado al siguiente nivel.</h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Gestiona evaluaciones, cuentas fondeadas, drawdowns, pagos y rendimiento, todo en un solo lugar con métricas exactas.
          </p>
          <ul class="space-y-3 pt-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Múltiples prop firms en tu cuenta</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Monitoreo de drawdowns y objetivos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Seguimiento de pagos y ROI</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
              <span>Convierte tu trading en un negocio real</span>
            </li>
          </ul>
          <div class="pt-3">
            <a href="#precios" class="inline-flex items-center gap-2 text-sm font-extrabold text-cyan-600 dark:text-cyan-400 hover:underline">
              <span>Explorar Prop Firms</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: BACKTESTING -->
    <section class="py-20 border-t dark:border-slate-800/60 border-slate-200/60">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-5 space-y-5">
          <div class="text-[11px] font-black uppercase tracking-widest text-purple-600 dark:text-purple-400">BACKTESTING REPLAY</div>
          <h2 class="text-3xl sm:text-4xl font-black dark:text-white text-slate-950 leading-tight">Reproduce. Prueba. Demuestra.</h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Practica cualquier sesión histórica, ejecuta operaciones simuladas y descubre si tu estrategia realmente tiene ventaja.
          </p>
          <ul class="space-y-3 pt-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
            <li class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-purple-500 text-[20px]">check_circle</span>
              <span>Reproducción de mercados históricos bar-by-bar</span>
            </li>
