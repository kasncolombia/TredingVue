<%# app/views/pages/landing.html.erb %>
<div class="min-h-screen relative flex flex-col justify-between bg-white text-slate-900 dark:bg-[#05080d] dark:text-white overflow-hidden selection:bg-[#009DFA]/25 selection:text-[#009DFA] transition-colors duration-150">

  <!-- BACKGROUND: grid técnico + un único glow de acento -->
  <div class="pointer-events-none fixed inset-0 z-0">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[#009DFA]/[0.06] dark:bg-[#009DFA]/10 blur-[120px]"></div>
    <div class="absolute inset-0 opacity-[0.025] dark:opacity-[0.035]" style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 50px 50px;"></div>
  </div>

  <!-- NAVBAR -->
  <header class="w-full max-w-[1280px] mx-auto flex items-center justify-between h-20 px-5 sm:px-8 lg:px-12 z-30 relative border-b border-slate-200 dark:border-white/[0.06] backdrop-blur-xl bg-white/80 dark:bg-[#05080d]/80 sticky top-0">
    <div class="flex items-center gap-10">
      <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#009DFA]/30 bg-[#009DFA]/10">
          <svg class="h-4 w-4 text-[#009DFA]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"/>
          </svg>
        </div>
        <span class="text-lg font-bold tracking-tight">Trade<span class="text-[#009DFA]">Tres</span></span>
      <% end %>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600 dark:text-slate-400">
        <a href="#herramientas" class="hover:text-slate-900 dark:hover:text-white transition-colors">Producto</a>
        <a href="#ecosistema" class="hover:text-slate-900 dark:hover:text-white transition-colors">Recursos</a>
        <a href="#comunidad" class="hover:text-slate-900 dark:hover:text-white transition-colors">Comunidad</a>
        <a href="#precios" class="hover:text-slate-900 dark:hover:text-white transition-colors">Precios</a>
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <button onclick="toggleTheme()" type="button" aria-label="Cambiar tema" class="w-9 h-9 rounded-xl bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] flex items-center justify-center text-slate-600 dark:text-slate-300 hover:border-[#009DFA]/40 transition-colors shrink-0">
        <span class="material-symbols-outlined text-[18px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[18px] hidden dark:block">light_mode</span>
      </button>

      <% if user_signed_in? %>
        <%= link_to dashboard_path, class: "ml-1 px-4 py-2 rounded-xl bg-[#009DFA] hover:bg-[#14a8ff] text-white font-semibold text-sm transition-colors" do %>
          Ir a la plataforma
        <% end %>
      <% else %>
        <%= link_to "Iniciar sesión", new_user_session_path, class: "px-3.5 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors hidden sm:block" %>
        <%= link_to new_user_registration_path, class: "ml-1 px-4 py-2 rounded-xl bg-[#009DFA] hover:bg-[#14a8ff] text-white font-semibold text-sm shadow-[0_0_25px_rgba(0,157,250,0.2)] transition-all" do %>
          Comienza gratis
        <% end %>
      <% end %>
    </div>
  </header>

  <!-- HERO -->
  <main class="relative z-10 flex-1 w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12">
    <section class="py-14 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">

        <div class="lg:col-span-5 space-y-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#009DFA]/20 bg-[#009DFA]/5 px-3.5 py-1.5 text-xs font-medium text-[#009DFA]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#009DFA]"></span>
            Journal, prop firms y backtesting en un solo lugar
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[56px] leading-[1.05] tracking-[-0.02em] font-bold">
            Cada operación cuenta una historia.
            <span class="text-[#009DFA]"> Aprende a leerla.</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg mx-auto lg:mx-0">
            Registra tus trades, prueba tu estrategia contra datos históricos y gestiona tus cuentas de fondeo, todo conectado en un mismo lugar.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-1">
            <%= link_to new_user_registration_path, class: "w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#009DFA] hover:bg-[#14a8ff] text-white font-semibold text-sm shadow-[0_0_30px_rgba(0,157,250,0.25)] transition-all flex items-center justify-center gap-2" do %>
              <span>Comienza gratis</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"/></svg>
            <% end %>

            <a href="#herramientas" class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-slate-200 dark:border-white/[0.08] text-slate-700 dark:text-slate-200 font-medium text-sm hover:border-slate-300 dark:hover:border-white/[0.16] transition-colors flex items-center justify-center gap-2">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5v14l11-7z"/></svg>
              <span>Ver cómo funciona</span>
            </a>
          </div>

          <!-- MÉTRICAS: dato real de negocio, no decoración de color -->
          <div class="grid grid-cols-4 gap-4 pt-8 border-t border-slate-200 dark:border-white/[0.06] text-left max-w-md mx-auto lg:mx-0">
            <div>
              <p class="text-2xl font-bold font-mono">10K+</p>
              <p class="text-xs text-slate-500 mt-0.5">traders activos</p>
            </div>
            <div>
              <p class="text-2xl font-bold font-mono">1M+</p>
              <p class="text-xs text-slate-500 mt-0.5">operaciones</p>
            </div>
            <div>
              <p class="text-2xl font-bold font-mono">$500M+</p>
              <p class="text-xs text-slate-500 mt-0.5">volumen</p>
            </div>
            <div>
              <p class="text-2xl font-bold font-mono">4.8/5</p>
              <p class="text-xs text-slate-500 mt-0.5">valoración</p>
            </div>
          </div>
        </div>

        <!-- HERO MOCKUP -->
        <div class="lg:col-span-7 relative">
          <div class="relative rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.15)] dark:shadow-[0_30px_80px_-20px_rgba(0,157,250,0.12)]">
            <div class="relative overflow-hidden rounded-xl">
              <%= image_tag "landing-portada.png", class: "w-full h-auto object-cover rounded-xl", alt: "Panel de TradeTres" %>
            </div>
          </div>

          <!-- Una sola nota flotante, con contenido real -->
          <div class="absolute -bottom-5 left-6 bg-white dark:bg-[#0b1119] border border-slate-200 dark:border-white/[0.1] rounded-xl px-4 py-3 shadow-lg flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17l5-5 4 4 6-8"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold">Win rate 67%</p>
              <p class="text-xs text-slate-500">últimos 30 días</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CINCO HERRAMIENTAS -->
    <section id="herramientas" class="py-16 border-t border-slate-200 dark:border-white/[0.06]">
      <div class="max-w-xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold">Cinco herramientas, una sola plataforma.</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Todo lo que necesitas para operar con disciplina, en un mismo flujo de trabajo.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <% [
          ["dashboard", "Journal", "Registra y analiza tu rendimiento."],
          ["account_balance", "Prop firms", "Administra cuentas y objetivos."],
          ["replay", "Backtesting", "Prueba estrategias con datos históricos."],
          ["smart_toy", "AI Coach", "Recomendaciones basadas en tu propio historial."],
          ["groups", "Comunidad", "Comparte y aprende de otros traders."]
        ].each do |icon, title, desc| %>
          <div class="p-5 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] hover:border-[#009DFA]/40 transition-colors">
            <div class="w-9 h-9 rounded-lg bg-[#009DFA]/10 text-[#009DFA] flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-[19px]"><%= icon %></span>
            </div>
            <h3 class="font-semibold text-sm mb-1"><%= title %></h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed"><%= desc %></p>
          </div>
        <% end %>
      </div>
    </section>

    <!-- DASHBOARD / JOURNAL -->
    <section class="py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-5 space-y-5">
          <h2 class="text-3xl sm:text-4xl font-bold leading-tight">Tu centro de control de trading.</h2>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Registra cada operación y mide cada estrategia para entender exactamente qué impulsa tu rendimiento.
          </p>
          <ul class="space-y-3 pt-1 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Analíticas avanzadas y reportes</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Seguimiento de estrategias y playbook</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Capturas, notas y estado emocional por trade</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Identifica patrones y corrígelos más rápido</span>
            </li>
          </ul>
          <a href="#precios" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#009DFA] hover:underline pt-1">
            Explorar el journal
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-2 shadow-sm">
            <%= image_tag "calendario-landing.png", class: "w-full h-auto object-cover rounded-xl", alt: "Calendario de trading TradeTres" %>
          </div>
        </div>
      </div>
    </section>

    <!-- PROP FIRMS -->
    <section class="py-20 border-t border-slate-200 dark:border-white/[0.06]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="p-6 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] shadow-sm space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-white/[0.06]">
              <div>
                <p class="text-xs text-slate-500">Cuentas fondeadas</p>
                <p class="text-2xl font-bold font-mono mt-0.5">$1,250,000 <span class="text-xs text-slate-400 font-normal">capital total</span></p>
              </div>
              <div class="flex gap-5 text-right">
                <div>
                  <p class="text-[11px] text-slate-500">Pagos recibidos</p>
                  <p class="text-sm font-semibold text-emerald-500 font-mono">$14,750</p>
                </div>
                <div>
                  <p class="text-[11px] text-slate-500">Ganancia neta</p>
                  <p class="text-sm font-semibold text-emerald-500 font-mono">$12,910</p>
                </div>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="text-slate-500 border-b border-slate-100 dark:border-white/[0.06]">
                    <th class="pb-2 font-medium">Firma</th>
                    <th class="pb-2 font-medium">Cuenta</th>
                    <th class="pb-2 font-medium">Tipo</th>
                    <th class="pb-2 font-medium">Balance</th>
                    <th class="pb-2 font-medium">P&L</th>
                    <th class="pb-2 font-medium">Estado</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/[0.06] font-mono">
                  <tr>
                    <td class="py-3 font-sans font-semibold">Apex</td>
                    <td class="py-3 text-slate-500">250k</td>
                    <td class="py-3 text-emerald-500">Fondeada</td>
                    <td class="py-3">$254,450</td>
                    <td class="py-3 text-emerald-500">+$4,450</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-500 font-sans font-medium text-[10px]">Activa</span></td>
                  </tr>
                  <tr>
                    <td class="py-3 font-sans font-semibold">Topstep</td>
                    <td class="py-3 text-slate-500">50k</td>
                    <td class="py-3 text-emerald-500">Fondeada</td>
                    <td class="py-3">$52,140</td>
                    <td class="py-3 text-emerald-500">+$2,140</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-500 font-sans font-medium text-[10px]">Activa</span></td>
                  </tr>
                  <tr>
                    <td class="py-3 font-sans font-semibold">AlphaFutures</td>
                    <td class="py-3 text-slate-500">50k</td>
                    <td class="py-3 text-amber-500">Evaluación</td>
                    <td class="py-3">$51,120</td>
                    <td class="py-3 text-emerald-500">+$1,120</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-500 font-sans font-medium text-[10px]">En curso</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 order-1 lg:order-2 space-y-5">
          <h2 class="text-3xl sm:text-4xl font-bold leading-tight">Lleva el trading fondeado al siguiente nivel.</h2>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Gestiona evaluaciones, cuentas fondeadas, drawdowns y pagos, todo en un solo lugar con métricas exactas.
          </p>
          <ul class="space-y-3 pt-1 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Múltiples prop firms en una sola cuenta</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Monitoreo de drawdowns y objetivos</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Seguimiento de pagos y retorno</span>
            </li>
          </ul>
          <a href="#precios" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#009DFA] hover:underline pt-1">
            Explorar prop firms
          </a>
        </div>
      </div>
    </section>

    <!-- BACKTESTING -->
    <section class="py-20 border-t border-slate-200 dark:border-white/[0.06]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-5 space-y-5">
          <h2 class="text-3xl sm:text-4xl font-bold leading-tight">Reproduce. Prueba. Demuestra.</h2>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Practica sobre cualquier sesión histórica y descubre si tu estrategia realmente tiene ventaja antes de arriesgar capital real.
          </p>
          <ul class="space-y-3 pt-1 text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Reproducción de mercados históricos, vela a vela</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Estadísticas de rendimiento detalladas</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 text-[#009DFA] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Sincroniza tus backtests con tu journal</span>
            </li>
          </ul>
          <a href="#precios" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#009DFA] hover:underline pt-1">
            Explorar backtesting
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="p-5 rounded-2xl bg-[#0b1119] text-white border border-white/[0.08] shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-3">
              <div class="flex items-center gap-3">
                <span class="px-2 py-0.5 rounded-md bg-[#009DFA]/15 text-[#5cc8ff] font-mono text-xs font-medium">MNQ · 1m</span>
                <span class="text-xs text-slate-500 font-mono">14 dic 2025</span>
              </div>
              <div class="flex gap-2">
                <span class="px-3 py-1 rounded-lg bg-emerald-500/15 text-emerald-400 font-medium text-xs">BUY</span>
                <span class="px-3 py-1 rounded-lg bg-rose-500/15 text-rose-400 font-medium text-xs">SELL</span>
              </div>
            </div>

            <div class="h-44 rounded-xl bg-black/20 border border-white/[0.06] p-4 relative flex items-end justify-between overflow-hidden">
              <div class="absolute top-2 left-4 text-[10px] font-mono text-slate-500">O 245.20 H 246.10 L 244.80 C 245.90</div>
              <div class="w-full flex items-end justify-between gap-1.5 h-32">
                <% [40, 55, 30, 70, 60, 90, 80, 110, 95, 125, 115, 140].each_with_index do |h, i| %>
                  <div class="flex-1 flex flex-col items-center justify-end h-full">
                    <div class="w-1 rounded-sm <%= i.even? ? 'bg-emerald-500' : 'bg-rose-500' %>" style="height: <%= h %>px;"></div>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="grid grid-cols-4 gap-2 text-center font-mono pt-1">
              <div class="p-2.5 rounded-lg bg-white/[0.03]">
                <p class="text-[10px] text-slate-500">Trades</p>
                <p class="text-sm font-semibold">42</p>
              </div>
              <div class="p-2.5 rounded-lg bg-white/[0.03]">
                <p class="text-[10px] text-slate-500">Win rate</p>
                <p class="text-sm font-semibold text-emerald-400">67%</p>
              </div>
              <div class="p-2.5 rounded-lg bg-white/[0.03]">
                <p class="text-[10px] text-slate-500">Profit factor</p>
                <p class="text-sm font-semibold">2.41</p>
              </div>
              <div class="p-2.5 rounded-lg bg-white/[0.03]">
                <p class="text-[10px] text-slate-500">P&L</p>
                <p class="text-sm font-semibold text-emerald-400">+$38.4K</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI COACH -->
    <section class="py-20 border-t border-slate-200 dark:border-white/[0.06]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="p-6 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] shadow-sm space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-white/[0.06]">
              <div class="w-9 h-9 rounded-lg bg-[#009DFA]/10 text-[#009DFA] flex items-center justify-center">
