<% content_for :page_title, "AI Trading Coach" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 fade-in">

  <!-- CHAT INTERACTIVO -->
  <div class="lg:col-span-2 glass rounded-2xl flex flex-col h-[600px] overflow-hidden">

    <!-- HEADER CHAT -->
    <div class="p-4 border-b border-slate-200 dark:border-darkBorder flex items-center justify-between bg-slate-50/50 dark:bg-darkSidebar/40">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-indigo-500/20">🤖</div>
        <div>
          <p class="text-sm font-bold text-slate-800 dark:text-white">AI Trading Coach Personal</p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">Basado en tus <%= @stats[:total_trades] %> operaciones registradas</p>
        </div>
      </div>
      <span class="text-[10px] px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-bold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> AI Activo
      </span>
    </div>

    <!-- MENSAJES -->
    <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-4">
      <% @messages.each do |msg| %>
        <% if msg.role == "assistant" %>
          <div class="flex items-start gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-xs font-bold flex-shrink-0">AI</div>
            <div class="bg-slate-100 dark:bg-darkSidebar p-3.5 rounded-2xl rounded-tl-none border border-slate-200 dark:border-darkBorder text-xs text-slate-700 dark:text-slate-200 leading-relaxed max-w-[85%] shadow-sm">
              <%= msg.content %>
            </div>
          </div>
        <% else %>
          <div class="flex items-start gap-2.5 justify-end">
            <div class="bg-gradient-to-r from-indigo-600 to-violet-600 p-3.5 rounded-2xl rounded-tr-none text-xs text-white leading-relaxed max-w-[85%] shadow-md shadow-indigo-500/20">
              <%= msg.content %>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @messages.empty? %>
        <div class="flex items-start gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-xs font-bold flex-shrink-0">AI</div>
          <div class="bg-slate-100 dark:bg-darkSidebar p-3.5 rounded-2xl rounded-tl-none border border-slate-200 dark:border-darkBorder text-xs text-slate-700 dark:text-slate-200 leading-relaxed shadow-sm">
            👋 ¡Hola! Soy tu AI Trading Coach. He analizado tus operaciones. ¿En qué área o pregunta te gustaría enfocarte hoy?
          </div>
        </div>
      <% end %>
    </div>

    <!-- SUGERENCIAS Y FORMULARIO -->
    <div class="p-4 border-t border-slate-200 dark:border-darkBorder space-y-2.5 bg-slate-50/30 dark:bg-darkSidebar/20">
      <div class="flex flex-wrap gap-1.5">
        <button onclick="setQuestion(this)" class="text-[11px] px-2.5 py-1 rounded-lg bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder text-slate-600 dark:text-slate-300 hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all">¿Cuál es mi mayor error?</button>
        <button onclick="setQuestion(this)" class="text-[11px] px-2.5 py-1 rounded-lg bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder text-slate-600 dark:text-slate-300 hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all">¿Qué estrategia me funciona mejor?</button>
        <button onclick="setQuestion(this)" class="text-[11px] px-2.5 py-1 rounded-lg bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder text-slate-600 dark:text-slate-300 hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all">¿Estoy sobreoperando?</button>
      </div>
      <div class="flex gap-2">
        <input id="chat-input" type="text" placeholder="Haz una pregunta a tu coach..." class="input-field flex-1 px-4 py-2.5 rounded-xl text-xs focus:outline-none transition-all">
        <button onclick="sendMessage()" class="px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-500/20 transition-all cursor-pointer">
          Enviar
        </button>
      </div>
    </div>
  </div>

  <!-- PANEL LATERAL: DIAGNÓSTICO RECIENTE Y STATS -->
  <div class="space-y-5 flex flex-col">

    <!-- Diagnóstico Reciente -->
    <div class="glass p-5 rounded-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-200 dark:border-darkBorder">
        <p class="text-sm font-bold text-slate-800 dark:text-white">Diagnóstico Reciente</p>
        <% if @recent_trade %><span class="text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400"><%= @recent_trade.symbol %></span><% end %>
      </div>

      <% if @last_analysis %>
        <div class="space-y-3 text-xs">
          <div>
            <div class="flex justify-between text-slate-500 dark:text-slate-400 mb-1">
              <span>Score de Disciplina</span>
              <span class="font-bold text-slate-800 dark:text-white"><%= @last_analysis.discipline_score %>/10</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
              <div class="h-2 rounded-full <%= @last_analysis.discipline_score >= 7 ? "bg-emerald-500" : @last_analysis.discipline_score >= 5 ? "bg-amber-500" : "bg-rose-500" %>" style="width:<%= @last_analysis.discipline_score * 10 %>%"></div>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg border border-slate-200 dark:border-darkBorder text-slate-700 dark:text-slate-300 leading-relaxed">
            <%= @last_analysis.feedback %>
          </div>
          <% if @last_analysis.reflection_question %>
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 text-[11px]">
              <strong>💡 Reflexión:</strong> <%= @last_analysis.reflection_question %>
            </div>
          <% end %>
        </div>
      <% elsif @recent_trade %>
        <div class="text-center py-4 space-y-2">
          <p class="text-xs text-slate-500 dark:text-slate-400">Sin análisis aún para tu última operación (<%= @recent_trade.symbol %>).</p>
          <button onclick="analyzeLastTrade(<%= @recent_trade.id %>)" class="px-4 py-2 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-600 dark:text-indigo-300 text-xs font-bold rounded-xl border border-indigo-500/30 transition-all">
            ⚡ Analizar Trade Ahora
          </button>
        </div>
      <% else %>
        <p class="text-xs text-slate-400 text-center py-6">Registra tu primera operación para recibir un diagnóstico del AI Coach.</p>
      <% end %>
    </div>

    <!-- Resumen de Métricas -->
    <div class="glass p-5 rounded-2xl space-y-3">
      <p class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider mb-2">Métricas Base del Coach</p>
      <div class="space-y-2 text-xs">
        <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-darkBorder/50">
          <span class="text-slate-500 dark:text-slate-400">Win Rate</span>
          <span class="font-bold text-slate-800 dark:text-white"><%= @stats[:win_rate] %>%</span>
        </div>
        <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-darkBorder/50">
          <span class="text-slate-500 dark:text-slate-400">Profit Factor</span>
          <span class="font-bold text-slate-800 dark:text-white"><%= @stats[:profit_factor] %></span>
        </div>
        <div class="flex justify-between items-center py-1">
          <span class="text-slate-500 dark:text-slate-400">P&L Acumulado</span>
          <span class="font-bold <%= pnl_class(@stats[:total_pnl]) %>"><%= @stats[:total_pnl] >= 0 ? "+" : "" %>$<%= number_with_precision(@stats[:total_pnl], precision: 2) %></span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function setQuestion(btn) {
  document.getElementById("chat-input").value = btn.textContent;
}

function sendMessage() {
  const input = document.getElementById("chat-input");
  const msg = input.value.trim();
  if (!msg) return;
  input.value = "";
  const container = document.getElementById("chat-messages");
  container.innerHTML += `<div class="flex items-start gap-2.5 justify-end"><div class="bg-gradient-to-r from-indigo-600 to-violet-600 p-3.5 rounded-2xl rounded-tr-none text-xs text-white leading-relaxed max-w-[85%] shadow-md shadow-indigo-500/20">${msg}</div></div>`;
  container.scrollTop = container.scrollHeight;

  fetch("<%= chat_ai_coach_path %>", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content },
    body: JSON.stringify({ message: msg })
  }).then(r => r.json()).then(data => {
    container.innerHTML += `<div class="flex items-start gap-2.5"><div class="w-8 h-8 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-xs font-bold flex-shrink-0">AI</div><div class="bg-slate-100 dark:bg-darkSidebar p-3.5 rounded-2xl rounded-tl-none border border-slate-200 dark:border-darkBorder text-xs text-slate-700 dark:text-slate-200 leading-relaxed max-w-[85%] shadow-sm">${data.message}</div></div>`;
    container.scrollTop = container.scrollHeight;
  });
}

document.getElementById("chat-input")?.addEventListener("keypress", e => { if (e.key === "Enter") sendMessage(); });
const c = document.getElementById("chat-messages"); if (c) c.scrollTop = c.scrollHeight;

function analyzeLastTrade(id) {
  fetch("<%= analyze_trade_ai_coach_path %>", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content },
    body: JSON.stringify({ trade_id: id })
  }).then(() => window.location.reload());
}
</script>
