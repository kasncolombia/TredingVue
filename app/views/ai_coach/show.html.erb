<% content_for :page_title, "AI Trading Coach" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 fade-in">

  <!-- ===================== MAIN CHAT INTERFACE ===================== -->
  <div class="lg:col-span-2 glass rounded-3xl flex flex-col h-[680px] overflow-hidden">

    <!-- CHAT HEADER -->
    <div class="p-3 sm:p-4 border-b dark:border-darkBorder border-lightBorder flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4 dark:bg-darkCard/50 bg-slate-50/50">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-brand flex items-center justify-center text-white shadow-lg glow-brand shrink-0">
          <span class="material-symbols-outlined text-[22px]">smart_toy</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <p class="text-sm font-extrabold dark:text-white text-slate-900">AI Trading Coach Personal</p>
          </div>
          <p class="text-[10px] sm:text-[11px] text-slate-400">Analizando tus <%= @stats[:total_trades] %> operaciones registradas</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <% if current_user.admin? %>
          <span class="text-[10px] px-2.5 py-1 rounded-full bg-cyan-500/15 text-cyan-500 border border-cyan-500/30 font-mono font-bold flex items-center gap-1 shadow-sm" title="Solo visible para Administradores">
            <span class="material-symbols-outlined text-[12px] text-cyan-400">bolt</span>
            <%= @ai_provider.to_s.upcase %>: <%= @ai_model %>
          </span>
        <% end %>
        <span class="text-[10px] px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold flex items-center gap-1.5 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Coach En Línea
        </span>
      </div>
    </div>

    <!-- MESSAGES AREA -->
    <div id="chat-messages" class="flex-1 p-5 overflow-y-auto space-y-4 text-xs">
      <% @messages.each do |msg| %>
        <% if msg.role == "assistant" %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-brand/15 border border-brand/30 flex items-center justify-center text-brand text-xs font-bold flex-shrink-0">
              <span class="material-symbols-outlined text-[16px]">smart_toy</span>
            </div>
            <div class="dark:bg-darkInput bg-white p-4 rounded-2xl rounded-tl-none border dark:border-darkBorder border-lightBorder text-slate-700 dark:text-slate-200 leading-relaxed max-w-[85%] shadow-sm">
              <%= msg.content %>
            </div>
          </div>
        <% else %>
          <div class="flex items-start gap-3 justify-end">
            <div class="bg-brand p-4 rounded-2xl rounded-tr-none text-white leading-relaxed max-w-[85%] shadow-md glow-brand">
              <%= msg.content %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @messages.empty? %>
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-xl bg-brand/15 border border-brand/30 flex items-center justify-center text-brand text-xs font-bold flex-shrink-0">
            <span class="material-symbols-outlined text-[16px]">smart_toy</span>
          </div>
          <div class="dark:bg-darkInput bg-white p-4 rounded-2xl rounded-tl-none border dark:border-darkBorder border-lightBorder text-slate-700 dark:text-slate-200 leading-relaxed shadow-sm space-y-2">
            <p>👋 ¡Hola, <strong><%= current_user.name&.split&.first || "Trader" %></strong>! Soy tu AI Trading Coach.</p>
            <p>Tengo sincronizado tu perfil de trader (<%= current_user.trader_type || 'Futures' %> - <%= current_user.main_market || 'NQ/ES' %>) y tus <%= @stats[:total_trades] %> operaciones en bitácora.</p>
            <p class="text-slate-400">¿Qué aspecto de tu psicología o estrategia te gustaría analizar hoy?</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- QUICK PROMPTS AND INPUT FORM -->
    <div class="p-4 border-t dark:border-darkBorder border-lightBorder space-y-3 dark:bg-darkCard/30 bg-slate-50/30">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-nowrap overflow-x-auto snap-x snap-mandatory gap-2 pb-2 scrollbar-hide xl:flex-wrap xl:overflow-visible xl:pb-0 w-full xl:w-auto">
          <button onclick="setQuestion(this)" class="text-[11px] px-3 py-1.5 rounded-xl dark:bg-darkInput bg-white border dark:border-darkBorder border-lightBorder text-slate-600 dark:text-slate-300 hover:border-brand hover:text-brand transition-all font-medium flex items-center gap-1 whitespace-nowrap snap-start">
            <span>💡</span> ¿Cuál es mi patrón de pérdida más frecuente?
          </button>
          <button onclick="setQuestion(this)" class="text-[11px] px-3 py-1.5 rounded-xl dark:bg-darkInput bg-white border dark:border-darkBorder border-lightBorder text-slate-600 dark:text-slate-300 hover:border-brand hover:text-brand transition-all font-medium flex items-center gap-1 whitespace-nowrap snap-start">
            <span>🎯</span> ¿Qué estrategia me genera mayor retorno?
          </button>
          <button onclick="setQuestion(this)" class="text-[11px] px-3 py-1.5 rounded-xl dark:bg-darkInput bg-white border dark:border-darkBorder border-lightBorder text-slate-600 dark:text-slate-300 hover:border-brand hover:text-brand transition-all font-medium flex items-center gap-1 whitespace-nowrap snap-start">
            <span>⚠️</span> ¿Cómo estoy operando después de una pérdida?
          </button>
        </div>
        <button onclick="resetChat()" class="text-[11px] px-3 py-1.5 rounded-xl bg-rose-500/10 text-rose-500 hover:bg-rose-500/20 border border-rose-500/20 transition-all font-bold flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">delete</span> Limpiar Chat
        </button>
      </div>

      <div class="flex gap-2">
        <input id="chat-input" type="text" placeholder="Haz una consulta cuantitativa o psicológica a tu AI Coach..." class="input-field flex-1 px-4 py-3 rounded-xl text-xs focus:outline-none transition-all">
        <button onclick="sendMessage()" class="px-6 py-3 bg-brand hover:bg-brand-hover text-white text-xs font-bold rounded-xl shadow-md glow-brand transition-all cursor-pointer flex items-center gap-1.5">
          <span>Enviar</span>
          <span class="material-symbols-outlined text-[16px]">send</span>
        </button>
      </div>
    </div>

  </div>

  <!-- ===================== SIDEBAR DIAGNOSIS ===================== -->
  <div class="space-y-6 flex flex-col">

    <!-- RECENT DIAGNOSIS -->
    <div class="glass p-5 rounded-3xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b dark:border-darkBorder border-lightBorder">
        <h3 class="text-sm font-extrabold dark:text-white text-slate-900">Diagnóstico de la Última Operación</h3>
        <% if @recent_trade %>
          <span class="text-[10px] font-bold font-mono px-2 py-0.5 rounded bg-brand/10 text-brand"><%= @recent_trade.symbol %></span>
        <% end %>
      </div>

      <% if @last_analysis %>
        <div class="space-y-3 text-xs">
          <div>
            <div class="flex justify-between text-slate-400 mb-1 font-semibold">
              <span>Score de Disciplina</span>
              <span class="font-bold dark:text-white text-slate-800 font-mono"><%= @last_analysis.discipline_score %>/10</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-darkInput h-2 rounded-full overflow-hidden">
              <div class="h-2 rounded-full <%= @last_analysis.discipline_score >= 7 ? "bg-accent-green" : @last_analysis.discipline_score >= 5 ? "bg-amber-500" : "bg-loss" %>" style="width:<%= @last_analysis.discipline_score * 10 %>%"></div>
            </div>
          </div>
          <div class="p-3 rounded-2xl dark:bg-darkInput bg-slate-50 border dark:border-darkBorder border-lightBorder text-slate-600 dark:text-slate-300 leading-relaxed">
            <%= @last_analysis.feedback %>
          </div>
          <% if @last_analysis.reflection_question %>
            <div class="p-3 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[11px]">
              <strong>💡 Pregunta de Reflexión:</strong> <%= @last_analysis.reflection_question %>
            </div>
          <% end %>
        </div>
      <% elsif @recent_trade %>
        <div class="text-center py-4 space-y-3">
          <p class="text-xs text-slate-400">Aún no has generado un análisis para tu último trade (<%= @recent_trade.symbol %>).</p>
          <button onclick="analyzeLastTrade(<%= @recent_trade.id %>)" class="px-4 py-2 bg-brand/15 hover:bg-brand/25 text-brand dark:text-brand-light text-xs font-bold rounded-xl border border-brand/20 transition-all cursor-pointer">
            ⚡ Generar Diagnóstico AI
          </button>
        </div>
      <% else %>
        <p class="text-xs text-slate-400 text-center py-6">Registra tu primera operación para recibir un diagnóstico personalizado.</p>
      <% end %>
    </div>

    <!-- METRIC BASE SUMMARY -->
    <div class="glass p-5 rounded-3xl space-y-3">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Base de Conocimiento AI</h4>
      <div class="space-y-2 text-xs">
        <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/50 border-lightBorder/50">
          <span class="text-slate-400">Estilo de Trader</span>
          <span class="font-bold dark:text-white text-slate-800 font-mono"><%= current_user.trader_type || 'General' %></span>
        </div>
        <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/50 border-lightBorder/50">
          <span class="text-slate-400">Mercado Clave</span>
          <span class="font-bold dark:text-white text-slate-800 font-mono"><%= current_user.main_market || 'NQ/Forex' %></span>
        </div>
        <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/50 border-lightBorder/50">
          <span class="text-slate-400">Win Rate Evaluado</span>
          <span class="font-bold dark:text-white text-slate-800 font-mono"><%= @stats[:win_rate] %>%</span>
        </div>
        <div class="flex justify-between items-center py-1.5 border-b dark:border-darkBorder/50 border-lightBorder/50">
          <span class="text-slate-400">Factor de Beneficio</span>
          <span class="font-bold dark:text-white text-slate-800 font-mono"><%= @stats[:profit_factor] %></span>
        </div>
        <div class="flex justify-between items-center py-1.5">
          <span class="text-slate-400">P&L Neto Analizado</span>
          <span class="font-bold font-mono <%= pnl_class(@stats[:total_pnl]) %>"><%= @stats[:total_pnl] >= 0 ? "+" : "" %>$<%= number_with_precision(@stats[:total_pnl], precision: 2) %></span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function setQuestion(btn) {
  document.getElementById("chat-input").value = btn.textContent.replace(/^[^\w¿]+/, '').trim();
}

function sendMessage() {
  const input = document.getElementById("chat-input");
  const msg = input.value.trim();
  if (!msg) return;
  input.value = "";
  const container = document.getElementById("chat-messages");
  
  // Agregar mensaje de usuario
  container.innerHTML += `
    <div class="flex items-start gap-3 justify-end">
      <div class="bg-brand p-4 rounded-2xl rounded-tr-none text-white leading-relaxed max-w-[85%] shadow-md glow-brand">${msg}</div>
    </div>`;

  // Agregar indicador de carga temporal
  const loadingId = "loading-" + Date.now();
  container.innerHTML += `
    <div id="${loadingId}" class="flex items-start gap-3 fade-in">
      <div class="w-8 h-8 rounded-xl bg-brand/15 border border-brand/30 flex items-center justify-center text-brand text-xs font-bold flex-shrink-0 animate-pulse"><span class="material-symbols-outlined text-[16px]">smart_toy</span></div>
      <div class="dark:bg-darkInput bg-white p-4 rounded-2xl rounded-tl-none border dark:border-darkBorder border-lightBorder text-slate-400 leading-relaxed shadow-sm font-mono flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        Coach IA analizando...
      </div>
    </div>`;
  container.scrollTop = container.scrollHeight;

  const csrfToken = document.querySelector("meta[name=csrf-token]").content;
  fetch("<%= chat_ai_coach_path %>", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
    body: JSON.stringify({ message: msg })
  }).then(r => r.json()).then(data => {
    const loadingElem = document.getElementById(loadingId);
    if (loadingElem) loadingElem.remove();

    const formattedReply = (data.message || "").replace(/\n/g, '<br>');
    container.innerHTML += `
      <div class="flex items-start gap-3 fade-in">
        <div class="w-8 h-8 rounded-xl bg-brand/15 border border-brand/30 flex items-center justify-center text-brand text-xs font-bold flex-shrink-0"><span class="material-symbols-outlined text-[16px]">smart_toy</span></div>
        <div class="dark:bg-darkInput bg-white p-4 rounded-2xl rounded-tl-none border dark:border-darkBorder border-lightBorder text-slate-700 dark:text-slate-200 leading-relaxed max-w-[85%] shadow-sm">${formattedReply}</div>
      </div>`;
    container.scrollTop = container.scrollHeight;
  }).catch(() => {
    const loadingElem = document.getElementById(loadingId);
    if (loadingElem) loadingElem.remove();
  });
}

function resetChat() {
  if (!confirm('¿Estás seguro de que deseas limpiar el chat actual con el AI Coach? El historial se borrará.')) return;
  
  const csrfToken = document.querySelector("meta[name=csrf-token]").content;
  fetch("<%= reset_ai_coach_path %>", {
    method: "DELETE",
    headers: { "X-CSRF-Token": csrfToken, "Accept": "application/json" }
  }).then(r => r.json()).then(data => {
    if (data.success) {
      window.location.reload();
    }
  });
}

document.getElementById("chat-input")?.addEventListener("keypress", e => { if (e.key === "Enter") sendMessage(); });
const c = document.getElementById("chat-messages"); if (c) c.scrollTop = c.scrollHeight;

function analyzeLastTrade(id) {
  const csrfToken = document.querySelector("meta[name=csrf-token]").content;
  fetch("<%= analyze_trade_ai_coach_path %>", {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
    body: JSON.stringify({ trade_id: id })
  }).then(() => window.location.reload());
}
</script>
