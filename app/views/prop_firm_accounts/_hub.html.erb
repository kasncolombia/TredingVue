<% content_for :page_title, "Prop Firms & Herramientas" %>

<div class="space-y-6 fade-in pb-12" data-controller="prop-filter">
  
  <!-- BOTÓN PARA VER / OCULTAR INTRO EN CUALQUIER MOMENTO -->
  <div class="flex items-center justify-between">
    <button type="button" onclick="toggleIntroHero()" class="inline-flex items-center gap-2 text-xs font-bold text-brand hover:underline cursor-pointer bg-brand/10 dark:bg-brand/20 px-3.5 py-1.5 rounded-xl border border-brand/20">
      <span class="material-symbols-outlined text-[16px]">info</span>
      <span id="intro-hero-btn-text"><%= @accounts.any? ? "Ver Guía de Introducción 💼" : "Ocultar Guía 💼" %></span>
    </button>
  </div>

  <!-- SECCIÓN INTRO HERO (VISIBLE POR DEFAULT SI NO HAY CUENTAS, O TOGGLEABLE SI HAY CUENTAS) -->
  <div id="intro-hero-banner" class="glass rounded-3xl p-6 md:p-8 border border-brand/30 bg-gradient-to-r from-brand/10 via-slate-900/40 to-emerald-500/10 shadow-xl space-y-4 fade-in <%= @accounts.any? ? 'hidden' : '' %>">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- CONTENIDO Y PROPUESTA DE VALOR -->
      <div class="space-y-3 max-w-xl text-center md:text-left">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand/20 text-brand text-xs font-bold border border-brand/30">
          <span class="material-symbols-outlined text-[14px]">domain</span>
          Módulo Institucional de Cuentas de Fondeo
        </div>
        <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Gestiona tu Empresa de Fondeo como un Negocio Real 💼
        </h2>
        <p class="text-xs md:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Configura tus cuentas de evaluación (Topstep, Apex, FTMO, etc.), audita tus reglas de Drawdown/Profit y registra cada inversión o retiro ganado para mantener tu contabilidad institucional al día.
        </p>
        <div class="pt-1 flex flex-wrap items-center justify-center md:justify-start gap-3">
          <%= link_to new_prop_firm_account_path, class: "px-6 py-2.5 bg-brand hover:scale-[1.02] text-white font-extrabold text-xs rounded-xl shadow-lg glow-brand transition-all inline-flex items-center gap-1.5 cursor-pointer" do %>
            <span class="material-symbols-outlined text-[16px]">add_circle</span>
            <span>+ Nueva Cuenta de Fondeo</span>
          <% end %>
        </div>
      </div>

      <!-- MOCKUP / ICONO ILUSTRATIVO DE PRO TOOLS -->
      <div class="relative w-28 h-28 flex-shrink-0 flex items-center justify-center">
        <div class="absolute inset-0 rounded-3xl bg-brand/20 blur-xl animate-pulse"></div>
        <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-brand to-emerald-400 text-white flex items-center justify-center shadow-2xl relative z-10 border border-white/20">
          <span class="material-symbols-outlined text-[52px]">account_tree</span>
        </div>
      </div>

    </div>
  </div>

  <% if @accounts.any? %>
    
    <% 
      # KPIs TOP-LEVEL ANALYTICS
      total_capital = @accounts.sum { |a| a.account_size.to_s.gsub(/[^\d.]/, '').to_f * 1000 }
      total_invested = @accounts.sum { |a| a.eval_fee.to_f + a.activation_fee.to_f }
      total_pnl = @accounts.sum { |a| a.pnl_total.to_f }
      total_payouts = current_user.respond_to?(:prop_transactions) ? current_user.prop_transactions.where(transaction_type: 'payout').sum(:amount).to_f : 0.0
    %>

    <!-- BANNER DE KPIS GLOBALES (TOP-LEVEL ANALYTICS) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-2">
      <!-- KPI 1: CAPITAL FINANCIADO TOTAL -->
      <div class="glass p-4 rounded-2xl border border-slate-200 dark:border-darkBorder flex items-center justify-between shadow-xs">
        <div>
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Capital Monitoreado</span>
          <span class="text-xl font-black text-slate-900 dark:text-white font-mono mt-0.5 block">
            $<%= number_with_precision(total_capital, precision: 0, delimiter: ',') %>
          </span>
        </div>
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-[20px]">account_balance</span>
        </div>
      </div>

      <!-- KPI 2: INVERSIÓN EN EVALUACIONES -->
      <div class="glass p-4 rounded-2xl border border-slate-200 dark:border-darkBorder flex items-center justify-between shadow-xs">
        <div>
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Inversión Evaluaciones</span>
          <span class="text-xl font-black text-slate-900 dark:text-white font-mono mt-0.5 block">
            $<%= number_with_precision(total_invested, precision: 2, delimiter: ',') %>
          </span>
        </div>
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-[20px]">receipt_long</span>
        </div>
      </div>

      <!-- KPI 3: PNL / PROFIT ACUMULADO -->
      <div class="glass p-4 rounded-2xl border border-slate-200 dark:border-darkBorder flex items-center justify-between shadow-xs">
        <div>
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">PnL Acumulado</span>
          <span class="text-xl font-black font-mono mt-0.5 block <%= total_pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
            <%= total_pnl >= 0 ? '+' : '' %>$<%= number_with_precision(total_pnl, precision: 2, delimiter: ',') %>
          </span>
        </div>
        <div class="w-10 h-10 rounded-xl <%= total_pnl >= 0 ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500' %> flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-[20px]"><%= total_pnl >= 0 ? 'trending_up' : 'trending_down' %></span>
        </div>
      </div>

      <!-- KPI 4: RETIROS REALIZADOS (PAYOUTS) -->
      <div class="glass p-4 rounded-2xl border border-slate-200 dark:border-darkBorder flex items-center justify-between shadow-xs">
        <div>
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Retiros Realizados</span>
          <span class="text-xl font-black text-emerald-500 font-mono mt-0.5 block">
            +$<%= number_with_precision(total_payouts, precision: 2, delimiter: ',') %>
          </span>
        </div>
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-[20px]">savings</span>
        </div>
      </div>
    </div>

    <!-- FILTROS RÁPIDOS POR TAGS & BARRA DE ACCIÓN -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
      <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
        <button type="button" onclick="filterAccounts('all', this)" class="account-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-brand text-white shadow-xs transition-all cursor-pointer">
          Todas (<%= @accounts.count %>)
        </button>
        <button type="button" onclick="filterAccounts('activa', this)" class="account-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 hover:text-brand transition-all cursor-pointer">
          Activas (<%= @accounts.select { |a| a.status == 'activa' }.count %>)
        </button>
        <button type="button" onclick="filterAccounts('eval', this)" class="account-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 hover:text-brand transition-all cursor-pointer">
          En Evaluación (<%= @accounts.select { |a| a.phase.to_s.include?('paso') || a.phase == 'express' }.count %>)
        </button>
        <button type="button" onclick="filterAccounts('fondeada', this)" class="account-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 hover:text-brand transition-all cursor-pointer">
          Fondeadas (<%= @accounts.select { |a| a.phase == 'fondeada' || a.status == 'fondeada' }.count %>)
        </button>
        <button type="button" onclick="filterAccounts('quemada', this)" class="account-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-darkCard text-slate-600 dark:text-slate-400 hover:text-brand transition-all cursor-pointer">
          Quemadas (<%= @accounts.select { |a| a.status == 'quemada' }.count %>)
        </button>
      </div>

      <span class="text-xs text-slate-400 font-bold hidden md:inline">
        Mostrando <span id="account-visible-count"><%= @accounts.count %></span> de <%= @accounts.count %> cuentas
      </span>
    </div>

    <!-- GRID REDISEÑADO DE TARJETAS DE CUENTAS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="accounts-grid">
      <% @accounts.each do |acc| %>
        <% 
          phase_slug = acc.phase.to_s.downcase
          status_slug = acc.status.to_s.downcase
          filter_tags = [status_slug, phase_slug]
          filter_tags << 'eval' if phase_slug.include?('paso') || phase_slug == 'express'
        %>
        
        <div class="account-card glass rounded-2xl p-4 border border-slate-200/80 dark:border-darkBorder space-y-3 hover:border-brand/60 transition-all group" data-tags="<%= filter_tags.join(' ') %>">
          
          <!-- HEADER DE TARJETA CON LOGO & CHIPS DE ESTADO DE TAILWIND -->
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-3">
              <% logo_file = case acc.firm_name.to_s.downcase
                when /topstep/ then "compañias/Topstep.png"
                when /apex/ then "compañias/Apex Trader funding.png"
                when /myfunded/ then "compañias/My funded futures.png"
                when /tradeify/ then "compañias/Tradeify.png"
                when /lucid/ then "compañias/Lucid trading.png"
                when /alpha/ then "compañias/Alpha futures.png"
                when /take profit/ then "compañias/take profit trader.png"
                else nil
                end
              %>
              <% if logo_file %>
                <div class="w-10 h-10 rounded-xl bg-white p-1 border border-slate-200 flex items-center justify-center shadow-xs flex-shrink-0">
                  <%= image_tag logo_file, class: "max-h-full max-w-full object-contain" %>
                </div>
              <% else %>
                <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center flex-shrink-0 font-bold text-xs border border-brand/20">
                  <%= acc.firm_name.to_s.first(2).upcase %>
                </div>
              <% end %>
              <div>
                <h3 class="text-sm font-black dark:text-white text-slate-900 group-hover:text-brand transition-colors line-clamp-1"><%= acc.name.presence || acc.firm_name %></h3>
                <span class="text-[11px] font-mono text-slate-400 font-bold flex items-center gap-1">
                  <%= acc.firm_name %> • <%= acc.account_size %>
                </span>
              </div>
            </div>

            <!-- CHIPS DE ESTADO EN TAILWIND COLORS (emerald, blue, amber, red, purple) -->
            <div class="flex flex-col items-end gap-1">
              <% 
                chip_class = case status_slug
                  when 'activa' then 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30'
                  when 'fondeada' then 'bg-purple-500/10 text-purple-400 border-purple-500/30'
                  when 'quemada' then 'bg-red-500/10 text-red-500 border-red-500/30'
                  else 'bg-amber-500/10 text-amber-500 border-amber-500/30'
                  end

                phase_chip_class = case phase_slug
                  when 'paso_1' then 'bg-blue-500/10 text-blue-500 border-blue-500/30'
                  when 'paso_2' then 'bg-amber-500/10 text-amber-500 border-amber-500/30'
                  when 'fondeada' then 'bg-purple-500/10 text-purple-400 border-purple-500/30'
                  else 'bg-slate-500/10 text-slate-400 border-slate-500/30'
                  end
              %>
              <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider border <%= chip_class %>">
                <%= acc.status.capitalize %>
              </span>
              <span class="px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider border <%= phase_chip_class %>">
                <%= acc.phase.gsub('_', ' ').upcase %>
              </span>
            </div>
          </div>

          <!-- MÉTRICAS COMPACTAS -->
          <div class="grid grid-cols-2 gap-2 text-[11px] font-mono border-t dark:border-darkBorder border-slate-200 pt-3">
            <div class="bg-slate-50 dark:bg-darkCard/60 p-2 rounded-xl border border-slate-200/50 dark:border-darkBorder/50">
              <span class="text-slate-400 font-sans block text-[10px]">Profit Actual</span>
              <% pnl = acc.pnl_total.to_f %>
              <span class="font-bold text-xs <%= pnl >= 0 ? 'text-emerald-500' : 'text-rose-500' %>">
                <%= pnl >= 0 ? '+' : '' %>$<%= pnl.round(2) %>
              </span>
            </div>
            <div class="bg-slate-50 dark:bg-darkCard/60 p-2 rounded-xl border border-slate-200/50 dark:border-darkBorder/50">
              <span class="text-slate-400 font-sans block text-[10px]">Profit Target</span>
              <span class="font-bold text-xs dark:text-slate-200 text-slate-800"><%= acc.active_profit_target.present? ? "$#{acc.active_profit_target}" : 'N/A' %></span>
            </div>
            <div class="bg-slate-50 dark:bg-darkCard/60 p-2 rounded-xl border border-slate-200/50 dark:border-darkBorder/50">
              <span class="text-slate-400 font-sans block text-[10px]">Máx Drawdown</span>
              <span class="font-bold text-xs text-rose-500"><%= acc.active_max_drawdown.present? ? "$#{acc.active_max_drawdown}" : 'N/A' %></span>
            </div>
            <div class="bg-slate-50 dark:bg-darkCard/60 p-2 rounded-xl border border-slate-200/50 dark:border-darkBorder/50">
              <span class="text-slate-400 font-sans block text-[10px]">Cuota Eval.</span>
              <span class="font-bold text-xs dark:text-slate-200 text-slate-800">$<%= acc.eval_fee %></span>
            </div>
          </div>

          <div class="pt-1">
            <%= link_to prop_firm_account_path(acc), class: "w-full py-2 rounded-xl bg-slate-100 dark:bg-darkCard hover:bg-brand hover:text-white dark:hover:bg-brand text-slate-700 dark:text-slate-200 font-bold text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer" do %>
              <span class="material-symbols-outlined text-[16px]">visibility</span>
              <span>Ver Detalle</span>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
    
  <% end %>

</div>

<!-- SCRIPT DE FILTRADO DINÁMICO POR TAGS & TOGGLE INTRO -->
<script>
window.toggleIntroHero = function() {
  const banner = document.getElementById("intro-hero-banner");
  const btnText = document.getElementById("intro-hero-btn-text");
  if (banner) {
    if (banner.classList.contains("hidden")) {
      banner.classList.remove("hidden");
      if (btnText) btnText.textContent = "Ocultar Guía 💼";
    } else {
      banner.classList.add("hidden");
      if (btnText) btnText.textContent = "Ver Guía de Introducción 💼";
    }
  }
};

window.filterAccounts = function(tag, btn) {
  document.querySelectorAll('.account-filter-btn').forEach(b => {
    b.classList.remove('bg-brand', 'text-white', 'shadow-xs');
    b.classList.add('bg-slate-100', 'dark:bg-darkCard', 'text-slate-600', 'dark:text-slate-400');
  });
  if (btn) {
    btn.classList.add('bg-brand', 'text-white', 'shadow-xs');
    btn.classList.remove('bg-slate-100', 'dark:bg-darkCard', 'text-slate-600', 'dark:text-slate-400');
  }

  const cards = document.querySelectorAll('.account-card');
  let visibleCount = 0;

  cards.forEach(card => {
    const tags = card.getAttribute('data-tags') || '';
    if (tag === 'all' || tags.includes(tag)) {
      card.style.display = 'block';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  const countEl = document.getElementById('account-visible-count');
  if (countEl) countEl.textContent = visibleCount;
};
</script>
