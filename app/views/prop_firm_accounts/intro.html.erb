<%# app/views/prop_firm_accounts/intro.html.erb %>
<div class="w-full max-w-2xl mx-auto pt-10 relative z-10 flex flex-col items-center justify-center min-h-[500px]"
     data-controller="intro-steps">

  <!-- HEADER -->
  <div class="w-full flex items-center justify-between mb-6">
    <a href="<%= dashboard_path %>"
       class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold transition-all flex items-center gap-1.5 border border-slate-200 dark:border-slate-700/60">
      <span class="material-symbols-outlined text-[16px]">arrow_back</span> Regresar
    </a>

    <div class="flex items-center gap-2">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg border border-purple-500/30 bg-purple-500/10">
        <svg class="h-4 w-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
      </div>
      <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white">Trade<span class="text-purple-600 dark:text-purple-400">Tres</span></span>
    </div>

    <a href="<%= prop_firm_accounts_path(skip_intro: 1) %>"
       class="text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
      Saltar
    </a>
  </div>

  <!-- PROGRESO -->
  <div class="w-full mb-6 space-y-2">
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400">
      <span>Introducción</span>
      <span data-intro-steps-target="counter">1 / 4</span>
    </div>
    <div class="w-full h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
      <div data-intro-steps-target="bar"
           class="h-full w-0 rounded-full bg-gradient-to-r from-purple-500 to-fuchsia-500 shadow-[0_0_12px_rgba(168,85,247,0.5)] transition-all duration-300"></div>
    </div>
  </div>

  <!-- CARD -->
  <div class="w-full bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800/90 rounded-3xl p-6 sm:p-10 shadow-xl dark:shadow-2xl backdrop-blur-xl relative overflow-hidden min-h-[440px] flex flex-col justify-between group">

    <div class="absolute -top-32 -right-32 w-64 h-64 bg-purple-500/10 rounded-full blur-[100px] pointer-events-none group-hover:bg-purple-500/20 transition-all duration-700"></div>

    <div class="relative z-10 my-auto">

      <!-- PASO 1: BIENVENIDA -->
      <div data-intro-steps-target="step" class="flex flex-col items-center text-center space-y-5">
        <div class="w-16 h-16 rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-3xl shadow-[0_0_30px_rgba(168,85,247,0.2)]">🏦</div>
        <div class="space-y-3">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Gestor de <span class="text-purple-600 dark:text-purple-400">Cuentas Fondeadas</span>
          </h1>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
            Centraliza tus evaluaciones y cuentas fondeadas, controla tu drawdown y descubre si tu negocio de fondeo realmente es rentable.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-2 pt-1">
          <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">Topstep</span>
          <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">Apex</span>
          <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">Evaluación y Fondeada</span>
        </div>
      </div>

      <!-- PASO 2: CÓMO FUNCIONA -->
      <div data-intro-steps-target="step" class="hidden flex-col space-y-5">
        <div class="text-center space-y-1">
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">Así funciona</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Tres pasos para tener tu negocio bajo control.</p>
        </div>
        <div class="space-y-2.5">
          <% [
            ["1", "add_circle", "Añade tus cuentas", "Elige la plantilla de reglas de tu firma con el asistente."],
            ["2", "receipt_long", "Registra transacciones", "Cuotas, resets y pagos recibidos en un solo lugar."],
            ["3", "query_stats", "Mide tu ROI real", "Retorno neto, tasa de aprobación y análisis de quemas."]
          ].each do |num, icon, title, desc| %>
            <div class="flex items-center gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/50 p-3.5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-600 dark:text-purple-400">
                <span class="material-symbols-outlined text-[20px]"><%= icon %></span>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white"><%= title %></h3>
                <p class="text-xs text-slate-500 dark:text-slate-400"><%= desc %></p>
              </div>
              <span class="text-xs font-mono font-bold text-purple-500/60"><%= num %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- PASO 3: QUÉ GANAS -->
      <div data-intro-steps-target="step" class="hidden flex-col space-y-5">
        <div class="text-center space-y-1">
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">Cuida cada cuenta</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Cada firma tiene sus reglas. Aquí no se mezclan.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <% [
            ["🛡️", "Drawdown aislado", "Tus operaciones se miden contra los límites reales de cada cuenta."],
            ["🔥", "Análisis de quemas", "Entiende por qué se quemó una cuenta y evita repetirlo."],
            ["💰", "ROI en el tiempo", "Ingresos, gastos y retorno acumulado en una sola gráfica."],
            ["✅", "Tasa de aprobación", "Cuántas evaluaciones pasas frente a las que intentas."]
          ].each do |emoji, title, desc| %>
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/50 p-4 space-y-1.5 hover:border-purple-500/50 transition-colors">
              <div class="text-xl"><%= emoji %></div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white"><%= title %></h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-snug"><%= desc %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- PASO 4: CTA -->
      <div data-intro-steps-target="step" class="hidden flex-col items-center text-center space-y-6">
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 text-3xl flex items-center justify-center">✓</div>
        <div class="space-y-2">
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">¡Todo listo!</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-sm mx-auto leading-relaxed">
            Empieza añadiendo tu primera cuenta. Te toma menos de un minuto.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row w-full sm:w-auto gap-3">
          <a href="<%= new_prop_firm_account_path %>"
             class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm shadow-[0_0_25px_rgba(168,85,247,0.35)] transition-all flex items-center justify-center gap-2 group/btn">
            <span>Añadir mi primera cuenta</span>
            <span class="material-symbols-outlined text-[18px] group-hover/btn:translate-x-1 transition-transform">add_circle</span>
          </a>
          <a href="<%= prop_firm_accounts_path(skip_intro: 1) %>"
             class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-sm border border-slate-200 dark:border-slate-700 transition-all flex items-center justify-center">
            Explorar el panel
          </a>
        </div>
      </div>
    </div>

    <!-- NAVEGACIÓN -->
    <div class="relative z-10 mt-8 flex items-center justify-between">
      <button type="button" data-intro-steps-target="prev" data-action="click->intro-steps#prev"
              class="invisible flex items-center gap-1 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700/60 bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 text-xs font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span> Atrás
      </button>

      <div class="flex items-center gap-1.5">
        <% 4.times do |idx| %>
          <button type="button" data-intro-steps-target="dot" data-index="<%= idx %>"
                  data-action="click->intro-steps#goTo" aria-label="Ir al paso <%= idx + 1 %>"
                  class="h-2 rounded-full bg-purple-500 transition-all cursor-pointer <%= idx.zero? ? 'w-6' : 'w-2 opacity-40' %>"></button>
        <% end %>
      </div>

      <button type="button" data-intro-steps-target="next" data-action="click->intro-steps#next"
              class="flex items-center gap-1 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold shadow-lg shadow-purple-500/30 transition-all cursor-pointer">
        Siguiente <span class="material-symbols-outlined text-[16px]">chevron_right</span>
      </button>
    </div>
  </div>
</div>
