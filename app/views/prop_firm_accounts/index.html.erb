<% content_for :page_title, "Configuración de Cuentas Prop Firm" %>

<div class="space-y-6 fade-in pb-12">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b dark:border-darkBorder border-slate-200 pb-4">
    <div>
      <h1 class="text-xl md:text-2xl font-black dark:text-white text-slate-800 flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[26px]">verified</span>
        Mis Cuentas de Fondeo & Challenges
      </h1>
      <p class="text-xs text-slate-400 mt-1">Administra tus cuentas activas, reglas de challenge y cuotas por firma.</p>
    </div>

    <%= link_to new_prop_firm_account_path, class: "px-5 py-2.5 bg-brand hover:bg-brand-hover text-white font-bold text-xs rounded-xl shadow-md glow-brand transition-all flex items-center gap-1.5 w-max" do %>
      <span class="material-symbols-outlined text-[16px]">add</span>
      <span>+ Nueva Cuenta de Fondeo</span>
    <% end %>
  </div>

  <% if @accounts.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @accounts.each do |acc| %>
        <div class="glass rounded-2xl p-5 border-l-4 border-brand space-y-4 hover:border-brand/80 transition-all">
          
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-2.5">
              <% logo_file = case acc.firm_name.to_s.downcase
                when /topstep/ then "compañias/Topstep.png"
                when /apex/ then "compañias/Apex Trader funding.png"
                when /myfunded/ then "compañias/My funded futures.png"
                when /tradeify/ then "compañias/Tradeify.png"
                when /lucid/ then "compañias/Lucid trading.png"
                when /alpha/ then "compañias/Alpha futures.png"
                when /take profit/ then "compañias/take profit trader.png"
                else nil
                end
              %>
              <% if logo_file %>
                <div class="w-9 h-9 rounded-xl bg-white p-1 border flex items-center justify-center shadow-xs flex-shrink-0">
                  <%= image_tag logo_file, class: "max-h-full max-w-full object-contain" %>
                </div>
              <% end %>
              <div>
                <h3 class="text-sm font-black dark:text-white text-slate-900"><%= acc.name %></h3>
                <span class="text-[10px] font-mono text-slate-400 font-bold"><%= acc.firm_name %> • <%= acc.account_size %></span>
              </div>
            </div>

            <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-brand/15 text-brand border border-brand/20">
              <%= acc.phase.gsub('_', ' ').upcase %>
            </span>
          </div>

          <div class="space-y-2 text-xs border-t dark:border-darkBorder border-slate-200 pt-3">
            <div class="flex justify-between items-center text-slate-400">
              <span>Cuota Evaluación:</span>
              <span class="font-mono font-bold text-slate-200">$<%= acc.eval_fee %></span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Cuota Activación:</span>
              <span class="font-mono font-bold text-slate-200">$<%= acc.activation_fee %></span>
            </div>
          </div>

          <div class="flex items-center justify-end gap-2 pt-2 border-t dark:border-darkBorder border-slate-200">
            <%= button_to prop_firm_account_path(acc), method: :delete, data: { turbo_confirm: "¿Borrar esta cuenta?" }, class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 transition-colors" do %>
              <span class="material-symbols-outlined text-[16px]">delete</span>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="glass rounded-2xl p-12 text-center max-w-md mx-auto space-y-4">
      <div class="w-16 h-16 rounded-full bg-brand/10 text-brand flex items-center justify-center mx-auto">
        <span class="material-symbols-outlined text-[32px]">verified</span>
      </div>
      <h3 class="text-base font-bold dark:text-white text-slate-800">Sin Cuentas Registradas</h3>
      <p class="text-xs text-slate-400">Configura tu primera cuenta de fondeo con sus reglas de profit, drawdown y comisiones para auditar tus trades.</p>
      <%= link_to new_prop_firm_account_path, class: "px-6 py-2.5 bg-brand text-white font-bold text-xs rounded-xl shadow-md inline-flex items-center gap-1.5" do %>
        <span class="material-symbols-outlined text-[16px]">add</span>
        Configurar Primera Cuenta
      <% end %>
    </div>
  <% end %>

</div>
