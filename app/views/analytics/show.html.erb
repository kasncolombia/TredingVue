<% content_for :page_title, "Analytics Avanzado" %>

<div class="space-y-6 fade-in">

  <!-- ===================== TOP ANALYTICS HEADER ===================== -->
  <div class="glass rounded-2xl p-5 flex flex-col md:flex-row items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-brand text-[22px]">analytics</span>
        <h2 class="text-lg font-black dark:text-white text-slate-800">Centro de Inteligencia Cuantitativa</h2>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Análisis profundo de sesgos, rendimiento por estrategia y flujo de capital</p>
    </div>

    <!-- FILTER CHIPS -->
    <div class="flex items-center gap-2">
      <button class="px-3 py-1.5 rounded-xl bg-brand text-white font-bold text-xs glow-brand">Todo el Historial</button>
      <button class="px-3 py-1.5 rounded-xl dark:bg-darkCard bg-slate-100 dark:text-slate-300 text-slate-700 hover:text-brand font-semibold text-xs border dark:border-darkBorder border-lightBorder transition-all">Último Mes</button>
      <button class="px-3 py-1.5 rounded-xl dark:bg-darkCard bg-slate-100 dark:text-slate-300 text-slate-700 hover:text-brand font-semibold text-xs border dark:border-darkBorder border-lightBorder transition-all">Este Año</button>
    </div>
  </div>

  <!-- ===================== RADIAL GAUGES & METRICS (MOBILE SLIDER) ===================== -->
  <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 scrollbar-hide sm:grid sm:grid-cols-3 sm:gap-6 sm:overflow-visible sm:pb-0">

    <!-- ECHARTS GAUGE 1: WIN RATE -->
    <div class="glass rounded-2xl p-4 sm:p-5 flex flex-col items-center justify-between text-center min-w-[240px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <div class="w-full flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder mb-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Eficiencia de Entradas</span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-accent-green/10 text-accent-green font-bold">Win Rate</span>
      </div>
      <div id="echarts-gauge-winrate" class="w-full h-32 sm:h-44"></div>
      <p class="text-xs text-slate-400 mt-1">
        <strong class="text-accent-green"><%= @stats[:winning_trades] %> ganadores</strong> de <%= @stats[:total_trades] %> ejecuciones
      </p>
    </div>

    <!-- ECHARTS GAUGE 2: DISCIPLINE SCORE -->
    <div class="glass rounded-2xl p-4 sm:p-5 flex flex-col items-center justify-between text-center min-w-[240px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <div class="w-full flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder mb-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Score de Disciplina AI</span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-brand/10 text-brand font-bold">AI Coach</span>
      </div>
      <div id="echarts-gauge-discipline" class="w-full h-32 sm:h-44"></div>
      <p class="text-xs text-slate-400 mt-1">
        Cumplimiento estricto del plan de trading
      </p>
    </div>

    <!-- ECHARTS GAUGE 3: PROFIT FACTOR -->
    <div class="glass rounded-2xl p-4 sm:p-5 flex flex-col items-center justify-between text-center min-w-[240px] sm:min-w-0 snap-start flex-shrink-0 sm:flex-shrink">
      <div class="w-full flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder mb-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Factor de Beneficio</span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-bold">P.F. <%= @stats[:profit_factor] %></span>
      </div>
      <div id="echarts-gauge-pf" class="w-full h-32 sm:h-44"></div>
      <p class="text-xs text-slate-400 mt-1">
        Ratio Beneficios Brutos vs Pérdidas Brutas
      </p>
    </div>

  </div>

  <!-- ===================== RADAR CHART + SANKEY FLUX ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- RADAR CHART (ECHARTS) -->
    <div class="glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <div>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Evaluación Hexagonal de Trader</h3>
          <p class="text-[11px] text-slate-400">6 dimensiones críticas evaluadas por AI Coach</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-brand/10 text-brand font-bold">Perfil Actual</span>
      </div>
      <div id="echarts-radar-container" class="w-full h-52 sm:h-72"></div>
    </div>

    <!-- SANKEY / FLOW DIAGRAM (ECHARTS) -->
    <div class="glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <div>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Flujo de Capital Saney Diagram</h3>
          <p class="text-[11px] text-slate-400">Bruto -> Comisiones -> Pérdidas -> P&L Neto</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-lg bg-accent-green/10 text-accent-green font-bold">Desglose Financiero</span>
      </div>
      <div id="echarts-sankey-container" class="w-full h-52 sm:h-72"></div>
    </div>

  </div>

  <!-- ===================== BAR CHART BY SYMBOL & STRATEGY PIE ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- P&L BY ASSET / SYMBOL (2 COLS) -->
    <div class="lg:col-span-2 glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <h3 class="text-sm font-bold dark:text-white text-slate-800">Rendimiento por Activo / Símbolo</h3>
        <span class="text-[11px] text-slate-400">P&L Neto acumulado por ticker</span>
      </div>
      <div id="echarts-bar-symbol-container" class="w-full h-44 sm:h-64"></div>
    </div>

    <!-- P&L BY STRATEGY DONUT (1 COL) -->
    <div class="glass rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b dark:border-darkBorder border-lightBorder">
        <h3 class="text-sm font-bold dark:text-white text-slate-800">Ganancia por Estrategia</h3>
      </div>
      <div id="echarts-pie-strategy-container" class="w-full h-44 sm:h-64"></div>
    </div>

  </div>

</div>

<!-- ===================== ECHARTS ANALYTICS SCRIPTS ===================== -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const isDark = document.getElementById("html-root").classList.contains("dark");
  const textColor = isDark ? "#9DA3B4" : "#64748B";
  const borderColor = isDark ? "#23263A" : "#E3E6EF";
  const bgCard = isDark ? "#151724" : "#FFFFFF";

  // 1. GAUGE WIN RATE
  const gWin = echarts.init(document.getElementById("echarts-gauge-winrate"));
  const winRateVal = <%= @stats[:win_rate] || 68 %>;
  gWin.setOption({
    series: [{
      type: 'gauge',
      startAngle: 180,
      endAngle: 0,
      min: 0,
      max: 100,
      pointer: { show: false },
      progress: { show: true, overlap: false, roundCap: true, itemStyle: { color: '#10B981' } },
      axisLine: { lineStyle: { width: 12, color: [[1, borderColor]] } },
      axisTick: { show: false },
      splitLine: { show: false },
      axisLabel: { show: false },
      detail: {
        valueAnimation: true,
        formatter: '{value}%',
        color: isDark ? '#FFFFFF' : '#0F0E1A',
        fontFamily: 'Manrope',
        fontWeight: 'bold',
        fontSize: 24,
        offsetCenter: [0, '-10%']
      },
      data: [{ value: winRateVal }]
    }]
  });

  // 2. GAUGE DISCIPLINE
  const gDisc = echarts.init(document.getElementById("echarts-gauge-discipline"));
  gDisc.setOption({
    series: [{
      type: 'gauge',
      startAngle: 180,
      endAngle: 0,
      min: 0,
      max: 10,
      pointer: { show: false },
      progress: { show: true, overlap: false, roundCap: true, itemStyle: { color: '#009DFA' } },
      axisLine: { lineStyle: { width: 12, color: [[1, borderColor]] } },
      axisTick: { show: false },
      splitLine: { show: false },
      axisLabel: { show: false },
      detail: {
        valueAnimation: true,
        formatter: '{value}/10',
        color: isDark ? '#FFFFFF' : '#0F0E1A',
        fontFamily: 'Manrope',
        fontWeight: 'bold',
        fontSize: 24,
        offsetCenter: [0, '-10%']
      },
      data: [{ value: 8.5 }]
    }]
  });

  // 3. GAUGE PROFIT FACTOR
  const gPF = echarts.init(document.getElementById("echarts-gauge-pf"));
  const pfVal = <%= @stats[:profit_factor] || 2.41 %>;
  gPF.setOption({
    series: [{
      type: 'gauge',
      startAngle: 180,
      endAngle: 0,
      min: 0,
      max: 5,
      pointer: { show: false },
      progress: { show: true, overlap: false, roundCap: true, itemStyle: { color: '#05BFFB' } },
      axisLine: { lineStyle: { width: 12, color: [[1, borderColor]] } },
      axisTick: { show: false },
      splitLine: { show: false },
      axisLabel: { show: false },
      detail: {
        valueAnimation: true,
        formatter: '{value}',
        color: isDark ? '#FFFFFF' : '#0F0E1A',
        fontFamily: 'Manrope',
        fontWeight: 'bold',
        fontSize: 24,
        offsetCenter: [0, '-10%']
      },
      data: [{ value: pfVal }]
    }]
  });

  // 4. RADAR CHART (EVALUACIÓN HEXAGONAL)
  const radarChart = echarts.init(document.getElementById("echarts-radar-container"));
  radarChart.setOption({
    tooltip: { backgroundColor: bgCard, borderColor: borderColor, textStyle: { color: isDark ? '#FFF' : '#000', fontFamily: 'Manrope' } },
    radar: {
      indicator: [
        { name: 'Disciplina (Paciencia)', max: 100 },
        { name: 'Gestión de Riesgo', max: 100 },
        { name: 'Timing de Entrada', max: 100 },
        { name: 'Gestión Emocional', max: 100 },
        { name: 'Consistencia R:R', max: 100 },
        { name: 'Ejecución del Plan', max: 100 }
      ],
      axisName: { color: textColor, fontFamily: 'Manrope', fontSize: 11 },
      splitArea: { areaStyle: { color: [isDark ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)', isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)'] } },
      axisLine: { lineStyle: { color: borderColor } },
      splitLine: { lineStyle: { color: borderColor } }
    },
    series: [{
      name: 'Métricas Psicológicas',
      type: 'radar',
      data: [{
        value: [88, 92, 75, 82, 85, 90],
        name: 'Perfil Trader',
        symbolSize: 6,
        itemStyle: { color: '#009DFA' },
        areaStyle: { color: 'rgba(0, 157, 250, 0.35)' }
      }]
    }]
  });

  // 5. SANKEY DIAGRAM (FLUJO DE CAPITAL)
  const sankeyChart = echarts.init(document.getElementById("echarts-sankey-container"));
  sankeyChart.setOption({
    tooltip: { trigger: 'item', backgroundColor: bgCard, borderColor: borderColor, textStyle: { color: isDark ? '#FFF' : '#000' } },
    series: {
      type: 'sankey',
      layout: 'none',
      emphasis: { focus: 'adjacency' },
      label: { color: textColor, fontFamily: 'Manrope', fontSize: 11 },
      lineStyle: { color: 'gradient', curveness: 0.5 },
      data: [
        { name: 'Ganancias Brutas' },
        { name: 'Comisiones Broker' },
        { name: 'Pérdidas Brutas' },
        { name: 'Beneficio Neto ($12.4K)' }
      ],
      links: [
        { source: 'Ganancias Brutas', target: 'Beneficio Neto ($12.4K)', value: 18500 },
        { source: 'Ganancias Brutas', target: 'Comisiones Broker', value: 850 },
        { source: 'Ganancias Brutas', target: 'Pérdidas Brutas', value: 5200 }
      ]
    }
  });

  // 6. BAR CHART BY SYMBOL
  const barSymbol = echarts.init(document.getElementById("echarts-bar-symbol-container"));
  barSymbol.setOption({
    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, backgroundColor: bgCard, borderColor: borderColor, textStyle: { color: isDark ? '#FFF' : '#000' } },
    grid: { left: '3%', right: '3%', bottom: '3%', top: '8%', containLabel: true },
    xAxis: {
      type: 'category',
      data: ['NQ1!', 'EUR/USD', 'BTC/USD', 'AAPL', 'TSLA', 'XAU/USD'],
      axisLine: { lineStyle: { color: borderColor } },
      axisLabel: { color: textColor, fontFamily: 'Manrope' }
    },
    yAxis: {
      type: 'value',
      splitLine: { lineStyle: { color: borderColor, type: 'dashed' } },
      axisLabel: { color: textColor, fontFamily: 'Manrope', formatter: '${value}' }
    },
    series: [{
      type: 'bar',
      barWidth: '35%',
      itemStyle: {
        borderRadius: [6, 6, 0, 0],
        color: function(params) { return params.value >= 0 ? '#10B981' : '#F43F5E'; }
      },
      data: [6400, -850, 4200, 1850, -320, 1170]
    }]
  });

  // 7. PIE CHART BY STRATEGY
  const pieStrat = echarts.init(document.getElementById("echarts-pie-strategy-container"));
  pieStrat.setOption({
    tooltip: { trigger: 'item', backgroundColor: bgCard, borderColor: borderColor, textStyle: { color: isDark ? '#FFF' : '#000' } },
    series: [{
      type: 'pie',
      radius: '70%',
      center: ['50%', '50%'],
      label: { color: textColor, fontFamily: 'Manrope', fontSize: 10 },
      data: [
        { value: 5400, name: 'Breakout NV', itemStyle: { color: '#009DFA' } },
        { value: 3800, name: 'Pullback VWAP', itemStyle: { color: '#10B981' } },
        { value: 2100, name: 'Reversión SM', itemStyle: { color: '#34D399' } },
        { value: 1150, name: 'Scalping 1M', itemStyle: { color: '#F59E0B' } }
      ]
    }]
  });

  // RESIZE ALL CHARTS ON WINDOW RESIZE
  window.addEventListener('resize', () => {
    [gWin, gDisc, gPF, radarChart, sankeyChart, barSymbol, pieStrat].forEach(c => c.resize());
  });
});
</script>
