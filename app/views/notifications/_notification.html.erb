<div id="<%= dom_id(notification) %>" class="p-3 border-b dark:border-darkBorder border-lightBorder hover:bg-slate-100 dark:hover:bg-darkHover transition-all fade-in <%= 'bg-brand/5 dark:bg-brand/10' unless notification.read? %>">
  <div class="flex items-start gap-3">
    <% case notification.category %>
    <% when 'warning', 'danger' %>
      <div class="w-8 h-8 rounded-full bg-loss/10 text-loss flex items-center justify-center flex-shrink-0 mt-0.5 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">warning</span>
      </div>
    <% else %>
      <div class="w-8 h-8 rounded-full bg-brand/10 text-brand flex items-center justify-center flex-shrink-0 mt-0.5 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">notifications</span>
      </div>
    <% end %>
    <div class="flex-1">
      <p class="text-[13px] font-extrabold dark:text-white text-slate-900 leading-tight"><%= notification.title %></p>
      <p class="text-[11px] dark:text-slate-300 text-slate-600 mt-1 leading-snug"><%= notification.message %></p>
      <p class="text-[9px] text-slate-400 mt-1.5 uppercase tracking-widest font-bold"><%= time_ago_in_words(notification.created_at) %> atrás</p>
    </div>
  </div>
</div>
