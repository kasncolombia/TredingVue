<% content_for :page_title, "Perfil de Trader Pro" %>

<div class="max-w-6xl mx-auto space-y-6 fade-in">

  <!-- ===================== HERO PROFILE BANNER ===================== -->
  <div class="glass rounded-3xl p-6 sm:p-8 relative overflow-hidden border dark:border-darkBorder border-lightBorder shadow-xl">
    <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-accent-green/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
        <!-- AVATAR LARGE -->
        <div class="relative group">
          <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-brand via-violet-600 to-accent-teal flex items-center justify-center font-black text-white text-3xl shadow-2xl glow-brand">
            <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
          </div>
          <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-accent-green border-4 dark:border-darkCard border-white flex items-center justify-center text-white" title="Cuenta Activa & Verificada">
            <span class="material-symbols-outlined text-[12px] font-bold">check</span>
          </span>
        </div>

        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <h2 class="text-2xl font-black dark:text-white text-slate-900 tracking-tight"><%= current_user.name.presence || "Trader Profesional" %></h2>
            <span class="px-3 py-0.5 rounded-full text-[11px] font-extrabold bg-brand/15 text-brand border border-brand/25">Funded Trader</span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-accent-green/15 text-accent-green border border-accent-green/20">Verificado</span>
          </div>

          <p class="text-xs text-slate-400 font-mono"><%= current_user.email %></p>

          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-slate-400 pt-1">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px] text-brand">calendar_today</span>
              <span>Miembro desde <strong><%= current_user.created_at.strftime("%b %Y") %></strong></span>
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px] text-accent-green">account_balance_wallet</span>
              <span>Capital Base: <strong>$<%= number_with_precision(current_user.initial_capital || 10000, precision: 0, delimiter: ',') %> <%= current_user.preferred_currency || "USD" %></strong></span>
            </span>
          </div>
        </div>
      </div>

      <!-- ACCIONES CERRAR SESION & CONFIGURACION -->
      <div class="flex items-center gap-3 w-full sm:w-auto justify-center">
        <a href="#config-section" class="px-4 py-2.5 rounded-xl dark:bg-darkInput bg-slate-100 dark:text-slate-200 text-slate-700 hover:text-brand border dark:border-darkBorder border-lightBorder text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
          <span class="material-symbols-outlined text-[16px]">settings</span>
          <span>Ajustes</span>
        </a>

        <%= button_to destroy_user_session_path, method: :delete, class: "px-4 py-2.5 rounded-xl bg-loss/10 hover:bg-loss/20 text-loss border border-loss/20 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
          <span class="material-symbols-outlined text-[16px]">logout</span>
          <span>Cerrar Sesión</span>
        <% end %>
      </div>

    </div>
  </div>

  <!-- ===================== STATS PERFORMANCE SUMMARY ===================== -->
  <%
    trades = current_user.trades
    total_trades = trades.count
    total_pnl    = trades.sum(&:pnl)
    wins         = trades.select { |t| t.pnl > 0 }
    losses       = trades.select { |t| t.pnl < 0 }
    win_rate     = total_trades > 0 ? (wins.count.to_f / total_trades * 100).round(1) : 0
    best_trade   = wins.map(&:pnl).max || 0
    worst_trade  = losses.map(&:pnl).min || 0
    gross_profit = wins.sum(&:pnl)
    gross_loss   = losses.sum(&:pnl).abs
    pf           = gross_loss > 0 ? (gross_profit / gross_loss).round(2) : gross_profit.round(2)
  %>

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Trades</span>
      <p class="text-xl font-black dark:text-white text-slate-900 font-mono mt-1"><%= total_trades %></p>
    </div>

    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Win Rate</span>
      <p class="text-xl font-black text-brand font-mono mt-1"><%= win_rate %>%</p>
    </div>

    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Profit Factor</span>
      <p class="text-xl font-black text-violet-400 font-mono mt-1"><%= pf %></p>
    </div>

    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">P&L Neto</span>
      <p class="text-xl font-black font-mono mt-1 <%= total_pnl >= 0 ? 'text-accent-green' : 'text-loss' %>">
        <%= total_pnl >= 0 ? '+' : '' %>$<%= number_with_precision(total_pnl, precision: 2, delimiter: ',') %>
      </p>
    </div>

    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Mejor Trade</span>
      <p class="text-xl font-black text-accent-green font-mono mt-1">+$<%= number_with_precision(best_trade, precision: 2) %></p>
    </div>

    <div class="stat-card rounded-2xl p-4 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Peor Trade</span>
      <p class="text-xl font-black text-loss font-mono mt-1">$<%= number_with_precision(worst_trade, precision: 2) %></p>
    </div>
  </div>

  <!-- ===================== TABBED SECTIONS & FORMS ===================== -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- CONFIGURACIÓN DE CUENTA (2 COLS) -->
    <div id="config-section" class="lg:col-span-2 glass rounded-3xl p-6 space-y-6">
      <div class="flex items-center gap-2 pb-3 border-b dark:border-darkBorder border-lightBorder">
        <span class="material-symbols-outlined text-brand text-[22px]">manage_accounts</span>
        <h3 class="text-base font-bold dark:text-white text-slate-800">Parámetros de la Cuenta & Perfil</h3>
      </div>

      <%= form_for(current_user, url: registration_path(:user), html: { method: :put, class: "space-y-4" }) do |f| %>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div>
            <label class="block font-bold dark:text-slate-300 text-slate-700 mb-1">Nombre Completo</label>
            <%= f.text_field :name, class: "input-field w-full px-4 py-2.5 rounded-xl focus:outline-none" %>
          </div>

          <div>
            <label class="block font-bold dark:text-slate-300 text-slate-700 mb-1">Correo Electrónico</label>
            <%= f.email_field :email, class: "input-field w-full px-4 py-2.5 rounded-xl focus:outline-none" %>
          </div>

          <div>
            <label class="block font-bold dark:text-slate-300 text-slate-700 mb-1">Moneda Base de Reportes</label>
            <%= f.select :preferred_currency, [["USD - Dólar ($)", "USD"], ["EUR - Euro (€)", "EUR"], ["GBP - Libra (£)", "GBP"], ["MXN - Peso MX ($)", "MXN"]], {}, class: "input-field w-full px-4 py-2.5 rounded-xl focus:outline-none" %>
          </div>

          <div>
            <label class="block font-bold dark:text-slate-300 text-slate-700 mb-1">Capital Inicial de Cuenta</label>
            <%= f.number_field :initial_capital, step: "100", class: "input-field w-full px-4 py-2.5 rounded-xl focus:outline-none" %>
          </div>

          <div>
            <label class="block font-bold dark:text-slate-300 text-slate-700 mb-1">Zona Horaria</label>
            <%= f.time_zone_select :timezone, nil, { default: "UTC" }, class: "input-field w-full px-4 py-2.5 rounded-xl focus:outline-none" %>
          </div>
        </div>

        <div class="pt-3 border-t dark:border-darkBorder border-lightBorder flex items-center justify-between">
          <p class="text-[11px] text-slate-400">Los cambios afectarán tus cálculos de porcentaje de rendimiento.</p>
          <%= f.button type: :submit, class: "px-5 py-2.5 bg-brand hover:bg-brand-hover text-white text-xs font-bold rounded-xl glow-brand transition-all cursor-pointer flex items-center gap-1.5" do %>
            <span class="material-symbols-outlined text-[16px]">save</span>
            <span>Guardar Cambios</span>
          <% end %>
        </div>

      <% end %>
    </div>

    <!-- ESTRATEGIA CON MAYOR WIN RATE & ACCIONES RÁPIDAS (1 COL) -->
    <div class="space-y-6">

      <!-- TOP STRATEGY -->
      <div class="glass rounded-3xl p-6 space-y-4">
        <div class="flex items-center gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="material-symbols-outlined text-brand text-[20px]">emoji_events</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Estrategias Destacadas</h3>
        </div>

        <div class="space-y-3 text-xs">
          <% current_user.strategies.each do |st| %>
            <%
              st_t = st.trades
              st_win = st_t.select { |t| t.pnl > 0 }.size
              st_wr = st_t.count > 0 ? (st_win.to_f / st_t.count * 100).round(1) : 0
            %>
            <div class="p-3 rounded-2xl dark:bg-darkInput bg-slate-50 flex items-center justify-between border dark:border-darkBorder border-lightBorder">
              <div>
                <p class="font-bold dark:text-white text-slate-900"><%= st.name %></p>
                <p class="text-[10px] text-slate-400"><%= st_t.count %> ejecuciones</p>
              </div>
              <div class="text-right">
                <span class="font-bold font-mono text-brand"><%= st_wr %>% WR</span>
              </div>
            </div>
          <% end %>

          <% if current_user.strategies.empty? %>
            <p class="text-xs text-slate-400 italic">No tienes estrategias asignadas.</p>
          <% end %>
        </div>
      </div>

      <!-- EXPORT DATA & SECURITY -->
      <div class="glass rounded-3xl p-6 space-y-4">
        <div class="flex items-center gap-2 pb-2 border-b dark:border-darkBorder border-lightBorder">
          <span class="material-symbols-outlined text-brand text-[20px]">shield</span>
          <h3 class="text-sm font-bold dark:text-white text-slate-800">Seguridad & Datos</h3>
        </div>

        <div class="space-y-3 text-xs">
          <%= link_to import_trades_path, class: "w-full py-2.5 px-4 rounded-xl dark:bg-darkInput bg-slate-100 hover:bg-brand/10 dark:text-slate-200 text-slate-700 hover:text-brand border dark:border-darkBorder border-lightBorder font-bold transition-all flex items-center justify-between" do %>
            <span class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[16px] text-brand">download</span>
              <span>Importar Historial CSV</span>
            </span>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
          <% end %>

          <div class="p-3 rounded-2xl bg-accent-green/10 border border-accent-green/20 text-accent-green flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">verified_user</span>
            <span>Cuenta protegida con cifrado bancario</span>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>