<% content_for :page_title, "Sesión de Backtesting | #{@session.name}" %>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-8 fade-in">
  <!-- HEADER -->
  <div class="flex items-center gap-4">
    <%= link_to backtesting_root_path, class: "p-2.5 rounded-2xl glass border border-slate-200 dark:border-darkBorder text-slate-500 hover:text-brand transition-colors" do %>
      <span class="material-symbols-outlined text-[20px]">arrow_back</span>
    <% end %>
    
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand/10 text-brand text-xs font-bold uppercase tracking-wider mb-1">
        <span class="material-symbols-outlined text-[14px]">history</span> Resumen de Sesión
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white"><%= @session.name %></h1>
    </div>
  </div>

  <div class="glass border border-slate-200 dark:border-darkBorder rounded-3xl p-6 md:p-8 shadow-xl bg-white/70 dark:bg-slate-900/80 text-center">
    <% coverage = HistoricalDataCoverage.find_by(symbol: @session.symbol, from_date: @session.start_date, to_date: @session.end_date) %>
    
    <% if coverage.nil? || coverage.status == "pending" %>
      <div class="py-10 flex flex-col items-center">
        <span class="material-symbols-outlined animate-spin text-4xl text-slate-400 mb-4">sync</span>
        <h2 class="text-xl font-black text-slate-800 dark:text-gray-100 mb-2">Preparando Entorno</h2>
        <p class="text-slate-500">Estamos encolando la descarga de <%= @session.symbol %>. Refresca en un momento.</p>
      </div>

    <% elsif coverage.status == "importing" %>
      <div class="py-10 flex flex-col items-center">
        <span class="material-symbols-outlined animate-spin text-4xl text-brand mb-4">downloading</span>
        <h2 class="text-xl font-black text-slate-800 dark:text-gray-100 mb-2">Descargando Velitas</h2>
        <p class="text-slate-500">Estamos obteniendo el historial mercado para <%= @session.symbol %> de <%= @session.start_date %> a <%= @session.end_date %>.<br>Puede demorar un minuto si hay limitación de peticiones.</p>
      </div>

    <% elsif coverage.status == "failed" %>
      <div class="py-10 flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mb-4 border border-rose-500/20">
          <span class="material-symbols-outlined text-3xl">error</span>
        </div>
        <h2 class="text-xl font-black text-rose-600 mb-2">Fallo en Importación</h2>
        <p class="text-slate-500 max-w-md mx-auto mb-4"><%= coverage.error_message %></p>
        <%= link_to "Atrás", backtesting_root_path, class: "px-6 py-2 rounded-2xl border border-slate-200 dark:border-darkBorder text-slate-500 font-bold" %>
      </div>

    <% elsif coverage.status == "completed" %>
      <div class="py-8 flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-4 border border-emerald-500/20">
          <span class="material-symbols-outlined text-3xl">check_circle</span>
        </div>
        <h2 class="text-xl font-black text-slate-800 dark:text-gray-100 mb-2">¡Datos Listos!</h2>
        <p class="text-slate-500 mb-8 w-full max-w-sm mx-auto">Se ha importado y procesado exitosamente el histórico de <%= @session.symbol %>.</p>
        
        <%= link_to replay_backtesting_session_path(@session), class: "w-full max-w-xs bg-brand text-white px-6 py-3 rounded-2xl font-extrabold text-sm shadow-xl shadow-brand/20 hover:-translate-y-0.5 glow-brand transition-all flex items-center justify-center gap-2" do %>
          <span class="material-symbols-outlined">play_circle</span>
          <span>Abrir Replay</span>
        <% end %>
      </div>
    <% end %>

    <% if coverage && (coverage.status == "pending" || coverage.status == "importing") %>
      <script>
        setTimeout(() => {
          window.location.reload();
        }, 3000);
      </script>
    <% end %>
  </div>
</div>
