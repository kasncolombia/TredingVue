<!-- app/views/backtesting/sessions/replay.html.erb -->
<div class="h-screen flex flex-col md:flex-row bg-[#FAFAFA] dark:bg-darkBg text-slate-800 dark:text-gray-100 overflow-hidden" 
     style="font-family: 'Inter', sans-serif;"
     data-controller="backtest-replayer"
     data-backtest-replayer-session-id-value="<%= @session.id %>"
     data-backtest-replayer-initial-state-value="<%= @session.state %>"
     data-backtest-replayer-speed-value="<%= @session.speed %>">

  <!-- ===============================
       MAIN PANEL: CHART & REPLAY CONTROLS
       =============================== -->
  <div class="flex-1 flex flex-col h-full bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-darkBorder relative">
    
    <!-- TOP NAVBAR & REPLAYER CONTROLS -->
    <div class="h-14 flex items-center justify-between px-4 border-b border-slate-200 dark:border-darkBorder bg-slate-50 dark:bg-slate-800/50">
      <div class="flex items-center gap-3">
        <%= link_to backtesting_root_path, class: "text-slate-400 hover:text-brand transition-colors" do %>
          <span class="material-symbols-outlined text-lg">arrow_back</span>
        <% end %>
        
        <h1 class="text-sm font-bold truncate max-w-[150px]"><%= @session.name.presence || "Simulación" %></h1>
      </div>

      <!-- REPLAYER CONTROLS -->
      <div class="flex items-center gap-2">
        <button data-action="click->backtest-replayer#stepBack" class="p-1.5 rounded-lg text-slate-500 hover:text-white hover:bg-slate-700 transition" title="Step Back">
          <span class="material-symbols-outlined text-[18px]">skip_previous</span>
        </button>
        
        <button data-backtest-replayer-target="playBtn" data-action="click->backtest-replayer#togglePlay" class="p-1.5 rounded-lg text-brand hover:bg-brand/10 transition shadow-sm border border-brand/20 bg-brand/5" title="Play">
          <span class="material-symbols-outlined text-[18px]">play_arrow</span>
        </button>
        
        <button data-backtest-replayer-target="pauseBtn" data-action="click->backtest-replayer#togglePlay" class="hidden p-1.5 rounded-lg text-amber-500 hover:bg-amber-500/10 transition shadow-sm border border-amber-500/20 bg-amber-500/5" title="Pause">
          <span class="material-symbols-outlined text-[18px]">pause</span>
        </button>
        
        <button data-action="click->backtest-replayer#stepForward" class="p-1.5 rounded-lg text-slate-500 hover:text-white hover:bg-slate-700 transition" title="Step Forward">
          <span class="material-symbols-outlined text-[18px]">skip_next</span>
        </button>
        
        <div class="h-5 w-px bg-slate-300 dark:bg-darkBorder mx-1"></div>
        
        <select data-backtest-replayer-target="timeframeSelect" data-action="change->backtest-replayer#changeTimeframe" class="bg-transparent text-xs font-bold ring-0 focus:ring-0 border-none outline-none cursor-pointer">
          <option value="M1" <%= 'selected' if @session.timeframe == 'M1' %>>1m</option>
          <option value="M5" <%= 'selected' if @session.timeframe == 'M5' %>>5m</option>
          <option value="M15" <%= 'selected' if @session.timeframe == 'M15' %>>15m</option>
          <option value="H1" <%= 'selected' if @session.timeframe == 'H1' %>>1h</option>
        </select>
        
        <select data-backtest-replayer-target="speedSelect" data-action="change->backtest-replayer#changeSpeed" class="bg-transparent text-xs font-bold text-brand ring-0 focus:ring-0 border-none outline-none cursor-pointer">
          <option value="1">1x Speed</option>
          <option value="5">5x Speed</option>
          <option value="20">20x Speed</option>
        </select>
      </div>
    </div>

    <!-- OHLC HEADER LAYER (Superimposed over chart) -->
    <div class="absolute top-[56px] left-0 right-0 z-10 px-4 py-3 pointer-events-none flex flex-col gap-1.5">
       <div class="flex items-center gap-3">
         <span class="flex items-center gap-1 text-xs font-black text-slate-800 dark:text-gray-200">
           <% if @session.state == 'playing' %>
             <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
           <% else %>
             <span class="w-2 h-2 rounded-full bg-amber-500"></span>
           <% end %>
           <span data-backtest-replayer-target="headerSymbol"><%= @session.symbol %></span> 
           <span class="text-slate-400">·</span> 
           <span data-backtest-replayer-target="headerTimeframe"><%= @session.timeframe || 'M1' %></span>
         </span>
         <span data-backtest-replayer-target="headerTime" class="text-xs font-mono font-medium text-slate-500">Cargando...</span>
       </div>
       <div class="flex items-center gap-4 text-[11px] font-mono whitespace-nowrap overflow-hidden text-ellipsis">
         <span class="text-slate-500">O <span data-backtest-replayer-target="legendO" class="text-slate-300 ml-1 font-semibold">—</span></span>
         <span class="text-slate-500">H <span data-backtest-replayer-target="legendH" class="text-slate-300 ml-1 font-semibold">—</span></span>
         <span class="text-slate-500">L <span data-backtest-replayer-target="legendL" class="text-slate-300 ml-1 font-semibold">—</span></span>
         <span class="text-slate-500">C <span data-backtest-replayer-target="legendC" class="text-slate-300 ml-1 font-bold">—</span></span>
         <span class="text-slate-500">Vol <span data-backtest-replayer-target="legendV" class="text-slate-400 ml-1 font-semibold">—</span></span>
       </div>
    </div>

    <!-- CHART AREA (Lightweight Charts) -->
    <div class="flex-1 w-full relative z-0 mt-14 p-4 md:p-6 bg-[#FAFAFA] dark:bg-[#0B0F19]">
      <div class="w-full h-full glass border border-slate-200 dark:border-slate-800/80 rounded-3xl shadow-xl bg-white/70 dark:bg-[#111827]/70 relative overflow-hidden flex flex-col">
        <div data-backtest-replayer-target="chartContainer" class="flex-1 w-full h-full relative z-0">
          <!-- Loading overlay -->
          <div data-backtest-replayer-target="loadingOverlay" class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm rounded-3xl">
             <span class="material-symbols-outlined animate-spin text-brand text-4xl mb-3">sync</span>
             <p class="text-sm font-bold text-slate-500 animate-pulse">Cargando datos históricos...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===============================
       RIGHT SIDEBAR: TRADE & STATS
       =============================== -->
  <div class="w-full md:w-80 h-full flex flex-col bg-white dark:bg-slate-900/95 overflow-y-auto z-10">
    
    <!-- Balance & PNL -->
    <div class="p-5 border-b border-slate-200 dark:border-darkBorder space-y-4 shadow-sm">
      <div class="flex justify-between items-end">
        <div>
          <p class="text-xs text-slate-500 font-semibold mb-1">Balance Actual</p>
          <h2 class="text-2xl font-black font-mono text-slate-800 dark:text-white">
            <%= number_to_currency(@session.balance_actual, precision: 2) %>
          </h2>
        </div>
        <div class="text-right">
          <p class="text-xs text-slate-500 font-semibold mb-1">Unrealized P&L</p>
          <p class="text-sm font-bold font-mono text-slate-500">
            $0.00
          </p>
        </div>
      </div>
    </div>

    <!-- ORDER EXECUTION FORM -->
    <div class="p-5 border-b border-slate-200 dark:border-darkBorder space-y-4">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Ejecutar Orden</h3>
      
      <div class="grid grid-cols-2 gap-3">
        <button data-action="click->backtest-replayer#handleBuy" class="glass border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-500 font-bold py-3 rounded-xl transition-all flex flex-col items-center justify-center cursor-pointer">
          <span class="material-symbols-outlined mb-1">trending_up</span>
          BUY
        </button>
        <button data-action="click->backtest-replayer#handleSell" class="glass border border-rose-500/30 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 font-bold py-3 rounded-xl transition-all flex flex-col items-center justify-center cursor-pointer">
          <span class="material-symbols-outlined mb-1">trending_down</span>
          SELL
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-2">
        <div>
          <label class="text-[10px] text-slate-500 font-bold uppercase block mb-1">Qtty / Lotes</label>
          <input type="number" value="1" class="w-full bg-slate-50 dark:bg-darkBorder/50 border border-slate-200 dark:border-darkBorder rounded-lg px-2 py-1.5 text-sm font-mono text-center focus:ring-1 focus:ring-brand font-bold text-slate-700 dark:text-white">
        </div>
        <div>
          <label class="text-[10px] text-slate-500 font-bold uppercase block mb-1">SL (Ticks)</label>
          <input type="number" value="20" class="w-full bg-slate-50 dark:bg-darkBorder/50 border border-slate-200 dark:border-darkBorder rounded-lg px-2 py-1.5 text-sm font-mono text-center focus:ring-1 focus:ring-brand font-bold text-slate-700 dark:text-white">
        </div>
      </div>
    </div>

    <!-- POSITIONS AND JOURNAL -->
    <div class="flex-1 p-5 flex flex-col">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Posición Activa</h3>
      
      <!-- Empty State -->
      <div class="flex-1 flex flex-col items-center justify-center text-center opacity-50 space-y-2">
        <span class="material-symbols-outlined text-4xl">inventory_2</span>
        <p class="text-xs font-medium">No hay compras ni ventas activas.<br>Dale PLAY al motor y ejecuta una orden.</p>
      </div>
    </div>
    
  </div>
</div>
