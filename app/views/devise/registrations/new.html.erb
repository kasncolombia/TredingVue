<%# app/views/devise/registrations/new.html.erb %>
<div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden">

  <!-- BG GRADIENT ORBS -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-violet-600/20 dark:bg-violet-600/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-600/20 dark:bg-indigo-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="w-full max-w-md relative fade-in">

    <!-- LOGO + TITULO -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 shadow-2xl shadow-indigo-500/40 mb-4">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
      </div>
      <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">Crea tu cuenta</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Empieza a mejorar tu trading hoy — gratis</p>
    </div>

    <!-- CARD -->
    <div class="glass rounded-2xl p-8 shadow-2xl shadow-indigo-500/10">

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>

        <!-- NOMBRE -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Nombre completo</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <%= f.text_field :name, autofocus: true,
                placeholder: "Tu nombre",
                class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
        </div>

        <!-- EMAIL -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Correo electrónico</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <%= f.email_field :email, autocomplete: "email",
                placeholder: "trader@ejemplo.com",
                class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
        </div>

        <!-- PASSWORD -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Contraseña</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <%= f.password_field :password, autocomplete: "new-password",
                placeholder: "Mínimo 8 caracteres",
                class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
          <% if @minimum_password_length %>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Mínimo <%= @minimum_password_length %> caracteres</p>
          <% end %>
        </div>

        <!-- PASSWORD CONFIRM -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Confirmar contraseña</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                placeholder: "Repite tu contraseña",
                class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
          </div>
        </div>

        <!-- TERMS -->
        <div class="flex items-start gap-2">
          <input type="checkbox" id="terms" required class="mt-0.5 w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 flex-shrink-0">
          <label for="terms" class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed cursor-pointer">
            Acepto los <a href="#" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Términos de Servicio</a> y la <a href="#" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Política de Privacidad</a>
          </label>
        </div>

        <!-- SUBMIT -->
        <%= f.submit "Crear cuenta gratuita",
            class: "w-full py-3 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/30 transition-all duration-200 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99]" %>

      <% end %>

      <!-- DIVIDER -->
      <div class="flex items-center gap-3 my-5">
        <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        <span class="text-xs text-slate-400">o</span>
        <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
      </div>

      <!-- LOGIN LINK -->
      <p class="text-center text-xs text-slate-500 dark:text-slate-400">
        ¿Ya tienes cuenta?
        <%= link_to "Iniciar sesión", new_session_path(resource_name),
            class: "text-indigo-600 dark:text-indigo-400 font-bold hover:underline" %>
      </p>
    </div>

    <!-- SOCIAL PROOF -->
    <div class="mt-6 glass rounded-xl px-5 py-3 flex items-center justify-between">
      <div class="flex -space-x-2">
        <% ["from-indigo-600 to-blue-500","from-violet-600 to-indigo-400","from-emerald-500 to-teal-400","from-amber-500 to-orange-400"].each_with_index do |grad, i| %>
          <div class="w-7 h-7 rounded-full bg-gradient-to-br <%= grad %> border-2 border-white dark:border-darkCard flex items-center justify-center text-white text-[9px] font-bold"><%= ("A".ord + i).chr %></div>
        <% end %>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 ml-3">
        <span class="font-bold text-indigo-600 dark:text-indigo-400">+2,400 traders</span> ya mejoran su disciplina
      </p>
    </div>
  </div>
</div>
