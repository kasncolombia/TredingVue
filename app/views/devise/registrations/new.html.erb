<%# app/views/devise/registrations/new.html.erb %>
<div class="min-h-screen relative flex flex-col bg-white text-slate-900 dark:bg-[#05080d] dark:text-white overflow-hidden selection:bg-[#009DFA]/25 selection:text-[#009DFA] transition-colors duration-150">

  <!-- BACKGROUND: mismo grid técnico + glow de acento que la landing -->
  <div class="pointer-events-none fixed inset-0 z-0">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[#009DFA]/[0.06] dark:bg-[#009DFA]/10 blur-[120px]"></div>
    <div class="absolute inset-0 opacity-[0.025] dark:opacity-[0.035]" style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 50px 50px;"></div>
  </div>

  <!-- NAVBAR -->
  <header class="w-full max-w-[1280px] mx-auto flex items-center justify-between h-20 px-5 sm:px-8 lg:px-12 z-30 relative border-b border-slate-200 dark:border-white/[0.06] backdrop-blur-xl bg-white/80 dark:bg-[#05080d]/80">
    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#009DFA]/30 bg-[#009DFA]/10">
        <svg class="h-4 w-4 text-[#009DFA]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"/>
        </svg>
      </div>
      <span class="text-lg font-bold tracking-tight">Trade<span class="text-[#009DFA]">Tres</span></span>
    <% end %>

    <div class="flex items-center gap-2">
      <button onclick="toggleTheme()" type="button" aria-label="Cambiar tema" class="w-9 h-9 rounded-xl bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] flex items-center justify-center text-slate-600 dark:text-slate-300 hover:border-[#009DFA]/40 transition-colors shrink-0">
        <span class="material-symbols-outlined text-[18px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[18px] hidden dark:block">light_mode</span>
      </button>

      <%= link_to "Iniciar sesión", new_session_path(resource_name), class: "px-4 py-2 rounded-xl border border-slate-200 dark:border-white/[0.08] text-sm font-medium text-slate-700 dark:text-slate-300 hover:border-[#009DFA]/40 hover:text-slate-900 dark:hover:text-white transition-colors" %>
    </div>
  </header>

  <!-- MAIN -->
  <main class="relative z-10 flex-1 w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-10 lg:py-16 flex items-center">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <!-- LEFT: SHOWCASE -->
      <div class="hidden lg:flex lg:col-span-7 flex-col justify-center space-y-7">
        <div class="inline-flex items-center gap-2 self-start rounded-full border border-[#009DFA]/20 bg-[#009DFA]/5 px-3.5 py-1.5 text-xs font-medium text-[#009DFA]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#009DFA]"></span>
          Prueba gratuita, sin tarjeta de crédito
        </div>

        <div class="space-y-3">
          <h1 class="text-4xl xl:text-5xl leading-[1.1] tracking-[-0.02em] font-bold">
            Toma el control de tu
            <span class="text-[#009DFA]"> psicología y rentabilidad.</span>
          </h1>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg">
            Únete a traders que auditan su disciplina diaria con analítica y acompañamiento de IA en tiempo real.
          </p>
        </div>

        <!-- STATS -->
        <div class="grid grid-cols-3 rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] divide-x divide-slate-100 dark:divide-white/[0.06] overflow-hidden">
          <div class="p-5">
            <p class="text-2xl font-bold font-mono">2.4K+</p>
            <p class="text-xs text-slate-500 mt-0.5">traders activos</p>
          </div>
          <div class="p-5">
            <p class="text-2xl font-bold font-mono">+42%</p>
            <p class="text-xs text-slate-500 mt-0.5">disciplina promedio</p>
          </div>
          <div class="p-5">
            <p class="text-2xl font-bold font-mono">24/7</p>
            <p class="text-xs text-slate-500 mt-0.5">AI Coach</p>
          </div>
        </div>

        <!-- TESTIMONIAL -->
        <div class="p-5 rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] flex items-center gap-4">
          <div class="flex -space-x-2 shrink-0">
            <div class="w-9 h-9 rounded-full bg-[#009DFA] text-white font-semibold text-xs flex items-center justify-center border-2 border-white dark:border-[#05080d]">AR</div>
            <div class="w-9 h-9 rounded-full bg-emerald-500 text-white font-semibold text-xs flex items-center justify-center border-2 border-white dark:border-[#05080d]">JV</div>
            <div class="w-9 h-9 rounded-full bg-slate-700 text-white font-semibold text-xs flex items-center justify-center border-2 border-white dark:border-[#05080d]">MC</div>
          </div>
          <div class="text-xs space-y-0.5">
            <p class="font-medium text-slate-700 dark:text-slate-300">El AI Coach detectó mis sesgos emocionales y transformó mi estrategia.</p>
            <p class="text-slate-400">Carlos M. · Trader fondeado $150K</p>
          </div>
        </div>
      </div>

      <!-- RIGHT: REGISTER CARD -->
      <div class="w-full lg:col-span-5 max-w-md mx-auto">
        <turbo-frame id="auth_card" target="_top" class="block w-full">
        <div class="rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-7 sm:p-8 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.15)] dark:shadow-[0_30px_80px_-20px_rgba(0,157,250,0.12)]">

          <div class="mb-6">
            <h2 class="text-2xl font-bold tracking-tight">Crea tu cuenta</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1.5">
              Acceso inmediato al journal, analíticas y AI Coach.
            </p>
          </div>

          <button type="button" class="w-full mb-5 py-3 px-4 flex items-center justify-center gap-3 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] hover:border-slate-300 dark:hover:border-white/[0.16] transition-colors text-sm font-medium text-slate-700 dark:text-slate-200">
            <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            Continuar con Google
          </button>

          <div class="flex items-center gap-3 mb-5">
            <div class="flex-1 h-px bg-slate-200 dark:bg-white/[0.08]"></div>
            <span class="text-[11px] font-medium text-slate-400">o con tu correo</span>
            <div class="flex-1 h-px bg-slate-200 dark:bg-white/[0.08]"></div>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>

            <% if resource.errors.any? %>
              <div class="p-3.5 rounded-xl bg-rose-500/5 border border-rose-500/20 text-rose-500 text-xs space-y-1">
                <div class="font-semibold flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px]">error</span>
                  <span>No se pudo crear la cuenta</span>
                </div>
                <ul class="list-disc list-inside space-y-0.5 pl-1 text-[11px] text-rose-500/90">
                  <% resource.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- NOMBRE -->
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Nombre completo</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">person</span>
                </span>
                <%= f.text_field :name, autofocus: true, placeholder: "Alex Rivera",
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-4 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400" %>
              </div>
            </div>

            <!-- EMAIL -->
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Correo electrónico</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">mail</span>
                </span>
                <%= f.email_field :email, autocomplete: "email", placeholder: "alex.rivera@ejemplo.com",
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-4 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400 font-mono" %>
              </div>
            </div>

            <!-- PASSWORD -->
            <div data-controller="password-toggle password-strength">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Contraseña</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">lock</span>
                </span>
                <%= f.password_field :password, autocomplete: "new-password",
                    placeholder: "Mínimo 8 caracteres",
                    data: { "password-toggle-target": "input", "password-strength-target": "input", action: "input->password-strength#check" },
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-11 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400 font-mono" %>
                <button type="button" data-action="password-toggle#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                  <span data-password-toggle-target="icon" class="material-symbols-outlined text-[18px]">visibility</span>
                </button>
              </div>

              <!-- STRENGTH METER -->
              <div class="mt-2.5 space-y-2 p-3 rounded-xl bg-slate-50 dark:bg-black/20 border border-slate-100 dark:border-white/[0.06]">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-medium text-slate-500">Nivel de seguridad</span>
                  <span data-password-strength-target="badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold border flex items-center gap-1 bg-slate-100 dark:bg-white/5 text-slate-500 dark:text-slate-400 border-slate-200 dark:border-white/10">
                    <span class="material-symbols-outlined text-[13px]">lock</span> Ingresa tu clave
                  </span>
                </div>

                <div class="flex items-center gap-1.5">
                  <div data-password-strength-target="bar" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-white/10"></div>
                  <div data-password-strength-target="bar" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-white/10"></div>
                  <div data-password-strength-target="bar" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-white/10"></div>
                  <div data-password-strength-target="bar" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-white/10"></div>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-0.5">
                  <span data-password-strength-target="chipLength" data-label="8+ caracteres" class="inline-flex items-center gap-1 text-[10px] px-2.5 py-0.5 rounded-full font-medium bg-slate-100 dark:bg-white/5 text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-white/10">
                    <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span> 8+ caracteres
                  </span>
                  <span data-password-strength-target="chipComplexity" data-label="Mayúscula + número" class="inline-flex items-center gap-1 text-[10px] px-2.5 py-0.5 rounded-full font-medium bg-slate-100 dark:bg-white/5 text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-white/10">
                    <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span> Mayúscula + número
                  </span>
                  <span data-password-strength-target="chipSymbol" data-label="Símbolo (!@#)" class="inline-flex items-center gap-1 text-[10px] px-2.5 py-0.5 rounded-full font-medium bg-slate-100 dark:bg-white/5 text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-white/10">
                    <span class="material-symbols-outlined text-[12px]">radio_button_unchecked</span> Símbolo (!@#)
                  </span>
                </div>
              </div>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div data-controller="password-toggle">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Confirmar contraseña</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">lock_reset</span>
                </span>
                <%= f.password_field :password_confirmation, autocomplete: "new-password",
                    placeholder: "Repite tu clave",
                    data: { "password-toggle-target": "input" },
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-11 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400 font-mono" %>
                <button type="button" data-action="password-toggle#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                  <span data-password-toggle-target="icon" class="material-symbols-outlined text-[18px]">visibility</span>
                </button>
              </div>
            </div>

            <!-- TERMS -->
            <label class="flex items-start gap-2.5 pt-1 cursor-pointer select-none">
              <input type="checkbox" required class="mt-0.5 w-4 h-4 rounded border-slate-300 dark:border-white/20 dark:bg-black/20 text-[#009DFA] focus:ring-[#009DFA]/30 cursor-pointer">
              <span class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                Acepto los <a href="#" class="text-[#009DFA] font-medium hover:underline">Términos de servicio</a> y la <a href="#" class="text-[#009DFA] font-medium hover:underline">Política de privacidad</a>.
              </span>
            </label>

            <!-- SUBMIT -->
            <%= f.button type: :submit, class: "group w-full py-3.5 px-4 rounded-xl bg-[#009DFA] hover:bg-[#14a8ff] text-white font-semibold text-sm shadow-[0_0_25px_rgba(0,157,250,0.25)] transition-all flex items-center justify-center gap-2 cursor-pointer mt-2" do %>
              <span>Crear cuenta gratis</span>
              <svg class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"/></svg>
            <% end %>

          <% end %>

          <p class="text-center text-xs text-slate-500 dark:text-slate-400 mt-5">
            ¿Ya tienes cuenta?
            <%= link_to "Iniciar sesión", new_session_path(resource_name), class: "text-[#009DFA] font-semibold hover:underline ml-1" %>
          </p>

        </div>
        </turbo-frame>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-6 text-center text-xs text-slate-500 dark:text-slate-500 relative z-10">
    <p>© 2026 TradeTres Technologies Inc. Todos los derechos reservados.</p>
  </footer>
</div>
