<%# app/views/devise/sessions/new.html.erb %>
<div class="min-h-screen relative flex flex-col bg-white text-slate-900 dark:bg-[#05080d] dark:text-white overflow-hidden selection:bg-[#009DFA]/25 selection:text-[#009DFA] transition-colors duration-150">

  <!-- BACKGROUND: mismo grid técnico + glow de acento que la landing -->
  <div class="pointer-events-none fixed inset-0 z-0">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[#009DFA]/[0.06] dark:bg-[#009DFA]/10 blur-[120px]"></div>
    <div class="absolute inset-0 opacity-[0.025] dark:opacity-[0.035]" style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 50px 50px;"></div>
  </div>

  <!-- NAVBAR -->
  <header class="w-full max-w-[1280px] mx-auto flex items-center justify-between h-20 px-5 sm:px-8 lg:px-12 z-30 relative border-b border-slate-200 dark:border-white/[0.06] backdrop-blur-xl bg-white/80 dark:bg-[#05080d]/80">
    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#009DFA]/30 bg-[#009DFA]/10">
        <svg class="h-4 w-4 text-[#009DFA]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"/>
        </svg>
      </div>
      <span class="text-lg font-bold tracking-tight">Trade<span class="text-[#009DFA]">Tres</span></span>
    <% end %>

    <div class="flex items-center gap-2">
      <div class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-full border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] text-xs text-slate-600 dark:text-slate-400">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
        </span>
        <span>Brokers conectados: <strong class="text-emerald-500 font-mono font-medium">45/45</strong></span>
      </div>

      <button onclick="toggleTheme()" type="button" aria-label="Cambiar tema" class="w-9 h-9 rounded-xl bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] flex items-center justify-center text-slate-600 dark:text-slate-300 hover:border-[#009DFA]/40 transition-colors shrink-0">
        <span class="material-symbols-outlined text-[18px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[18px] hidden dark:block">light_mode</span>
      </button>

      <%= link_to "Crear cuenta", new_registration_path(resource_name), class: "hidden sm:inline-flex px-4 py-2 rounded-xl border border-slate-200 dark:border-white/[0.08] text-sm font-medium text-slate-700 dark:text-slate-300 hover:border-[#009DFA]/40 hover:text-slate-900 dark:hover:text-white transition-colors" %>
    </div>
  </header>

  <!-- MAIN -->
  <main class="relative z-10 flex-1 w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-10 lg:py-16 flex items-center">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <!-- LEFT: SHOWCASE -->
      <div class="hidden lg:flex lg:col-span-7 flex-col justify-center space-y-7">
        <div class="inline-flex items-center gap-2 self-start rounded-full border border-[#009DFA]/20 bg-[#009DFA]/5 px-3.5 py-1.5 text-xs font-medium text-[#009DFA]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#009DFA]"></span>
          Journal, prop firms y backtesting en un solo lugar
        </div>

        <div class="space-y-3">
          <h1 class="text-4xl xl:text-5xl leading-[1.1] tracking-[-0.02em] font-bold">
            Tu trading, con datos
            <span class="text-[#009DFA]"> reales delante tuyo.</span>
          </h1>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg">
            Sincroniza tus operaciones, revisa tu evolución y deja que TresBot te ayude a corregir lo que te cuesta dinero.
          </p>
        </div>

        <!-- PREVIEW CARD -->
        <div class="relative rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-5 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.15)] dark:shadow-[0_30px_80px_-20px_rgba(0,157,250,0.12)]">
          <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-white/[0.06]">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-[#009DFA]/10 text-[#009DFA] flex items-center justify-center font-semibold text-xs">TT</div>
              <div>
                <p class="text-xs text-slate-500">Cuenta Pro</p>
                <p class="text-sm font-semibold font-mono">Futures &amp; Forex Intraday</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1 rounded-full">
              <span class="material-symbols-outlined text-[14px]">trending_up</span> +34.8% YTD
            </span>
          </div>

          <div class="grid grid-cols-3 gap-3 my-4">
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-black/20 border border-slate-100 dark:border-white/[0.06]">
              <p class="text-[11px] text-slate-500">Profit neto</p>
              <p class="text-base font-bold text-emerald-500 font-mono mt-0.5">+$18,420</p>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-black/20 border border-slate-100 dark:border-white/[0.06]">
              <p class="text-[11px] text-slate-500">Win rate</p>
              <p class="text-base font-bold font-mono mt-0.5">71.2%</p>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-black/20 border border-slate-100 dark:border-white/[0.06]">
              <p class="text-[11px] text-slate-500">Profit factor</p>
              <p class="text-base font-bold text-[#009DFA] font-mono mt-0.5">2.84</p>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex justify-between items-center text-[11px] text-slate-500">
              <span>Curva de equity · últimos 150 trades</span>
              <span class="text-emerald-500 font-mono font-medium">Drawdown máx. -2.4%</span>
            </div>
            <svg class="w-full h-20 overflow-visible" preserveAspectRatio="none" viewBox="0 0 400 100">
              <defs>
                <linearGradient id="loginEquityGrad" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#009DFA" stop-opacity="0.25"/>
                  <stop offset="100%" stop-color="#009DFA" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,85 Q30,70 60,65 T120,50 T180,42 T240,30 T320,18 T400,6 L400,100 L0,100 Z" fill="url(#loginEquityGrad)"/>
              <path d="M0,85 Q30,70 60,65 T120,50 T180,42 T240,30 T320,18 T400,6" fill="none" stroke="#009DFA" stroke-linecap="round" stroke-width="2.5"/>
            </svg>
          </div>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">
          <span>Conexión API en tiempo real:</span>
          <div class="flex items-center gap-2 font-medium">
            <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02]">TradingView</span>
            <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02]">MetaTrader 5</span>
            <span class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02]">Interactive Brokers</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: LOGIN CARD -->
      <div class="w-full lg:col-span-5 max-w-md mx-auto">
        <turbo-frame id="auth_card" target="_top" class="block w-full">
        <div class="rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-7 sm:p-8 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.15)] dark:shadow-[0_30px_80px_-20px_rgba(0,157,250,0.12)]">

          <div class="mb-6">
            <h2 class="text-2xl font-bold tracking-tight">Ingresa a tu journal</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1.5">
              Revisa tu bitácora, métricas de desempeño y AI Coach.
            </p>
          </div>

          <% if Rails.env.development? %>
            <button type="button" onclick="fillDemoCredentials()"
                class="w-full mb-5 py-3 px-4 rounded-xl border border-[#009DFA]/25 bg-[#009DFA]/5 hover:bg-[#009DFA]/10 text-[#009DFA] font-semibold text-xs transition-colors flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[18px]">bolt</span>
              Acceso rápido (cuenta demo)
            </button>

            <div class="relative flex items-center justify-center my-5">
              <div class="border-t border-slate-200 dark:border-white/[0.08] w-full"></div>
              <span class="bg-white dark:bg-[#0b1119] px-3 text-[11px] font-medium text-slate-400 shrink-0">o con tus credenciales</span>
              <div class="border-t border-slate-200 dark:border-white/[0.08] w-full"></div>
            </div>
          <% end %>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

            <% if resource.errors.any? %>
              <div class="p-3.5 rounded-xl bg-rose-500/5 border border-rose-500/20 text-rose-500 text-xs space-y-1">
                <div class="font-semibold flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px]">error</span>
                  <span>Error al ingresar</span>
                </div>
                <ul class="list-disc list-inside space-y-0.5 pl-1 text-[11px] text-rose-500/90">
                  <% resource.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- EMAIL -->
            <div>
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Correo electrónico</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">mail</span>
                </span>
                <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    placeholder: "trader@tradetres.com",
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-4 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400 font-mono" %>
              </div>
            </div>

            <!-- PASSWORD -->
            <div data-controller="password-toggle">
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-medium text-slate-700 dark:text-slate-300">Contraseña</label>
                <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
                  <%= link_to "¿Olvidaste tu clave?", new_password_path(resource_name),
                      class: "text-xs font-medium text-[#009DFA] hover:underline" %>
                <% end %>
              </div>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[18px]">lock</span>
                </span>
                <%= f.password_field :password, autocomplete: "current-password",
                    data: { "password-toggle-target": "input" },
                    placeholder: "••••••••••••",
                    class: "w-full bg-slate-50 dark:bg-black/20 border border-slate-200 dark:border-white/[0.08] text-slate-900 dark:text-white rounded-xl pl-11 pr-11 py-3 text-sm focus:outline-none focus:border-[#009DFA] focus:ring-1 focus:ring-[#009DFA] transition-colors placeholder:text-slate-400 font-mono" %>
                <button type="button" data-action="password-toggle#toggle" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                  <span data-password-toggle-target="icon" class="material-symbols-outlined text-[18px]">visibility</span>
                </button>
              </div>
            </div>

            <!-- REMEMBER ME -->
            <label class="flex items-center cursor-pointer select-none pt-1">
              <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-slate-300 dark:border-white/20 dark:bg-black/20 text-[#009DFA] focus:ring-[#009DFA]/30 cursor-pointer" %>
              <span class="ml-2.5 text-xs text-slate-600 dark:text-slate-400">Recordarme por 30 días</span>
            </label>

            <!-- SUBMIT -->
            <%= f.button type: :submit, class: "group w-full py-3.5 px-4 rounded-xl bg-[#009DFA] hover:bg-[#14a8ff] text-white font-semibold text-sm shadow-[0_0_25px_rgba(0,157,250,0.25)] transition-all flex items-center justify-center gap-2 cursor-pointer mt-2" do %>
              <span>Iniciar sesión</span>
              <svg class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"/></svg>
            <% end %>

          <% end %>

          <div class="mt-6 pt-5 border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-center gap-1.5 text-[11px] text-slate-400">
            <span class="material-symbols-outlined text-[15px] text-emerald-500">verified_user</span>
            <span>Cifrado de extremo a extremo SSL 256-bit</span>
          </div>

          <p class="text-center text-xs text-slate-500 dark:text-slate-400 mt-4">
            ¿Aún no eres miembro?
            <%= link_to "Crea tu cuenta gratis", new_registration_path(resource_name),
                class: "text-[#009DFA] font-semibold hover:underline ml-1" %>
          </p>

          <% if Rails.env.development? %>
            <script>
              window.fillDemoCredentials = function() {
                const emailInput = document.querySelector('input[type="email"]');
                const passInput  = document.querySelector('input[type="password"]');
                if (emailInput && passInput) {
                  emailInput.value = 'trader@coachtrading.com';
                  passInput.value  = 'password123';
                  const form = emailInput.closest('form');
                  if (form) {
                    if (typeof form.requestSubmit === 'function') {
                      form.requestSubmit();
                    } else {
                      form.submit();
                    }
                  }
                }
              };
            </script>
          <% end %>

        </div>
        </turbo-frame>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 py-6 text-center text-xs text-slate-500 dark:text-slate-500 relative z-10">
    <p>© 2026 TradeTres Technologies Inc. Todos los derechos reservados.</p>
  </footer>
</div>

