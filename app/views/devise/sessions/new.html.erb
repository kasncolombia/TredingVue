<%# app/views/devise/sessions/new.html.erb %>
<div class="min-h-screen relative flex flex-col justify-between py-6 px-4 sm:px-6 lg:px-8 dark:bg-slate-950 bg-slate-50 dark:text-slate-100 text-slate-900 overflow-hidden selection:bg-brand/30 selection:text-brand transition-colors duration-300">

  <!-- BACKGROUND GLOW EFFECTS & GRID -->
  <div class="absolute inset-0 dark:bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand/20 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-500/15 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-violet-600/10 rounded-full blur-[160px] pointer-events-none"></div>

  <!-- TOP BAR / LOGO & STATUS -->
  <header class="w-full max-w-7xl mx-auto flex items-center justify-between py-4 px-2 z-30 relative">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white shadow-lg shadow-brand/25 border border-white/10">
        <span class="material-symbols-outlined text-[22px]">monitoring</span>
      </div>
      <div class="leading-none">
        <span class="font-black text-2xl tracking-tight dark:text-white text-slate-900">Coach<span class="bg-gradient-to-r from-brand via-violet-500 to-emerald-500 bg-clip-text text-transparent">Trading</span></span>
        <span class="ml-2 inline-block text-[10px] font-extrabold uppercase tracking-widest px-2 py-0.5 rounded-full bg-brand/15 text-brand dark:text-brand-light border border-brand/30 align-top shadow-sm">PRO v2.5</span>
      </div>
    </div>

    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden sm:flex items-center gap-2.5 px-4 py-2 rounded-full dark:bg-slate-900/80 bg-white/80 border dark:border-slate-800 border-slate-200 text-xs dark:text-slate-300 text-slate-700 backdrop-blur-md shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-medium dark:text-slate-400 text-slate-500">Broker Connect:</span>
        <strong class="text-emerald-500 font-mono">45/45 Activos</strong>
      </div>

      <!-- THEME TOGGLE BUTTON -->
      <button onclick="toggleTheme()" type="button" class="w-10 h-10 rounded-2xl dark:bg-slate-900/80 bg-white border dark:border-slate-800 border-slate-200 flex items-center justify-center dark:text-amber-400 text-slate-700 hover:border-brand/40 transition-all shadow-sm group" title="Cambiar Tema (Claro / Oscuro)">
        <span class="material-symbols-outlined text-[20px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[20px] hidden dark:block text-amber-400">light_mode</span>
      </button>

      <%= link_to new_registration_path(resource_name), class: "px-4 py-2 text-xs font-bold dark:text-slate-300 text-slate-700 hover:text-brand dark:hover:text-white dark:bg-slate-900/80 bg-white hover:bg-slate-100 border dark:border-slate-800 border-slate-200 hover:border-slate-300 rounded-2xl transition-all shadow-sm flex items-center gap-1.5" do %>
        <span>Crear Cuenta</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      <% end %>
    </div>
  </header>

  <!-- MAIN SPLIT CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto my-auto py-8 flex items-center justify-center relative z-20">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">

      <!-- LEFT COLUMN: HERO SHOWCASE -->
      <div class="hidden lg:flex lg:col-span-6 xl:col-span-7 flex-col justify-center space-y-7 pr-2">

        <div class="inline-flex items-center gap-2.5 self-start px-4 py-2 rounded-full dark:bg-slate-900/90 bg-white/90 border border-brand/30 text-brand dark:text-brand-light text-xs font-semibold backdrop-blur-xl shadow-md">
          <span class="material-symbols-outlined text-emerald-500 text-[18px]">verified</span>
          <span>Plataforma #1 de Journaling & Psicología Cuantitativa</span>
        </div>

        <div class="space-y-3">
          <h1 class="text-4xl xl:text-5xl font-black tracking-tight dark:text-white text-slate-900 leading-[1.15]">
            Domina tus emociones, <br/>
            <span class="bg-gradient-to-r from-brand via-violet-500 to-emerald-500 bg-clip-text text-transparent">optimiza tu R-Multiple</span>.
          </h1>
          <p class="text-base dark:text-slate-400 text-slate-600 max-w-xl leading-relaxed font-normal">
            Sincroniza tus ejecuciones en tiempo real, recibe alertas inteligentes de sesgos emocionales y deja que el AI Coach audite tu plan diario.
          </p>
        </div>

        <!-- DASHBOARD PREVIEW CARD -->
        <div class="relative rounded-3xl dark:bg-slate-900/80 bg-white/90 border dark:border-slate-800 border-slate-200 p-6 shadow-2xl backdrop-blur-2xl overflow-hidden group hover:border-brand/40 transition-all duration-300">
          <div class="absolute top-0 right-0 w-full h-1 bg-gradient-to-r from-brand via-violet-500 to-emerald-400"></div>

          <!-- TOP BAR INSIDE PREVIEW -->
          <div class="flex items-center justify-between pb-4 border-b dark:border-slate-800/80 border-slate-200">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-brand/20 to-violet-600/20 border border-brand/30 flex items-center justify-center font-bold text-sm text-brand">CT</div>
              <div>
                <p class="text-xs font-semibold dark:text-slate-400 text-slate-500">Cuenta Auditada Pro</p>
                <p class="text-sm font-bold dark:text-white text-slate-900 font-mono">Futures & Forex Intraday</p>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-500 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20 shadow-sm">
                <span class="material-symbols-outlined text-[15px]">trending_up</span> +34.8% (YTD)
              </span>
            </div>
          </div>

          <!-- LIVE STATS GRID -->
          <div class="grid grid-cols-3 gap-3 my-5">
            <div class="p-3.5 rounded-2xl dark:bg-slate-950/60 bg-slate-50 border dark:border-slate-800/80 border-slate-200 transition-colors">
              <p class="text-[11px] font-medium dark:text-slate-400 text-slate-500">Profit Neto</p>
              <p class="text-lg font-black text-emerald-500 font-mono tracking-tight mt-0.5">+$18,420.50</p>
            </div>
            <div class="p-3.5 rounded-2xl dark:bg-slate-950/60 bg-slate-50 border dark:border-slate-800/80 border-slate-200 transition-colors">
              <p class="text-[11px] font-medium dark:text-slate-400 text-slate-500">Win Rate</p>
              <p class="text-lg font-black dark:text-white text-slate-900 font-mono tracking-tight mt-0.5">71.2%</p>
            </div>
            <div class="p-3.5 rounded-2xl dark:bg-slate-950/60 bg-slate-50 border dark:border-slate-800/80 border-slate-200 transition-colors">
              <p class="text-[11px] font-medium dark:text-slate-400 text-slate-500">Profit Factor</p>
              <p class="text-lg font-black text-brand font-mono tracking-tight mt-0.5">2.84</p>
            </div>
          </div>

          <!-- MINI SVG EQUITY CURVE -->
          <div class="space-y-1.5 pt-1">
            <div class="flex justify-between items-center text-[11px] dark:text-slate-400 text-slate-500 font-medium">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Curva de Equity (Últimos 150 Trades)
              </span>
              <span class="text-emerald-500 font-mono font-semibold">Drawdown Máx: -2.4%</span>
            </div>
            <div class="h-24 w-full pt-1">
              <svg class="w-full h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 400 100">
                <defs>
                  <linearGradient id="loginEquityGrad" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#10B981" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#10B981" stop-opacity="0.0"/>
                  </linearGradient>
                </defs>
                <path d="M0,85 Q30,70 60,65 T120,50 T180,42 T240,30 T320,18 T400,6 L400,100 L0,100 Z" fill="url(#loginEquityGrad)"/>
                <path d="M0,85 Q30,70 60,65 T120,50 T180,42 T240,30 T320,18 T400,6" fill="none" stroke="#10B981" stroke-linecap="round" stroke-width="3"/>
                <circle cx="400" cy="6" r="4.5" fill="#10B981" stroke="#ffffff" stroke-width="2.5"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- BROKER BADGES -->
        <div class="flex items-center gap-3 text-xs">
          <span class="font-medium dark:text-slate-500 text-slate-400">Conexión API en tiempo real:</span>
          <div class="flex items-center gap-2 font-semibold">
            <span class="px-3 py-1 rounded-xl dark:bg-slate-900 bg-white border dark:border-slate-800 border-slate-200 dark:text-slate-300 text-slate-700 shadow-sm">TradingView</span>
            <span class="px-3 py-1 rounded-xl dark:bg-slate-900 bg-white border dark:border-slate-800 border-slate-200 dark:text-slate-300 text-slate-700 shadow-sm">MetaTrader 5</span>
            <span class="px-3 py-1 rounded-xl dark:bg-slate-900 bg-white border dark:border-slate-800 border-slate-200 dark:text-slate-300 text-slate-700 shadow-sm">Interactive Brokers</span>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: LOGIN CARD -->
      <div class="w-full lg:col-span-6 xl:col-span-5 max-w-md mx-auto">
        <div class="dark:bg-slate-900/90 bg-white/90 border dark:border-slate-800 border-slate-200 p-8 sm:p-10 rounded-3xl shadow-2xl backdrop-blur-2xl relative overflow-hidden transition-all">

          <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand/15 rounded-full blur-2xl pointer-events-none"></div>

          <!-- HEADER -->
          <div class="mb-7 text-center sm:text-left">
            <div class="lg:hidden inline-flex w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 text-white items-center justify-center shadow-lg shadow-brand/30 mb-4">
              <span class="material-symbols-outlined text-[24px]">monitoring</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black dark:text-white text-slate-900 tracking-tight">
              Ingresa a tu Journal
            </h2>
            <p class="text-xs dark:text-slate-400 text-slate-500 mt-2 font-normal leading-relaxed">
              Inicia sesión para revisar tu Bitácora, Métricas de Desempeño y AI Coach.
            </p>
          </div>

          <!-- DEMO QUICK LOGIN BUTTON -->
          <button type="button" onclick="fillDemoCredentials()"
              class="w-full mb-6 py-3.5 px-4 bg-gradient-to-r from-emerald-500/15 via-emerald-500/10 to-teal-500/15 hover:from-emerald-500/25 hover:to-teal-500/25 text-emerald-600 dark:text-emerald-400 font-extrabold text-xs rounded-2xl border border-emerald-500/30 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-emerald-500/5 group">
            <span class="material-symbols-outlined text-[20px] group-hover:scale-110 transition-transform">bolt</span>
            <span>Acceso Rápido 1-Click (Trader Demo)</span>
          </button>

          <div class="relative flex items-center justify-center my-5">
            <div class="border-t dark:border-slate-800 border-slate-200 w-full"></div>
            <span class="dark:bg-slate-900 bg-white px-3 text-[10px] font-bold uppercase tracking-wider dark:text-slate-500 text-slate-400 shrink-0">o credenciales manuales</span>
            <div class="border-t dark:border-slate-800 border-slate-200 w-full"></div>
          </div>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

            <!-- EMAIL -->
            <div>
              <label class="block text-xs font-bold dark:text-slate-300 text-slate-700 mb-1.5">Correo Electrónico</label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[19px]">mail</span>
                </span>
                <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    placeholder: "trader@coachtrading.com",
                    class: "w-full dark:bg-slate-950/80 bg-slate-50 border dark:border-slate-800 border-slate-300 dark:text-white text-slate-900 rounded-2xl pl-11 pr-4 py-3 text-xs focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all placeholder:text-slate-400 font-mono" %>
              </div>
            </div>

            <!-- PASSWORD -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-bold dark:text-slate-300 text-slate-700">Contraseña</label>
                <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
                  <%= link_to "¿Olvidaste tu clave?", new_password_path(resource_name),
                      class: "text-xs font-semibold text-brand hover:underline transition-colors" %>
                <% end %>
              </div>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                  <span class="material-symbols-outlined text-[19px]">lock</span>
                </span>
                <%= f.password_field :password, autocomplete: "current-password", id: "login-password-field",
                    placeholder: "••••••••••••",
                    class: "w-full dark:bg-slate-950/80 bg-slate-50 border dark:border-slate-800 border-slate-300 dark:text-white text-slate-900 rounded-2xl pl-11 pr-11 py-3 text-xs focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all placeholder:text-slate-400 font-mono" %>
                <button type="button" onclick="toggleLoginPassword()" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                  <span id="login-pwd-icon" class="material-symbols-outlined text-[19px]">visibility</span>
                </button>
              </div>
            </div>

            <!-- REMEMBER ME -->
            <div class="flex items-center justify-between pt-1">
              <label class="flex items-center cursor-pointer select-none">
                <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-slate-300 dark:border-slate-800 dark:bg-slate-950 bg-white text-brand focus:ring-brand/30 cursor-pointer" %>
                <span class="ml-2.5 text-xs dark:text-slate-400 text-slate-600 font-medium">Recordarme por 30 días</span>
              </label>
              <span class="text-[11px] dark:text-slate-500 text-slate-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 2FA Activo
              </span>
            </div>

            <!-- SUBMIT BUTTON -->
            <%= f.button type: :submit, class: "group relative w-full py-4 px-4 rounded-2xl bg-gradient-to-r from-brand to-violet-600 hover:from-brand-hover hover:to-violet-700 text-white font-extrabold text-xs shadow-xl shadow-brand/25 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2" do %>
              <span>Iniciar Sesión en la Plataforma</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            <% end %>

          <% end %>

          <!-- SECURITY BADGE -->
          <div class="mt-6 pt-4 border-t dark:border-slate-800/80 border-slate-200 flex items-center justify-center gap-2 text-[11px] dark:text-slate-500 text-slate-400 font-medium">
            <span class="material-symbols-outlined text-[16px] text-emerald-500">verified_user</span>
            <span>Cifrado de extremo a extremo SSL 256-bit</span>
          </div>

          <!-- REGISTER LINK -->
          <p class="text-center text-xs dark:text-slate-400 text-slate-500 mt-4">
            ¿Aún no eres miembro?
            <%= link_to "Crea tu cuenta gratis", new_registration_path(resource_name),
                class: "text-brand font-bold hover:underline ml-1" %>
          </p>

        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="w-full max-w-7xl mx-auto px-4 py-4 text-center text-xs dark:text-slate-500 text-slate-400 relative z-30">
    <p>© 2026 CoachTrading Technologies Inc. Todos los derechos reservados.</p>
  </footer>
</div>

<script>
  function fillDemoCredentials() {
    const emailInput = document.querySelector('input[type="email"]');
    const passInput  = document.getElementById('login-password-field');
    if (emailInput && passInput) {
      emailInput.value = 'trader@coachtrading.com';
      passInput.value  = 'password123';
      emailInput.form.submit();
    }
  }

  function toggleLoginPassword() {
    const input = document.getElementById('login-password-field');
    const icon  = document.getElementById('login-pwd-icon');
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }
</script>
