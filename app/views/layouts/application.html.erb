<!DOCTYPE html>
<html lang="es" id="html-root" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) + " | " : "" %>AI Trading Journal</title>
  <meta name="description" content="Tu diario de trading profesional con AI Coach personal.">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: { extend: {
        colors: {
          /* Dark palette */
          darkBg: "#0D0E1A", darkCard: "#13152B", darkSidebar: "#10122A",
          darkBorder: "#2A2D4A",
          /* Light palette */
          lightBg: "#F0F2FF", lightCard: "#FFFFFF", lightSidebar: "#ECEEFF",
          lightBorder: "#D1D5F5",
          primary: "#4F46E5",
          profit: "#22C55E", loss: "#EF4444", warning: "#F59E0B", muted: "#8B8FA8"
        },
        fontFamily: { sans: ["Inter", "sans-serif"] }
      }}
    }
  </script>
  <style>
    /* ---- BASE ---- */
    body { font-family:"Inter",sans-serif; transition: background .3s, color .3s; }

    /* ---- DARK MODE ---- */
    .dark body { background:#0D0E1A; color:#F8FAFC; }
    .dark .glass { background:rgba(19,21,43,.85); backdrop-filter:blur(12px); border:1px solid #2A2D4A; }
    .dark .sidebar-bg { background:#10122A; border-right:1px solid #2A2D4A; }
    .dark .header-bg { background:rgba(16,18,42,.8); border-bottom:1px solid #2A2D4A; }
    .dark .nav-active { background:rgba(79,70,229,.2); color:#818cf8; border:1px solid rgba(79,70,229,.3); }
    .dark .nav-item { color:#94A3B8; }
    .dark .nav-item:hover { background:rgba(19,21,43,.8); color:#E2E8F0; }
    .dark .stat-card { background:rgba(19,21,43,.85); border:1px solid #2A2D4A; }
    .dark .input-field { background:#0D0E1A; border:1px solid #2A2D4A; color:#F8FAFC; }
    .dark .input-field:focus { border-color:#4F46E5; }
    .dark .table-header { background:rgba(16,18,42,.6); }
    .dark .table-row-hover:hover { background:rgba(19,21,43,.5); }
    .dark .dropdown-bg { background:#13152B; border:1px solid #2A2D4A; }
    .dark ::-webkit-scrollbar { width:5px; height:5px; }
    .dark ::-webkit-scrollbar-track { background:#10122A; }
    .dark ::-webkit-scrollbar-thumb { background:#2A2D4A; border-radius:3px; }

    /* ---- LIGHT MODE ---- */
    html:not(.dark) body { background:#F0F2FF; color:#1E1B4B; }
    html:not(.dark) .glass { background:rgba(255,255,255,.9); backdrop-filter:blur(12px); border:1px solid #D1D5F5; box-shadow:0 2px 16px rgba(79,70,229,.07); }
    html:not(.dark) .sidebar-bg { background:#ECEEFF; border-right:1px solid #D1D5F5; }
    html:not(.dark) .header-bg { background:rgba(240,242,255,.9); border-bottom:1px solid #D1D5F5; backdrop-filter:blur(12px); }
    html:not(.dark) .nav-active { background:rgba(79,70,229,.1); color:#4F46E5; border:1px solid rgba(79,70,229,.2); }
    html:not(.dark) .nav-item { color:#64748B; }
    html:not(.dark) .nav-item:hover { background:rgba(79,70,229,.06); color:#4F46E5; }
    html:not(.dark) .stat-card { background:#FFFFFF; border:1px solid #D1D5F5; box-shadow:0 2px 12px rgba(79,70,229,.07); }
    html:not(.dark) .input-field { background:#FFFFFF; border:1px solid #D1D5F5; color:#1E1B4B; }
    html:not(.dark) .input-field:focus { border-color:#4F46E5; box-shadow:0 0 0 3px rgba(79,70,229,.1); }
    html:not(.dark) .table-header { background:rgba(236,238,255,.8); }
    html:not(.dark) .table-row-hover:hover { background:rgba(236,238,255,.6); }
    html:not(.dark) .dropdown-bg { background:#FFFFFF; border:1px solid #D1D5F5; box-shadow:0 4px 24px rgba(79,70,229,.12); }
    html:not(.dark) ::-webkit-scrollbar { width:5px; height:5px; }
    html:not(.dark) ::-webkit-scrollbar-track { background:#ECEEFF; }
    html:not(.dark) ::-webkit-scrollbar-thumb { background:#D1D5F5; border-radius:3px; }

    /* ---- TOGGLE ANIMATION ---- */
    .toggle-sun, .toggle-moon { transition: opacity .3s, transform .3s; }
    .dark .toggle-sun { opacity:0; transform:rotate(-90deg) scale(0); position:absolute; }
    .dark .toggle-moon { opacity:1; transform:rotate(0); }
    html:not(.dark) .toggle-sun { opacity:1; transform:rotate(0); }
    html:not(.dark) .toggle-moon { opacity:0; transform:rotate(90deg) scale(0); position:absolute; }

    /* ---- ANIMATIONS ---- */
    @keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .fade-in { animation: fadeSlideIn .4s ease forwards; }
    @keyframes pulse-glow { 0%,100% { box-shadow:0 0 8px rgba(79,70,229,.3); } 50% { box-shadow:0 0 20px rgba(79,70,229,.6); } }
    @keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-4px); } }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    .animate-float { animation: float 3s ease-in-out infinite; }
    .animate-shimmer { background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent); background-size: 200% 100%; animation: shimmer 2s infinite; }
  </style>
  <%= csrf_meta_tags %>
</head>
<body class="flex h-screen overflow-hidden antialiased">

  <% if user_signed_in? %>
  <!-- MOBILE BACKDROP -->
  <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>

  <!-- ===================== SIDEBAR ===================== -->
  <aside id="sidebar-container" class="w-60 sidebar-bg flex flex-col justify-between flex-shrink-0 transition-transform duration-300 transform -translate-x-full md:translate-x-0 fixed md:static inset-y-0 left-0 z-40">
    <div>
      <!-- LOGO -->
      <div class="h-16 flex items-center justify-between px-5 border-b border-opacity-30" style="border-color:inherit;">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center font-black text-white shadow-lg shadow-indigo-500/30" style="animation: pulse-glow 3s infinite;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <div>
            <p class="font-black text-sm leading-none text-indigo-600 dark:text-white">AI Trading</p>
            <p class="text-[11px] text-indigo-500 dark:text-indigo-400 font-semibold">Journal Pro</p>
          </div>
        </div>
        <!-- CLOSE MOBILE SIDEBAR BUTTON -->
        <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-400 hover:text-white p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- NAVIGATION -->
      <nav class="p-3 space-y-0.5 mt-1">
        <% nav_items = [
          { label: "Perfil",    path: profile_path,     icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" },
          { label: "Dashboard",    path: dashboard_path,    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" },
          { label: "Comunidad",  path: community_feed_index_path, icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" },
          { label: "Operaciones",  path: trades_path,       icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
          { label: "Calendario",   path: calendar_path,     icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
          { label: "Analytics",   path: analytics_path,    icon: "M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" },
          { label: "AI Coach",    path: ai_coach_path,     icon: "M13 10V3L4 14h7v7l9-11h-7z" },
          { label: "Estrategias", path: strategies_path,   icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
        ] %>
        <% nav_items.each do |item| %>
          <% active = current_page?(item[:path]) %>
          <a href="<%= item[:path] %>" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl font-medium text-xs transition-all duration-200 nav-item <%= active ? 'nav-active' : '' %>">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item[:icon] %>"/>
            </svg>
            <span><%= item[:label] %></span>
            <% if item[:label] == "Operaciones" %>
              <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 font-bold"><%= current_user.trades.count %></span>
            <% end %>
          </a>
        <% end %>


      </nav>
    </div>

    <!-- USER SECTION -->
    <div class="p-3" style="border-top: 1px solid rgba(79,70,229,.2);">
<div class="flex items-center gap-3 px-2 py-2 rounded-xl transition-all hover:bg-slate-800/30 dark:hover:bg-darkCard/30 cursor-pointer" onclick="window.location.href='<%= profile_path %>'">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center font-bold text-white text-xs flex-shrink-0">
              <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
            </div>
            <div class="overflow-hidden flex-1">
              <p class="text-xs font-semibold truncate text-slate-800 dark:text-white"><%= current_user.name || current_user.email %></p>
              <p class="text-[10px] text-indigo-500 dark:text-indigo-400 font-medium">Pro Trader</p>
            </div>
          </div>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "p-1.5 text-slate-400 hover:text-rose-500 rounded-lg transition-all cursor-pointer ml-1" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <% end %>
        </div>
      </aside>

  <!-- ===================== MAIN ===================== -->
  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <!-- TOP HEADER -->
    <header class="h-14 header-bg px-4 md:px-6 flex items-center justify-between flex-shrink-0 transition-all duration-300">
      <div class="flex items-center gap-3">
        <!-- HAMBURGER MENU FOR MOBILE -->
        <button onclick="toggleMobileSidebar()" class="md:hidden p-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-indigo-50 dark:hover:bg-darkCard transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <h1 class="text-sm md:text-base font-bold text-slate-800 dark:text-white truncate">
          <%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %>
        </h1>
        <% if content_for?(:badge) %><div class="hidden sm:block"><%= yield(:badge) %></div><% end %>
      </div>

      <div class="flex items-center gap-2">
        <!-- THEME TOGGLE -->
        <button id="theme-toggle" onclick="toggleTheme()" class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-xl text-slate-500 dark:text-slate-400 hover:bg-indigo-50 dark:hover:bg-darkCard border border-transparent hover:border-indigo-200 dark:hover:border-darkBorder transition-all duration-200" title="Cambiar tema">
          <span class="toggle-sun">
            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
          </span>
          <span class="toggle-moon">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </span>
        </button>

        <!-- PERFIL -->
        <%= link_to profile_path, class: "px-3 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-indigo-50 dark:hover:bg-darkCard transition-all flex items-center gap-1.5 border border-transparent hover:border-indigo-200 dark:hover:border-darkBorder" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <span class="hidden sm:inline">Perfil</span>
        <% end %>

        <!-- NUEVA OPERACIÓN -->
        <%= link_to new_trade_path, class: "px-3 py-1.5 md:px-3.5 md:py-1.5 text-xs font-bold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-1.5 animate-float animate-shimmer" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
          <span class="hidden xs:inline">Nueva Operación</span>
          <span class="xs:hidden">Nueva</span>
        <% end %>

        <!-- CERRAR SESION -->
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "p-1.5 text-slate-400 hover:text-rose-500 rounded-lg hover:bg-rose-50 dark:hover:bg-darkCard transition-all cursor-pointer ml-1" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <% end %>
      </div>
    </header>

    <!-- PAGE CONTENT -->
    <div class="flex-1 overflow-y-auto p-4 md:p-5">
      <% if notice %><div class="mb-4 px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm fade-in"><%= notice %></div><% end %>
      <% if alert  %><div class="mb-4 px-4 py-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm fade-in"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </main>

  <!-- ===================== FLOATING AI ASSISTANT WIDGET ===================== -->
  <div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2">
    <!-- MINI CHAT DRAWER -->
    <div id="ai-floating-chat" class="hidden w-84 sm:w-96 h-[460px] glass rounded-2xl border border-indigo-500/30 shadow-2xl flex flex-col overflow-hidden transition-all duration-300 fade-in">
      <!-- HEADER -->
      <div class="p-3.5 bg-slate-900/90 dark:bg-darkCard/95 border-b border-slate-200 dark:border-darkBorder flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white text-sm shadow-md">🤖</div>
          <div>
            <div class="flex items-center gap-1.5">
              <h4 class="text-xs font-bold text-slate-800 dark:text-white">AI Coach Assistant</h4>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            </div>
            <p class="text-[10px] text-slate-400">Asistente en tiempo real</p>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <!-- EXPAND TO FULL PAGE -->
          <%= link_to ai_coach_path, class: "p-1.5 text-slate-400 hover:text-indigo-400 rounded-lg hover:bg-slate-800/50 transition-all", title: "Vista Completa" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          <% end %>
          <!-- MINIMIZE / CLOSE BUTTON -->
          <button onclick="toggleFloatingCoach()" class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/50 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
        </div>
      </div>

      <!-- MESSAGES CONTAINER -->
      <div id="floating-chat-messages" class="flex-1 p-3 overflow-y-auto space-y-3 text-xs">
        <!-- BOT GREETING -->
        <div class="flex gap-2 items-start">
          <div class="w-6 h-6 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-[10px] flex-shrink-0">🤖</div>
          <div class="p-2.5 rounded-2xl rounded-tl-none bg-indigo-600/10 dark:bg-indigo-600/20 border border-indigo-500/20 text-slate-700 dark:text-slate-200">
            ¡Hola, <strong><%= current_user.name&.split&.first || "Trader" %></strong>! 👋 ¿Cómo puedo ayudarte hoy con tu disciplina, psicología o estrategia?
          </div>
        </div>

        <!-- QUICK CHIPS -->
        <div id="floating-quick-chips" class="flex flex-wrap gap-1.5 pt-1">
          <button onclick="sendQuickPrompt('¿Cómo está mi Win Rate esta semana?')" class="text-[10px] px-2.5 py-1 rounded-full bg-slate-100 dark:bg-darkCard text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/10 transition-all">
            📊 Mi Win Rate
          </button>
          <button onclick="sendQuickPrompt('Dame un consejo para controlar el FOMO')" class="text-[10px] px-2.5 py-1 rounded-full bg-slate-100 dark:bg-darkCard text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/10 transition-all">
            🧠 Evitar FOMO
          </button>
          <button onclick="sendQuickPrompt('¿Cómo evaluar mi relación Riesgo/Beneficio?')" class="text-[10px] px-2.5 py-1 rounded-full bg-slate-100 dark:bg-darkCard text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/10 transition-all">
            🎯 Riesgo/Beneficio
          </button>
        </div>
      </div>

      <!-- INPUT BAR -->
      <form onsubmit="handleFloatingChatSubmit(event)" class="p-2.5 border-t border-slate-200 dark:border-darkBorder bg-slate-50 dark:bg-darkSidebar flex gap-2">
        <input id="floating-chat-input" type="text" placeholder="Escribe tu consulta..." class="flex-1 bg-white dark:bg-darkBg border border-slate-200 dark:border-darkBorder rounded-xl px-3 py-2 text-xs text-slate-800 dark:text-white focus:outline-none focus:border-indigo-500" />
        <button type="submit" class="p-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold hover:scale-105 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
    </div>

    <!-- TRIGGER BUTTON -->
    <button onclick="toggleFloatingCoach()" class="px-3.5 py-2.5 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-xl shadow-indigo-600/40 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center gap-2 font-bold text-xs group border border-indigo-400/30">
      <span class="text-base group-hover:rotate-12 transition-transform">🤖</span>
      <span class="hidden sm:inline">AI Coach</span>
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    </button>
  </div>

  <% else %>
  <!-- AUTH LAYOUT (sin sidebar) -->
  <div class="flex-1 overflow-y-auto">
    <% if notice %><div style="position:fixed;top:1rem;right:1rem;z-index:99;" class="px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm fade-in"><%= notice %></div><% end %>
    <% if alert  %><div style="position:fixed;top:1rem;right:1rem;z-index:99;" class="px-4 py-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm fade-in"><%= alert %></div><% end %>
    <!-- Theme toggle para auth pages -->
    <div class="fixed top-4 right-4 z-50">
      <button id="theme-toggle-auth" onclick="toggleTheme()" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/80 dark:bg-darkCard/80 backdrop-blur border border-indigo-100 dark:border-darkBorder text-slate-500 dark:text-slate-400 hover:border-indigo-300 transition-all shadow-sm" title="Cambiar tema">
        <span class="toggle-sun"><svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg></span>
        <span class="toggle-moon"><svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></span>
      </button>
    </div>
    <!-- NAVEGACIÓN AUTH -->
    <nav class="fixed top-4 left-4 z-50 flex items-center gap-2">
      <%= link_to new_session_path(:user), class: "px-3 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-white/50 dark:hover:bg-darkCard/50 transition-all border border-transparent hover:border-indigo-200 dark:hover:border-darkBorder" do %>
        <svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
        Iniciar Sesión
      <% end %>
      <span class="text-slate-300 dark:text-slate-600">|</span>
      <%= link_to new_registration_path(:user), class: "px-3 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-white/50 dark:hover:bg-darkCard/50 transition-all border border-transparent hover:border-indigo-200 dark:hover:border-darkBorder" do %>
        <svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        Registrarse
      <% end %>
    </nav>
    <%= yield %>
  </div>
  <% end %>

</body>
<script>
  // ---- THEME MANAGER ----
  (function() {
    const saved = localStorage.getItem('tj-theme');
    const root = document.getElementById('html-root');
    if (saved === 'light') {
      root.classList.remove('dark');
    } else {
      root.classList.add('dark');
    }
  })();

  function toggleTheme() {
    const root = document.getElementById('html-root');
    const isDark = root.classList.contains('dark');
    if (isDark) {
      root.classList.remove('dark');
      localStorage.setItem('tj-theme', 'light');
    } else {
      root.classList.add('dark');
      localStorage.setItem('tj-theme', 'dark');
    }
  }

  // ---- MOBILE SIDEBAR DRAWER ----
  function toggleMobileSidebar() {
    const sidebar = document.getElementById('sidebar-container');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');
    if (!sidebar || !backdrop) return;

    const isOpen = !sidebar.classList.contains('-translate-x-full');
    if (isOpen) {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    } else {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    }
  }

  // ---- FLOATING AI COACH WIDGET ----
  function toggleFloatingCoach() {
    const chat = document.getElementById('ai-floating-chat');
    if (!chat) return;
    chat.classList.toggle('hidden');
    if (!chat.classList.contains('hidden')) {
      const input = document.getElementById('floating-chat-input');
      if (input) input.focus();
    }
  }

  function sendQuickPrompt(promptText) {
    const input = document.getElementById('floating-chat-input');
    if (input) {
      input.value = promptText;
      handleFloatingChatSubmit(new Event('submit'));
    }
  }

  async function handleFloatingChatSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('floating-chat-input');
    const msg = input.value.trim();
    if (!msg) return;

    const messagesContainer = document.getElementById('floating-chat-messages');
    const chips = document.getElementById('floating-quick-chips');
    if (chips) chips.remove();

    messagesContainer.innerHTML += `
      <div class="flex gap-2 items-start justify-end">
        <div class="p-2.5 rounded-2xl rounded-tr-none bg-indigo-600 text-white max-w-[80%]">
          ${msg}
        </div>
      </div>
    `;

    const typingId = 'typing-' + Date.now();
    messagesContainer.innerHTML += `
      <div id="${typingId}" class="flex gap-2 items-start">
        <div class="w-6 h-6 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-[10px] flex-shrink-0">🤖</div>
        <div class="p-2.5 rounded-2xl rounded-tl-none bg-indigo-600/10 dark:bg-indigo-600/20 border border-indigo-500/20 text-slate-400 text-[11px] animate-pulse">
          Escribiendo respuesta...
        </div>
      </div>
    `;
    input.value = '';
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const res = await fetch('/ai_coach/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ message: msg })
      });
      const data = await res.json();
      document.getElementById(typingId)?.remove();

      messagesContainer.innerHTML += `
        <div class="flex gap-2 items-start fade-in">
          <div class="w-6 h-6 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-[10px] flex-shrink-0">🤖</div>
          <div class="p-2.5 rounded-2xl rounded-tl-none bg-indigo-600/10 dark:bg-indigo-600/20 border border-indigo-500/20 text-slate-700 dark:text-slate-200">
            ${data.message.replace(/\n/g, '<br>')}
          </div>
        </div>
      `;
    } catch (err) {
      document.getElementById(typingId)?.remove();
      messagesContainer.innerHTML += `
        <div class="text-rose-500 text-[10px] text-center">Error al conectar con el AI Coach.</div>
      `;
    }
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }
</script>
</html>
