<!DOCTYPE html>
<html lang="es" id="html-root" class="dark">
<!-- THEME FLASH PREVENTION: se aplica ANTES de renderizar cualquier contenido -->
<script>
  (function(){
    var s = localStorage.getItem('tj-theme');
    var r = document.documentElement;
    if (s === 'light') { r.classList.remove('dark'); }
    else { r.classList.add('dark'); }
  })();
</script>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) + " | " : "" %>AI Trading Journal</title>
  <meta name="description" content="Tu diario de trading profesional con AI Coach personal.">

  <!-- ===================== FONTS ===================== -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- ===================== TAILWIND ===================== -->
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>

  <!-- ===================== CHARTS — ECharts 5 ===================== -->
  <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>

  <!-- ===================== TradingView Lightweight Charts 4 ===================== -->
  <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: { extend: {
        colors: {
          /* ── Brand ── */
          brand:    "#6C5CE7",
          "brand-hover": "#5847D2",
          "brand-light": "#EDEAFE",
          /* ── Accent ── */
          "accent-green": "#10B981",
          "accent-teal":  "#34D399",
          /* ── Dark surfaces ── */
          darkBg:       "#0D0E15",
          darkCard:     "#151724",
          darkCardAlt:  "#1A1D2D",
          darkInput:    "#11121C",
          darkHover:    "#1E2133",
          darkBorder:   "#23263A",
          /* ── Light surfaces ── */
          lightBg:      "#F8F9FD",
          lightCard:    "#FFFFFF",
          lightBorder:  "#E3E6EF",
          /* ── Status ── */
          profit: "#10B981",
          loss:   "#F43F5E",
          warning:"#F59E0B",
          muted:  "#8B8FA8"
        },
        fontFamily: {
          sans:    ["Manrope", "sans-serif"],
          mono:    ["JetBrains Mono", "monospace"],
          heading: ["Manrope", "sans-serif"]
        }
      }}
    }
  </script>

  <style>
    /* ──────────────────────────────────────────
       BASE
    ────────────────────────────────────────── */
    * { box-sizing: border-box; }
    body { font-family: "Manrope", sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20; }

    /* ── TRANSICIÓN GLOBAL UNIFICADA ──
       Se activa solo DESPUÉS del primer render para evitar flash blanco.
       La clase .theme-ready se agrega dinámicamente tras cargar. */
    .theme-ready,
    .theme-ready *,
    .theme-ready *::before,
    .theme-ready *::after {
      transition: background-color .25s ease, border-color .25s ease, color .25s ease, box-shadow .25s ease !important;
    }

    /* ──────────────────────────────────────────
       SCROLLBAR
    ────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    .dark ::-webkit-scrollbar-track { background: #0D0E15; }
    .dark ::-webkit-scrollbar-thumb { background: #23263A; border-radius: 3px; }
    html:not(.dark) ::-webkit-scrollbar-track { background: #F8F9FD; }
    html:not(.dark) ::-webkit-scrollbar-thumb { background: #E3E6EF; border-radius: 3px; }

    /* ──────────────────────────────────────────
       DARK MODE & HARMONIC FRAME
       Jerarquía de profundidad en dark:
         Canvas exterior : #070810  (más oscuro — el "hueco")
         Sidebar/Header  : #0E1020  (superficie nivel 1)
         Content inner   : #121526  (superficie nivel 2 — ligeramente más claro, se distingue)
         Cards/Glass     : #161A2E  (superficie nivel 3)
    ────────────────────────────────────────── */
    .dark body { background: #090A10; color: #F1F2F6; }
    .dark .glass        { background: rgba(20,23,38,.90); backdrop-filter: blur(14px); border: 1px solid #1E2235; }
    .dark .sidebar-bg   { background: #0C0E1A; border-right: 1px solid #1A1D30; transition: width .3s cubic-bezier(0.4,0,0.2,1); }
    .dark .header-bg    { background: rgba(12,14,26,.95); border-bottom: 1px solid #1A1D30; backdrop-filter: blur(14px); }
    .dark .stat-card    { background: #141729; border: 1px solid #1E2235; }
    .dark .input-field  { background: #0D0E18; border: 1px solid #1E2235; color: #F1F2F6; }
    .dark .input-field::placeholder { color: #4A4D6A; }
    .dark .input-field:focus { border-color: #6C5CE7; box-shadow: 0 0 0 3px rgba(108,92,231,.15); }
    .dark .table-header { background: rgba(14,16,28,.7); }
    .dark .table-row-hover:hover { background: rgba(108,92,231,.15); }
    .dark .table-row-hover:hover td { color: #E5E0ED; }
    .dark .dropdown-bg  { background: #141729; border: 1px solid #1E2235; }
    .dark .nav-item     { color: #8286A8; }
    .dark .nav-item:hover { background: #1A1D2E; color: #E5E0ED; }
    .dark .nav-active   { background: #6C5CE7; color: #fff !important; }
    .dark .nav-active .material-symbols-outlined { color: #fff; }

    /* Dark content canvas — profundidad sutil respecto a sidebar/header */
    .dark .content-canvas    { background: #070810; }
    .dark .content-inner     { background: #10122A; border-color: #1A1D30; box-shadow: 0 1px 3px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.02); }

    /* ──────────────────────────────────────────
       LIGHT MODE & HARMONIC FRAME
    ────────────────────────────────────────── */
    html:not(.dark) body { background: #F6F7FC; color: #0F0E1A; }
    html:not(.dark) .glass        { background: rgba(255,255,255,.94); backdrop-filter: blur(14px); border: 1px solid #E2E6F0; box-shadow: 0 2px 20px rgba(108,92,231,.05); }
    html:not(.dark) .sidebar-bg   { background: #FFFFFF; border-right: 1px solid #E2E6F0; transition: width .3s cubic-bezier(0.4,0,0.2,1); }
    html:not(.dark) .header-bg    { background: rgba(255,255,255,.94); border-bottom: 1px solid #E2E6F0; backdrop-filter: blur(14px); }
    html:not(.dark) .stat-card    { background: #FFFFFF; border: 1px solid #E2E6F0; box-shadow: 0 2px 12px rgba(108,92,231,.05); }
    html:not(.dark) .input-field  { background: rgba(246,247,252,.6); border: 1px solid #E2E6F0; color: #0F0E1A; }
    html:not(.dark) .input-field::placeholder { color: #9DA3B4; }
    html:not(.dark) .input-field:focus { border-color: #6C5CE7; box-shadow: 0 0 0 3px rgba(108,92,231,.12); }
    html:not(.dark) .table-header { background: rgba(236,238,255,.8); }
    html:not(.dark) .table-row-hover:hover { background: rgba(108,92,231,.08); }
    html:not(.dark) .table-row-hover:hover td { color: #0F0E1A; }
    html:not(.dark) .dropdown-bg  { background: #FFFFFF; border: 1px solid #E2E6F0; box-shadow: 0 4px 24px rgba(108,92,231,.1); }
    html:not(.dark) .nav-item     { color: #64748B; }
    html:not(.dark) .nav-item:hover { background: rgba(108,92,231,.06); color: #6C5CE7; }
    html:not(.dark) .nav-active   { background: #6C5CE7; color: #fff !important; }
    html:not(.dark) .nav-active .material-symbols-outlined { color: #fff; }

    /* Light content canvas */
    html:not(.dark) .content-canvas { background: #EEF0F8; }
    html:not(.dark) .content-inner  { background: #FFFFFF; border-color: #E2E6F0; box-shadow: 0 2px 16px rgba(108,92,231,.06); }

    /* ──────────────────────────────────────────
       COLLAPSED SIDEBAR DESKTOP STYLES
    ────────────────────────────────────────── */
    #sidebar-container.collapsed {
      width: 4.5rem !important;
    }
    #sidebar-container.collapsed .sidebar-text-hide {
      display: none !important;
    }
    #sidebar-container.collapsed .nav-item {
      justify-content: center;
      padding: 10px 0;
    }
    #sidebar-container.collapsed .nav-item .material-symbols-outlined {
      margin: 0;
      font-size: 22px;
    }
    #sidebar-container.collapsed #sidebar-logo-icon {
      margin: 0 auto;
    }

    /* ──────────────────────────────────────────
       SIDEBAR NAV ITEM
    ────────────────────────────────────────── */
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border-radius: 12px;
      font-size: 13px; font-weight: 500;
      transition: all .2s ease; text-decoration: none;
    }
    .nav-item .material-symbols-outlined { font-size: 18px; }
    .nav-active { border-radius: 12px; }

    /* ──────────────────────────────────────────
       THEME TOGGLE ICONS
    ────────────────────────────────────────── */
    .toggle-sun, .toggle-moon { transition: opacity .3s, transform .3s; }
    .dark .toggle-sun  { opacity:0; transform:rotate(-90deg) scale(0); position:absolute; }
    .dark .toggle-moon { opacity:1; transform:rotate(0); }
    html:not(.dark) .toggle-sun  { opacity:1; transform:rotate(0); }
    html:not(.dark) .toggle-moon { opacity:0; transform:rotate(90deg) scale(0); position:absolute; }

    /* ──────────────────────────────────────────
       ANIMATIONS
    ────────────────────────────────────────── */
    @keyframes fadeSlideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .fade-in { animation: fadeSlideIn .4s ease forwards; }

    @keyframes pulse-glow { 0%,100% { box-shadow:0 0 8px rgba(108,92,231,.3); } 50% { box-shadow:0 0 22px rgba(108,92,231,.65); } }
    @keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-3px); } }
    .animate-float { animation: float 3s ease-in-out infinite; }

    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    .animate-shimmer { background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); background-size: 200% 100%; animation: shimmer 2s infinite; }

    /* ──────────────────────────────────────────
       GLOW BRAND BUTTON
    ────────────────────────────────────────── */
    .glow-brand { box-shadow: 0 8px 30px -6px rgba(108,92,231,.55); }
    .glow-brand:hover { box-shadow: 0 10px 36px -6px rgba(108,92,231,.75); }

    /* ──────────────────────────────────────────
       BADGE PILL
    ────────────────────────────────────────── */
    .badge-win  { background: rgba(16,185,129,.12); color: #10B981; border: 1px solid rgba(16,185,129,.25); }
    .badge-loss { background: rgba(244,63,94,.12);  color: #F43F5E; border: 1px solid rgba(244,63,94,.25); }
    .badge-long { background: rgba(16,185,129,.1);  color: #10B981; }
    .badge-short{ background: rgba(244,63,94,.1);   color: #F43F5E; }

    /* ──────────────────────────────────────────
       FLOATING AI WIDGET
    ────────────────────────────────────────── */
  </style>

  <%= csrf_meta_tags %>
</head>
<body class="flex h-screen overflow-hidden antialiased">

  <% if user_signed_in? %>

  <!-- MOBILE BACKDROP -->
  <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>

  <!-- ===================== SIDEBAR ===================== -->
  <aside id="sidebar-container" class="w-64 sidebar-bg flex flex-col justify-between flex-shrink-0 transition-all duration-300 transform -translate-x-full md:translate-x-0 fixed md:static inset-y-0 left-0 z-40">
    <div class="overflow-y-auto overflow-x-hidden flex flex-col h-full">

      <!-- LOGO -->
      <div class="h-14 flex items-center justify-between px-4 border-b dark:border-darkBorder border-lightBorder flex-shrink-0">
        <div class="flex items-center gap-3 w-full">
          <%= link_to dashboard_path, id: "sidebar-logo-icon", class: "flex items-center justify-start flex-shrink-0 transition-transform hover:scale-105 ml-1" do %>
            <%= image_tag "tradetres_logo.png", class: "h-9 md:h-10 w-auto object-contain drop-shadow-md" %>
          <% end %>
        </div>
        <!-- CLOSE mobile -->
        <button onclick="toggleMobileSidebar()" class="md:hidden flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-200/70 dark:bg-darkCardAlt text-slate-600 dark:text-slate-300 hover:text-rose-500 transition-all border dark:border-darkBorder border-slate-300">
          <span>Cerrar</span>
          <span class="material-symbols-outlined text-[15px]">close</span>
        </button>
      </div>

      <!-- NAVIGATION -->
      <nav class="p-2.5 space-y-0.5 mt-1 flex-1">
        <% nav_items = [
          { label: "Dashboard",    path: dashboard_path,             icon: "dashboard" },
          { label: "Trades",       path: trades_path,                icon: "swap_horiz", count: current_user.trades.count },
          { label: "Estrategia",   path: strategies_path,            icon: "target" },
          { label: "Prop Firm",    path: pro_tools_path,             icon: "verified" },
          { label: "Backtesting",  path: backtester_path,            icon: "history" },
          { label: "AI Coach",     path: ai_coach_path,              icon: "smart_toy" },
          { label: "Comunidad",    path: community_feed_index_path,  icon: "forum" },
        ] %>
        <% if current_user.admin? %>
          <% nav_items << { label: "Panel Admin", path: admin_root_path, icon: "admin_panel_settings" } %>
        <% end %>
        <% nav_items.each do |item| %>
          <% active = current_page?(item[:path]) %>
          <a href="<%= item[:path] %>" class="nav-item <%= active ? 'nav-active' : '' %>" title="<%= item[:label] %>">
            <span class="material-symbols-outlined flex-shrink-0" style="font-size:18px"><%= item[:icon] %></span>
            <span class="flex-1 sidebar-text-hide truncate"><%= item[:label] %></span>
            <% if item[:count] %>
              <span class="sidebar-text-hide text-[10px] px-1.5 py-0.5 rounded-full font-bold <%= active ? 'bg-white/20 text-white' : 'bg-brand/15 text-brand dark:text-brand-light' %>"><%= item[:count] %></span>
            <% end %>
          </a>
        <% end %>
      </nav>

      <!-- USER SECTION -->
      <div class="p-2.5 border-t dark:border-darkBorder border-lightBorder flex-shrink-0">
        <div class="flex items-center gap-3 px-2 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-darkHover cursor-pointer transition-all" onclick="window.location.href='<%= profile_path %>'" title="<%= current_user.name || current_user.email %>">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand to-violet-600 flex items-center justify-center font-bold text-white text-xs flex-shrink-0">
            <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
          </div>
          <div class="overflow-hidden flex-1 sidebar-text-hide">
            <p class="text-xs font-semibold truncate dark:text-white text-slate-800"><%= current_user.name || current_user.email %></p>
            <% if current_user.admin? %>
              <p class="text-[10px] font-bold text-amber-500 flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[12px]">verified</span>
                Administrador
              </p>
            <% else %>
              <p class="text-[10px] font-medium text-brand dark:text-brand-light">Pro Trader</p>
            <% end %>
          </div>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "p-1.5 dark:text-slate-400 text-slate-400 hover:text-loss rounded-lg transition-all cursor-pointer ml-auto sidebar-text-hide", title: "Cerrar Sesión" do %>
            <span class="material-symbols-outlined text-[18px]">logout</span>
          <% end %>
        </div>
      </div>

    </div>
  </aside>

  <!-- ===================== MAIN ===================== -->
  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">

    <!-- TOP HEADER -->
    <header class="h-14 header-bg px-4 md:px-6 flex items-center justify-between flex-shrink-0 relative z-[100]">
      <div class="flex items-center gap-2 md:gap-3 min-w-0">
        <!-- MOBILE HAMBURGER -->
        <button onclick="toggleMobileSidebar()" class="md:hidden p-1.5 -ml-1 rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 transition-all flex-shrink-0">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </button>

        <!-- LOGO (Solo Visible en Mobile Header) -->
        <%= link_to dashboard_path, class: "md:hidden flex items-center flex-shrink-0 mr-1" do %>
          <%= image_tag "tradetres_logo.png", class: "h-7 xs:h-8 sm:h-9 w-auto object-contain" %>
        <% end %>

        <!-- DESKTOP TOGGLE SIDEBAR BUTTON -->
        <button onclick="toggleDesktopSidebar()" class="hidden md:flex items-center justify-center p-1.5 rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 dark:hover:bg-darkHover transition-all cursor-pointer border border-transparent hover:border-brand/20 flex-shrink-0" title="Colapsar/Expandir Menú Sidebar">
          <span id="desktop-sidebar-icon" class="material-symbols-outlined text-[20px]">menu_open</span>
        </button>

        <h1 class="text-sm md:text-base font-bold dark:text-white text-slate-800 truncate border-l pl-3 ml-1 dark:border-[#23263A] border-slate-200 hidden xs:block">
          <%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %>
        </h1>
        <% if content_for?(:badge) %><div class="hidden sm:block"><%= yield(:badge) %></div><% end %>
      </div>

      <div class="flex items-center gap-1 md:gap-2">
        <% if current_user.admin? %>
          <%= link_to admin_root_path, class: "px-2.5 py-1.5 text-xs font-extrabold bg-amber-500/15 text-amber-400 border border-amber-500/30 hover:bg-amber-500/25 rounded-xl transition-all flex items-center gap-1.5 shadow-sm", title: "Acceso al Panel Admin" do %>
            <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
            <span class="hidden sm:inline">Panel Admin</span>
          <% end %>
        <% end %>

        <!-- NOTIFICATIONS (Real-time with Turbo) -->
        <div class="relative group z-[100]" id="notifications-dropdown-container">
          <%= turbo_stream_from "notifications_#{current_user.id}" %>
          <button type="button" class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all duration-200" title="Notificaciones" onclick="document.getElementById('notif-panel').classList.toggle('hidden')">
            <span class="material-symbols-outlined text-[20px]">notifications</span>
            <%= render partial: "notifications/counter", locals: { count: current_user.notifications.unread.count } %>
          </button>

          <!-- Dropdown Panel Solid UI -->
          <div id="notif-panel" class="hidden fixed left-4 right-4 top-16 md:absolute md:left-auto md:right-0 md:top-full md:mt-2 md:w-[400px] dark:bg-[#141729] bg-white rounded-2xl border dark:border-[#23263A] border-slate-200 shadow-2xl z-[9999] overflow-hidden fade-in">
            <div class="p-3.5 border-b dark:border-[#23263A] border-slate-100 flex items-center justify-between dark:bg-[#1A1D2D] bg-slate-50">
              <h4 class="text-xs font-extrabold uppercase tracking-wider dark:text-white text-slate-900 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-brand">notifications</span>
                Alertas y Notificaciones
              </h4>
              <%= button_to "Marcar todas leídas", mark_all_read_notifications_path, method: :patch, class: "text-[10px] text-brand hover:text-brand-hover font-extrabold bg-transparent border-none cursor-pointer uppercase tracking-wider" %>
            </div>
            <div id="notifications_list" class="max-h-80 overflow-y-auto dark:bg-[#141729] bg-white flex flex-col divide-y dark:divide-[#1E2235] divide-slate-100">
              <% current_user.notifications.recent.limit(20).each do |n| %>
                <%= render partial: "notifications/notification", locals: { notification: n } %>
              <% end %>
              <% if current_user.notifications.empty? %>
                <p class="text-xs text-slate-500 text-center py-8" id="empty-notifications">No tienes notificaciones recientes.</p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- THEME TOGGLE -->
        <button id="theme-toggle" onclick="toggleTheme()" class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all duration-200" title="Cambiar tema">
          <span class="toggle-sun material-symbols-outlined text-[18px] text-amber-500">light_mode</span>
          <span class="toggle-moon material-symbols-outlined text-[18px] text-brand-light">dark_mode</span>
        </button>

        <!-- PERFIL -->
        <%= link_to profile_path, class: "px-2 md:px-3 py-1.5 text-xs font-semibold dark:text-slate-300 text-slate-600 hover:text-brand dark:hover:text-brand-light rounded-xl hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all flex items-center gap-1.5" do %>
          <span class="material-symbols-outlined text-[16px]">person</span>
          <span class="hidden sm:inline">Perfil</span>
        <% end %>

        <!-- NUEVA OPERACIÓN -->
        <%= link_to new_trade_path, class: "px-3 py-1.5 text-xs font-bold bg-brand hover:bg-brand-hover text-white rounded-xl glow-brand transition-all flex items-center gap-1.5 animate-float" do %>
          <span class="material-symbols-outlined text-[16px]">add</span>
          <span class="hidden xs:inline">Nueva</span>
        <% end %>

        <!-- CERRAR SESIÓN -->
        <%= link_to destroy_user_session_path, class: "p-1.5 text-slate-400 hover:text-loss rounded-lg hover:bg-loss/10 transition-all cursor-pointer flex items-center gap-1 text-xs font-semibold", title: "Cerrar Sesión" do %>
          <span class="material-symbols-outlined text-[18px]">logout</span>
          <span class="hidden md:inline">Salir</span>
        <% end %>
      </div>
    </header>

    <!-- PAGE CONTENT (CANVAS CON PROFUNDIDAD SUTIL EN DARK Y LIGHT) -->
    <div class="flex-1 overflow-y-auto p-4 md:p-6 content-canvas">
      <div class="min-h-full rounded-2xl content-inner p-4 md:p-6 border shadow-sm">
        <% if notice && notice != "Signed out successfully." && notice != "Signed in successfully." && !notice.include?("Cerró sesión") %><div class="mb-4 px-4 py-3 rounded-xl bg-profit/10 border border-profit/20 text-profit text-sm fade-in flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">check_circle</span><%= notice %></div><% end %>
        <% if alert  %><div class="mb-4 px-4 py-3 rounded-xl bg-loss/10 border border-loss/20 text-loss text-sm fade-in flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">error</span><%= alert %></div><% end %>
        <%= yield %>
      </div>
    </div>
  </main>

  <!-- ===================== FLOATING AI ASSISTANT ===================== -->
  <div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2">
    <!-- MINI CHAT DRAWER -->
    <div id="ai-floating-chat" class="hidden w-80 sm:w-96 h-[460px] glass rounded-2xl border dark:border-darkBorder border-lightBorder shadow-2xl overflow-hidden transition-all duration-300 fade-in flex-col">

      <!-- HEADER -->
      <div class="p-3.5 dark:bg-darkCardAlt/95 bg-white/90 border-b dark:border-darkBorder border-lightBorder flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-brand flex items-center justify-center text-white text-sm shadow-md">
            <span class="material-symbols-outlined text-[18px]">smart_toy</span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h4 class="text-xs font-bold dark:text-white text-slate-800">AI Coach Assistant</h4>
              <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
            </div>
            <p class="text-[10px] dark:text-slate-400 text-slate-500">Asistente en tiempo real</p>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="resetFloatingChat()" class="p-1.5 dark:text-rose-400/80 text-rose-500/80 hover:bg-rose-500/10 hover:text-rose-500 rounded-lg transition-all" title="Limpiar Chat">
            <span class="material-symbols-outlined text-[16px]">delete</span>
          </button>
          <%= link_to ai_coach_path, class: "p-1.5 dark:text-slate-400 text-slate-400 hover:text-brand rounded-lg hover:bg-brand/10 transition-all", title: "Vista Completa" do %>
            <span class="material-symbols-outlined text-[16px]">open_in_full</span>
          <% end %>
          <button onclick="closeFloatingCoach()" class="p-1.5 dark:text-slate-400 text-slate-400 hover:dark:text-white hover:text-brand rounded-lg hover:bg-brand/10 transition-all" title="Ocultar Chat">
            <span class="material-symbols-outlined text-[18px]">keyboard_arrow_down</span>
          </button>
        </div>
      </div>

      <!-- MESSAGES -->
      <div id="floating-chat-messages" class="flex-1 p-3 overflow-y-auto space-y-3 text-xs">
        <div class="flex gap-2 items-start">
          <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0">
            <span class="material-symbols-outlined text-[13px]">smart_toy</span>
          </div>
          <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">
            ¡Hola, <strong><%= current_user.name&.split&.first || "Trader" %></strong>! 👋 ¿Cómo puedo ayudarte hoy con tu disciplina, psicología o estrategia?
          </div>
        </div>

        <!-- QUICK CHIPS -->
        <div id="floating-quick-chips" class="flex flex-wrap gap-1.5 pt-1">
          <button onclick="sendQuickPrompt('¿Cómo está mi Win Rate esta semana?')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">📊 Mi Win Rate</button>
          <button onclick="sendQuickPrompt('Dame un consejo para controlar el FOMO')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">🧠 Evitar FOMO</button>
          <button onclick="sendQuickPrompt('¿Cómo evaluar mi relación Riesgo/Beneficio?')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">🎯 R:R Ratio</button>
        </div>
      </div>

      <!-- INPUT BAR -->
      <form onsubmit="handleFloatingChatSubmit(event)" class="p-2.5 border-t dark:border-darkBorder border-lightBorder dark:bg-darkBg bg-slate-50 flex gap-2 flex-shrink-0">
        <input id="floating-chat-input" type="text" placeholder="Escribe tu consulta..." class="flex-1 dark:bg-darkInput bg-white border dark:border-darkBorder border-lightBorder rounded-xl px-3 py-2 text-xs dark:text-white text-slate-800 focus:outline-none focus:border-brand" />
        <button type="submit" class="p-2 rounded-xl bg-brand hover:bg-brand-hover text-white font-bold transition-all glow-brand">
          <span class="material-symbols-outlined text-[16px]">send</span>
        </button>
      </form>
    </div>

    <!-- TRIGGER BUTTON -->
    <button onclick="toggleFloatingCoach()" class="px-3.5 py-2.5 rounded-2xl bg-brand text-white shadow-xl glow-brand hover:scale-105 active:scale-95 transition-all duration-200 flex items-center gap-2 font-bold text-xs group border border-brand-light/20">
      <span class="material-symbols-outlined text-[18px] group-hover:rotate-12 transition-transform">smart_toy</span>
      <span class="hidden sm:inline font-semibold">AI Coach</span>
      <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
    </button>
  </div>

  <% else %>
  <!-- AUTH LAYOUT (sin sidebar) -->
  <div class="flex-1 overflow-y-auto">
    <% if notice && notice != "Signed out successfully." && notice != "Signed in successfully." && !notice.include?("Cerró sesión") %><div class="fixed top-4 left-4 right-4 sm:left-auto sm:right-4 z-[99] px-4 py-3 rounded-xl bg-profit/10 border border-profit/20 text-profit text-sm fade-in shadow-xl sm:max-w-sm"><%= notice %></div><% end %>
    <% if alert  %><div class="fixed top-4 left-4 right-4 sm:left-auto sm:right-4 z-[99] px-4 py-3 rounded-xl bg-loss/10 border border-loss/20 text-loss text-sm fade-in shadow-xl sm:max-w-sm"><%= alert %></div><% end %>
    <%= yield %>
  </div>
  <% end %>

</body>
<script>
  // ── THEME MANAGER ──
  // La detección inicial está en el <head> para evitar flash.
  // Aquí solo activamos las transiciones DESPUÉS del primer render.
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      document.documentElement.classList.add('theme-ready');
    });
  });

  function toggleTheme() {
    const root = document.getElementById('html-root');
    const isDark = root.classList.contains('dark');
    if (isDark) {
      root.classList.remove('dark');
      localStorage.setItem('tj-theme', 'light');
    } else {
      root.classList.add('dark');
      localStorage.setItem('tj-theme', 'dark');
    }
  }

  // ── DESKTOP SIDEBAR TOGGLE & INITIALIZATION ──
  (function() {
    const isCollapsed = localStorage.getItem('tj-sidebar-collapsed') === 'true';
    if (isCollapsed) {
      const sidebar = document.getElementById('sidebar-container');
      const icon = document.getElementById('desktop-sidebar-icon');
      if (sidebar) sidebar.classList.add('collapsed');
      if (icon) icon.textContent = 'menu';
    }
  })();

  function toggleDesktopSidebar() {
    const sidebar = document.getElementById('sidebar-container');
    const icon = document.getElementById('desktop-sidebar-icon');
    if (!sidebar) return;
    sidebar.classList.toggle('collapsed');
    const nowCollapsed = sidebar.classList.contains('collapsed');
    localStorage.setItem('tj-sidebar-collapsed', nowCollapsed ? 'true' : 'false');
    if (icon) {
      icon.textContent = nowCollapsed ? 'menu' : 'menu_open';
    }
  }

  // ── MOBILE SIDEBAR ──
  function toggleMobileSidebar() {
    const sidebar = document.getElementById('sidebar-container');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');
    if (!sidebar || !backdrop) return;
    const isOpen = !sidebar.classList.contains('-translate-x-full');
    if (isOpen) {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    } else {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    }
  }

  // ── FLOATING AI COACH ──
  function toggleFloatingCoach() {
    const chat = document.getElementById('ai-floating-chat');
    if (!chat) return;
    const isHidden = chat.classList.contains('hidden') || chat.style.display === 'none';
    if (isHidden) {
      chat.classList.remove('hidden');
      chat.style.display = 'flex';
      const input = document.getElementById('floating-chat-input');
      if (input) input.focus();
    } else {
      chat.classList.add('hidden');
      chat.style.display = 'none';
    }
  }

  function closeFloatingCoach() {
    const chat = document.getElementById('ai-floating-chat');
    if (chat) {
      chat.classList.add('hidden');
      chat.style.display = 'none';
    }
  }

  function sendQuickPrompt(promptText) {
    const input = document.getElementById('floating-chat-input');
    if (input) {
      input.value = promptText;
      handleFloatingChatSubmit(new Event('submit'));
    }
  }

  async function handleFloatingChatSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('floating-chat-input');
    const msg = input.value.trim();
    if (!msg) return;
    const container = document.getElementById('floating-chat-messages');
    const chips = document.getElementById('floating-quick-chips');
    if (chips) chips.remove();

    container.innerHTML += `
      <div class="flex gap-2 items-start justify-end">
        <div class="p-2.5 rounded-2xl rounded-tr-none bg-brand text-white max-w-[80%]">${msg}</div>
      </div>`;

    const typingId = 'typing-' + Date.now();
    container.innerHTML += `
      <div id="${typingId}" class="flex gap-2 items-start">
        <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
        <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 text-slate-400 text-[11px] font-mono flex items-center gap-1.5 animate-pulse">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
          Coach IA analizando...
        </div>
      </div>`;
    input.value = '';
    container.scrollTop = container.scrollHeight;

    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const res = await fetch('/ai_coach/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ message: msg })
      });
      const data = await res.json();
      document.getElementById(typingId)?.remove();
      container.innerHTML += `
        <div class="flex gap-2 items-start fade-in">
          <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
          <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">${data.message.replace(/\n/g, '<br>')}</div>
        </div>`;
    } catch (err) {
      document.getElementById(typingId)?.remove();
      container.innerHTML += `<div class="text-loss text-[10px] text-center">Error al conectar con el AI Coach.</div>`;
    }
    container.scrollTop = container.scrollHeight;
  }

  function resetFloatingChat() {
    if (!confirm('¿Seguro que deseas reiniciar el chat flotante?')) return;
    
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const container = document.getElementById('floating-chat-messages');
    
    fetch('/ai_coach/reset', {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
    }).then(r => r.json()).then(data => {
      if (data.success) {
        container.innerHTML = `
          <div class="flex gap-2 items-start fade-in">
            <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0">
              <span class="material-symbols-outlined text-[13px]">smart_toy</span>
            </div>
            <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">
              Chat reiniciado. ¿En qué te ayudo ahora?
            </div>
          </div>
        `;
      }
    });
  }
</script>
</html>
