<!DOCTYPE html>
<html class="h-full bg-[#0B0F19] text-white" data-theme="dark">
  <head>
    <title>Bienvenido a TradeTres</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" rescue nil %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" rescue nil %>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: { extend: {
          fontFamily: { sans: ["'League Spartan'", "sans-serif"] },
          colors: { brand: "#009DFA" }
        }}
      }
    </script>
    <style>
      body { font-family: "League Spartan", sans-serif; }
      h1, h2, h3, h4, h5, h6, .title-white { font-family: "League Spartan", sans-serif; }
      .dark h1, .dark h2, .dark h3, .dark h4, .dark h5, .dark h6, .dark .title-white { color: #FFFFFF !important; }
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20; display: inline-block; vertical-align: middle; }
    </style>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full antialiased bg-[#0B0F19] text-white">
    <main class="h-full w-full flex flex-col justify-center items-center relative overflow-hidden p-4 sm:p-6">
      <!-- Background subtle elements -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,157,250,0.15),rgba(255,255,255,0))] pointer-events-none"></div>
      
      <%= yield %>
    </main>
  </body>
</html>
