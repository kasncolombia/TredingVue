<div class="min-h-screen bg-slate-950 text-white flex flex-col justify-between relative overflow-hidden font-sans">
  
  <!-- BACKGROUND GLOWS -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-brand/10 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- HEADER & PROGRESS BAR -->
  <header class="relative z-10 max-w-4xl mx-auto w-full px-6 pt-10">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white shadow-lg shadow-brand/30">
          <span class="material-symbols-outlined text-[22px]">monitoring</span>
        </div>
        <span class="font-black text-lg tracking-tight">Coach<span class="text-brand">Trading</span> <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">PRO</span></span>
      </div>
      <span class="text-xs font-mono text-slate-400 font-bold bg-slate-900 border border-slate-800 px-3 py-1 rounded-full">Paso final (3 de 3)</span>
    </div>

    <!-- PROGRESS BAR -->
    <div class="h-2 w-full bg-slate-900 rounded-full overflow-hidden border border-slate-800/80 p-0.5">
      <div class="h-full w-full bg-gradient-to-r from-brand via-violet-500 to-emerald-400 rounded-full transition-all duration-500 shadow-sm shadow-emerald-500/50"></div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="relative z-10 max-w-3xl mx-auto w-full px-6 py-12 flex-1 flex flex-col justify-center">
    
    <div class="text-center mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-violet-500/10 text-violet-400 border border-violet-500/20 mb-4">
        <span class="material-symbols-outlined text-[15px]">flag</span> Objetivo de Performance
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-3">
        ¿Cuál es tu objetivo principal en este momento?
      </h1>
      <p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
        El AI Coach usará esta meta como tu KPI prioritario para detectar sobreoperación o desvíos emocionales.
      </p>
    </div>

    <% if alert %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-medium text-center">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: onboarding_completar_path, method: :post, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- OP 1: Disciplina & Control de Pérdidas -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[trading_goal]" value="Mejorar disciplina y frenar el revenge trading" class="hidden peer" required>
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-emerald-500/20 text-slate-300 group-hover:text-emerald-400 flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-emerald-500 peer-checked:text-slate-950">
            <span class="material-symbols-outlined text-[24px]">psychology</span>
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-emerald-400 transition-colors">Mejorar Disciplina</h3>
            <p class="text-xs text-slate-400 mt-1">Frenar el revenge trading, overtrading y respetar mi Stop Loss.</p>
          </div>
        </label>

        <!-- OP 2: Consistencia & Profit Factor -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-brand/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[trading_goal]" value="Aumentar la consistencia de ganancias (Profit Factor)" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-brand/20 text-slate-300 group-hover:text-brand flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-brand peer-checked:text-white">
            <span class="material-symbols-outlined text-[24px]">trending_up</span>
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-brand transition-colors">Aumentar Consistencia</h3>
            <p class="text-xs text-slate-400 mt-1">Optimizar mi Win Rate y elevar mi Profit Factor a > 1.8.</p>
          </div>
        </label>

        <!-- OP 3: Pasar Evaluación de Prop Firm -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[trading_goal]" value="Aprobar evaluación de fondeo (Prop Firm Evaluation)" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-amber-500/20 text-slate-300 group-hover:text-amber-400 flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-amber-500 peer-checked:text-slate-950">
            <span class="material-symbols-outlined text-[24px]">emoji_events</span>
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-amber-400 transition-colors">Aprobar Evaluación Fondeo</h3>
            <p class="text-xs text-slate-400 mt-1">Cumplir reglas de Drawdown de Apex / Topstep / FTMO.</p>
          </div>
        </label>

        <!-- OP 4: Escalar Capital Real -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-violet-500/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[trading_goal]" value="Escalar mi capital real y automatizar bitácora" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-violet-500/20 text-slate-300 group-hover:text-violet-400 flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-violet-500 peer-checked:text-white">
            <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-violet-400 transition-colors">Escalar Cuenta Real</h3>
            <p class="text-xs text-slate-400 mt-1">Automatizar el registro y maximizar la rentabilidad anual.</p>
          </div>
        </label>

      </div>

      <div class="pt-6 flex justify-between items-center">
        <%= link_to onboarding_paso_2_path, class: "px-5 py-3 rounded-2xl bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-400 text-xs font-bold transition-all flex items-center gap-1.5" do %>
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          <span>Atrás</span>
        <% end %>

        <button type="submit" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-xs shadow-xl shadow-emerald-500/20 transition-all flex items-center gap-2 cursor-pointer">
          <span>Completar Onboarding & Entrar</span>
          <span class="material-symbols-outlined text-[18px]">rocket_launch</span>
        </button>
      </div>
    <% end %>

  </main>

  <footer class="relative z-10 text-center py-6 text-xs text-slate-500 font-mono">
    CoachTrading PRO &copy; 2026 — Antigravity Engine
  </footer>
</div>
