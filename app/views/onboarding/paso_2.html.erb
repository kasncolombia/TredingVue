<div class="min-h-screen bg-slate-950 text-white flex flex-col justify-between relative overflow-hidden font-sans">
  
  <!-- BACKGROUND GLOWS -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-violet-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- HEADER & PROGRESS BAR -->
  <header class="relative z-10 max-w-4xl mx-auto w-full px-6 pt-10">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white shadow-lg shadow-brand/30">
          <span class="material-symbols-outlined text-[22px]">monitoring</span>
        </div>
        <span class="font-black text-lg tracking-tight">Coach<span class="text-brand">Trading</span> <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">PRO</span></span>
      </div>
      <span class="text-xs font-mono text-slate-400 font-bold bg-slate-900 border border-slate-800 px-3 py-1 rounded-full">Paso 2 de 3</span>
    </div>

    <!-- PROGRESS BAR -->
    <div class="h-2 w-full bg-slate-900 rounded-full overflow-hidden border border-slate-800/80 p-0.5">
      <div class="h-full w-2/3 bg-gradient-to-r from-brand to-violet-500 rounded-full transition-all duration-500 shadow-sm shadow-brand/50"></div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="relative z-10 max-w-3xl mx-auto w-full px-6 py-12 flex-1 flex flex-col justify-center">
    
    <div class="text-center mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
        <span class="material-symbols-outlined text-[15px]">analytics</span> Instrumentos Principales
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-3">
        ¿Qué mercado o activo operas principalmente?
      </h1>
      <p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
        Esto ayuda al AI Coach a analizar la volatilidad y los patrones específicos de tus activos clave.
      </p>
    </div>

    <% if alert %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-medium text-center">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: onboarding_paso_3_path, method: :post, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- OP 1: NQ / MNQ -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-brand/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[main_market]" value="NQ / MNQ (Nasdaq 100)" class="hidden peer" required>
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-brand/20 text-slate-300 group-hover:text-brand flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-brand peer-checked:text-white font-mono font-bold text-xs">
            NQ
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-brand transition-colors">Nasdaq 100 (NQ / MNQ)</h3>
            <p class="text-xs text-slate-400 mt-1">Alta volatilidad, empresas tecnológicas US.</p>
          </div>
        </label>

        <!-- OP 2: ES / MES -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-brand/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[main_market]" value="ES / MES (S&P 500)" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-brand/20 text-slate-300 group-hover:text-brand flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-brand peer-checked:text-white font-mono font-bold text-xs">
            ES
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-brand transition-colors">S&P 500 (ES / MES)</h3>
            <p class="text-xs text-slate-400 mt-1">Mercado de referencia institucional.</p>
          </div>
        </label>

        <!-- OP 3: EURUSD / GBPUSD -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-brand/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[main_market]" value="EURUSD / Divisas Mj" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-brand/20 text-slate-300 group-hover:text-brand flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-brand peer-checked:text-white font-mono font-bold text-xs">
            FX
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-brand transition-colors">EUR/USD & Majors</h3>
            <p class="text-xs text-slate-400 mt-1">Pares de divisas con gran liquidez.</p>
          </div>
        </label>

        <!-- OP 4: BTCUSD / ETHUSD -->
        <label class="group relative p-5 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-brand/60 hover:bg-slate-900 cursor-pointer transition-all duration-200 flex items-start gap-4">
          <input type="radio" name="user[main_market]" value="BTC / Crypto Perps" class="hidden peer">
          <div class="w-12 h-12 rounded-2xl bg-slate-800 group-hover:bg-brand/20 text-slate-300 group-hover:text-brand flex items-center justify-center flex-shrink-0 transition-colors peer-checked:bg-brand peer-checked:text-white font-mono font-bold text-xs">
            BTC
          </div>
          <div class="flex-1">
            <h3 class="font-extrabold text-sm text-white group-hover:text-brand transition-colors">Bitcoin & Altcoins</h3>
            <p class="text-xs text-slate-400 mt-1">Mercado 24/7 de alta volatilidad.</p>
          </div>
        </label>

      </div>

      <div class="pt-6 flex justify-between items-center">
        <%= link_to onboarding_paso_1_path, class: "px-5 py-3 rounded-2xl bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-400 text-xs font-bold transition-all flex items-center gap-1.5" do %>
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          <span>Atrás</span>
        <% end %>

        <button type="submit" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-brand to-violet-600 hover:from-brand-hover hover:to-violet-700 text-white font-extrabold text-xs shadow-xl shadow-brand/25 transition-all flex items-center gap-2 cursor-pointer">
          <span>Continuar al Paso 3</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
      </div>
    <% end %>

  </main>

  <footer class="relative z-10 text-center py-6 text-xs text-slate-500 font-mono">
    CoachTrading PRO &copy; 2026 — Antigravity Engine
  </footer>
</div>
