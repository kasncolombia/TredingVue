<div
  data-controller="onboarding"
  class="relative min-h-screen w-full overflow-hidden bg-[#05080d] text-white"
  data-onboarding-wizard-url-value="<%= prop_firm_accounts_path %>"
  data-onboarding-backtester-url-value="<%= backtesting_root_path rescue '/backtesting' %>"
  data-onboarding-journal-url-value="<%= trades_path %>"
  data-onboarding-dashboard-url-value="<%= dashboard_path %>"
>

  <!-- ========================================================= -->
  <!-- BACKGROUND / AMBIENTE -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <!-- Glow superior -->
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-[#009DFA]/10 blur-[120px]"></div>

    <!-- Glow lateral -->
    <div class="absolute top-1/3 -left-40 h-[350px] w-[350px] rounded-full bg-[#009DFA]/5 blur-[100px]"></div>

    <!-- Glow inferior -->
    <div class="absolute -bottom-40 right-0 h-[400px] w-[400px] rounded-full bg-blue-500/5 blur-[120px]"></div>

    <!-- Grid técnico -->
    <div
      class="absolute inset-0 opacity-[0.035]"
      style="
        background-image:
          linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
        background-size: 50px 50px;
      "
    ></div>

  </div>


  <!-- ========================================================= -->
  <!-- MAIN CONTAINER -->
  <!-- ========================================================= -->

  <div class="relative z-10 flex min-h-screen w-full flex-col">


    <!-- ======================================================= -->
    <!-- HEADER -->
    <!-- ======================================================= -->

    <header class="flex h-20 w-full shrink-0 items-center justify-between border-b border-white/[0.06] px-5 sm:px-8 lg:px-12">

      <!-- Back -->
      <div class="w-28 sm:w-32">

        <button
          data-action="click->onboarding#back"
          data-onboarding-target="backButton"
          class="group hidden items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-slate-400 transition-all duration-200 hover:bg-white/[0.05] hover:text-white focus:outline-none"
        >

          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>

          <span>Atrás</span>

        </button>

      </div>


      <!-- LOGO -->

      <div class="absolute left-1/2 -translate-x-1/2">

        <div class="flex items-center gap-2">

          <!-- Logo mark -->
          <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#009DFA]/30 bg-[#009DFA]/10 shadow-[0_0_20px_rgba(0,157,250,0.15)]">

            <svg
              class="h-4 w-4 text-[#009DFA]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"
              />
            </svg>

          </div>

          <div class="text-xl font-bold tracking-tight text-white sm:text-2xl">
            Trade<span class="text-[#009DFA]">Tres</span>
          </div>

        </div>

      </div>


      <!-- PROGRESS SPACE (Balancing the left button) -->
      <div class="w-28 sm:w-32"></div>

    </header>

    <!-- PROGRESS BAR (Large and Centered) -->
    <div class="w-full flex justify-center pt-8 px-4 -mb-2 relative z-20">
      <div
        data-onboarding-target="progressContainer"
        class="hidden w-full max-w-md flex-col gap-2.5 opacity-0 transition-opacity duration-300"
      >
        <div class="flex items-center justify-between text-xs font-bold tracking-widest uppercase text-slate-400 px-1">
          <span>Configuración</span>
          <div>
            <span>Paso </span>
            <span data-onboarding-target="progressText" class="text-[#009DFA] text-sm">1</span>
            <span class="text-slate-600"> / 3</span>
          </div>
        </div>
        
        <div class="h-3 w-full rounded-full bg-white/5 overflow-hidden shadow-inner flex justify-start p-0.5 border border-white/10">
          <div
            data-onboarding-target="progressBar"
            class="h-full rounded-full bg-gradient-to-r from-[#009DFA]/60 via-[#009DFA] to-[#5cc8ff] shadow-[0_0_20px_rgba(0,157,250,0.8)] transition-all duration-500 ease-out"
            style="width: 33.33%;"
          ></div>
        </div>
      </div>
    </div>



    <!-- ======================================================= -->
    <!-- CONTENT -->
    <!-- ======================================================= -->

    <main class="flex flex-1 items-center justify-center px-4 py-8 sm:px-6 lg:px-8">

      <!-- Main width -->
      <div class="w-full max-w-2xl">


        <!-- =================================================== -->
        <!-- STEP 0 — WELCOME -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="0"
          class="flex w-full flex-col items-center justify-center text-center transition-all duration-500"
        >

          <!-- Icon -->
          <div class="relative mb-8">

            <div class="absolute inset-0 rounded-3xl bg-[#009DFA]/20 blur-2xl"></div>

            <div class="relative flex h-24 w-24 items-center justify-center rounded-3xl border border-[#009DFA]/20 bg-[#0b1119] shadow-[0_20px_60px_rgba(0,157,250,0.12)]">

              <svg
                class="h-11 w-11 text-[#009DFA]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                  d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"
                />
              </svg>

            </div>

          </div>


          <!-- Badge -->

          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#009DFA]/20 bg-[#009DFA]/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#5cc8ff]">

            <span class="h-1.5 w-1.5 rounded-full bg-[#009DFA] shadow-[0_0_8px_rgba(0,157,250,0.8)]"></span>

            Configuración inicial

          </div>


          <h1 class="max-w-xl text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">

            Bienvenido a

            <span class="block bg-gradient-to-r from-white via-white to-[#009DFA] bg-clip-text text-transparent">
              TradeTres
            </span>

          </h1>


          <p class="mt-6 max-w-lg text-base leading-7 text-slate-400 sm:text-lg">

            Vamos a configurar tu espacio de trading para que encuentres rápidamente las herramientas que necesitas.

          </p>


          <button
            data-action="click->onboarding#next"
            class="group mt-10 flex w-full max-w-md items-center justify-center gap-3 rounded-2xl bg-[#009DFA] px-6 py-4 text-base font-bold text-white shadow-[0_0_35px_rgba(0,157,250,0.25)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#14a8ff] hover:shadow-[0_0_45px_rgba(0,157,250,0.4)] focus:outline-none focus:ring-2 focus:ring-[#009DFA]/50"
          >

            <span>Comenzar configuración</span>

            <svg
              class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 12h14m-6-6l6 6-6 6"
              />
            </svg>

          </button>


          <p class="mt-5 text-xs text-slate-600">
            Solo tomará unos minutos
          </p>

        </div>



        <!-- =================================================== -->
        <!-- STEP 1 — INTENTIONS -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="1"
          class="hidden w-full flex-col items-center text-center transition-all duration-500"
        >

          <div class="mb-8 w-full">

            <div class="mb-4 flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#009DFA]">

              <span class="h-px w-8 bg-[#009DFA]/30"></span>

              TU ESPACIO

              <span class="h-px w-8 bg-[#009DFA]/30"></span>

            </div>

            <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
              ¿Qué quieres hacer con TradeTres?
            </h2>

            <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-slate-400 sm:text-base">
              Selecciona todo lo que quieras utilizar. Puedes cambiarlo más adelante.
            </p>

          </div>


          <div class="grid w-full gap-3">

            <!-- PROP FIRMS -->

            <label class="group relative cursor-pointer">

              <input
                type="checkbox"
                value="Prop Firms"
                data-onboarding-target="intention"
                data-action="change->onboarding#updateNextButton"
                class="peer sr-only"
              >

              <div class="flex min-h-[100px] items-center gap-4 rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5 text-left transition-all duration-300 hover:border-white/[0.16] hover:bg-white/[0.045] peer-checked:border-[#009DFA]/70 peer-checked:bg-[#009DFA]/[0.07] peer-checked:shadow-[0_0_30px_rgba(0,157,250,0.08)]">

                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-white/[0.08] bg-[#0d141d] text-[#009DFA] transition-all duration-300 peer-checked:border-[#009DFA]/30 peer-checked:bg-[#009DFA]/10">

                  <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-width="1.8" d="M4 19h16M5 19V9l7-4 7 4v10M9 19v-6h6v6M3 9h18"/>
                  </svg>

                </div>

                <div class="min-w-0 flex-1">

                  <h3 class="text-base font-bold text-white">
                    Prop Firms
                  </h3>

                  <p class="mt-1 text-sm leading-5 text-slate-400">
                    Gestiona tus cuentas, reglas, riesgo y progreso.
                  </p>

                </div>

                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-white/20 transition-all peer-checked:border-[#009DFA] peer-checked:bg-[#009DFA]">

                  <svg
                    class="h-3.5 w-3.5 text-white opacity-0 transition-opacity peer-checked:opacity-100"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-width="3" d="M5 12l4 4L19 7"/>
                  </svg>

                </div>

              </div>

            </label>


            <!-- BACKTESTING -->

            <label class="group relative cursor-pointer">

              <input
                type="checkbox"
                value="Backtesting"
                data-onboarding-target="intention"
                data-action="change->onboarding#updateNextButton"
                class="peer sr-only"
              >

              <div class="flex min-h-[100px] items-center gap-4 rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5 text-left transition-all duration-300 hover:border-white/[0.16] hover:bg-white/[0.045] peer-checked:border-[#009DFA]/70 peer-checked:bg-[#009DFA]/[0.07] peer-checked:shadow-[0_0_30px_rgba(0,157,250,0.08)]">

                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-white/[0.08] bg-[#0d141d] text-[#009DFA]">

                  <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-width="1.8" d="M4 19V5M4 19h17M8 16v-4M12 16V8M16 16v-6M20 16v-9"/>
                  </svg>

                </div>

                <div class="min-w-0 flex-1">

                  <h3 class="text-base font-bold text-white">
                    Backtesting
                  </h3>

                  <p class="mt-1 text-sm leading-5 text-slate-400">
                    Prueba estrategias con datos históricos y replay.
                  </p>

                </div>

                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-white/20 transition-all peer-checked:border-[#009DFA] peer-checked:bg-[#009DFA]">

                  <svg class="h-3.5 w-3.5 text-white opacity-0 peer-checked:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-width="3" d="M5 12l4 4L19 7"/>
                  </svg>

                </div>

              </div>

            </label>


            <!-- JOURNAL -->

            <label class="group relative cursor-pointer">

              <input
                type="checkbox"
                value="Journal & Analytics"
                data-onboarding-target="intention"
                data-action="change->onboarding#updateNextButton"
                class="peer sr-only"
              >

              <div class="flex min-h-[100px] items-center gap-4 rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5 text-left transition-all duration-300 hover:border-white/[0.16] hover:bg-white/[0.045] peer-checked:border-[#009DFA]/70 peer-checked:bg-[#009DFA]/[0.07] peer-checked:shadow-[0_0_30px_rgba(0,157,250,0.08)]">

                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-white/[0.08] bg-[#0d141d] text-[#009DFA]">

                  <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-width="1.8" d="M6 3h9l3 3v15H6V3Z"/>
                    <path stroke-width="1.8" d="M9 12h6M9 16h5M9 8h3"/>
                  </svg>

                </div>

                <div class="min-w-0 flex-1">

                  <h3 class="text-base font-bold text-white">
                    Journal & Analytics
                  </h3>

                  <p class="mt-1 text-sm leading-5 text-slate-400">
                    Registra operaciones y analiza tu rendimiento.
                  </p>

                </div>

                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-white/20 transition-all peer-checked:border-[#009DFA] peer-checked:bg-[#009DFA]">

                  <svg class="h-3.5 w-3.5 text-white opacity-0 peer-checked:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-width="3" d="M5 12l4 4L19 7"/>
                  </svg>

                </div>

              </div>

            </label>

          </div>


          <button
            data-action="click->onboarding#next"
            data-onboarding-target="nextButton"
            disabled
            class="mt-6 w-full rounded-2xl bg-white/[0.06] px-6 py-4 text-base font-bold text-slate-500 transition-all duration-300 disabled:cursor-not-allowed enabled:bg-[#009DFA] enabled:text-white enabled:shadow-[0_0_30px_rgba(0,157,250,0.25)] enabled:hover:bg-[#14a8ff]"
          >
            Continuar
          </button>

        </div>



        <!-- =================================================== -->
        <!-- STEP 2 — MARKETS -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="2"
          class="hidden w-full flex-col items-center text-center transition-all duration-500"
        >

          <div class="mb-8">

            <div class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-[#009DFA]">
              MERCADOS
            </div>

            <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
              ¿Qué estás operando?
            </h2>

            <p class="mt-3 text-sm text-slate-400 sm:text-base">
              Selecciona todos los mercados que utilizas.
            </p>

          </div>


          <div class="grid w-full grid-cols-2 gap-3 sm:grid-cols-3">

            <% [
              ["Crypto", "₿"],
              ["Futures", "◈"],
              ["Forex", "↔"],
              ["Stocks", "↗"],
              ["Options", "◫"],
              ["CFD", "⌁"],
              ["Otros", "•••"]
            ].each do |market, icon| %>

              <label class="group cursor-pointer">

                <input
                  type="checkbox"
                  value="<%= market %>"
                  data-onboarding-target="market"
                  data-action="change->onboarding#updateNextButton"
                  class="peer sr-only"
                >

                <div class="flex min-h-[110px] flex-col items-center justify-center rounded-2xl border border-white/[0.08] bg-white/[0.025] p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-white/[0.16] hover:bg-white/[0.045] peer-checked:border-[#009DFA]/70 peer-checked:bg-[#009DFA]/[0.08]">

                  <div class="mb-3 text-2xl font-bold text-slate-500 transition-colors peer-checked:text-[#009DFA]">
                    <%= icon %>
                  </div>

                  <span class="text-sm font-semibold text-slate-300 peer-checked:text-white">
                    <%= market %>
                  </span>

                </div>

              </label>

            <% end %>

          </div>


          <button
            data-action="click->onboarding#next"
            data-onboarding-target="nextButton"
            disabled
            class="mt-6 w-full rounded-2xl bg-white/[0.06] px-6 py-4 text-base font-bold text-slate-500 transition-all duration-300 disabled:cursor-not-allowed enabled:bg-[#009DFA] enabled:text-white enabled:shadow-[0_0_30px_rgba(0,157,250,0.25)]"
          >
            Continuar
          </button>

        </div>



        <!-- =================================================== -->
        <!-- STEP 3 — EXPERIENCE -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="3"
          class="hidden w-full flex-col items-center text-center transition-all duration-500"
        >

          <div class="mb-8">

            <div class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-[#009DFA]">
              TU EXPERIENCIA
            </div>

            <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
              ¿Cuánto tiempo llevas operando?
            </h2>

            <p class="mt-3 text-sm text-slate-400 sm:text-base">
              Esto nos ayuda a personalizar tu experiencia.
            </p>

          </div>


          <div class="grid w-full gap-3">

            <% [

              ["Estoy comenzando", "Menos de 1 año", "01"],

              ["Tengo algo de experiencia", "1–3 años", "02"],

              ["Trader experimentado", "3–5 años", "03"],

              ["Trader avanzado", "Más de 5 años", "04"]

            ].each do |title, subtitle, number| %>

              <label class="group cursor-pointer">

                <input
                  type="radio"
                  name="experience"
                  value="<%= title %>"
                  data-onboarding-target="experience"
                  data-action="change->onboarding#updateNextButton"
                  class="peer sr-only"
                >

                <div class="flex items-center gap-4 rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5 text-left transition-all duration-300 hover:border-white/[0.16] hover:bg-white/[0.045] peer-checked:border-[#009DFA]/70 peer-checked:bg-[#009DFA]/[0.07]">

                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/[0.08] bg-[#0d141d] text-xs font-bold text-slate-500 peer-checked:border-[#009DFA]/30 peer-checked:text-[#009DFA]">

                    <%= number %>

                  </div>

                  <div class="min-w-0 flex-1">

                    <h3 class="font-bold text-white">
                      <%= title %>
                    </h3>

                    <p class="mt-1 text-sm text-slate-400">
                      <%= subtitle %>
                    </p>

                  </div>

                  <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-white/20 peer-checked:border-[#009DFA] peer-checked:bg-[#009DFA]">

                    <div class="h-2 w-2 rounded-full bg-white opacity-0 peer-checked:opacity-100"></div>

                  </div>

                </div>

              </label>

            <% end %>

          </div>


          <button
            data-action="click->onboarding#submit"
            data-onboarding-target="submitButton"
            disabled
            class="relative mt-6 flex w-full items-center justify-center rounded-2xl bg-white/[0.06] px-6 py-4 text-base font-bold text-slate-500 transition-all duration-300 disabled:cursor-not-allowed enabled:bg-[#009DFA] enabled:text-white enabled:shadow-[0_0_30px_rgba(0,157,250,0.25)] enabled:hover:bg-[#14a8ff]"
          >

            <span data-onboarding-target="submitText">
              Finalizar configuración
            </span>

            <svg
              data-onboarding-target="submitSpinner"
              class="ml-2 hidden h-5 w-5 animate-spin text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >

              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              ></circle>

              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>

            </svg>

          </button>

        </div>



        <!-- =================================================== -->
        <!-- STEP 4 — PROCESSING -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="4"
          class="hidden w-full flex-col items-center justify-center text-center transition-all duration-500"
        >

          <div class="relative mb-8">

            <div class="absolute inset-0 animate-pulse rounded-full bg-[#009DFA]/20 blur-2xl"></div>

            <div class="relative flex h-24 w-24 items-center justify-center rounded-full border border-[#009DFA]/20 bg-[#0b1119]">

              <svg
                class="h-10 w-10 animate-pulse text-[#009DFA]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-width="1.8"
                  d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"
                />
              </svg>

            </div>

          </div>


          <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
            Configurando tu espacio
          </h1>

          <p class="mt-4 max-w-md text-sm leading-6 text-slate-400 sm:text-base">
            Estamos preparando TradeTres según las preferencias que seleccionaste.
          </p>


          <div class="mt-8 h-1.5 w-48 overflow-hidden rounded-full bg-white/[0.06]">

            <div class="h-full w-1/2 animate-pulse rounded-full bg-[#009DFA]"></div>

          </div>

        </div>



        <!-- =================================================== -->
        <!-- STEP 5 — BRANCHING -->
        <!-- =================================================== -->

        <div
          data-onboarding-target="step"
          data-step="5"
          class="hidden w-full flex-col items-center text-center transition-all duration-500"
        >

          <div class="mb-8">

            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#009DFA]/20 bg-[#009DFA]/5 px-3 py-1.5 text-xs font-semibold text-[#5cc8ff]">

              <span class="h-1.5 w-1.5 rounded-full bg-[#009DFA]"></span>

              TODO LISTO

            </div>


            <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
              Tu espacio está listo
            </h2>

            <p class="mt-3 text-sm leading-6 text-slate-400 sm:text-base">
              Hemos preparado las herramientas que seleccionaste.
            </p>

          </div>


          <!-- Selected modules -->

          <div
            data-onboarding-target="multipleSelectionList"
            class="mb-8 flex flex-wrap justify-center gap-2"
          >
            <!-- JS injects selected items -->
          </div>


          <div class="w-full">

            <div class="mb-4 text-left">

              <p class="text-sm font-semibold text-white">
                ¿Por dónde quieres empezar?
              </p>

              <p class="mt-1 text-xs text-slate-500">
