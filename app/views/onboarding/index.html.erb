<%# app/views/onboarding/index.html.erb %>
<div class="w-full max-w-2xl relative z-10 flex flex-col items-center justify-center min-h-[500px]"
     data-controller="onboarding"
     data-onboarding-wizard-url-value="<%= prop_firm_accounts_path %>"
     data-onboarding-backtester-url-value="<%= backtesting_root_path %>"
     data-onboarding-journal-url-value="<%= trades_path %>"
     data-onboarding-dashboard-url-value="<%= dashboard_path %>">

  <!-- TOP HEADER / BRANDING & BACK BUTTON -->
  <div class="w-full flex items-center justify-between mb-6">
    <button data-onboarding-target="backButton"
            data-action="click->onboarding#back"
            class="hidden px-3.5 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer border border-slate-700/60">
      <span class="material-symbols-outlined text-[16px]">arrow_back</span> Regresar
    </button>
    <div class="flex items-center gap-2 mx-auto sm:mx-0">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg border border-[#009DFA]/30 bg-[#009DFA]/10">
        <svg class="h-4 w-4 text-[#009DFA]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19V5m0 14h16M7 15l3-4 3 2 5-7"/>
        </svg>
      </div>
      <span class="text-base font-bold tracking-tight text-white">Trade<span class="text-[#009DFA]">Tres</span></span>
    </div>
  </div>

  <!-- PROGRESS INDICATOR -->
  <div data-onboarding-target="progressContainer" class="hidden opacity-0 transition-opacity duration-300 w-full flex-col gap-2 mb-8">
    <div class="flex items-center justify-between text-xs font-mono text-slate-400">
      <span>Paso <span data-onboarding-target="progressText" class="text-[#009DFA] font-bold">1</span> de 3</span>
      <span class="text-[11px]">Configuración de Perfil</span>
    </div>
    <div class="w-full bg-slate-800/80 rounded-full h-2 overflow-hidden border border-slate-700/50">
      <div data-onboarding-target="progressBar" class="bg-gradient-to-r from-[#009DFA] to-blue-500 h-full w-0 transition-all duration-300 rounded-full shadow-[0_0_12px_rgba(0,157,250,0.6)]"></div>
    </div>
  </div>

  <!-- CONTAINER CARD -->
  <div class="w-full bg-slate-900/90 border border-slate-800/90 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl relative overflow-hidden min-h-[420px] flex flex-col justify-between">
    
    <!-- STEP 0: BIENVENIDA -->
    <div data-onboarding-target="step" data-step="0" class="flex flex-col items-center text-center space-y-6 my-auto transition-all duration-300">
      <div class="w-16 h-16 rounded-2xl bg-[#009DFA]/10 border border-[#009DFA]/30 flex items-center justify-center text-[#009DFA] text-3xl shadow-[0_0_30px_rgba(0,157,250,0.2)]">
        🚀
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          ¡Bienvenido a <span class="text-[#009DFA]">TradeTres</span>!
        </h1>
        <p class="text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
          Diseñado para ayudarte a dominar tu disciplina, validar tus estrategias y escalar cuentas fondeadas. Configura tu perfil en 3 sencillos pasos.
        </p>
      </div>

      <button data-action="click->onboarding#next" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#009DFA] hover:bg-blue-600 text-white font-bold text-sm shadow-[0_0_25px_rgba(0,157,250,0.35)] transition-all flex items-center justify-center gap-2 group cursor-pointer">
        <span>Comenzar Configuración</span>
        <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </button>
    </div>

    <!-- STEP 1: INTENCIONES / OBJETIVOS -->
    <div data-onboarding-target="step" data-step="1" class="hidden flex-col space-y-6 my-auto transition-all duration-300">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1">¿Cuál es tu objetivo principal en TradeTres?</h2>
        <p class="text-xs text-slate-400">Selecciona una o más opciones según tus metas de trading.</p>
      </div>

      <div class="grid grid-cols-1 gap-3">
        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="checkbox" value="Prop Firms" data-onboarding-target="intention" data-action="change->onboarding#updateNextButton" class="w-5 h-5 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <div class="text-2xl group-hover:scale-110 transition-transform">🏦</div>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA] transition-colors">Prop Firms & Fondeo</h3>
            <p class="text-xs text-slate-400">Aprobar evaluaciones, monitorear drawdown y escalar cuentas fondeadas.</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="checkbox" value="Backtesting" data-onboarding-target="intention" data-action="change->onboarding#updateNextButton" class="w-5 h-5 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <div class="text-2xl group-hover:scale-110 transition-transform">📊</div>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA] transition-colors">Backtesting & Replay</h3>
            <p class="text-xs text-slate-400">Simular sesiones históricas vela a vela y calcular la esperanza matemática de mi sistema.</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="checkbox" value="Journal & Analytics" data-onboarding-target="intention" data-action="change->onboarding#updateNextButton" class="w-5 h-5 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <div class="text-2xl group-hover:scale-110 transition-transform">📓</div>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA] transition-colors">Diario de Operaciones (Journal)</h3>
            <p class="text-xs text-slate-400">Registrar ejecuciones en vivo, medir mi Win Rate y recibir consejos del AI Coach.</p>
          </div>
        </label>
      </div>

      <div class="flex justify-end pt-2">
        <button data-onboarding-target="nextButton" data-action="click->onboarding#next" disabled class="px-6 py-3 rounded-xl bg-gray-700 opacity-50 cursor-not-allowed text-white font-bold text-xs transition-all flex items-center gap-1">
          <span>Siguiente</span>
          <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- STEP 2: MERCADO PRINCIPAL -->
    <div data-onboarding-target="step" data-step="2" class="hidden flex-col space-y-6 my-auto transition-all duration-300">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1">¿En qué mercados operas habitualmente?</h2>
        <p class="text-xs text-slate-400">Elige los activos que más monitoreas en tus análisis.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-3 group">
          <input type="checkbox" value="Futuros" data-onboarding-target="market" data-action="change->onboarding#updateNextButton" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-xl">📈</span>
          <div>
            <h3 class="text-xs font-bold text-white group-hover:text-[#009DFA]">Futuros</h3>
            <p class="text-[10px] text-slate-400">NQ, ES, CL, Gold, YM</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-3 group">
          <input type="checkbox" value="Forex" data-onboarding-target="market" data-action="change->onboarding#updateNextButton" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-xl">💱</span>
          <div>
            <h3 class="text-xs font-bold text-white group-hover:text-[#009DFA]">Forex</h3>
            <p class="text-[10px] text-slate-400">EUR/USD, GBP/USD, USD/JPY</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-3 group">
          <input type="checkbox" value="Criptomonedas" data-onboarding-target="market" data-action="change->onboarding#updateNextButton" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-xl">🪙</span>
          <div>
            <h3 class="text-xs font-bold text-white group-hover:text-[#009DFA]">Criptomonedas</h3>
            <p class="text-[10px] text-slate-400">BTC, ETH, SOL, Futures</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-3 group">
          <input type="checkbox" value="Acciones & Opciones" data-onboarding-target="market" data-action="change->onboarding#updateNextButton" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-xl">📊</span>
          <div>
            <h3 class="text-xs font-bold text-white group-hover:text-[#009DFA]">Acciones & Opciones</h3>
            <p class="text-[10px] text-slate-400">NVDA, AAPL, SPY, QQQ</p>
          </div>
        </label>
      </div>

      <div class="flex justify-end pt-2">
        <button data-onboarding-target="nextButton" data-action="click->onboarding#next" disabled class="px-6 py-3 rounded-xl bg-gray-700 opacity-50 cursor-not-allowed text-white font-bold text-xs transition-all flex items-center gap-1">
          <span>Siguiente</span>
          <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- STEP 3: NIVEL DE EXPERIENCIA -->
    <div data-onboarding-target="step" data-step="3" class="hidden flex-col space-y-6 my-auto transition-all duration-300">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1">¿Cuál es tu nivel actual como trader?</h2>
        <p class="text-xs text-slate-400">Nos ayuda a personalizar los insights del AI Coach.</p>
      </div>

      <div class="grid grid-cols-1 gap-3">
        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="radio" name="trader_level" value="Principiante" data-onboarding-target="experience" data-action="change->onboarding#updateNextButton" class="w-4 h-4 border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-2xl">🌱</span>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA]">Principiante</h3>
            <p class="text-xs text-slate-400">Llevo menos de 1 año o estoy consolidando mi plan de trading.</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="radio" name="trader_level" value="Intermedio" data-onboarding-target="experience" data-action="change->onboarding#updateNextButton" class="w-4 h-4 border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-2xl">⚖️</span>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA]">Intermedio</h3>
            <p class="text-xs text-slate-400">Tengo estrategia definida y he operado cuentas de evaluación o reales.</p>
          </div>
        </label>

        <label class="p-4 rounded-2xl border border-slate-800 bg-slate-950/50 hover:border-[#009DFA]/60 hover:bg-[#009DFA]/5 transition-all cursor-pointer flex items-center gap-4 group">
          <input type="radio" name="trader_level" value="Avanzado" data-onboarding-target="experience" data-action="change->onboarding#updateNextButton" class="w-4 h-4 border-slate-700 bg-slate-900 text-[#009DFA] focus:ring-[#009DFA]">
          <span class="text-2xl">🏆</span>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-white group-hover:text-[#009DFA]">Avanzado / Rentable</h3>
            <p class="text-xs text-slate-400">Trader consistente gestionando cuentas fondeadas o capital propio.</p>
          </div>
        </label>
      </div>

      <div class="flex justify-end pt-2">
        <button data-onboarding-target="submitButton" data-action="click->onboarding#submit" disabled class="px-6 py-3 rounded-xl bg-gray-700 opacity-50 cursor-not-allowed text-white font-bold text-xs transition-all flex items-center gap-2">
          <span data-onboarding-target="submitText">Finalizar y Personalizar</span>
          <span data-onboarding-target="submitSpinner" class="hidden material-symbols-outlined animate-spin text-sm">sync</span>
        </button>
      </div>
    </div>

    <!-- STEP 4: CARGANDO / ENRUTAMIENTO -->
    <div data-onboarding-target="step" data-step="4" class="hidden flex-col items-center justify-center text-center space-y-4 my-auto transition-all duration-300">
      <span class="material-symbols-outlined animate-spin text-4xl text-[#009DFA]">sync</span>
      <h2 class="text-xl font-bold text-white">Configurando tu experiencia personalizada...</h2>
      <p class="text-xs text-slate-400">Guardando tus preferencias y preparando tus módulos de trading.</p>
    </div>

    <!-- STEP 5: SELECCIÓN FINAL DE MÓDULOS -->
    <div data-onboarding-target="step" data-step="5" class="hidden flex-col space-y-6 my-auto transition-all duration-300">
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-2xl flex items-center justify-center mx-auto">
          ✓
        </div>
        <h2 class="text-2xl font-extrabold text-white">¡Perfil configurado con éxito!</h2>
        <div data-onboarding-target="multipleSelectionList" class="text-xs text-slate-300 flex items-center justify-center flex-wrap pt-1"></div>
      </div>

      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 text-center">¿Por dónde deseas comenzar hoy?</p>
        <div data-onboarding-target="multipleSelectionOptions" class="space-y-2.5"></div>
      </div>
    </div>

  </div>
</div>
