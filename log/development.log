365:    
366:            <!-- THEME TOGGLE -->
367:            <button id="theme-toggle" onclick="toggleTheme()" class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all duration-200" title="Cambiar tema">
368:              <span class="toggle-sun material-symbols-outlined text-[18px] text-amber-500">light_mode</span>
369:              <span class="toggle-moon material-symbols-outlined text-[18px] text-brand-light">dark_mode</span>
370:            </button>
371:    
372:            <!-- PERFIL -->
373:            <%= link_to profile_path, class: "px-2 md:px-3 py-1.5 text-xs font-semibold dark:text-slate-300 text-slate-600 hover:text-brand dark:hover:text-brand-light rounded-xl hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all flex items-center gap-1.5" do %>
374:              <span class="material-symbols-outlined text-[16px]">person</span>
375:              <span class="hidden sm:inline">Perfil</span>
376:            <% end %>
377:    
378:            <!-- NUEVA OPERACIÓN -->
379:            <%= link_to new_trade_path, class: "px-3 py-1.5 text-xs font-bold bg-brand hover:bg-brand-hover text-white rounded-xl glow-brand transition-all flex items-center gap-1.5 animate-float" do %>
380:              <span class="material-symbols-outlined text-[16px]">add</span>
381:              <span class="hidden xs:inline">Nueva</span>
382:            <% end %>
383:    
384:            <!-- CERRAR SESIÓN -->
385:            <%= link_to destroy_user_session_path, class: "p-1.5 text-slate-400 hover:text-loss rounded-lg hover:bg-loss/10 transition-all cursor-pointer flex items-center gap-1 text-xs font-semibold", title: "Cerrar Sesión" do %>
386:              <span class="material-symbols-outlined text-[18px]">logout</span>
387:              <span class="hidden md:inline">Salir</span>
388:          </div>
389:        </header>
390:    
391:        <!-- PAGE CONTENT (CANVAS CON PROFUNDIDAD SUTIL EN DARK Y LIGHT) -->
392:        <div class="flex-1 overflow-y-auto p-4 md:p-6 content-canvas">
393:          <div class="min-h-full rounded-2xl content-inner p-4 md:p-6 border shadow-sm">
394:            <% if notice && notice != "Signed out successfully." && notice != "Signed in successfully." && !notice.include?("Cerró sesión") %><div class="mb-4 px-4 py-3 rounded-xl bg-profit/10 border border-profit/20 text-profit text-sm fade-in flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">check_circle</span><%= notice %></div><% end %>
395:            <% if alert  %><div class="mb-4 px-4 py-3 rounded-xl bg-loss/10 border border-loss/20 text-loss text-sm fade-in flex items-center gap-2"><span class="material-symbols-outlined text-[16px]">error</span><%= alert %></div><% end %>
396:            <%= yield %>
397:          </div>
398:        </div>
399:      </main>
400:    
401:      <!-- ===================== FLOATING AI ASSISTANT ===================== -->
402:      <div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2">
403:        <!-- MINI CHAT DRAWER -->
404:        <div id="ai-floating-chat" class="hidden w-80 sm:w-96 h-[460px] glass rounded-2xl border dark:border-darkBorder border-lightBorder shadow-2xl overflow-hidden transition-all duration-300 fade-in flex-col">
405:    
406:          <!-- HEADER -->
407:          <div class="p-3.5 dark:bg-darkCardAlt/95 bg-white/90 border-b dark:border-darkBorder border-lightBorder flex items-center justify-between flex-shrink-0">
408:            <div class="flex items-center gap-2.5">
409:              <div class="w-8 h-8 rounded-xl bg-brand flex items-center justify-center text-white text-sm shadow-md">
410:                <span class="material-symbols-outlined text-[18px]">smart_toy</span>
411:              </div>
412:              <div>
413:                <div class="flex items-center gap-1.5">
414:                  <h4 class="text-xs font-bold dark:text-white text-slate-800">AI Coach Assistant</h4>
415:                  <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
416:                </div>
417:                <p class="text-[10px] dark:text-slate-400 text-slate-500">Asistente en tiempo real</p>
418:              </div>
419:            </div>
420:            <div class="flex items-center gap-1">
421:              <%= link_to ai_coach_path, class: "p-1.5 dark:text-slate-400 text-slate-400 hover:text-brand rounded-lg hover:bg-brand/10 transition-all", title: "Vista Completa" do %>
422:                <span class="material-symbols-outlined text-[16px]">open_in_full</span>
423:              <% end %>
424:              <button onclick="closeFloatingCoach()" class="p-1.5 dark:text-slate-400 text-slate-400 hover:dark:text-white hover:text-brand rounded-lg hover:bg-brand/10 transition-all" title="Ocultar Chat">
425:                <span class="material-symbols-outlined text-[18px]">keyboard_arrow_down</span>
426:              </button>
427:            </div>
428:          </div>
429:    
430:          <!-- MESSAGES -->
431:          <div id="floating-chat-messages" class="flex-1 p-3 overflow-y-auto space-y-3 text-xs">
432:            <div class="flex gap-2 items-start">
433:              <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0">
434:                <span class="material-symbols-outlined text-[13px]">smart_toy</span>
435:              </div>
436:              <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">
437:                ¡Hola, <strong><%= current_user.name&.split&.first || "Trader" %></strong>! 👋 ¿Cómo puedo ayudarte hoy con tu disciplina, psicología o estrategia?
438:              </div>
439:            </div>
440:    
441:            <!-- QUICK CHIPS -->
442:            <div id="floating-quick-chips" class="flex flex-wrap gap-1.5 pt-1">
443:              <button onclick="sendQuickPrompt('¿Cómo está mi Win Rate esta semana?')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">📊 Mi Win Rate</button>
444:              <button onclick="sendQuickPrompt('Dame un consejo para controlar el FOMO')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">🧠 Evitar FOMO</button>
445:              <button onclick="sendQuickPrompt('¿Cómo evaluar mi relación Riesgo/Beneficio?')" class="text-[10px] px-2.5 py-1 rounded-full dark:bg-darkCard bg-slate-100 text-brand border border-brand/20 hover:bg-brand/10 transition-all">🎯 R:R Ratio</button>
446:            </div>
447:          </div>
448:    
449:          <!-- INPUT BAR -->
450:          <form onsubmit="handleFloatingChatSubmit(event)" class="p-2.5 border-t dark:border-darkBorder border-lightBorder dark:bg-darkBg bg-slate-50 flex gap-2 flex-shrink-0">
451:            <input id="floating-chat-input" type="text" placeholder="Escribe tu consulta..." class="flex-1 dark:bg-darkInput bg-white border dark:border-darkBorder border-lightBorder rounded-xl px-3 py-2 text-xs dark:text-white text-slate-800 focus:outline-none focus:border-brand" />
452:            <button type="submit" class="p-2 rounded-xl bg-brand hover:bg-brand-hover text-white font-bold transition-all glow-brand">
453:              <span class="material-symbols-outlined text-[16px]">send</span>
454:            </button>
455:          </form>
456:        </div>
457:    
458:        <!-- TRIGGER BUTTON -->
459:        <button onclick="toggleFloatingCoach()" class="px-3.5 py-2.5 rounded-2xl bg-brand text-white shadow-xl glow-brand hover:scale-105 active:scale-95 transition-all duration-200 flex items-center gap-2 font-bold text-xs group border border-brand-light/20">
460:          <span class="material-symbols-outlined text-[18px] group-hover:rotate-12 transition-transform">smart_toy</span>
461:          <span class="hidden sm:inline font-semibold">AI Coach</span>
462:          <span class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></span>
463:        </button>
464:      </div>
465:    
466:      <% else %>
467:      <!-- AUTH LAYOUT (sin sidebar) -->
468:      <div class="flex-1 overflow-y-auto">
469:        <% if notice && notice != "Signed out successfully." && notice != "Signed in successfully." && !notice.include?("Cerró sesión") %><div style="position:fixed;top:1rem;right:1rem;z-index:99;" class="px-4 py-3 rounded-xl bg-profit/10 border border-profit/20 text-profit text-sm fade-in"><%= notice %></div><% end %>
470:        <% if alert  %><div style="position:fixed;top:1rem;right:1rem;z-index:99;" class="px-4 py-3 rounded-xl bg-loss/10 border border-loss/20 text-loss text-sm fade-in"><%= alert %></div><% end %>
471:        <%= yield %>
472:      </div>
473:      <% end %>
474:    
475:    </body>
476:    <script>
477:      // ── THEME MANAGER ──
478:      // La detección inicial está en el <head> para evitar flash.
479:      // Aquí solo activamos las transiciones DESPUÉS del primer render.
480:      requestAnimationFrame(function() {
481:        requestAnimationFrame(function() {
482:          document.documentElement.classList.add('theme-ready');
483:        });
484:      });
485:    
486:      function toggleTheme() {
487:        const root = document.getElementById('html-root');
488:        const isDark = root.classList.contains('dark');
489:        if (isDark) {
490:          root.classList.remove('dark');
491:          localStorage.setItem('tj-theme', 'light');
492:        } else {
493:          root.classList.add('dark');
494:          localStorage.setItem('tj-theme', 'dark');
495:        }
496:      }
497:    
498:      // ── DESKTOP SIDEBAR TOGGLE & INITIALIZATION ──
499:      (function() {
500:        const isCollapsed = localStorage.getItem('tj-sidebar-collapsed') === 'true';
501:        if (isCollapsed) {
502:          const sidebar = document.getElementById('sidebar-container');
503:          const icon = document.getElementById('desktop-sidebar-icon');
504:          if (sidebar) sidebar.classList.add('collapsed');
505:          if (icon) icon.textContent = 'menu';
506:        }
507:      })();
508:    
509:      function toggleDesktopSidebar() {
510:        const sidebar = document.getElementById('sidebar-container');
511:        const icon = document.getElementById('desktop-sidebar-icon');
512:        if (!sidebar) return;
513:        sidebar.classList.toggle('collapsed');
514:        const nowCollapsed = sidebar.classList.contains('collapsed');
515:        localStorage.setItem('tj-sidebar-collapsed', nowCollapsed ? 'true' : 'false');
516:        if (icon) {
517:          icon.textContent = nowCollapsed ? 'menu' : 'menu_open';
518:        }
519:      }
520:    
521:      // ── MOBILE SIDEBAR ──
522:      function toggleMobileSidebar() {
523:        const sidebar = document.getElementById('sidebar-container');
524:        const backdrop = document.getElementById('mobile-sidebar-backdrop');
525:        if (!sidebar || !backdrop) return;
526:        const isOpen = !sidebar.classList.contains('-translate-x-full');
527:        if (isOpen) {
528:          sidebar.classList.add('-translate-x-full');
529:          backdrop.classList.add('hidden');
530:        } else {
531:          sidebar.classList.remove('-translate-x-full');
532:          backdrop.classList.remove('hidden');
533:        }
534:      }
535:    
536:      // ── FLOATING AI COACH ──
537:      function toggleFloatingCoach() {
538:        const chat = document.getElementById('ai-floating-chat');
539:        if (!chat) return;
540:        const isHidden = chat.classList.contains('hidden') || chat.style.display === 'none';
541:        if (isHidden) {
542:          chat.classList.remove('hidden');
543:          chat.style.display = 'flex';
544:          const input = document.getElementById('floating-chat-input');
545:          if (input) input.focus();
546:        } else {
547:          chat.classList.add('hidden');
548:          chat.style.display = 'none';
549:        }
550:      }
551:    
552:      function closeFloatingCoach() {
553:        const chat = document.getElementById('ai-floating-chat');
554:        if (chat) {
555:          chat.classList.add('hidden');
556:          chat.style.display = 'none';
557:        }
558:      }
559:    
560:      function sendQuickPrompt(promptText) {
561:        const input = document.getElementById('floating-chat-input');
562:        if (input) {
563:          input.value = promptText;
564:          handleFloatingChatSubmit(new Event('submit'));
565:        }
566:      }
567:    
568:      async function handleFloatingChatSubmit(e) {
569:        e.preventDefault();
570:        const input = document.getElementById('floating-chat-input');
571:        const msg = input.value.trim();
572:        if (!msg) return;
573:        const container = document.getElementById('floating-chat-messages');
574:        const chips = document.getElementById('floating-quick-chips');
575:        if (chips) chips.remove();
576:    
577:        container.innerHTML += `
578:          <div class="flex gap-2 items-start justify-end">
579:            <div class="p-2.5 rounded-2xl rounded-tr-none bg-brand text-white max-w-[80%]">${msg}</div>
580:          </div>`;
581:    
582:        const typingId = 'typing-' + Date.now();
583:        container.innerHTML += `
584:          <div id="${typingId}" class="flex gap-2 items-start">
585:            <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
586:            <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 text-slate-400 text-[11px] animate-pulse">Analizando tu consulta...</div>
587:          </div>`;
588:        input.value = '';
589:        container.scrollTop = container.scrollHeight;
590:    
591:        try {
592:          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
593:          const res = await fetch('/ai_coach/chat', {
594:            method: 'POST',
595:            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
596:            body: JSON.stringify({ message: msg })
597:          });
598:          const data = await res.json();
599:          document.getElementById(typingId)?.remove();
600:          container.innerHTML += `
601:            <div class="flex gap-2 items-start fade-in">
602:              <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
603:              <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">${data.message.replace(/\n/g, '<br>')}</div>
604:            </div>`;
605:        } catch (err) {
606:          document.getElementById(typingId)?.remove();
607:          container.innerHTML += `<div class="text-loss text-[10px] text-center">Error al conectar con el AI Coach.</div>`;
608:        }
609:        container.scrollTop = container.scrollHeight;
610:      }
611:    </script>
612:    </html>
  
