98:                      when /take profit/ then "compañias/take profit trader.png"
99:                      else nil
100:                      end
101:                    %>
102:                    <% if logo_file %>
103:                      <div class="w-10 h-10 rounded-xl bg-white p-1 border border-slate-200 flex items-center justify-center shadow-xs flex-shrink-0">
104:                        <%= image_tag logo_file, class: "max-h-full max-w-full object-contain" %>
105:                      </div>
106:                    <% else %>
107:                      <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center flex-shrink-0 font-bold text-sm border border-brand/20">
108:                        <%= acc.firm_name.to_s.first(2).upcase %>
109:                      </div>
110:                    <% end %>
111:                    <div>
112:                      <h3 class="text-sm font-black dark:text-white text-slate-900 group-hover:text-brand transition-colors"><%= acc.name %></h3>
113:                      <span class="text-[10px] font-mono text-slate-400 font-bold"><%= acc.firm_name %> • <%= acc.account_size %></span>
114:                    </div>
115:                  </div>
116:    
117:                  <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider bg-brand/15 text-brand border border-brand/20">
118:                    <%= acc.phase.gsub('_', ' ').upcase %>
119:                  </span>
120:                </div>
121:    
122:                <div class="space-y-2 text-xs border-t dark:border-darkBorder border-slate-200 pt-3 font-mono">
123:                  <div class="flex justify-between items-center text-slate-400">
124:                    <span>Cuota Evaluación:</span>
125:                    <span class="font-bold dark:text-slate-200 text-slate-800">$<%= acc.eval_fee %></span>
126:                  </div>
127:                  <div class="flex justify-between items-center text-slate-400">
128:                    <span>Cuota Activación:</span>
129:                    <span class="font-bold dark:text-slate-200 text-slate-800">$<%= acc.activation_fee %></span>
130:                  </div>
131:                </div>
132:    
133:                <div class="flex items-center justify-end gap-2 pt-2 border-t dark:border-darkBorder border-slate-200">
134:                  <%= link_to prop_firm_account_path(acc), class: "p-1.5 px-3 rounded-xl bg-brand/10 text-brand hover:bg-brand hover:text-white transition-all flex items-center gap-1 text-xs font-bold" do %>
135:                    <span class="material-symbols-outlined text-[16px]">visibility</span>
136:                    <span>Ver Detalle</span>
137:                  <% end %>
138:                  <%= link_to edit_prop_firm_account_path(acc), class: "p-1.5 rounded-lg text-slate-400 hover:text-brand hover:bg-brand/10 transition-colors" do %>
139:                    <span class="material-symbols-outlined text-[16px]">edit</span>
140:                  <% end %>
141:                  <%= button_to prop_firm_account_path(acc), method: :delete, data: { turbo_confirm: "¿Borrar esta cuenta?" }, class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 transition-colors" do %>
142:                    <span class="material-symbols-outlined text-[16px]">delete</span>
143:                  <% end %>
144:                </div>
145:    
146:              </div>
147:            <% end %>
148:          </div>
149:        <% else %>
150:          <!-- EMPTY STATE CON INTRO GUIADA -->
151:          <div class="glass rounded-3xl p-8 md:p-12 text-center max-w-xl mx-auto space-y-5 border border-slate-200 dark:border-darkBorder shadow-sm">
152:            <div class="w-16 h-16 rounded-3xl bg-brand/10 text-brand flex items-center justify-center mx-auto border border-brand/20 shadow-inner">
153:              <span class="material-symbols-outlined text-[34px]">verified</span>
154:            </div>
155:            
156:            <div>
157:              <h3 class="text-lg font-black dark:text-white text-slate-900">Aún no tienes cuentas de fondeo incorporadas</h3>
158:              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">
159:                Inicia el onboarding en 3 pasos para elegir tu firma de fondeo (Apex, Topstep, FTMO), o configura una cuenta manual con tus propias reglas de gestión de riesgo.
160:              </p>
161:            </div>
162:    
163:            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
164:              <%= link_to new_prop_firm_account_path, class: "w-full sm:w-auto px-6 py-3 bg-brand hover:scale-[1.02] text-white font-extrabold text-xs rounded-xl shadow-lg glow-brand transition-all inline-flex items-center justify-center gap-2" do %>
165:                <span class="material-symbols-outlined text-[18px]">add_circle</span>
166:                <span>Iniciar Onboarding (Paso a Paso)</span>
167:              <% end %>
168:    
169:              <%= link_to pro_tools_path(tab: 'prop'), class: "w-full sm:w-auto px-5 py-3 bg-slate-100 dark:bg-darkCard hover:bg-slate-200 dark:hover:bg-darkHover text-slate-700 dark:text-slate-300 font-bold text-xs rounded-xl border border-slate-200 dark:border-darkBorder transition-all inline-flex items-center justify-center gap-1.5" do %>
170:                <span class="material-symbols-outlined text-[18px]">account_balance</span>
171:                <span>Ver Tracker Contable</span>
172:              <% end %>
173:            </div>
174:          </div>
175:        <% endif %>
176:      </div>
177:    
178:    </div>
  
