136:                <div class="pt-2">
137:                  <%= link_to new_user_session_path, class: "w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-brand to-violet-600 hover:from-brand-hover hover:to-violet-700 text-white font-extrabold text-xs shadow-lg flex items-center justify-center gap-2 cursor-pointer" do %>
138:                    <span>Ingresar a mi Cuenta Pro</span>
139:                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
140:                  <% end %>
