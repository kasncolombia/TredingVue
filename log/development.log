197:        @keyframes pulse-glow { 0%,100% { box-shadow:0 0 8px rgba(108,92,231,.3); } 50% { box-shadow:0 0 22px rgba(108,92,231,.65); } }
198:        @keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-3px); } }
199:        .animate-float { animation: float 3s ease-in-out infinite; }
200:    
201:        @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
202:        .animate-shimmer { background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); background-size: 200% 100%; animation: shimmer 2s infinite; }
203:    
204:        /* ──────────────────────────────────────────
205:           GLOW BRAND BUTTON
206:        ────────────────────────────────────────── */
207:        .glow-brand { box-shadow: 0 8px 30px -6px rgba(108,92,231,.55); }
208:        .glow-brand:hover { box-shadow: 0 10px 36px -6px rgba(108,92,231,.75); }
209:    
210:        /* ──────────────────────────────────────────
211:           BADGE PILL
212:        ────────────────────────────────────────── */
213:        .badge-win  { background: rgba(16,185,129,.12); color: #10B981; border: 1px solid rgba(16,185,129,.25); }
214:        .badge-loss { background: rgba(244,63,94,.12);  color: #F43F5E; border: 1px solid rgba(244,63,94,.25); }
215:        .badge-long { background: rgba(16,185,129,.1);  color: #10B981; }
216:        .badge-short{ background: rgba(244,63,94,.1);   color: #F43F5E; }
217:    
218:        /* ──────────────────────────────────────────
219:           FLOATING AI WIDGET
220:        ────────────────────────────────────────── */
221:      </style>
222:    
223:      <%= csrf_meta_tags %>
224:    </head>
225:    <body class="flex h-screen overflow-hidden antialiased">
226:    
227:      <% if user_signed_in? %>
228:    
229:      <!-- MOBILE BACKDROP -->
230:      <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>
231:    
232:      <!-- ===================== SIDEBAR ===================== -->
233:      <aside id="sidebar-container" class="w-64 sidebar-bg flex flex-col justify-between flex-shrink-0 transition-all duration-300 transform -translate-x-full md:translate-x-0 fixed md:static inset-y-0 left-0 z-40">
234:        <div class="overflow-y-auto overflow-x-hidden flex flex-col h-full">
235:    
236:          <!-- LOGO -->
237:          <div class="h-14 flex items-center justify-between px-4 border-b dark:border-darkBorder border-lightBorder flex-shrink-0">
238:            <div class="flex items-center gap-3">
239:              <div id="sidebar-logo-icon" class="w-8 h-8 rounded-xl bg-brand flex items-center justify-center shadow-lg flex-shrink-0" style="animation: pulse-glow 3s infinite;">
240:                <span class="material-symbols-outlined text-white text-[18px]">monitoring</span>
241:              </div>
242:              <div class="sidebar-text-hide">
243:                <p class="font-extrabold text-sm leading-none dark:text-white text-slate-900 tracking-tight">Coach<span class="text-brand">Trading</span></p>
244:                <p class="text-[10px] font-bold uppercase tracking-wider mt-0.5 dark:text-brand-light text-brand">PRO</p>
245:              </div>
246:            </div>
247:            <!-- CLOSE mobile -->
248:            <button onclick="toggleMobileSidebar()" class="md:hidden flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-200/70 dark:bg-darkCardAlt text-slate-600 dark:text-slate-300 hover:text-rose-500 transition-all border dark:border-darkBorder border-slate-300">
249:              <span>Cerrar</span>
250:              <span class="material-symbols-outlined text-[15px]">close</span>
251:            </button>
252:          </div>
253:    
254:          <!-- NAVIGATION -->
255:          <nav class="p-2.5 space-y-0.5 mt-1 flex-1">
256:            <% nav_items = [
257:              { label: "Dashboard",    path: dashboard_path,             icon: "dashboard" },
258:              { label: "Perfil",       path: profile_path,               icon: "person" },
259:              { label: "Comunidad",    path: community_feed_index_path,  icon: "forum" },
260:              { label: "Operaciones",  path: trades_path,                icon: "swap_horiz", count: current_user.trades.count },
261:              { label: "Importar CSV", path: import_trades_path,         icon: "file_upload" },
262:              { label: "Calendario",   path: calendar_path,              icon: "calendar_month" },
263:              { label: "Analytics",    path: analytics_path,             icon: "monitoring" },
264:              { label: "AI Coach",     path: ai_coach_path,              icon: "smart_toy" },
