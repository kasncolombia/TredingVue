317:            </button>
318:    
319:            <!-- DESKTOP TOGGLE SIDEBAR BUTTON -->
320:            <button onclick="toggleDesktopSidebar()" class="hidden md:flex items-center justify-center p-1.5 rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 dark:hover:bg-darkHover transition-all cursor-pointer border border-transparent hover:border-brand/20" title="Colapsar/Expandir Menú Sidebar">
321:              <span id="desktop-sidebar-icon" class="material-symbols-outlined text-[20px]">menu_open</span>
