297:                <% end %>
298:              </div>
299:              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "p-1.5 dark:text-slate-400 text-slate-400 hover:text-loss rounded-lg transition-all cursor-pointer ml-auto sidebar-text-hide", title: "Cerrar Sesión" do %>
300:                <span class="material-symbols-outlined text-[18px]">logout</span>
