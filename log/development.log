169:    <script>
170:      function showDayDetails(dateStr, trades) {
171:        const modal = document.getElementById('day-modal');
172:        const title = document.getElementById('modal-date-title');
173:        const subtitle = document.getElementById('modal-date-subtitle');
174:        const list = document.getElementById('modal-trades-list');
175:    
176:        title.innerText = `Operaciones del ` + dateStr;
177:        
178:        if (!trades || trades.length === 0) {
179:          subtitle.innerText = "No se ejecutaron trades en esta fecha.";
180:          list.innerHTML = `
181:            <div class="text-center py-8 text-xs text-slate-400">
182:              <p>Sin actividad de trading registrada.</p>
183:            </div>
184:          `;
185:        } else {
186:          const totalPnL = trades.reduce((acc, t) => acc + parseFloat(t.pnl || 0), 0);
187:          subtitle.innerText = `${trades.length} operaciones | P&L Día: ${totalPnL >= 0 ? '+' : ''}$${totalPnL.toFixed(2)}`;
188:    
189:          list.innerHTML = trades.map(t => {
190:            const pnl = parseFloat(t.pnl || 0);
191:            const isWin = pnl >= 0;
192:            return `
193:              <div class="p-3 rounded-xl bg-slate-50 dark:bg-darkBg border border-slate-200 dark:border-darkBorder flex items-center justify-between">
194:                <div>
195:                  <div class="flex items-center gap-2">
196:                    <span class="font-black text-sm text-slate-800 dark:text-white">${t.symbol}</span>
197:                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold ${t.direction === 'LONG' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'}">${t.direction}</span>
198:                  </div>
199:                  <p class="text-[11px] text-slate-400 mt-0.5">Estrategia: ${t.strategy ? t.strategy.name : '—'}</p>
200:                </div>
201:                <div class="text-right">
202:                  <p class="font-black text-sm ${isWin ? 'text-emerald-500' : 'text-rose-500'}">
203:                    ${isWin ? '+' : ''}$${pnl.toFixed(2)}
204:                  </p>
205:                  <span class="text-[10px] text-slate-400">${t.r_multiple || 0}R</span>
206:                </div>
207:              </div>
208:            `;
209:          }).join('');
210:        }
211:    
212:        modal.classList.remove('hidden');
213:      }
214:    
215:      function closeDayModal() {
216:        document.getElementById('day-modal').classList.add('hidden');
217:      }
218:    </script>
  
