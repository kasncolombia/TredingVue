341:              <button type="button" class="relative w-8 h-8 md:w-9 md:h-9 flex items-center justify-center rounded-xl dark:text-slate-400 text-slate-500 hover:bg-brand/10 border border-transparent hover:border-brand/20 dark:hover:border-darkBorder transition-all duration-200" title="Notificaciones" onclick="document.getElementById('notif-panel').classList.toggle('hidden')">
342:                <span class="material-symbols-outlined text-[20px]">notifications</span>
343:                <%= render partial: "notifications/counter", locals: { count: current_user.notifications.unread.count } %>
344:              </button>
345:    
346:              <!-- Dropdown Panel Solid UI -->
347:              <div id="notif-panel" class="hidden absolute right-0 top-full mt-2 w-[340px] sm:w-[400px] dark:bg-[#141729] bg-white rounded-2xl border dark:border-[#23263A] border-slate-200 shadow-2xl z-50 overflow-hidden fade-in">
348:                <div class="p-3.5 border-b dark:border-[#23263A] border-slate-100 flex items-center justify-between dark:bg-[#1A1D2D] bg-slate-50">
349:                  <h4 class="text-xs font-extrabold uppercase tracking-wider dark:text-white text-slate-900 flex items-center gap-1.5">
350:                    <span class="material-symbols-outlined text-[16px] text-brand">notifications</span>
351:                    Alertas y Notificaciones
352:                  </h4>
353:                  <%= button_to "Marcar todas leídas", mark_all_read_notifications_path, method: :patch, class: "text-[10px] text-brand hover:text-brand-hover font-extrabold bg-transparent border-none cursor-pointer uppercase tracking-wider" %>
354:                </div>
355:                <div id="notifications_list" class="max-h-80 overflow-y-auto dark:bg-[#141729] bg-white flex flex-col divide-y dark:divide-[#1E2235] divide-slate-100">
356:                  <% current_user.notifications.recent.limit(20).each do |n| %>
357:                    <%= render partial: "notifications/notification", locals: { notification: n } %>
358:                  <% end %>
359:                  <% if current_user.notifications.empty? %>
360:                    <p class="text-xs text-slate-500 text-center py-8" id="empty-notifications">No tienes notificaciones recientes.</p>
361:                  <% end %>
362:                </div>
363:              </div>
