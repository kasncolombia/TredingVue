476:    <script>
477:      // ── THEME MANAGER ──
478:      // La detección inicial está en el <head> para evitar flash.
479:      // Aquí solo activamos las transiciones DESPUÉS del primer render.
480:      requestAnimationFrame(function() {
481:        requestAnimationFrame(function() {
482:          document.documentElement.classList.add('theme-ready');
483:        });
484:      });
485:    
486:      function toggleTheme() {
487:        const root = document.getElementById('html-root');
488:        const isDark = root.classList.contains('dark');
489:        if (isDark) {
490:          root.classList.remove('dark');
491:          localStorage.setItem('tj-theme', 'light');
492:        } else {
493:          root.classList.add('dark');
494:          localStorage.setItem('tj-theme', 'dark');
495:        }
496:      }
497:    
498:      // ── DESKTOP SIDEBAR TOGGLE & INITIALIZATION ──
499:      (function() {
500:        const isCollapsed = localStorage.getItem('tj-sidebar-collapsed') === 'true';
501:        if (isCollapsed) {
502:          const sidebar = document.getElementById('sidebar-container');
503:          const icon = document.getElementById('desktop-sidebar-icon');
504:          if (sidebar) sidebar.classList.add('collapsed');
505:          if (icon) icon.textContent = 'menu';
506:        }
507:      })();
508:    
509:      function toggleDesktopSidebar() {
510:        const sidebar = document.getElementById('sidebar-container');
511:        const icon = document.getElementById('desktop-sidebar-icon');
512:        if (!sidebar) return;
513:        sidebar.classList.toggle('collapsed');
514:        const nowCollapsed = sidebar.classList.contains('collapsed');
515:        localStorage.setItem('tj-sidebar-collapsed', nowCollapsed ? 'true' : 'false');
516:        if (icon) {
517:          icon.textContent = nowCollapsed ? 'menu' : 'menu_open';
518:        }
519:      }
520:    
521:      // ── MOBILE SIDEBAR ──
522:      function toggleMobileSidebar() {
523:        const sidebar = document.getElementById('sidebar-container');
524:        const backdrop = document.getElementById('mobile-sidebar-backdrop');
525:        if (!sidebar || !backdrop) return;
526:        const isOpen = !sidebar.classList.contains('-translate-x-full');
527:        if (isOpen) {
528:          sidebar.classList.add('-translate-x-full');
529:          backdrop.classList.add('hidden');
530:        } else {
531:          sidebar.classList.remove('-translate-x-full');
532:          backdrop.classList.remove('hidden');
533:        }
534:      }
535:    
536:      // ── FLOATING AI COACH ──
537:      function toggleFloatingCoach() {
538:        const chat = document.getElementById('ai-floating-chat');
539:        if (!chat) return;
540:        const isHidden = chat.classList.contains('hidden') || chat.style.display === 'none';
541:        if (isHidden) {
542:          chat.classList.remove('hidden');
543:          chat.style.display = 'flex';
544:          const input = document.getElementById('floating-chat-input');
545:          if (input) input.focus();
546:        } else {
547:          chat.classList.add('hidden');
548:          chat.style.display = 'none';
549:        }
550:      }
551:    
552:      function closeFloatingCoach() {
553:        const chat = document.getElementById('ai-floating-chat');
554:        if (chat) {
555:          chat.classList.add('hidden');
556:          chat.style.display = 'none';
557:        }
558:      }
559:    
560:      function sendQuickPrompt(promptText) {
561:        const input = document.getElementById('floating-chat-input');
562:        if (input) {
563:          input.value = promptText;
564:          handleFloatingChatSubmit(new Event('submit'));
565:        }
566:      }
567:    
568:      async function handleFloatingChatSubmit(e) {
569:        e.preventDefault();
570:        const input = document.getElementById('floating-chat-input');
571:        const msg = input.value.trim();
572:        if (!msg) return;
573:        const container = document.getElementById('floating-chat-messages');
574:        const chips = document.getElementById('floating-quick-chips');
575:        if (chips) chips.remove();
576:    
577:        container.innerHTML += `
578:          <div class="flex gap-2 items-start justify-end">
579:            <div class="p-2.5 rounded-2xl rounded-tr-none bg-brand text-white max-w-[80%]">${msg}</div>
580:          </div>`;
581:    
582:        const typingId = 'typing-' + Date.now();
583:        container.innerHTML += `
584:          <div id="${typingId}" class="flex gap-2 items-start">
585:            <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
586:            <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 text-slate-400 text-[11px] animate-pulse">Analizando tu consulta...</div>
587:          </div>`;
588:        input.value = '';
589:        container.scrollTop = container.scrollHeight;
590:    
591:        try {
592:          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
593:          const res = await fetch('/ai_coach/chat', {
594:            method: 'POST',
595:            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
596:            body: JSON.stringify({ message: msg })
597:          });
598:          const data = await res.json();
599:          document.getElementById(typingId)?.remove();
600:          container.innerHTML += `
601:            <div class="flex gap-2 items-start fade-in">
602:              <div class="w-6 h-6 rounded-lg bg-brand flex items-center justify-center text-white text-[10px] flex-shrink-0"><span class="material-symbols-outlined text-[13px]">smart_toy</span></div>
603:              <div class="p-2.5 rounded-2xl rounded-tl-none bg-brand/10 border border-brand/20 dark:text-slate-200 text-slate-700">${data.message.replace(/\n/g, '<br>')}</div>
604:            </div>`;
605:        } catch (err) {
606:          document.getElementById(typingId)?.remove();
607:          container.innerHTML += `<div class="text-loss text-[10px] text-center">Error al conectar con el AI Coach.</div>`;
608:        }
609:        container.scrollTop = container.scrollHeight;
610:      }
611:    </script>
612:    </html>
  
