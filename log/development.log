5:      <div class="absolute inset-0 dark:bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
6:      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-brand/20 rounded-full blur-[140px] pointer-events-none"></div>
7:      <div class="absolute top-1/2 -left-40 w-[450px] h-[450px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none"></div>
8:    
9:      <!-- NAVIGATION HEADER -->
10:      <header class="w-full max-w-7xl mx-auto flex items-center justify-between py-6 px-4 sm:px-6 lg:px-8 z-30 relative">
11:        <div class="flex items-center gap-3">
12:          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand to-violet-600 flex items-center justify-center text-white shadow-xl shadow-brand/25 border border-white/10">
13:            <span class="material-symbols-outlined text-[24px]">monitoring</span>
14:          </div>
15:          <div class="leading-none">
16:            <span class="font-black text-2xl tracking-tight dark:text-white text-slate-900">Coach<span class="bg-gradient-to-r from-brand via-violet-500 to-emerald-500 bg-clip-text text-transparent">Trading</span></span>
17:            <span class="ml-2 inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-brand/15 text-brand border border-brand/30 align-top shadow-sm">PLATFORM</span>
18:          </div>
19:        </div>
20:    
21:        <!-- HEADER RIGHT ACTIONS -->
22:        <div class="flex items-center gap-3 sm:gap-4">
23:          <!-- THEME TOGGLE -->
24:          <button onclick="toggleTheme()" type="button" class="w-10 h-10 rounded-2xl dark:bg-slate-900/80 bg-white border dark:border-slate-800 border-slate-200 flex items-center justify-center dark:text-amber-400 text-slate-700 hover:border-brand/40 transition-all shadow-sm group" title="Cambiar Tema">
25:            <span class="material-symbols-outlined text-[20px] dark:hidden">dark_mode</span>
26:            <span class="material-symbols-outlined text-[20px] hidden dark:block text-amber-400">light_mode</span>
27:          </button>
28:    
29:          <% if user_signed_in? %>
30:            <%= link_to dashboard_path, class: "px-5 py-2.5 rounded-2xl bg-brand text-white font-extrabold text-xs shadow-lg shadow-brand/25 hover:bg-brand-hover transition-all flex items-center gap-2" do %>
31:              <span>Ir a la Plataforma</span>
32:              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
33:            <% end %>
34:          <% else %>
35:            <%= link_to new_user_session_path, class: "px-4 py-2 text-xs font-extrabold text-slate-700 dark:text-slate-200 hover:text-brand transition-colors hidden sm:block" do %>
36:              Iniciar Sesión
37:            <%= end rescue nil %>
38:            <%= link_to new_user_registration_path, class: "px-5 py-2.5 rounded-2xl bg-gradient-to-r from-brand to-violet-600 hover:from-brand-hover hover:to-violet-700 text-white font-extrabold text-xs shadow-xl shadow-brand/25 transition-all flex items-center gap-1.5" do %>
39:              <span>Registrarse Gratis</span>
40:              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
41:            <% end %>
42:          <% end %>
43:        </div>
44:      </header>
45:    
46:      <!-- HERO SECTION -->
47:      <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 relative z-20 flex flex-col justify-center">
48:        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
49:          
50:          <!-- HERO TEXT & CTA -->
51:          <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
52:            
53:            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full dark:bg-slate-900/90 bg-white/90 border border-brand/30 text-brand dark:text-brand-light text-xs font-extrabold backdrop-blur-xl shadow-md">
54:              <span class="material-symbols-outlined text-emerald-500 text-[18px]">smart_toy</span>
55:              <span>Potenciado con Inteligencia Artificial Institucional</span>
56:            </div>
57:    
58:            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight dark:text-white text-slate-900 leading-[1.12]">
59:              El Diario de Trading <br/>
60:              <span class="bg-gradient-to-r from-brand via-violet-500 to-emerald-500 bg-clip-text text-transparent">que audita tu mente y capital.</span>
61:            </h1>
62:    
63:            <p class="text-base sm:text-lg dark:text-slate-400 text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
64:              Registra tus operaciones, analiza tu curva de equidad en tiempo real y recibe retroalimentación inmediata de tu <strong class="text-brand dark:text-brand-light">AI Coach personal</strong> para eliminar errores emocionales.
65:            </p>
66:    
67:            <!-- CTA BUTTONS -->
68:            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
69:              <%= link_to new_user_session_path, class: "w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-brand to-violet-600 hover:from-brand-hover hover:to-violet-700 text-white font-black text-sm shadow-xl shadow-brand/30 transition-all flex items-center justify-center gap-2.5 cursor-pointer group" do %>
70:                <span>Ingresar a la Plataforma</span>
71:                <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">login</span>
72:              <% end %>
73:    
74:              <%= link_to new_user_registration_path, class: "w-full sm:w-auto px-8 py-4 rounded-2xl dark:bg-slate-900/90 bg-white border dark:border-slate-800 border-slate-300 dark:text-slate-200 text-slate-800 font-extrabold text-sm shadow-lg hover:border-brand/50 transition-all flex items-center justify-center gap-2" do %>
75:                <span class="material-symbols-outlined text-emerald-500 text-[20px]">person_add</span>
76:                <span>Crear Cuenta Gratis</span>
77:              <% end %>
78:            </div>
79:    
80:            <!-- STATS TICKER -->
81:            <div class="grid grid-cols-3 gap-4 pt-6 border-t dark:border-slate-800/80 border-slate-200/80 max-w-lg mx-auto lg:mx-0">
82:              <div>
83:                <p class="text-2xl sm:text-3xl font-black dark:text-white text-slate-900 font-mono">+2,400</p>
84:                <p class="text-xs text-slate-400 font-medium">Traders Activos</p>
85:              </div>
86:              <div>
87:                <p class="text-2xl sm:text-3xl font-black text-emerald-500 font-mono">68.4%</p>
88:                <p class="text-xs text-slate-400 font-medium">Win Rate Promedio</p>
89:              </div>
90:              <div>
91:                <p class="text-2xl sm:text-3xl font-black text-violet-500 font-mono">24/7</p>
92:                <p class="text-xs text-slate-400 font-medium">Asistencia IA</p>
93:              </div>
94:            </div>
95:    
96:          </div>
97:    
98:          <!-- HERO PREVIEW CARD / DASHBOARD MOCK -->
99:          <div class="lg:col-span-5 relative">
100:            <div class="dark:bg-slate-900/90 bg-white/90 border dark:border-slate-800 border-slate-200 rounded-3xl p-6 shadow-2xl backdrop-blur-2xl relative overflow-hidden space-y-5 border-t-2 border-t-brand/50">
101:              
102:              <div class="flex items-center justify-between pb-3 border-b dark:border-slate-800 border-slate-200">
103:                <div class="flex items-center gap-2.5">
104:                  <span class="w-3 h-3 rounded-full bg-rose-500"></span>
105:                  <span class="w-3 h-3 rounded-full bg-amber-500"></span>
106:                  <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
107:                  <span class="text-xs font-bold font-mono text-slate-400 ml-2">coachtrading.app/dashboard</span>
108:                </div>
109:                <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">MERCADO EN VIVO</span>
110:              </div>
111:    
112:              <!-- MOCK CHART CARDS -->
113:              <div class="space-y-3">
114:                <div class="p-4 rounded-2xl dark:bg-slate-950 bg-slate-100 border dark:border-slate-800 border-slate-200 flex items-center justify-between">
115:                  <div>
116:                    <p class="text-xs text-slate-400 font-medium">Balance Total de la Cuenta</p>
117:                    <p class="text-xl font-black font-mono dark:text-white text-slate-900">$24,850.50</p>
118:                  </div>
119:                  <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-500 font-mono">+14.2% este mes</span>
120:                </div>
121:    
122:                <!-- AI COACH MESSAGE MOCK -->
123:                <div class="p-4 rounded-2xl bg-brand/10 border border-brand/30 flex gap-3 items-start">
124:                  <div class="w-8 h-8 rounded-xl bg-brand text-white flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-md">
125:                    🤖
126:                  </div>
127:                  <div class="text-xs space-y-1">
128:                    <p class="font-extrabold text-brand dark:text-brand-light">Análisis del AI Coach</p>
129:                    <p class="dark:text-slate-300 text-slate-700 leading-relaxed font-normal">
130:                      "Tu efectividad en el activo NQ_F supera el 72% cuando operas en la sesión de Nueva York. Evita el overtrading en la apertura."
131:                    </p>
