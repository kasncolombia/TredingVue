77:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
78:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
79:                  </svg>
80:                </div>
81:                <%= f.password_field :current_password, autocomplete: "current-password",
82:                    placeholder: "••••••••",
83:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
84:              </div>
85:            </div>
86:    
87:            <!-- NUEVA CONTRASEÑA -->
88:            <div>
89:              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Nueva contraseña <span class="text-slate-400 font-normal">(dejar vacío si no deseas cambiar)</span></label>
90:              <div class="relative">
91:                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
92:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
93:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
94:                  </svg>
95:                </div>
96:                <%= f.password_field :password, autocomplete: "new-password",
97:                    placeholder: "Mínimo 8 caracteres",
98:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
99:              </div>
100:            </div>
101:    
102:            <!-- CONFIRMAR CONTRASEÑA -->
103:            <div>
104:              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Confirmar nueva contraseña</label>
105:              <div class="relative">
106:                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
107:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
108:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
109:                  </svg>
110:                </div>
111:                <%= f.password_field :password_confirmation, autocomplete: "new-password",
112:                    placeholder: "Repite tu contraseña",
113:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
114:              </div>
115:            </div>
116:    
117:            <!-- ZONA HORARIA -->
118:            <div>
119:              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Zona horaria</label>
120:              <div class="relative">
121:                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
122:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
123:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
124:                  </svg>
125:                </div>
126:                <%= f.select :timezone, options_for_select([
127:                  ["UTC", "UTC"],
128:                  ["America/New_York", "Eastern (ET)"],
129:                  ["America/Chicago", "Central (CT)"],
130:                  ["America/Denver", "Mountain (MT)"],
131:                  ["America/Los_Angeles", "Pacific (PT)"],
132:                  ["America/Mexico_City", "Mexico City"],
133:                  ["Europe/Madrid", "Madrid"],
134:                  ["Europe/Paris", "París"],
135:                  ["Asia/Tokyo", "Tokio"],
136:                  ["Asia/Singapore", "Singapur"]
137:                ], selected: current_user.timezone,
138:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
139:              </div>
140:            </div>
141:    
142:            <!-- CAPITAL INICIAL -->
143:            <div>
144:              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Capital inicial ($)</label>
145:              <div class="relative">
146:                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
147:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
148:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
149:                  </svg>
150:                </div>
151:                <%= f.number_field :initial_capital, step: 0.01, min: 0,
152:                    placeholder: "0.00",
153:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
154:              </div>
155:            </div>
156:    
157:            <!-- MONEDA PREFERIDA -->
158:            <div>
159:              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Moneda preferida</label>
160:              <div class="relative">
161:                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none">
162:                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
163:                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
164:                  </svg>
165:                </div>
166:                <%= f.select :preferred_currency, options_for_select([
167:                  ["USD - Dólar", "USD"],
168:                  ["EUR - Euro", "EUR"],
169:                  ["GBP - Libra", "GBP"],
170:                  ["MXN - Peso Mexicano", "MXN"],
171:                  ["COP - Peso Colombiano", "COP"],
172:                  ["ARS - Peso Argentino", "ARS"],
173:                  ["BRL - Real Brasileño", "BRL"],
174:                  ["JPY - Yen", "JPY"]
175:                ], selected: current_user.preferred_currency,
176:                    class: "input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm transition-all focus:outline-none" %>
177:              </div>
178:            </div>
179:    
180:            <!-- SUBMIT -->
181:            <div class="pt-4">
182:              <%= f.submit "Guardar cambios",
183:                  class: "w-full py-3 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/30 transition-all duration-200 cursor-pointer transform hover:scale-[1.01] active:scale-[0.99]" %>
184:            </div>
185:    
186:          <% end %>
187:    
188:          <!-- DIVIDER -->
189:          <div class="flex items-center gap-3 my-5">
190:            <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
191:            <span class="text-xs text-slate-400">peligro</span>
192:            <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
193:          </div>
194:    
195:          <!-- CANCELAR Y ELIMINAR CUENTA -->
196:          <div class="flex items-center justify-between">
197:            <div>
198:              <%= button_to "Cancelar cuenta", registration_path(resource_name),
199:                  method: :delete, data: { confirm: "¿Estás seguro? Esta acción es irreversible." },
200:                  class: "text-xs text-rose-500 hover:text-rose-400 font-bold hover:underline transition-all" %>
201:            </div>
202:          </div>
203:        </div>
204:    
205:        <!-- NAVEGACIÓN -->
206:        <div class="mt-5 flex justify-center gap-4">
207:          <%= link_to "Volver al Dashboard", dashboard_path, class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold flex items-center gap-1" %>
208:          <span class="text-slate-400">|</span>
209:          <%= link_to "Cambiar contraseña", edit_password_path(resource_name), class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold flex items-center gap-1" %>
210:        </div>
211:      </div>
212:    </div>
  
