277:                <% end %>
278:              </a>
279:            <% end %>
280:          </nav>
281:    
282:          <!-- USER SECTION -->
283:          <div class="p-2.5 border-t dark:border-darkBorder border-lightBorder flex-shrink-0">
284:            <div class="flex items-center gap-3 px-2 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-darkHover cursor-pointer transition-all" onclick="window.location.href='<%= profile_path %>'" title="<%= current_user.name || current_user.email %>">
285:              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand to-violet-600 flex items-center justify-center font-bold text-white text-xs flex-shrink-0">
